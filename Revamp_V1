----------------------------------------------------------------------

local function buildRoomA(root, entrancePosition, forward)
	local folder = newFolder(root, "RoomA_TrapCorridor")
	local geomFolder = newFolder(folder, "Geometry")
	local hazFolder = newFolder(folder, "Hazards")
	local decFolder = newFolder(folder, "Decoration")
	local markersFolder = newFolder(folder, "Markers")

	local width = CONFIG.roomA.width
	local height = CONFIG.roomA.height
	local length = CONFIG.roomA.length
	local halfWidth = width / 2
	local wallThick = 2
	local fwd = unitXZ(forward)
	local right = getRight(fwd)

	local center = entrancePosition + fwd * (length / 2)

	-- Floor
	addOrientedPart(geomFolder, "Floor",
		Vector3.new(width, 1, length),
		center + Vector3.new(0, -0.5, 0),
		fwd, CONFIG.materials.floor, CONFIG.colors.floor)

	-- Ceiling
	addOrientedPart(geomFolder, "Ceiling",
		Vector3.new(width, 1, length),
		center + Vector3.new(0, height + 0.5, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wallDark)

	-- Left Wall
	addOrientedPart(geomFolder, "LeftWall",
		Vector3.new(wallThick, height, length),
		center - right * (halfWidth + wallThick / 2) + Vector3.new(0, height / 2, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wall)

	-- Right Wall
	addOrientedPart(geomFolder, "RightWall",
		Vector3.new(wallThick, height, length),
		center + right * (halfWidth + wallThick / 2) + Vector3.new(0, height / 2, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wall)

	-- Entrance door frame
	buildDoorFrame(geomFolder, "EntranceDoor", entrancePosition, fwd, width, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)

	-- Exit portcullis
	local exitPosition = entrancePosition + fwd * length
	buildPortcullisDoor(geomFolder, "ExitPortcullis", exitPosition, fwd, width, height)

	----------------------------------------------------------------------
	-- Hazard placement (deterministic, clearance-validated)
	----------------------------------------------------------------------
	local hazardRng = Random.new(CONFIG.roomA.hazardSeed)
	local trapFootprint = CONFIG.spikeTrap.depth + CONFIG.spikeTrap.housingMargin * 2
	local clearance = 3
	local cursor = CONFIG.roomA.hazardStart
	local hazardIndex = 0

	while cursor < length - CONFIG.roomA.hazardEndOffset do
		hazardIndex = hazardIndex + 1
		local spacing = hazardRng:NextInteger(CONFIG.roomA.spacingMin, CONFIG.roomA.spacingMax)

		if hazardIndex % 3 == 0 then
			-- Swinging blade at ceiling
			local pivotY = height - CONFIG.swingingBlade.mountDrop
			local pivotPos = entrancePosition + fwd * cursor + Vector3.new(0, pivotY, 0)
			buildSwingingBlade(hazFolder, "Blade_" .. hazardIndex, pivotPos, right)
		else
			-- Spike trap on floor
			local trapPos = entrancePosition + fwd * cursor
			buildSpikeTrap(hazFolder, "SpikeTrap_" .. hazardIndex, trapPos, fwd)
		end

		cursor = cursor + math.max(spacing, trapFootprint + clearance)
	end

	----------------------------------------------------------------------
	-- Decoration
	----------------------------------------------------------------------
	-- Torches
	layWallTorches(decFolder, "TorchL", entrancePosition - right * halfWidth, fwd, right, 5, length - 5)
	layWallTorches(decFolder, "TorchR", entrancePosition + right * halfWidth, fwd, -right, 5, length - 5)

	-- Ceiling beams
	layCeilingBeams(decFolder, "Beam", entrancePosition, fwd, width, height, 4, length - 4, CONFIG.materials.wood, CONFIG.colors.wood)

	-- Cornice + Baseboard
	addCorniceBand(decFolder, "CorniceL", entrancePosition - right * halfWidth, fwd, length, height, CONFIG.materials.trim, CONFIG.colors.trim)
	addCorniceBand(decFolder, "CorniceR", entrancePosition + right * halfWidth, fwd, length, height, CONFIG.materials.trim, CONFIG.colors.trim)
	addBaseboardBand(decFolder, "BaseboardL", entrancePosition - right * halfWidth, fwd, length, CONFIG.materials.trim, CONFIG.colors.trim)
	addBaseboardBand(decFolder, "BaseboardR", entrancePosition + right * halfWidth, fwd, length, CONFIG.materials.trim, CONFIG.colors.trim)

	-- Corner pilasters
	addPilaster(decFolder, "PilasterFL", entrancePosition - right * halfWidth, fwd, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	addPilaster(decFolder, "PilasterFR", entrancePosition + right * halfWidth, fwd, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	addPilaster(decFolder, "PilasterBL", exitPosition - right * halfWidth, fwd, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	addPilaster(decFolder, "PilasterBR", exitPosition + right * halfWidth, fwd, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)

	-- Environmental details (deterministic)
	local decRng = Random.new(CONFIG.roomA.hazardSeed + 1)

	-- Moss patches on floor
	for i = 1, 4 do
		local zOff = decRng:NextNumber() * (length - 20) + 10
		local xOff = (decRng:NextNumber() - 0.5) * (width - 4)
		buildMossPatch(decFolder, "Moss_" .. i,
			entrancePosition + fwd * zOff + right * xOff,
			fwd, 2 + decRng:NextNumber() * 2, 2 + decRng:NextNumber() * 2)
	end

	-- Vine strips from ceiling
	for i = 1, 3 do
		local zOff = decRng:NextNumber() * (length - 20) + 10
		local side = decRng:NextNumber() > 0.5 and 1 or -1
		buildVineStrip(decFolder, "Vine_" .. i,
			entrancePosition + fwd * zOff + right * (side * halfWidth) + Vector3.new(0, height, 0),
			height * 0.4 + decRng:NextNumber() * height * 0.3)
	end

	-- Collapsed masonry (positioned AWAY from hazards - near end of corridor)
	addCollapsedMasonry(decFolder, "Masonry_1",
		entrancePosition + fwd * (length - 20) + right * (halfWidth - 3),
		6, 2.5)
	addCollapsedMasonry(decFolder, "Masonry_2",
		entrancePosition + fwd * (length - 15) - right * (halfWidth - 4),
		5, 2)

	-- Broken support
	addBrokenSupport(decFolder, "BrokenSupport",
		entrancePosition + fwd * 15 - right * halfWidth,
		fwd, height, height * 0.6)

	-- Cracked floor patches (away from hazards)
	addCrackedFloorPatch(decFolder, "CrackedFloor_1",
		entrancePosition + fwd * (length - 18),
		fwd, 5, 4)

	-- Warning carvings
	addWarningCarving(decFolder, "Warning_1",
		entrancePosition + fwd * 5 - right * halfWidth,
		right, height * 0.5)
	addWarningCarving(decFolder, "Warning_2",
		entrancePosition + fwd * 5 + right * halfWidth,
		-right, height * 0.5)

	-- Subtle sunlight shafts (sparse, dark corridor)
	buildSunlightShaft(decFolder, "Sunlight_1",
		entrancePosition + fwd * 60 + Vector3.new(0, height, 0), 3, height)
	buildSunlightShaft(decFolder, "Sunlight_2",
		entrancePosition + fwd * 130 + Vector3.new(0, height, 0), 2.5, height)

	----------------------------------------------------------------------
	-- Markers
	----------------------------------------------------------------------
	addCheckpoint(markersFolder, "RoomA_Start", entrancePosition)
	addCheckpoint(markersFolder, "RoomA_End", exitPosition + fwd * 5)

	return folder, exitPosition
end

----------------------------------------------------------------------
-- STONE GOLEM (Medium-detail, 3 cores)
----------------------------------------------------------------------

local function buildGolem(parent, name, basePosition, forward)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent

	local fwd = unitXZ(forward)
	local right = getRight(fwd)
	local mat = CONFIG.materials.wall
	local col = CONFIG.colors.golemStone
	local coreMat = CONFIG.materials.neon
	local coreCol = CONFIG.colors.golemCore

	-- Pedestal (cylinder, radius=4, height=1.5)
	local pedestal = newPart({
		Name = "Pedestal",
		Size = Vector3.new(1.5, 8, 8),
		CFrame = CFrame.new(basePosition + Vector3.new(0, 0.75, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Shape = Enum.PartType.Cylinder,
		Material = mat, Color = col,
		Parent = model
	})

	local golemBase = basePosition + Vector3.new(0, 1.5, 0)

	-- Legs
	local legCF = orientedCFrame(golemBase + Vector3.new(0, 2, 0), fwd)
	addOrientedPart(model, "LeftLeg",
		Vector3.new(1.5, 4, 1.5),
		golemBase + Vector3.new(0, 2, 0) - right * 1,
		fwd, mat, col)
	addOrientedPart(model, "RightLeg",
		Vector3.new(1.5, 4, 1.5),
		golemBase + Vector3.new(0, 2, 0) + right * 1,
		fwd, mat, col)

	-- Torso
	local torsoPos = golemBase + Vector3.new(0, 6, 0)
	addOrientedPart(model, "Torso",
		Vector3.new(4, 4, 2.5),
		torsoPos, fwd, mat, col)

	-- Shoulder plates
	local lShoulderPos = torsoPos + Vector3.new(0, 2.5, 0) - right * 2.5
	local lShoulder = addOrientedPart(model, "LeftShoulder",
		Vector3.new(2, 1, 3),
		lShoulderPos, fwd, mat, col)
	lShoulder.CFrame = lShoulder.CFrame * CFrame.Angles(0, 0, math.rad(15))

	local rShoulderPos = torsoPos + Vector3.new(0, 2.5, 0) + right * 2.5
	local rShoulder = addOrientedPart(model, "RightShoulder",
		Vector3.new(2, 1, 3),
		rShoulderPos, fwd, mat, col)
	rShoulder.CFrame = rShoulder.CFrame * CFrame.Angles(0, 0, math.rad(-15))

	-- Arms
	local lArmPos = torsoPos + Vector3.new(0, -0.5, 0) - right * 2.5
	addOrientedPart(model, "LeftArm",
		Vector3.new(1.5, 5, 1.5),
		lArmPos, fwd, mat, col)

	local rArmPos = torsoPos + Vector3.new(0, -0.5, 0) + right * 2.5
	addOrientedPart(model, "RightArm",
		Vector3.new(1.5, 5, 1.5),
		rArmPos, fwd, mat, col)

	-- Shield (left arm)
	addOrientedPart(model, "Shield",
		Vector3.new(1, 6, 4),
		lArmPos + Vector3.new(0, -2, 0) - right * 1,
		fwd, mat, col)

	-- Weapon (right arm)
	local weaponPart = addOrientedPart(model, "Weapon",
		Vector3.new(1, 8, 2),
		rArmPos + Vector3.new(0, -1, 0) + fwd * 2,
		fwd, mat, Color3.fromRGB(80, 80, 80))
	weaponPart.CFrame = weaponPart.CFrame * CFrame.Angles(math.rad(45), 0, 0)

	-- Neck + Head
	addOrientedPart(model, "Neck",
		Vector3.new(1.5, 1, 1.5),
		torsoPos + Vector3.new(0, 2.5, 0),
		fwd, mat, col)

	local headPos = torsoPos + Vector3.new(0, 4, 0)
	addOrientedPart(model, "Head",
		Vector3.new(2.5, 2.5, 2.5),
		headPos, fwd, mat, col)

	-- Face indent
	addOrientedPart(model, "FaceIndent",
		Vector3.new(1.5, 1, 0.5),
		headPos + fwd * 1.1,
		fwd, mat, Color3.fromRGB(30, 30, 30))

	-- 3 Cores (Neon + PointLight)
	local function makeCore(cName, cPos)
		local core = addOrientedPart(model, cName,
			Vector3.new(CONFIG.roomB.coreRadius * 2, CONFIG.roomB.coreRadius * 2, CONFIG.roomB.coreRadius * 2),
			cPos, fwd, coreMat, coreCol)
		addGlow(core, coreCol, 8, 2)
	end

	makeCore("ChestCore", torsoPos + fwd * 1.3)
	makeCore("LeftShoulderCore", lShoulderPos + Vector3.new(0, 0.6, 0))
	makeCore("RightHipCore", golemBase + Vector3.new(0, 3.5, 0) + right * 1 + fwd * 0.8)

	-- Damage cracks
	local crack1 = addOrientedPart(model, "Crack1",
		Vector3.new(0.15, 2, 0.15),
		torsoPos - right * 1 + fwd * 1.26,
		fwd, mat, Color3.fromRGB(20, 20, 20))
	crack1.CFrame = crack1.CFrame * CFrame.Angles(0, 0, math.rad(25))

	local crack2 = addOrientedPart(model, "Crack2",
		Vector3.new(0.15, 1.5, 0.15),
		golemBase + Vector3.new(0, 2, 0) - right * 1 + fwd * 0.76,
		fwd, mat, Color3.fromRGB(20, 20, 20))
	crack2.CFrame = crack2.CFrame * CFrame.Angles(0, 0, math.rad(-15))

	-- Moss on shoulders/head
	buildMossPatch(model, "GolemMoss1", lShoulderPos + Vector3.new(0, 0.5, 0) - right * 0.5, fwd, 1, 1)
	buildMossPatch(model, "GolemMoss2", headPos + Vector3.new(0, 1.26, 0), fwd, 1.5, 1.5)

	-- Tags + Attributes
	CollectionService:AddTag(model, "StoneGolem")
	model:SetAttribute("Kind", "StoneGolem")
	model:SetAttribute("CoreCount", 3)
	model:SetAttribute("Health", 300)

	return model
end

----------------------------------------------------------------------
-- ROOM B: COMBAT COURTYARD (chamfered corners, open-air)
----------------------------------------------------------------------

local function buildRoomB(root, entrancePosition, forward)
	local folder = newFolder(root, "RoomB_CombatCourtyard")
	local geomFolder = newFolder(folder, "Geometry")
	local arenaFolder = newFolder(folder, "Arena")
	local decFolder = newFolder(folder, "Decoration")
	local markersFolder = newFolder(folder, "Markers")

	local width = CONFIG.roomB.width
	local depth = CONFIG.roomB.depth
	local height = CONFIG.roomB.wallHeight
	local chamfer = CONFIG.roomB.chamferSize
	local halfW = width / 2
	local halfD = depth / 2
	local wallThick = 2
	local fwd = unitXZ(forward)
	local right = getRight(fwd)
	local center = entrancePosition + fwd * halfD

	-- Floor
	addOrientedPart(geomFolder, "Floor",
		Vector3.new(width, 1, depth),
		center + Vector3.new(0, -0.5, 0),
		fwd, CONFIG.materials.floor, CONFIG.colors.floor)

	-- NO ceiling (open-air courtyard)

	----------------------------------------------------------------------
	-- Chamfered walls (4 main + 4 chamfer = 8 segments)
	----------------------------------------------------------------------
	local mainL = width - 2 * chamfer
	local archW = 16
	local sidePieceL = (mainL - archW) / 2

	-- Helper: build a wall segment with decoration
	local function wallSegment(segName, segCenter, segNormal, segLength)
		local segRight = getRight(segNormal)
		addOrientedPart(geomFolder, segName,
			Vector3.new(segLength, height, wallThick),
			segCenter + Vector3.new(0, height / 2, 0),
			segNormal, CONFIG.materials.wall, CONFIG.colors.wall)

		-- Cornice + baseboard
		addCorniceBand(decFolder, segName .. "_Cornice",
			segCenter, segNormal, segLength, height, CONFIG.materials.trim, CONFIG.colors.trim)
		addBaseboardBand(decFolder, segName .. "_Baseboard",
			segCenter, segNormal, segLength, CONFIG.materials.trim, CONFIG.colors.trim)

		-- Torch at center of segment
		local inward = -segNormal
		addWallTorch(decFolder, segName .. "_Torch",
			segCenter + inward * (wallThick / 2),
			inward, CONFIG.detail.torchHeight)
	end

	-- North wall (entrance side): split for archway
	local nCenter = center - fwd * (halfD - wallThick / 2)
	wallSegment("NorthWallL", nCenter - right * (archW / 2 + sidePieceL / 2), -fwd, sidePieceL)
	wallSegment("NorthWallR", nCenter + right * (archW / 2 + sidePieceL / 2), -fwd, sidePieceL)
	buildAncientArch(geomFolder, "EntranceArch", nCenter, fwd, archW, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)

	-- South wall (exit side): split for archway
	local sCenter = center + fwd * (halfD - wallThick / 2)
	wallSegment("SouthWallL", sCenter - right * (archW / 2 + sidePieceL / 2), fwd, sidePieceL)
	wallSegment("SouthWallR", sCenter + right * (archW / 2 + sidePieceL / 2), fwd, sidePieceL)
	buildAncientArch(geomFolder, "ExitArch", sCenter, fwd, archW, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)

	-- East + West walls
	local ewLength = depth - 2 * chamfer
	wallSegment("EastWall", center + right * (halfW - wallThick / 2), -right, ewLength)
	wallSegment("WestWall", center - right * (halfW - wallThick / 2), right, ewLength)

	-- Chamfer walls
	local chLength = chamfer * math.sqrt(2)
	local chOff = halfW - chamfer / 2
	local chDOff = halfD - chamfer / 2

	local nwNorm = (fwd - right).Unit
	wallSegment("ChamferNW", center - fwd * chDOff - right * chOff, nwNorm, chLength)

	local neNorm = (fwd + right).Unit
	wallSegment("ChamferNE", center - fwd * chDOff + right * chOff, neNorm, chLength)

	local swNorm = (-fwd - right).Unit
	wallSegment("ChamferSW", center + fwd * chDOff - right * chOff, swNorm, chLength)

	local seNorm = (-fwd + right).Unit
	wallSegment("ChamferSE", center + fwd * chDOff + right * chOff, seNorm, chLength)

	-- Pilasters at 8 corner junctions
	local cornerOff = halfW - chamfer
	local corners = {
		{pos = center - fwd * halfD - right * cornerOff, dir = fwd},
		{pos = center - fwd * halfD + right * cornerOff, dir = fwd},
		{pos = center + fwd * halfD - right * cornerOff, dir = -fwd},
		{pos = center + fwd * halfD + right * cornerOff, dir = -fwd},
		{pos = center - fwd * cornerOff - right * halfW, dir = right},
		{pos = center - fwd * cornerOff + right * halfW, dir = -right},
		{pos = center + fwd * cornerOff - right * halfW, dir = right},
		{pos = center + fwd * cornerOff + right * halfW, dir = -right},
	}
	for i, c in ipairs(corners) do
		addPilaster(decFolder, "Pilaster_" .. i, c.pos, c.dir, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	end

	----------------------------------------------------------------------
	-- Water channels (inside, along main walls)
	----------------------------------------------------------------------
	local chanW = CONFIG.roomB.waterChannelWidth
	local chanDepth = CONFIG.roomB.waterDepth

	buildWaterChannel(decFolder, "WaterEast",
		center + right * (halfW - wallThick - chanW / 2) - fwd * (ewLength / 2),
		fwd, ewLength, chanW, chanDepth)
	buildWaterChannel(decFolder, "WaterWest",
		center - right * (halfW - wallThick - chanW / 2) - fwd * (ewLength / 2),
		fwd, ewLength, chanW, chanDepth)

	----------------------------------------------------------------------
	-- Central arena
	----------------------------------------------------------------------
	-- Raised circular platform
	local platformPart = newPart({
		Name = "CentralPlatform",
		Size = Vector3.new(0.4, 30, 30),
		CFrame = CFrame.new(center + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Shape = Enum.PartType.Cylinder,
		Material = CONFIG.materials.wall,
		Color = CONFIG.colors.ancientStone,
		Parent = arenaFolder
	})

	-- Golem on pedestal at center
	buildGolem(arenaFolder, "ArenaGolem", center + Vector3.new(0, 0.4, 0), fwd)

	----------------------------------------------------------------------
	-- Corner statues at chamfer positions
	----------------------------------------------------------------------
	local statPositions = {
		{pos = center - fwd * (halfD - chamfer) - right * (halfW - chamfer), dir = (fwd + right).Unit},
		{pos = center - fwd * (halfD - chamfer) + right * (halfW - chamfer), dir = (fwd - right).Unit},
		{pos = center + fwd * (halfD - chamfer) - right * (halfW - chamfer), dir = (-fwd + right).Unit},
		{pos = center + fwd * (halfD - chamfer) + right * (halfW - chamfer), dir = (-fwd - right).Unit},
	}
	for i, s in ipairs(statPositions) do
		buildStatue(decFolder, "Statue_" .. i, s.pos, s.dir, 8, "standing")
	end

	----------------------------------------------------------------------
	-- Extra decoration
	----------------------------------------------------------------------
	-- Moss on floor edges
	for i = 1, 6 do
		local angle = (i / 6) * math.pi * 2
		local mPos = center + Vector3.new(math.sin(angle), 0, math.cos(angle)) * (halfW - 4)
		buildMossPatch(decFolder, "Moss_" .. i, mPos, fwd, 3, 3)
	end

	-- Vines from wall tops
	for i = 1, 4 do
		local vPos = corners[i].pos + Vector3.new(0, height, 0)
		buildVineStrip(decFolder, "Vine_" .. i, vPos, height * 0.3)
	end

	-- Rubble in corners
	addRubblePile(decFolder, "Rubble_1", center - fwd * (halfD - 5) - right * (halfW - 5), 5, 3)
	addRubblePile(decFolder, "Rubble_2", center + fwd * (halfD - 5) + right * (halfW - 5), 4, 2.5)

	----------------------------------------------------------------------
	-- Markers
	----------------------------------------------------------------------
	local exitPosition = entrancePosition + fwd * depth
	addCheckpoint(markersFolder, "RoomB_Start", entrancePosition)
	addCheckpoint(markersFolder, "RoomB_End", exitPosition + fwd * 5)

	-- Golem spawn and arena center markers (invisible)
	local spawnMarker = newPart({
		Name = "RoomB_GolemSpawn",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(center + Vector3.new(0, 2, 0)),
		Transparency = 1, CanCollide = false,
		Parent = markersFolder
	})
	local centerMarker = newPart({
		Name = "RoomB_ArenaCenter",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(center + Vector3.new(0, 0.5, 0)),
		Transparency = 1, CanCollide = false,
		Parent = markersFolder
	})

	return folder, exitPosition
end

