        Name = "Shaft",
        Size = Vector3.new(beamWidth, beamHeight, beamWidth),
        CFrame = CFrame.new(pos),
        Shape = Enum.PartType.Cylinder,
        Material = Enum.Material.Neon,
        Color = CONFIG.colors.skyLight,
        Transparency = 0.85,
        CanCollide = false,
        CanQuery = false,
        Parent = model
    })
    
    -- cylinder is oriented along X naturally, need to flip it
    beam.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi/2)
    
    local light = Instance.new("SpotLight")
    light.Color = CONFIG.colors.skyLight
    light.Range = beamHeight * 1.5
    light.Brightness = CONFIG.lighting.sunlightBrightness
    light.Angle = 45
    light.Face = Enum.NormalId.Bottom
    light.Parent = beam
    
    return model
end

local function buildDragonMural(parent, name, wallPosition, forward, width, height)
    local model = newFolder(parent, name)
    local fwd = unitXZ(forward)
