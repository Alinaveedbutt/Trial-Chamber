----------------------------------------------------------------------
-- ROOM C: OASIS SANCTUARY
----------------------------------------------------------------------

local function buildRoomC(root, entrancePosition, forward)
	local folder = newFolder(root, "RoomC_OasisSanctuary")
	local archFolder = newFolder(folder, "Architecture")
	local heartFolder = newFolder(folder, "Heart")
	local waterFolder = newFolder(folder, "Water")
	local decorFolder = newFolder(folder, "Decoration")
	local markersFolder = newFolder(folder, "Markers")

	local radius = CONFIG.roomC.radius
	local height = CONFIG.roomC.wallHeight
	local fwd = unitXZ(forward)
	local right = getRight(fwd)
	local center = entrancePosition + fwd * radius

	-- Floor
	addOrientedPart(archFolder, "Floor",
		Vector3.new(radius * 2, 1, radius * 2),
		center + Vector3.new(0, -0.5, 0),
		fwd, CONFIG.materials.floor, CONFIG.colors.ancientStone)

	-- Circular wall ring (16 segments)
	local segmentCount = 16
	local angleStep = math.pi * 2 / segmentCount
	local wallWidth = (radius * 2 * math.pi) / segmentCount * 1.05

	for i = 0, segmentCount - 1 do
		local angle = i * angleStep
		local offset = Vector3.new(math.sin(angle), 0, math.cos(angle)) * radius
		local wallPos = center + offset + Vector3.new(0, height / 2, 0)
		
		-- Check distance to entrance/exit to leave gaps
		local distToEnt = (wallPos * Vector3.new(1,0,1) - entrancePosition * Vector3.new(1,0,1)).Magnitude
		local exitPosExact = center + fwd * radius
		local distToExit = (wallPos * Vector3.new(1,0,1) - exitPosExact * Vector3.new(1,0,1)).Magnitude

		if distToEnt > 10 and distToExit > 10 then
			local inward = (center - wallPos).Unit
			inward = unitXZ(inward)
			addOrientedPart(archFolder, "WallSegment_" .. i,
				Vector3.new(wallWidth, height, 2),
				wallPos, inward, CONFIG.materials.wall, CONFIG.colors.wall)
		end
	end

	-- Internal arches (8)
	local archCount = CONFIG.roomC.archCount
	local archAngleStep = math.pi * 2 / archCount
	for i = 1, archCount do
		local angle = i * archAngleStep
		local offset = Vector3.new(math.sin(angle), 0, math.cos(angle)) * (radius - 6)
		local archPos = center + offset
		local inward = (center - archPos).Unit
		
		buildAncientArch(archFolder, "Arch_" .. i, archPos, inward, CONFIG.roomC.archWidth, CONFIG.roomC.archHeight, CONFIG.materials.wall, CONFIG.colors.ancientStone)
		
		-- Wall Torches between arches
		local torchAngle = angle + (archAngleStep / 2)
		local tOffset = Vector3.new(math.sin(torchAngle), 0, math.cos(torchAngle)) * (radius - 1)
		local tInward = (center - (center + tOffset)).Unit
		addWallTorch(decorFolder, "Torch_" .. i, center + tOffset, tInward, 10)
	end

	-- Partial ceiling (hole in middle)
	local ceilY = center.Y + height
	local ceilThick = 1
	addOrientedPart(archFolder, "Ceil_N", Vector3.new(radius * 2, ceilThick, 26), center + fwd * 23 + Vector3.new(0, height + 0.5, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wallDark)
	addOrientedPart(archFolder, "Ceil_S", Vector3.new(radius * 2, ceilThick, 26), center - fwd * 23 + Vector3.new(0, height + 0.5, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wallDark)
	addOrientedPart(archFolder, "Ceil_E", Vector3.new(26, ceilThick, 20), center + right * 23 + Vector3.new(0, height + 0.5, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wallDark)
	addOrientedPart(archFolder, "Ceil_W", Vector3.new(26, ceilThick, 20), center - right * 23 + Vector3.new(0, height + 0.5, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wallDark)

	-- Heart Dais (stepped)
	local function makeCylStep(name, r, h, y, mat, col)
		local p = newPart({
			Name = name,
			Size = Vector3.new(h, r * 2, r * 2),
			CFrame = CFrame.new(center + Vector3.new(0, y + h/2, 0)) * CFrame.Angles(0, 0, math.pi/2),
			Shape = Enum.PartType.Cylinder,
			Material = mat, Color = col, Parent = heartFolder
		})
		return p
	end

	makeCylStep("Step1", 10, 0.8, 0, CONFIG.materials.floor, CONFIG.colors.ancientStone)
	makeCylStep("Step2", 8, 0.8, 0.8, CONFIG.materials.floor, CONFIG.colors.ancientStone)
	makeCylStep("Step3", 6, 0.9, 1.6, CONFIG.materials.floor, CONFIG.colors.ancientStone)
	makeCylStep("Pedestal", 1.5, 0.6, 2.5, CONFIG.materials.wall, CONFIG.colors.ancientStone)

	-- Heart Crystal
	local crystalY = 2.5 + 0.6 + 1.0
	local crystalPos = center + Vector3.new(0, crystalY + CONFIG.roomC.crystalHeight / 2, 0)
	local mainCrystal = addOrientedPart(heartFolder, "HeartCrystal",
		Vector3.new(CONFIG.roomC.crystalWidth, CONFIG.roomC.crystalHeight, CONFIG.roomC.crystalWidth),
		crystalPos, fwd, CONFIG.materials.neon, CONFIG.colors.crystal)
	
	addGlow(mainCrystal, CONFIG.colors.crystalGlow, CONFIG.lighting.crystalRange, CONFIG.lighting.crystalBrightness)
	addGlow(mainCrystal, CONFIG.colors.sacred, CONFIG.lighting.sacredRange, 1) -- secondary ambient

	for f = 1, 4 do
		local facet = addOrientedPart(heartFolder, "Facet_" .. f,
			Vector3.new(1.5, CONFIG.roomC.crystalHeight * 0.9, 1.5),
			crystalPos, fwd, CONFIG.materials.neon, CONFIG.colors.crystal)
		facet.CFrame = facet.CFrame * CFrame.Angles(0, (f-1)*math.pi/2 + math.pi/4, 0)
	end

	-- Water Pool (surrounding dais)
	local poolY = -CONFIG.roomC.poolDepth + 0.1
	for w = 1, 4 do
		local wPart = addOrientedPart(waterFolder, "Pool_" .. w,
			Vector3.new(14, 0.2, 14),
			center + Vector3.new(0, poolY, 0), fwd, CONFIG.materials.water, CONFIG.colors.water,
			{Transparency = 0.4, CanCollide = false})
		wPart.CFrame = CFrame.new(center) * CFrame.Angles(0, (w-1)*math.pi/2, 0) * CFrame.new(0, poolY, 14)
	end

	-- Decoration (magic motes, vines, moss)
	for d = 1, 6 do
		local angle = d * math.pi / 3
		local mPos = center + Vector3.new(math.sin(angle)*4, crystalY + 2 + math.sin(d)*1.5, math.cos(angle)*4)
		newPart({
			Name = "Mote_" .. d,
			Size = Vector3.new(0.5, 0.5, 0.5),
			CFrame = CFrame.new(mPos),
			Shape = Enum.PartType.Ball,
			Material = CONFIG.materials.neon, Color = CONFIG.colors.sacred,
			Transparency = 0.3, CanCollide = false, Parent = decorFolder
		})
	end

	buildSunlightShaft(decorFolder, "CentralSunlight", center + Vector3.new(0, height, 0), 12, height)
	buildMossPatch(decorFolder, "DaisMoss", center + Vector3.new(0, 1.6, 5), fwd, 3, 2)
	buildVineStrip(decorFolder, "ArchVine_1", center + fwd * 25 + Vector3.new(0, 16, 0), 6)
	buildVineStrip(decorFolder, "ArchVine_2", center - right * 25 + Vector3.new(0, 16, 0), 8)

	-- Markers
	local exitPosition = center + fwd * radius
	addCheckpoint(markersFolder, "RoomC_Start", entrancePosition)
	addCheckpoint(markersFolder, "RoomC_Heart", crystalPos)
	addCheckpoint(markersFolder, "RoomC_End", exitPosition)

	-- Invisible narrative hooks
	local function addHook(name, pos)
		newPart({Name = name, Size = Vector3.new(1,1,1), CFrame = CFrame.new(pos), Transparency = 1, CanCollide = false, Parent = markersFolder})
	end
	addHook("RoomC_HeartModel", crystalPos)
	addHook("RoomC_HeartPedestal", center + Vector3.new(0, 2.5, 0))
	addHook("RoomC_HeartRevealPoint", center - fwd * 20)
	addHook("RoomC_HeartInteractPoint", center - fwd * 8)
	addHook("RoomC_ProctorPoint", center + right * 10)
	addHook("RoomC_ProctorSpawn", center + right * 12)
	addHook("RoomC_ExitGate", exitPosition)

	local colZone = newPart({
		Name = "RoomC_CollapseZone", Size = Vector3.new(100, 50, 100),
		CFrame = CFrame.new(center + Vector3.new(0, 10, 0)),
		Transparency = 1, CanCollide = false, Parent = markersFolder
	})
	CollectionService:AddTag(colZone, "CollapseTrigger")

	return folder, exitPosition
end

----------------------------------------------------------------------
-- COLLAPSE TRANSITION C -> D
----------------------------------------------------------------------

local function buildCollapseTransition(root, startPosition, forward)
	local folder = newFolder(root, "Transition_C_D_Collapse")
	local geoFolder = newFolder(folder, "Geometry")
	local debrisFolder = newFolder(folder, "Debris")
	local markersFolder = newFolder(folder, "Markers")

	local length = CONFIG.transitions.collapseLength
	local fwd = unitXZ(forward)
	local right = getRight(fwd)
	
	-- Broken geometry
	addOrientedPart(geoFolder, "Floor1",
		Vector3.new(16, 1, length/2),
		startPosition + fwd * (length/4) + Vector3.new(0, -0.5, 0),
		fwd, CONFIG.materials.floor, CONFIG.colors.floor)
	
	local f2 = addOrientedPart(geoFolder, "Floor2",
		Vector3.new(12, 1, length/2),
		startPosition + fwd * (length*0.75) + Vector3.new(0, -0.7, 0),
		fwd, CONFIG.materials.floor, CONFIG.colors.floor)
	f2.CFrame = f2.CFrame * CFrame.Angles(math.rad(-3), 0, 0)

	local wL = addOrientedPart(geoFolder, "WallL",
		Vector3.new(1, 16, length),
		startPosition + fwd * (length/2) - right * 7 + Vector3.new(0, 8, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wall)
	wL.CFrame = wL.CFrame * CFrame.Angles(0, math.rad(2), math.rad(5))

	local wR = addOrientedPart(geoFolder, "WallR",
		Vector3.new(1, 16, length),
		startPosition + fwd * (length/2) + right * 7 + Vector3.new(0, 8, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wall)
	wR.CFrame = wR.CFrame * CFrame.Angles(0, math.rad(-2), math.rad(-3))

	local ceil = addOrientedPart(geoFolder, "CeilPartial",
		Vector3.new(14, 1, length*0.6),
		startPosition + fwd * (length*0.3) + Vector3.new(0, 15, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wallDark)
	ceil.CFrame = ceil.CFrame * CFrame.Angles(math.rad(10), 0, 0)

	-- Debris
	addBrokenSupport(debrisFolder, "FallenPillar", startPosition + fwd * (length/2) + right * 3, fwd, 16, 3)
	addCollapsedMasonry(debrisFolder, "Rubble_1", startPosition + fwd * (length*0.4) - right * 4, 6, 3)
	addCollapsedMasonry(debrisFolder, "Rubble_2", startPosition + fwd * (length*0.8) + right * 2, 8, 4)

	-- Glowing stress cracks
	for c = 1, 5 do
		local crackPos = startPosition + fwd * (length * c/6) + right * ((c%2 == 0) and 4 or -4)
		local p = newPart({
			Name = "GlowingCrack_"..c, Size = Vector3.new(4, 0.2, 0.5),
			CFrame = CFrame.new(crackPos) * CFrame.Angles(0, math.rad(math.random(-45, 45)), 0),
			Material = CONFIG.materials.neon, Color = CONFIG.colors.crack,
			CanCollide = false, Parent = debrisFolder
		})
		addGlow(p, CONFIG.colors.crack, 8, 1.5)
	end

	local exitPos = startPosition + fwd * length

	-- Markers
	local function addHook(name, pos)
		newPart({Name = name, Size = Vector3.new(1,1,1), CFrame = CFrame.new(pos), Transparency = 1, CanCollide = false, Parent = markersFolder})
	end
	
	addHook("Transition_C_D_WizardPoint", startPosition + fwd * 5)
	addHook("Transition_C_D_WizardRoute_1", startPosition + fwd * 15)
	addHook("Transition_C_D_WizardRoute_2", startPosition + fwd * 25)
	addHook("Transition_C_D_ExitTrigger", exitPos)
	addHook("Transition_C_D_MysteriousWarriorPoint", exitPos + fwd * 5)
	addHook("Transition_C_D_WarriorReveal", exitPos + fwd * 10)

	return folder, exitPos
end

----------------------------------------------------------------------
-- ROOM D: ASCENT OF ECHOES
----------------------------------------------------------------------

local function buildRoomD(root, entrancePosition, forward)
	local folder = newFolder(root, "RoomD_AscentOfEchoes")
	local geoFolder = newFolder(folder, "Geometry")
	local parkourFolder = newFolder(folder, "Parkour")
	local echoesFolder = newFolder(folder, "Echoes")
	local hazardsFolder = newFolder(folder, "Hazards")
	local decorFolder = newFolder(folder, "Decoration")
	local markersFolder = newFolder(folder, "Markers")

	local fwd = unitXZ(forward)
	local right = getRight(fwd)
	local center = entrancePosition + fwd * (CONFIG.roomD.depth / 2)
	local roomDRng = Random.new(CONFIG.roomD.seed)

	local wWidth = CONFIG.roomD.width
	local wDepth = CONFIG.roomD.depth
	local wHeight = CONFIG.roomD.height
	local t = CONFIG.roomD.wallThickness

	-- Base Floor
	addOrientedPart(geoFolder, "BaseFloor",
		Vector3.new(wWidth, 1, wDepth),
		center + Vector3.new(0, -0.5, 0),
		fwd, CONFIG.materials.floor, CONFIG.colors.floor)

	-- 4 Main Shaft Walls
	addOrientedPart(geoFolder, "WallBack",
		Vector3.new(wWidth + t*2, wHeight, t),
		center - fwd * (wDepth/2 + t/2) + Vector3.new(0, wHeight/2, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wall)
	addOrientedPart(geoFolder, "WallFront",
		Vector3.new(wWidth + t*2, wHeight, t),
		center + fwd * (wDepth/2 + t/2) + Vector3.new(0, wHeight/2, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wall)
	addOrientedPart(geoFolder, "WallLeft",
		Vector3.new(t, wHeight, wDepth),
		center - right * (wWidth/2 + t/2) + Vector3.new(0, wHeight/2, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wall)
	addOrientedPart(geoFolder, "WallRight",
		Vector3.new(t, wHeight, wDepth),
		center + right * (wWidth/2 + t/2) + Vector3.new(0, wHeight/2, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wall)

	-- Atmosphere/Fog layers
	for f = 1, 4 do
		local fog = newPart({
			Name = "FogLayer_" .. f,
			Size = Vector3.new(wWidth, 10, wDepth),
			CFrame = CFrame.new(center + Vector3.new(0, f * 40, 0)),
			Material = Enum.Material.Neon, Color = CONFIG.colors.fog,
			Transparency = 0.9, CanCollide = false, Parent = decorFolder
		})
	end

	-- Sunlight shafts (brighter at top)
	buildSunlightShaft(decorFolder, "Sun_1", center + Vector3.new(0, wHeight, 0), 10, wHeight)
	buildSunlightShaft(decorFolder, "Sun_2", center + right*10 + fwd*10 + Vector3.new(0, wHeight, 0), 6, wHeight*0.8)
	buildSunlightShaft(decorFolder, "Sun_3", center - right*10 - fwd*10 + Vector3.new(0, wHeight, 0), 8, wHeight*0.6)

	-- Dragon Murals
	buildDragonMural(decorFolder, "DragonMural_1", center + right * (wWidth/2 - 0.5) + Vector3.new(0, 80, 0), -right, 20, 10)
	buildDragonMural(decorFolder, "DragonMural_2", center - right * (wWidth/2 - 0.5) + Vector3.new(0, 140, 0), right, 25, 12)
	buildDragonMural(decorFolder, "DragonMural_3", center + fwd * (wDepth/2 - 0.5) + Vector3.new(0, 180, 0), -fwd, 30, 15)

	-- Parkour generation
	local sectionHeight = wHeight / CONFIG.roomD.sectionCount
	local side = 1
	local echoStages = {"Doubt", "Doubt", "Desperation", "Desperation", "Desperation", "Anger", "Anger", "Silence"}
	local echoCount = 1

	for section = 1, CONFIG.roomD.sectionCount do
		local sectionBaseY = (section - 1) * sectionHeight
		local platformCount = 3 + (section <= 4 and 0 or 1)
		local verticalStep = sectionHeight / (platformCount + 1)
		local stage = echoStages[section]

		for p = 1, platformCount do
			local py = sectionBaseY + verticalStep * p
			local px = side * (wWidth / 2 - CONFIG.roomD.parkour.minLandingSize - roomDRng:NextNumber() * 8)
			local pz = (roomDRng:NextNumber() - 0.5) * (wDepth - CONFIG.roomD.parkour.minLandingSize * 2)

			local platSizeX = CONFIG.roomD.parkour.minLandingSize + roomDRng:NextNumber() * 4
			local platSizeZ = CONFIG.roomD.parkour.platformDepth
			local pPos = center + right * px + fwd * pz + Vector3.new(0, py, 0)

			local platName = "Platform_" .. section .. "_" .. p
			if section == 3 and p == 2 then platName = "ShiftingPlatform" end

			local plat = buildParkourPlatform(parkourFolder, platName, pPos, fwd, platSizeX, platSizeZ, CONFIG.materials.wall, CONFIG.colors.ancientStone)

			if section == 3 and p == 3 then
				CollectionService:AddTag(plat, "CollapsingPlatform")
			end
			
			if roomDRng:NextNumber() > 0.6 then
				buildMossPatch(decorFolder, "Moss_"..section.."_"..p, pPos, fwd, platSizeX*0.8, platSizeZ*0.8)
			end

			side = side * -1
		end

		local sectionMidY = sectionBaseY + sectionHeight/2

		-- Echo Triggers
		if stage ~= "Silence" then
			local echo = Instance.new("Model")
			echo.Name = "RoomD_Echo_" .. echoCount
			echo.Parent = echoesFolder
			
			local trig = newPart({
				Name = "EchoTrigger",
				Size = Vector3.new(wWidth, sectionHeight, wDepth),
				CFrame = CFrame.new(center + Vector3.new(0, sectionMidY, 0)),
				Transparency = 1, CanCollide = false, CanQuery = true, Parent = echo
			})
			echo:SetAttribute("EchoStage", stage)
			echo:SetAttribute("EchoIndex", echoCount)
			CollectionService:AddTag(echo, "WarriorEcho")
			echoCount = echoCount + 1

			-- Statues matching psychological stage
			local pose = "standing"
			if stage == "Doubt" then pose = "sitting" end
			if stage == "Desperation" then pose = "collapsed" end
			if stage == "Anger" then pose = "reaching" end

			local sPos = center + right * (roomDRng:NextNumber()-0.5)*20 + fwd * (roomDRng:NextNumber()-0.5)*20 + Vector3.new(0, sectionMidY, 0)
			buildStatue(decorFolder, "Statue_"..stage.."_"..section, sPos, fwd, 6, pose)
		end

		-- Section specifics
		if section == 4 then
			buildBrokenBridge(parkourFolder, "BrokenBridge_S4",
				center - right*(wWidth/2) + Vector3.new(0, sectionMidY, 0),
				center + right*(wWidth/2) + Vector3.new(0, sectionMidY, 0),
				right, 6, false)
		end

		if section == 5 then
			for c = 1, 2 do
				local cPosTop = center + right * (c==1 and 8 or -8) + Vector3.new(0, sectionMidY + 15, 0)
				local cPosBot = cPosTop - Vector3.new(0, 20, 0)
				local chain = buildChainSegment(hazardsFolder, "Chain_"..c, cPosTop, cPosBot, 10)
				CollectionService:AddTag(chain, "ChainClimb")
			end
		end

		if section == 6 then
			buildStonePillar(hazardsFolder, "PillarJump_1", center + right*5 + Vector3.new(0, sectionMidY-5, 0), 10, 3, CONFIG.materials.wall, CONFIG.colors.ancientStone, true)
			buildStonePillar(hazardsFolder, "PillarJump_2", center - right*5 + Vector3.new(0, sectionMidY, 0), 10, 3, CONFIG.materials.wall, CONFIG.colors.ancientStone, true)
		end
	end

	-- Markers
	addCheckpoint(markersFolder, "RoomD_Start", entrancePosition)
	addCheckpoint(markersFolder, "RoomD_Checkpoint_01", center + Vector3.new(0, 50, 0))
	addCheckpoint(markersFolder, "RoomD_Checkpoint_02", center + Vector3.new(0, 100, 0))
	addCheckpoint(markersFolder, "RoomD_Checkpoint_03", center + Vector3.new(0, 150, 0))

	local topPosition = entrancePosition + Vector3.new(0, wHeight, 0)
	return folder, topPosition
end

