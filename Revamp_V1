local random = Random.new(20260802)

local function unitXZ(vector)
    local v = Vector3.new(vector.X, 0, vector.Z)
    if v.Magnitude > 0.001 then
        return v.Unit
    else
        return Vector3.new(0, 0, -1)
    end
end

local function getRight(forward)
    local fwd = unitXZ(forward)
    return Vector3.new(fwd.Z, 0, -fwd.X)
end

local function orientedCFrame(position, forward)
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    return CFrame.fromMatrix(position, right, Vector3.new(0, 1, 0), -fwd)
end

local function newFolder(parent, name)
    local folder = Instance.new("Folder")
    folder.Name = name
    folder.Parent = parent
    return folder
end

local function newPart(properties)
    local part = Instance.new("Part")
    part.Anchored = true
    for k, v in pairs(properties) do
        part[k] = v
    end
    return part
end

local function addGlow(part, color, range, brightness)
    local light = Instance.new("PointLight")
    light.Color = color
    light.Range = range
    light.Brightness = brightness
    light.Parent = part
    return light
end

local function addOrientedPart(parent, name, size, position, forward, material, color, options)
    local props = {
        Name = name,
        Size = size,
        CFrame = orientedCFrame(position, forward),
        Material = material,
        Color = color,
        Parent = parent
    }
    if options then
        for k, v in pairs(options) do
            props[k] = v
        end
    end
    return newPart(props)
end

local function horizontalAxisCFrame(position, axisDirection)
    local fwd = unitXZ(axisDirection)
    return CFrame.fromMatrix(position, fwd, Vector3.new(0, 1, 0))
end

local function addPilaster(parent, name, floorPosition, forward, height, material, color)
    local model = newFolder(parent, name)
    local right = getRight(forward)
    local fwd = unitXZ(forward)
    
    local w = CONFIG.detail.pillarSize
    local d = CONFIG.detail.pillarSize * 0.5
    local pos = floorPosition + Vector3.new(0, height/2, 0)
    addOrientedPart(model, "Shaft", Vector3.new(w, height, d), pos, fwd, material, color)
    
    addOrientedPart(model, "Base", Vector3.new(w+0.4, 0.8, d+0.2), floorPosition + Vector3.new(0, 0.4, 0) + fwd*(0.1), fwd, material, color)
    addOrientedPart(model, "Capital", Vector3.new(w+0.4, 0.8, d+0.2), floorPosition + Vector3.new(0, height-0.4, 0) + fwd*(0.1), fwd, material, color)
    
    return model
end

