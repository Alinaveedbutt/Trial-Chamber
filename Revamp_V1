local function buildStatue(parent, name, basePosition, forward, height, pose)
    local model = newFolder(parent, name)
    local mat = CONFIG.materials.wall
    local col = CONFIG.colors.statue
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    
    local pedH = height * 0.15
    addOrientedPart(model, "Pedestal", Vector3.new(height*0.4, pedH, height*0.4), basePosition + Vector3.new(0, pedH/2, 0), fwd, mat, col)
    
    local legH = height * 0.35
    local torsoH = height * 0.35
    local headS = height * 0.15
    local legW = height * 0.15
    
    local legPosY = basePosition.Y + pedH + legH/2
    local lLegPos = Vector3.new(basePosition.X, legPosY, basePosition.Z) - right*(legW/2)
    local rLegPos = Vector3.new(basePosition.X, legPosY, basePosition.Z) + right*(legW/2)
    
    addOrientedPart(model, "LeftLeg", Vector3.new(legW*0.8, legH, legW*0.8), lLegPos, fwd, mat, col)
    addOrientedPart(model, "RightLeg", Vector3.new(legW*0.8, legH, legW*0.8), rLegPos, fwd, mat, col)
    
    local torsoPos = basePosition + Vector3.new(0, pedH + legH + torsoH/2, 0)
    addOrientedPart(model, "Torso", Vector3.new(height*0.35, torsoH, height*0.2), torsoPos, fwd, mat, col)
    
    local headPos = basePosition + Vector3.new(0, pedH + legH + torsoH + headS/2, 0)
    addOrientedPart(model, "Head", Vector3.new(headS, headS, headS), headPos, fwd, mat, col)
    
    local armW = height * 0.1
    local armL = height * 0.35
    local lArmPos = torsoPos - right*(height*0.25)
    local rArmPos = torsoPos + right*(height*0.25)
    
    local armPitch = 0
    if pose == 'reaching' then armPitch = math.pi/2 end
    if pose == 'collapsed' then armPitch = -math.pi/4 end
    
    local lArmCF = orientedCFrame(lArmPos, fwd) * CFrame.Angles(armPitch, 0, 0) * CFrame.new(0, -armL/2, 0)
    local lArm = newPart({Name="LeftArm", Size=Vector3.new(armW, armL, armW), CFrame=lArmCF, Material=mat, Color=col, Parent=model})
    
    local rArmCF = orientedCFrame(rArmPos, fwd) * CFrame.Angles(armPitch, 0, 0) * CFrame.new(0, -armL/2, 0)
    local rArm = newPart({Name="RightArm", Size=Vector3.new(armW, armL, armW), CFrame=rArmCF, Material=mat, Color=col, Parent=model})
    
    return model
end

local function buildChainSegment(parent, name, topPosition, bottomPosition, linkCount)
    local model = newFolder(parent, name)
    local diff = bottomPosition - topPosition
    local len = diff.Magnitude
    local fwd = unitXZ(diff)
    if fwd.Magnitude < 0.001 then fwd = Vector3.new(1,0,0) end
    
    local step = len / linkCount
    local size = CONFIG.roomD.chainLinkSize
    
    for i=1, linkCount do
        local fraction = (i - 0.5) / linkCount
        local pos = topPosition + diff * fraction
        local orient = CFrame.new(pos, pos + diff)
        if i % 2 == 0 then
            orient = orient * CFrame.Angles(0, 0, math.pi/2)
        end
        newPart({
            Name = "Link_"..i,
            Size = size,
            CFrame = orient,
            Material = CONFIG.materials.metal,
            Color = CONFIG.colors.chainMetal,
            Parent = model
        })
    end
    
    return model
end

