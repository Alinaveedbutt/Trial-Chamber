----------------------------------------------------------------------
-- HELPERS
----------------------------------------------------------------------
local function newPart(props)
	local p = Instance.new("Part")
	p.Name = props.Name or "Part"
	p.Anchored = true
	p.Shape = props.Shape or Enum.PartType.Block
	p.Size = props.Size
	p.CFrame = props.CFrame
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Color = props.Color or Color3.fromRGB(150, 150, 150)
	if props.Transparency then p.Transparency = props.Transparency end
	if props.CanCollide == false then p.CanCollide = false end
	p.Parent = props.Parent
	return p
end

local function addGlow(part, color, range, brightness)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range or 16
	light.Brightness = brightness or 2
	light.Parent = part
end

local function angleDist(a, b)
	return math.abs((a - b + 180) % 360 - 180)
end

local function frameFromAxes(pos, right, up, back)
	return CFrame.fromMatrix(pos, right, up, back)
end

