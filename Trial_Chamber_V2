----------------------------------------------------------------------
-- DOME (unchanged)
----------------------------------------------------------------------
local function buildDome(folder, cx, cz, radius, wallHeight, domeHeight, wallSegments, ringCount, material, color)
	local N = wallSegments
	local halfPi = math.pi / 2

	for ring = 0, ringCount - 1 do
		local t0 = (ring / ringCount) * halfPi
		local t1 = ((ring + 1) / ringCount) * halfPi
		local r0 = radius * math.cos(t0)
		local r1 = radius * math.cos(t1)
		local h0 = wallHeight - 0.5 + domeHeight * math.sin(t0)
		local h1 = wallHeight - 0.5 + domeHeight * math.sin(t1)

		for i = 0, N - 1 do
			local angleA = (i / N) * math.pi * 2
			local angleB = ((i + 1) / N) * math.pi * 2

			local a0 = Vector3.new(cx + math.cos(angleA) * r0, h0, cz + math.sin(angleA) * r0)
			local b0 = Vector3.new(cx + math.cos(angleB) * r0, h0, cz + math.sin(angleB) * r0)
			local a1 = Vector3.new(cx + math.cos(angleA) * r1, h1, cz + math.sin(angleA) * r1)
			local b1 = Vector3.new(cx + math.cos(angleB) * r1, h1, cz + math.sin(angleB) * r1)

			local mid0 = (a0 + b0) / 2
			local mid1 = (a1 + b1) / 2
			local panelCenter = (mid0 + mid1) / 2

			local tangent = (b0 - a0).Unit
			local slope = (mid1 - mid0).Unit
			local radial = tangent:Cross(slope)
			if radial.Magnitude > 0.001 then
				radial = radial.Unit
			else
				radial = Vector3.new(0, 1, 0)
			end

			local panelWidth = (b0 - a0).Magnitude
			local panelHeight = (mid1 - mid0).Magnitude

			newPart{
				Name = "DomePanel_r" .. (ring + 1) .. "_" .. (i + 1),
				Size = Vector3.new(panelWidth + 0.5, panelHeight + 0.5, 1),
				CFrame = frameFromAxes(panelCenter, tangent, slope, radial),
				Material = material,
				Color = color,
				Parent = folder,
			}
		end
	end

	local apexY = wallHeight + domeHeight
	newPart{
		Name = "DomeCap",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.5, 5, 5),
		CFrame = CFrame.new(cx, apexY, cz) * CFrame.Angles(0, 0, math.rad(90)),
		Material = material,
		Color = color,
		Parent = folder,
	}
end

----------------------------------------------------------------------
-- DOORWAY ARCH (unchanged)
----------------------------------------------------------------------
local function buildArch(folder, cx, cz, radius, angleDeg, doorWidth, doorHeight, material, color)
	local rad = math.rad(angleDeg)
	local wallRadius = radius - CONFIG.wallThickness / 2
	local px = cx + math.cos(rad) * wallRadius
	local pz = cz + math.sin(rad) * wallRadius
	local facing = Vector3.new(math.cos(rad), 0, math.sin(rad))

	local pillarThick = 1.5
	local pillarWidth = doorWidth / 2 - 0.5
	local pillarHeight = doorHeight - 1.5

	local leftPos = Vector3.new(px - math.sin(rad) * pillarWidth, pillarHeight / 2, pz + math.cos(rad) * pillarWidth)
	newPart{
		Name = "DoorPillarL",
		Size = Vector3.new(pillarThick, pillarHeight, pillarThick),
		CFrame = CFrame.new(leftPos, leftPos + facing) * CFrame.Angles(0, 0, 0),
		Material = material,
		Color = color,
		Parent = folder,
	}
	local rightPos = Vector3.new(px + math.sin(rad) * pillarWidth, pillarHeight / 2, pz - math.cos(rad) * pillarWidth)
	newPart{
		Name = "DoorPillarR",
		Size = Vector3.new(pillarThick, pillarHeight, pillarThick),
		CFrame = CFrame.new(rightPos, rightPos + facing) * CFrame.Angles(0, 0, 0),
		Material = material,
		Color = color,
		Parent = folder,
	}
	local lintelPos = Vector3.new(px, doorHeight - 0.75, pz)
	newPart{
		Name = "DoorLintel",
		Size = Vector3.new(doorWidth + 1, 1.5, pillarThick),
		CFrame = CFrame.new(lintelPos, lintelPos + facing),
		Material = material,
		Color = color,
		Parent = folder,
	}
end

----------------------------------------------------------------------
-- CIRCULAR ROOM (unchanged)
----------------------------------------------------------------------
local function buildCircularRoom(params)
	local folder = Instance.new("Folder")
	folder.Name = params.name
	folder.Parent = params.parent

	local cx, cz = 0, params.centerZ
	local radius = params.radius
	local wallThickness = CONFIG.wallThickness
	local wallRadius = radius - wallThickness / 2

	newPart{
		Name = "Floor",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, radius * 2, radius * 2),
		CFrame = CFrame.new(cx, -0.5, cz) * CFrame.Angles(0, 0, math.rad(90)),
		Material = CONFIG.materials.floor,
		Color = CONFIG.colors.floor,
		Parent = folder,
	}

	local N = params.wallSegments
	for i = 0, N - 1 do
		local angleA = math.rad((i / N) * 360)
		local angleB = math.rad(((i + 1) / N) * 360)
		local ax, az = math.cos(angleA) * wallRadius, math.sin(angleA) * wallRadius
		local bx, bz = math.cos(angleB) * wallRadius, math.sin(angleB) * wallRadius
		local midAngleDeg = ((i + 0.5) / N) * 360

		local blocked = false
		for _, door in ipairs(params.doorways or {}) do
			local halfAngle = math.deg(math.asin(math.min(1, (door.width / 2) / wallRadius)))
			if angleDist(midAngleDeg, door.angle) < halfAngle then
				blocked = true
			end
		end

		if not blocked then
			local p1 = Vector3.new(cx + ax, 0, cz + az)
			local p2 = Vector3.new(cx + bx, 0, cz + bz)
			local mid = (p1 + p2) / 2
			local segLen = (p2 - p1).Magnitude
			local tangent = (p2 - p1).Unit
			local radial = Vector3.new(mid.X - cx, 0, mid.Z - cz).Unit
			local up = Vector3.new(0, 1, 0)

			newPart{
				Name = "WallSeg_" .. (i + 1),
				Size = Vector3.new(segLen + 0.8, params.wallHeight, wallThickness),
				CFrame = frameFromAxes(
					Vector3.new(mid.X, params.wallHeight / 2, mid.Z),
					tangent, up, radial
				),
				Material = params.wallMaterial or CONFIG.materials.wall,
				Color = params.wallColor or CONFIG.colors.wall,
				Parent = folder,
			}
		end
	end

	for _, door in ipairs(params.doorways or {}) do
		local doorHeight = params.wallHeight - 2
		buildArch(folder, cx, cz, radius, door.angle, door.width, doorHeight,
			params.wallMaterial or CONFIG.materials.wall,
			params.wallColor or CONFIG.colors.wall)
	end

	buildDome(
		folder, cx, cz, radius, params.wallHeight, params.domeHeight,
		params.wallSegments, params.ringCount or 6,
		params.domeMaterial or CONFIG.materials.dome,
		params.domeColor or CONFIG.colors.domeB
	)

	return folder
end

