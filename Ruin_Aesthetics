		if edge:IsA("BasePart") and string.sub(edge.Name, 1, 9) == "WaterEdge" then
			edge.Material = Enum.Material.Glass
			edge.Color = COLORS.waterDeep
			edge.Transparency = 0.28
			edge.Reflectance = 0.08
			edge.CastShadow = false
