local PROTECTED_NAME_FRAGMENTS = {
	"SpikeTrap", "SwingingBlade", "CeilingSpike", "WallSpike", "FinalSpike",
	"Checkpoint", "Spawn", "Golem", "Heart", "Portcullis", "Sealing",
	"Trap", "Controller", "Prompt", "Humanoid", "Hitbox", "Kill",
	"TrialStart", "GateLeaf", "DoorLeaf", "Magic", "Sword",
	"Chain", "KillVolume", "RoomACheckpoint", "RoomBCheckpoint",
	"RoomCCheckpoint", "RoomDCheckpoint",
}

local function isProtected(inst)
	local name = inst.Name
	for _, frag in ipairs(PROTECTED_NAME_FRAGMENTS) do
		if string.find(name, frag, 1, true) then
			return true
		end
	end
	local cur = inst
	while cur and cur ~= Workspace do
		for _, frag in ipairs(PROTECTED_NAME_FRAGMENTS) do
			if string.find(cur.Name, frag, 1, true) then
				return true
			end
		end
		if cur.Name == "Traps" or cur.Name == "GolemSpawnPoints" then
			return true
		end
		cur = cur.Parent
	end
	for _, tag in ipairs(CollectionService:GetTags(inst)) do
		if tag == "SpikeTrap" or tag == "SwingingBlade" or tag == "SealingDoor" then
			return true
		end
	end
	return false
end

local function makePart(props)
	local part = Instance.new(props.ClassName or "Part")
	part.Name = props.Name or "Decor"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = props.CastShadow ~= false
	part.Material = props.Material or Enum.Material.LeafyGrass
	part.Color = props.Color or COLORS.vineMid
	part.Size = props.Size or Vector3.new(1, 1, 1)
	part.CFrame = props.CFrame or CFrame.new()
	part.Transparency = props.Transparency or 0
	part.Reflectance = props.Reflectance or 0
	if props.Shape then
		part.Shape = props.Shape
	end
	if props.TopSurface then
		part.TopSurface = props.TopSurface
	end
	part.Parent = props.Parent
	return part
end

local function ensurePassFolder(chamber)
	local existing = chamber:FindFirstChild(PASS_FOLDER_NAME)
	if existing then
		existing:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = PASS_FOLDER_NAME
	folder.Parent = chamber
	return folder
end

local function subfolder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function gatherCandidates(root, predicate, limit)
	local list = {}
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") and not isProtected(d) and predicate(d) then
			table.insert(list, d)
			if limit and #list >= limit then
				break
			end
		end
	end
	return list
end

