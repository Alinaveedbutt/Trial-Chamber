local function addCreepingVine(_parent, wallPart, folder)
	local faceOffset = wallPart.Size.Z * 0.5 + 0.15
	local side = if RNG:NextNumber() > 0.5 then 1 else -1
	local along = RNG:NextNumber(-0.42, 0.42)
	local up = RNG:NextNumber(-0.35, 0.4)
	local drop = RNG:NextNumber(3.5, 11)
	local thick = RNG:NextNumber(0.28, 0.7)
	local cf = wallPart.CFrame
		* CFrame.new(along * wallPart.Size.X, up * wallPart.Size.Y * 0.45, side * faceOffset)
		* CFrame.Angles(RNG:NextNumber(-0.15, 0.15), 0, RNG:NextNumber(-0.2, 0.2))

	local vine = makePart({
		Name = "RuinVine",
		Size = Vector3.new(thick, drop, thick),
		CFrame = cf * CFrame.new(0, -drop * 0.45, 0),
		Material = Enum.Material.LeafyGrass,
		Color = if RNG:NextNumber() > 0.7 then COLORS.vineDead elseif RNG:NextNumber() > 0.4 then COLORS.vineMid else COLORS.vineDeep,
		Parent = folder,
	})

	for _ = 1, RNG:NextInteger(1, 3) do
		local y = RNG:NextNumber(-drop * 0.35, drop * 0.25)
		makePart({
			Name = "VineLeaf",
			Size = Vector3.new(RNG:NextNumber(0.8, 1.8), 0.18, RNG:NextNumber(0.5, 1.2)),
			CFrame = vine.CFrame * CFrame.new(RNG:NextNumber(-0.4, 0.4), y, RNG:NextNumber(0.2, 0.6))
				* CFrame.Angles(RNG:NextNumber(-0.6, 0.6), RNG:NextNumber(0, 6), RNG:NextNumber(-0.5, 0.5)),
			Material = Enum.Material.Grass,
			Color = COLORS.vineMid,
			Parent = folder,
		})
	end
end

local function addHangingVine(parentPart, folder)
	local drop = RNG:NextNumber(4, 14)
	local thick = RNG:NextNumber(0.25, 0.55)
	local cf = parentPart.CFrame
		* CFrame.new(
			RNG:NextNumber(-parentPart.Size.X * 0.4, parentPart.Size.X * 0.4),
			-parentPart.Size.Y * 0.5 - drop * 0.5,
			RNG:NextNumber(-parentPart.Size.Z * 0.4, parentPart.Size.Z * 0.4)
		)
	makePart({
		Name = "HangingRuinVine",
		Size = Vector3.new(thick, drop, thick),
		CFrame = cf * CFrame.Angles(RNG:NextNumber(-0.1, 0.1), 0, RNG:NextNumber(-0.12, 0.12)),
		Material = Enum.Material.LeafyGrass,
		Color = if RNG:NextNumber() > 0.6 then COLORS.vineDead else COLORS.vineDeep,
		Parent = folder,
	})
end

local function addCreepyWeed(floorPart, folder, yLift)
	local count = RNG:NextInteger(2, 5)
	local base = floorPart.Position
		+ Vector3.new(
			RNG:NextNumber(-floorPart.Size.X * 0.35, floorPart.Size.X * 0.35),
			(floorPart.Size.Y * 0.5) + (yLift or 0.05),
			RNG:NextNumber(-floorPart.Size.Z * 0.35, floorPart.Size.Z * 0.35)
		)
	for _ = 1, count do
		local h = RNG:NextNumber(0.7, 2.4)
		local lean = CFrame.Angles(RNG:NextNumber(-0.35, 0.35), RNG:NextNumber(0, 6.28), RNG:NextNumber(-0.25, 0.25))
		makePart({
			Name = "CreepyWeed",
			Size = Vector3.new(RNG:NextNumber(0.08, 0.22), h, RNG:NextNumber(0.08, 0.22)),
			CFrame = CFrame.new(base + Vector3.new(RNG:NextNumber(-0.5, 0.5), h * 0.5, RNG:NextNumber(-0.5, 0.5))) * lean,
			Material = Enum.Material.Grass,
			Color = if RNG:NextNumber() > 0.55 then COLORS.weedCreepy elseif RNG:NextNumber() > 0.5 then COLORS.weedSick else COLORS.weedDark,
			Parent = folder,
		})
	end
	makePart({
		Name = "WeedFringe",
		Size = Vector3.new(RNG:NextNumber(0.8, 1.6), 0.12, RNG:NextNumber(0.6, 1.3)),
		CFrame = CFrame.new(base + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, RNG:NextNumber(0, 6), 0.05),
		Material = Enum.Material.LeafyGrass,
		Color = COLORS.weedSick,
		Transparency = 0.1,
		Parent = folder,
	})
end

local function addRubble(nearPart, folder)
	local pile = RNG:NextInteger(2, 4)
	local base = nearPart.Position
		+ Vector3.new(
			RNG:NextNumber(-2.5, 2.5),
			nearPart.Size.Y * 0.5 + 0.1,
			RNG:NextNumber(-2.5, 2.5)
		)
	for _ = 1, pile do
		local s = Vector3.new(RNG:NextNumber(0.5, 1.8), RNG:NextNumber(0.3, 1.1), RNG:NextNumber(0.5, 1.6))
		makePart({
			Name = "RuinStone",
			Size = s,
			CFrame = CFrame.new(base + Vector3.new(RNG:NextNumber(-1.2, 1.2), s.Y * 0.45, RNG:NextNumber(-1.2, 1.2)))
				* CFrame.Angles(RNG:NextNumber(0, 1), RNG:NextNumber(0, 6), RNG:NextNumber(0, 1)),
			Material = Enum.Material.Rock,
			Color = if RNG:NextNumber() > 0.6 then COLORS.stoneDark elseif RNG:NextNumber() > 0.4 then COLORS.stonePale else COLORS.stone,
			Parent = folder,
		})
	end
end

local function addRustStreak(wallPart, folder)
	local side = if RNG:NextNumber() > 0.5 then 1 else -1
	local h = RNG:NextNumber(2.5, 8)
	local w = RNG:NextNumber(0.18, 0.55)
	local cf = wallPart.CFrame
		* CFrame.new(
			RNG:NextNumber(-wallPart.Size.X * 0.4, wallPart.Size.X * 0.4),
			RNG:NextNumber(-wallPart.Size.Y * 0.2, wallPart.Size.Y * 0.25),
			side * (wallPart.Size.Z * 0.5 + 0.04)
		)
	makePart({
		Name = "RustStreak",
		Size = Vector3.new(w, h, 0.08),
		CFrame = cf * CFrame.Angles(0, 0, RNG:NextNumber(-0.15, 0.15)),
		Material = Enum.Material.CorrodedMetal,
		Color = if RNG:NextNumber() > 0.5 then COLORS.rust else COLORS.rustDark,
		Transparency = 0.12,
		Reflectance = 0.05,
		CastShadow = false,
		Parent = folder,
	})
	makePart({
		Name = "RustBlot",
		Size = Vector3.new(RNG:NextNumber(0.6, 1.4), 0.1, RNG:NextNumber(0.4, 0.9)),
		CFrame = cf * CFrame.new(0, -h * 0.52, 0.1),
		Material = Enum.Material.CorrodedMetal,
		Color = COLORS.rustStreak,
		Transparency = 0.2,
		CastShadow = false,
		Parent = folder,
	})
end

local function weatherMetalInPlace(root, maxCount)
	local n = 0
	for _, d in ipairs(root:GetDescendants()) do
		if n >= maxCount then
			break
		end
		if d:IsA("BasePart") and d.Material == Enum.Material.Metal and not isProtected(d) then
			local vol = d.Size.X * d.Size.Y * d.Size.Z
			if vol < 40 and d.Size.Y < 12 then
				if RNG:NextNumber() < 0.35 then
					d.Material = Enum.Material.CorrodedMetal
					d.Color = COLORS.rustDark:Lerp(d.Color, 0.35)
					n += 1
				end
			end
		end
	end
	return n
end

local function decorateRegion(region, folder, config)
	if not region then
		return
	end

	local walls = gatherCandidates(region, function(p)
		local n = string.lower(p.Name)
		return (string.find(n, "wall") or string.find(n, "bay") or string.find(n, "pillar") or string.find(n, "arch") or string.find(n, "slate") or string.find(n, "cobble"))
			and p.Size.Y >= 4
			and p.Size.X >= 2
			and p.Transparency < 0.5
	end, config.wallScanLimit or 220)

	local floors = gatherCandidates(region, function(p)
		local n = string.lower(p.Name)
		return (string.find(n, "floor") or string.find(n, "ground") or string.find(n, "walk") or string.find(n, "plat") or string.find(n, "path") or string.find(n, "slab") or string.find(n, "rugged"))
			and p.Size.Y <= 4
			and p.Size.X >= 3
			and p.Transparency < 0.4
			and p.CanCollide
	end, config.floorScanLimit or 180)

	local roofs = gatherCandidates(region, function(p)
		local n = string.lower(p.Name)
		return (string.find(n, "roof") or string.find(n, "ceil") or string.find(n, "beam"))
			and p.Size.X >= 2
			and p.Transparency < 0.5
	end, config.roofScanLimit or 120)

	if #walls == 0 then
		walls = gatherCandidates(region, function(p)
			return p.Size.Y >= 6 and p.Size.X >= 3 and p.Transparency < 0.3 and p.Material ~= Enum.Material.LeafyGrass
		end, 120)
	end

	for _ = 1, (config.vines or 0) do
		if #walls == 0 then break end
		addCreepingVine(region, walls[RNG:NextInteger(1, #walls)], folder)
	end
	for _ = 1, (config.hanging or 0) do
		local pool = if #roofs > 0 then roofs else walls
		if #pool == 0 then break end
		addHangingVine(pool[RNG:NextInteger(1, #pool)], folder)
	end
	for _ = 1, (config.weeds or 0) do
		if #floors == 0 then break end
		addCreepyWeed(floors[RNG:NextInteger(1, #floors)], folder)
	end
	for _ = 1, (config.rubble or 0) do
		local pool = if #walls > 0 then walls else floors
		if #pool == 0 then break end
		addRubble(pool[RNG:NextInteger(1, #pool)], folder)
	end
	for _ = 1, (config.rust or 0) do
		if #walls == 0 then break end
		addRustStreak(walls[RNG:NextInteger(1, #walls)], folder)
	end
end

