-- Room B water v2: real Terrain water moat + dark riverbed + shoreline life
-- Surface sits WATER_SURFACE_Y_OFFSET above Floor_Main top (below walkways at +0.4),
-- so it is a shallow film: no swimming, no pathing change.
------------------------------------------------------------------------
local WATER_SURFACE_Y_OFFSET = 0.28
local WATER_RING_INNER = 38.6
local WATER_RING_OUTER = 46.2

local function octApothem(dx, dz)
	local best = 0
	for i = 0, 7 do
		local a = i * math.pi / 4
		local d = dx * math.sin(a) + dz * math.cos(a)
		if d > best then
			best = d
		end
	end
	return best
end

local function clearTerrainWaterRing()
	local terrain = Workspace.Terrain
	local minV = terrain:GetAttribute("RuinsWaterMin")
	local maxV = terrain:GetAttribute("RuinsWaterMax")
	if typeof(minV) ~= "Vector3" or typeof(maxV) ~= "Vector3" then
		return
	end
	local region = Region3.new(minV, maxV):ExpandToGrid(4)
	local mats, occ = terrain:ReadVoxels(region, 4)
	local s = mats.Size
	local changed = false
	for x = 1, s.X do
		for y = 1, s.Y do
			for z = 1, s.Z do
				if mats[x][y][z] == Enum.Material.Water then
					mats[x][y][z] = Enum.Material.Air
					occ[x][y][z] = 0
					changed = true
				end
			end
		end
	end
	if changed then
		terrain:WriteVoxels(region, 4, mats, occ)
	end
	terrain:SetAttribute("RuinsWaterMin", nil)
	terrain:SetAttribute("RuinsWaterMax", nil)
end

local function fillTerrainWaterRing(center, floorTopY)
	local terrain = Workspace.Terrain
	clearTerrainWaterRing()
	local surfaceY = floorTopY + WATER_SURFACE_Y_OFFSET
	local minP = Vector3.new(center.X - WATER_RING_OUTER - 4, floorTopY - 1.9, center.Z - WATER_RING_OUTER - 4)
	local maxP = Vector3.new(center.X + WATER_RING_OUTER + 4, surfaceY + 0.01, center.Z + WATER_RING_OUTER + 4)
	local region = Region3.new(minP, maxP):ExpandToGrid(4)
	local mats, occ = terrain:ReadVoxels(region, 4)
	local s = mats.Size
	local origin = region.CFrame.Position - region.Size / 2
	local filled = 0
	for x = 1, s.X do
		for z = 1, s.Z do
			local wx = origin.X + (x - 0.5) * 4
			local wz = origin.Z + (z - 0.5) * 4
			local ap = octApothem(wx - center.X, wz - center.Z)
			-- Neighbour bands sit just under the floor / inside the walls (hidden) so
			-- terrain smoothing does not pull the visible moat surface below the grass.
			local targetY = nil
			if ap >= WATER_RING_INNER and ap <= WATER_RING_OUTER then
				targetY = surfaceY
			elseif ap >= WATER_RING_INNER - 4 and ap < WATER_RING_INNER then
				targetY = floorTopY - 0.2
			elseif ap > WATER_RING_OUTER and ap <= WATER_RING_OUTER + 3.8 then
				targetY = floorTopY
			end
			if targetY then
				for y = 1, s.Y do
					local vyBottom = origin.Y + (y - 1) * 4
					local m = mats[x][y][z]
					if m == Enum.Material.Air or m == Enum.Material.Water then
						local fill = math.clamp((targetY - vyBottom) / 4, 0, 1)
						if fill > 0.02 then
							mats[x][y][z] = Enum.Material.Water
							occ[x][y][z] = fill
							filled += 1
						end
					end
				end
			end
		end
	end
	terrain:WriteVoxels(region, 4, mats, occ)
	terrain:SetAttribute("RuinsWaterMin", minP)
	terrain:SetAttribute("RuinsWaterMax", maxP)

	-- Murky, calm ruins moat look (global Terrain water appearance)
	terrain.WaterColor = Color3.fromRGB(14, 58, 56)
	terrain.WaterTransparency = 0.38
	terrain.WaterReflectance = 0.85
	terrain.WaterWaveSize = 0.1
	terrain.WaterWaveSpeed = 7
	return filled
end

local function addEmitter(parent, name, props)
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	e.Texture = "rbxasset://textures/particles/smoke_main.dds"
	e.Color = ColorSequence.new(props.color)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, props.size0), NumberSequenceKeypoint.new(1, props.size1) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, props.t0), NumberSequenceKeypoint.new(1, 1) })
	e.Lifetime = NumberRange.new(props.life0, props.life1)
	e.Rate = props.rate
	e.Speed = NumberRange.new(props.speed0, props.speed1)
	e.SpreadAngle = Vector2.new(props.spread, props.spread * 0.5)
	e.EmissionDirection = Enum.NormalId.Top
	e.RotSpeed = NumberRange.new(-15, 15)
	e.LightEmission = props.light or 0
	e.Parent = parent
	return e
end

local function enhanceRoomBWater(chamber, passRoot)
	local roomB = chamber:FindFirstChild("RoomB")
	local floor = roomB and roomB:FindFirstChild("StructuralFloor")
	local floorMain = floor and floor:FindFirstChild("Floor_Main")
	if not floorMain then
		return 0
	end

	local waterFolder = subfolder(passRoot, "RoomB_Water")
	local floorTopY = floorMain.Position.Y + floorMain.Size.Y * 0.5
	local surfaceY = floorTopY + WATER_SURFACE_Y_OFFSET
	local center = floorMain.Position

	local voxels = fillTerrainWaterRing(center, floorTopY)
	local count = 0

	for _, edge in ipairs(floor:GetChildren()) do
		if edge:IsA("BasePart") and string.sub(edge.Name, 1, 9) == "WaterEdge" then
			-- Hide the old flat sheet (kept in place, structure untouched).
			edge.Transparency = 1
			edge.CastShadow = false
			edge:SetAttribute(ATTR_WATER, true)

			local rot = edge.CFrame.Rotation
			local function at(dx, y, dz)
				return rot + Vector3.new(edge.Position.X, y, edge.Position.Z) + rot:VectorToWorldSpace(Vector3.new(dx, 0, dz))
			end
			local size = edge.Size

			-- Dark silty riverbed so the shallow film reads as deep water
			makePart({
				Name = "Riverbed",
				Size = Vector3.new(size.X * 0.98, 0.06, size.Z * 0.9),
				CFrame = at(0, floorTopY + 0.03, 0.2),
				Material = Enum.Material.Pebble,
				Color = Color3.fromRGB(20, 26, 25),
				CastShadow = false,
				Parent = waterFolder,
			})
			-- Pale sediment shelf along the inner shore
			makePart({
				Name = "SedimentShelf",
				Size = Vector3.new(size.X * 0.96, 0.07, 1.4),
				CFrame = at(0, floorTopY + 0.035, -size.Z * 0.5 + 0.9),
				Material = Enum.Material.Sand,
				Color = Color3.fromRGB(64, 66, 52),
				CastShadow = false,
				Parent = waterFolder,
			})

			-- Submerged / breaking stones with moss caps
			for _ = 1, 7 do
				local s = Vector3.new(RNG:NextNumber(0.5, 1.4), RNG:NextNumber(0.22, 0.5), RNG:NextNumber(0.5, 1.2))
				local dx = RNG:NextNumber(-size.X * 0.42, size.X * 0.42)
				local dz = RNG:NextNumber(-size.Z * 0.3, size.Z * 0.3)
				local stone = makePart({
					Name = "MoatStone",
					Size = s,
					CFrame = at(dx, floorTopY + s.Y * 0.45, dz) * CFrame.Angles(RNG:NextNumber(-0.2, 0.2), RNG:NextNumber(0, 6.28), RNG:NextNumber(-0.2, 0.2)),
					Material = Enum.Material.Slate,
					Color = Color3.fromRGB(44, 48, 46),
					Parent = waterFolder,
				})
				if s.Y > 0.3 then
					makePart({
						Name = "MoatStoneMoss",
						Size = Vector3.new(s.X * 0.8, 0.08, s.Z * 0.8),
						CFrame = stone.CFrame * CFrame.new(0, s.Y * 0.5 + 0.03, 0),
						Material = Enum.Material.LeafyGrass,
						Color = COLORS.mossWet,
						Parent = waterFolder,
					})
				end
			end

			-- Reed clusters on the inner grass shore
			for _ = 1, 5 do
				local dx = RNG:NextNumber(-size.X * 0.4, size.X * 0.4)
				local dz = -size.Z * 0.5 - RNG:NextNumber(0.2, 1.4)
				for _ = 1, RNG:NextInteger(3, 6) do
					local h = RNG:NextNumber(1.4, 3.2)
					local reed = makePart({
						Name = "Reed",
						Size = Vector3.new(0.09, h, 0.09),
						CFrame = at(dx + RNG:NextNumber(-0.5, 0.5), floorTopY + h * 0.5, dz + RNG:NextNumber(-0.4, 0.4))
							* CFrame.Angles(RNG:NextNumber(-0.18, 0.18), 0, RNG:NextNumber(-0.18, 0.18)),
						Material = Enum.Material.Grass,
						Color = if RNG:NextNumber() > 0.5 then Color3.fromRGB(46, 78, 34) else Color3.fromRGB(70, 74, 38),
						Parent = waterFolder,
					})
					if RNG:NextNumber() > 0.5 then
						makePart({
							Name = "Cattail",
							Size = Vector3.new(0.16, 0.45, 0.16),
							CFrame = reed.CFrame * CFrame.new(0, h * 0.5 + 0.2, 0),
							Material = Enum.Material.Fabric,
							Color = Color3.fromRGB(74, 48, 30),
							Parent = waterFolder,
						})
					end
				end
			end

			-- Lily pads floating on the surface
			for _ = 1, 4 do
				local d = RNG:NextNumber(0.9, 1.7)
				makePart({
					Name = "LilyPad",
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new(0.08, d, d),
					CFrame = at(RNG:NextNumber(-size.X * 0.4, size.X * 0.4), surfaceY + 0.03, RNG:NextNumber(-size.Z * 0.28, size.Z * 0.28))
						* CFrame.Angles(0, RNG:NextNumber(0, 6.28), math.rad(90)),
					Material = Enum.Material.Grass,
					Color = Color3.fromRGB(38, 88, 44),
					Parent = waterFolder,
				})
			end

			-- Invisible anchor for foam / mist / light
			local anchor = makePart({
				Name = "WaterFXAnchor",
				Size = Vector3.new(size.X * 0.9, 0.1, 0.5),
				CFrame = at(0, surfaceY + 0.05, -size.Z * 0.42),
				Transparency = 1,
				CastShadow = false,
				Parent = waterFolder,
			})
			addEmitter(anchor, "ShoreFoam", { color = COLORS.waterFoam, size0 = 0.3, size1 = 0.05, t0 = 0.4, life0 = 0.6, life1 = 1.2, rate = 9, speed0 = 0.1, speed1 = 0.4, spread = 15, light = 0.1 })
			addEmitter(anchor, "WaterMist", { color = Color3.fromRGB(150, 185, 190), size0 = 1.2, size1 = 2.6, t0 = 0.8, life0 = 2.5, life1 = 4, rate = 2, speed0 = 0.05, speed1 = 0.15, spread = 40 })

			local light = Instance.new("PointLight")
			light.Name = "WaterGlow"
			light.Color = Color3.fromRGB(70, 150, 150)
			light.Brightness = 0.45
			light.Range = 14
			light.Shadows = false
			light.Parent = anchor

			count += 1
		end
	end

	-- Wet moss where grass meets the moat
	for _ = 1, 30 do
		local angle = RNG:NextNumber(0, math.pi * 2)
		local dist = RNG:NextNumber(34, 38)
		local pos = center + Vector3.new(math.cos(angle) * dist, floorMain.Size.Y * 0.5 + 0.05, math.sin(angle) * dist)
		makePart({
			Name = "WetMoss",
			Size = Vector3.new(RNG:NextNumber(1.2, 3.2), 0.1, RNG:NextNumber(1.0, 2.6)),
			CFrame = CFrame.new(pos) * CFrame.Angles(0, RNG:NextNumber(0, 6.28), 0),
			Material = Enum.Material.LeafyGrass,
			Color = if RNG:NextNumber() > 0.5 then COLORS.mossWet else COLORS.moss,
			Transparency = 0.08,
			Parent = waterFolder,
		})
	end

	print("[RuinsAesthetic] Room B terrain water voxels:", voxels)
	return count
end

local function apply()
	local chamber = Workspace:FindFirstChild(CHAMBER_NAME)
	if not chamber then
		warn("[RuinsAesthetic] Chamber not found:", CHAMBER_NAME)
		return false
	end

	local pass = ensurePassFolder(chamber)
	local summary = {}

	local waterCount = enhanceRoomBWater(chamber, pass)
	table.insert(summary, "waterEdges=" .. tostring(waterCount))

	local regions = {
		{ name = "EntryForecourt", config = { vines = 36, hanging = 10, weeds = 22, rubble = 18, rust = 10 } },
		{ name = "RoomA", config = { vines = 90, hanging = 28, weeds = 55, rubble = 40, rust = 35, wallScanLimit = 300, floorScanLimit = 220 } },
		{ name = "RoomA_VisualPass", config = { vines = 55, hanging = 40, weeds = 20, rubble = 18, rust = 22 } },
		{ name = "RoomB", config = { vines = 70, hanging = 22, weeds = 40, rubble = 28, rust = 26, wallScanLimit = 200 } },
		{ name = "Transitions", config = { vines = 34, hanging = 12, weeds = 16, rubble = 14, rust = 12 } },
		{ name = "RoomC", config = { vines = 65, hanging = 30, weeds = 35, rubble = 26, rust = 24, wallScanLimit = 220 } },
		{ name = "ClearanceChamber", config = { vines = 28, hanging = 10, weeds = 14, rubble = 12, rust = 10 } },
		{ name = "TransitionCD", config = { vines = 24, hanging = 8, weeds = 10, rubble = 10, rust = 8 } },
		{ name = "RoomD_Chasm", config = { vines = 50, hanging = 35, weeds = 28, rubble = 30, rust = 18, wallScanLimit = 180, floorScanLimit = 140, roofScanLimit = 100 } },
		{ name = "ExteriorAdditions", config = { vines = 30, hanging = 16, weeds = 8, rubble = 10, rust = 8 } },
	}

	for _, entry in ipairs(regions) do
		local region = chamber:FindFirstChild(entry.name)
		local folder = subfolder(pass, entry.name)
		decorateRegion(region, folder, entry.config)
		table.insert(summary, entry.name)
	end

	-- In-place weathering is one-shot so Play/re-apply does not keep mutating metals/vines.
	local rusted = 0
	if not chamber:GetAttribute("RuinsMetalWeathered") then
		rusted = weatherMetalInPlace(chamber, 180)
		chamber:SetAttribute("RuinsMetalWeathered", true)
	end
	table.insert(summary, "metalWeathered=" .. tostring(rusted))

	local tinted = 0
	if not chamber:GetAttribute("RuinsVinesTinted") then
		for _, d in ipairs(chamber:GetDescendants()) do
			if tinted >= 400 then break end
			if d:IsA("BasePart") and (d.Name == "SideWallVine" or d.Name == "HangingVine" or string.find(d.Name, "Vine", 1, true)) then
				if d.Material == Enum.Material.LeafyGrass or d.Material == Enum.Material.Grass then
					local roll = RNG:NextNumber()
					if roll < 0.25 then
						d.Color = COLORS.vineDeep
						tinted += 1
					elseif roll < 0.4 then
						d.Color = COLORS.vineDead
						tinted += 1
					end
				end
			end
		end
		chamber:SetAttribute("RuinsVinesTinted", true)
	end
	table.insert(summary, "vinesTinted=" .. tostring(tinted))

	chamber:SetAttribute(ATTR_APPLIED, true)
	pass:SetAttribute("GeneratedAt", os.time())
	print("[RuinsAesthetic] Applied ->", table.concat(summary, ", "), "| parts in pass:", #pass:GetDescendants())
	return true
end

_G.TrialChamberRuinsAesthetic = { apply = apply, clearWater = clearTerrainWaterRing }

if not Workspace:FindFirstChild(CHAMBER_NAME) then
	Workspace.ChildAdded:Connect(function(child)
		if child.Name == CHAMBER_NAME then
			task.wait(1)
			apply()
		end
	end)
else
	task.defer(apply)
end
