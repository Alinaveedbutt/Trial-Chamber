	vineDeep = Color3.fromRGB(28, 62, 24),
	vineMid = Color3.fromRGB(42, 88, 34),
	vineDead = Color3.fromRGB(58, 72, 38),
	weedCreepy = Color3.fromRGB(36, 52, 28),
	weedSick = Color3.fromRGB(62, 58, 28),
	weedDark = Color3.fromRGB(24, 38, 22),
	moss = Color3.fromRGB(48, 78, 36),
	mossWet = Color3.fromRGB(34, 70, 48),
	stone = Color3.fromRGB(78, 74, 68),
	stoneDark = Color3.fromRGB(52, 50, 48),
	stonePale = Color3.fromRGB(110, 104, 96),
	rust = Color3.fromRGB(120, 62, 28),
	rustDark = Color3.fromRGB(78, 42, 22),
	rustStreak = Color3.fromRGB(96, 54, 30),
	waterDeep = Color3.fromRGB(8, 38, 48),
	waterMid = Color3.fromRGB(12, 72, 82),
	waterSurface = Color3.fromRGB(48, 120, 128),
	waterFoam = Color3.fromRGB(190, 220, 220),
	algae = Color3.fromRGB(40, 78, 42),
