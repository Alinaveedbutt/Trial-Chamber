				CFrame = cf * CFrame.new(0, 0.12, 0),
				Material = Enum.Material.Glass,
				Color = COLORS.waterMid,
				Transparency = 0.42,
				Reflectance = 0.35,
				CastShadow = false,
				Parent = waterFolder,
			})

			local surface = makePart({
				Name = "WaterSurface",
				Size = Vector3.new(size.X * 0.96, 0.08, size.Z * 0.88),
				CFrame = cf * CFrame.new(0, 0.28, 0),
				Material = Enum.Material.Glass,
				Color = COLORS.waterSurface,
