local CollectionService = game:GetService("CollectionService")

local CHAMBER_NAME = "TrialChamberGeneratedV5_Sky"
local PASS_FOLDER_NAME = "RuinsAestheticPass"
local ATTR_APPLIED = "RuinsAestheticApplied"
local ATTR_WATER = "RuinsWaterEnhanced"

local RNG = Random.new(90503744)

