					Material = Enum.Material.LeafyGrass,
					Color = COLORS.algae,
					Transparency = 0.15,
					Parent = waterFolder,
				})
			end

			local foamAtt = Instance.new("Attachment")
			foamAtt.Name = "FoamAtt"
			foamAtt.Position = Vector3.new(0, 0.35, -size.Z * 0.42)
			foamAtt.Parent = surface

			local foam = Instance.new("ParticleEmitter")
