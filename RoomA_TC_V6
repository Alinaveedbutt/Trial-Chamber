local random = Random.new(20260802)

local function unitXZ(vector)
	local flat = Vector3.new(vector.X, 0, vector.Z)
	if flat.Magnitude == 0 then
		return Vector3.new(0, 0, -1)
	end
	return flat.Unit
end

local function getRight(forward)
	return Vector3.new(-forward.Z, 0, forward.X)
end

local function orientedCFrame(position, forward)
	forward = unitXZ(forward)
	local right = getRight(forward)
	return CFrame.fromMatrix(
		position,
		right,
		Vector3.new(0, 1, 0),
		-forward
	)
end

local function newFolder(parent, name)
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function newPart(properties)
	local part = Instance.new("Part")
	part.Name = properties.Name or "Part"
	part.Anchored = true
	part.CanCollide = properties.CanCollide ~= false
	part.CanQuery = properties.CanQuery ~= false
	part.CastShadow = properties.CastShadow ~= false
	part.Size = properties.Size
	part.CFrame = properties.CFrame
	part.Material = properties.Material or Enum.Material.SmoothPlastic
	part.Color = properties.Color or Color3.fromRGB(150, 150, 150)
	if properties.Shape then
		part.Shape = properties.Shape
	end
	if properties.Transparency then
		part.Transparency = properties.Transparency
	end
	part.Parent = properties.Parent
	return part
end

local function addGlow(part, color, range, brightness)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range or 16
	light.Brightness = brightness or 2
	light.Shadows = true
	light.Parent = part
end

local function addOrientedPart(parent, name, size, position, forward, material, color, options)
	options = options or {}
	return newPart({
		Name = name,
		Size = size,
		CFrame = orientedCFrame(position, forward),
		Material = material,
		Color = color,
		Transparency = options.Transparency,
		CanCollide = options.CanCollide,
		CanQuery = options.CanQuery,
		CastShadow = options.CastShadow,
		Parent = parent,
	})
end

local function getExistingChamberFloorPosition()
	local existing = Workspace:FindFirstChild("TrialChamber")
	if not existing then
		return Vector3.new(0, 0, 0)
	end
	local centralHub = existing:FindFirstChild("CentralHub")
	if centralHub then
		local floor = centralHub:FindFirstChild("Floor", true)
		if floor and floor:IsA("BasePart") then
			return Vector3.new(
				floor.Position.X,
				floor.Position.Y + floor.Size.Y / 2,
				floor.Position.Z
			)
		end
		local part = centralHub:FindFirstChildWhichIsA("BasePart", true)
		if part then
			return Vector3.new(
				part.Position.X,
				part.Position.Y + part.Size.Y / 2,
				part.Position.Z
			)
		end
	end
	local part = existing:FindFirstChildWhichIsA("BasePart", true)
	if part then
		return Vector3.new(
			part.Position.X,
			part.Position.Y + part.Size.Y / 2,
			part.Position.Z
		)
	end
	return Vector3.new(0, 0, 0)
end

