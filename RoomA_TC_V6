local function addRubblePile(parent, name, centerPosition, chunkCount, spreadRadius)
	local pile = newFolder(parent, name)
	for index = 1, chunkCount do
		local angle = random:NextNumber() * math.pi * 2
		local distance = random:NextNumber() * spreadRadius
		local size = 0.8 + random:NextNumber() * 1.6
		local offset = Vector3.new(
			math.cos(angle) * distance,
			size * 0.35,
			math.sin(angle) * distance
		)
		newPart({
			Name = "Chunk_" .. index,
			Size = Vector3.new(size, size * 0.7, size * 0.9),
			CFrame = CFrame.new(centerPosition + offset) * CFrame.Angles(
				random:NextNumber() * math.pi,
				random:NextNumber() * math.pi,
				random:NextNumber() * math.pi
			),
			Material = CONFIG.materials.rubble,
			Color = CONFIG.colors.rubble,
			Parent = pile,
		})
	end
	return pile
end

