local function main()
	local oldDraft = Workspace:FindFirstChild("TrialChamberV2_RoomA")
	if oldDraft then oldDraft:Destroy() end

	local originalFloorPosition = getExistingChamberFloorPosition()
	local basePosition = originalFloorPosition + CONFIG.draftOffset

	local root = Instance.new("Model")
	root.Name = "TrialChamberV2_RoomA"
	root.Parent = Workspace

	-- Use the same forward direction as branch A in the original script
	local forward = Vector3.new(-1, 0, 1).Unit
	local corridorStart = basePosition + forward * (CONFIG.hub.radius - 1)

	local corridor = newFolder(root, "Hallway_RoomA")
	corridor.Name = "Hallway_RoomA"

	-- Build corridor structure
	local width = CONFIG.corridor.width
	local height = CONFIG.corridor.height
	local length = CONFIG.corridor.length
	local right = getRight(forward)
	local center = corridorStart + forward * (length / 2)

	addOrientedPart(corridor, "Floor", Vector3.new(width, 1, length), center + Vector3.new(0, -0.5, 0), forward, CONFIG.materials.floor, CONFIG.colors.floor)
	addOrientedPart(corridor, "Ceiling", Vector3.new(width, 1, length), center + Vector3.new(0, height + 0.5, 0), forward, CONFIG.materials.wall, CONFIG.colors.wall)
	addOrientedPart(corridor, "WallLeft", Vector3.new(CONFIG.corridor.wallThickness, height, length),
		center - right * (width / 2) + Vector3.new(0, height / 2, 0), forward, CONFIG.materials.wall, CONFIG.colors.wall)
	addOrientedPart(corridor, "WallRight", Vector3.new(CONFIG.corridor.wallThickness, height, length),
		center + right * (width / 2) + Vector3.new(0, height / 2, 0), forward, CONFIG.materials.wall, CONFIG.colors.wall)

	local leftWallOrigin = corridorStart - right * (width / 2)
	local rightWallOrigin = corridorStart + right * (width / 2)

	addCorniceBand(corridor, "WallLeft", leftWallOrigin, forward, length, height, CONFIG.materials.trim, CONFIG.colors.trim)
	addCorniceBand(corridor, "WallRight", rightWallOrigin, forward, length, height, CONFIG.materials.trim, CONFIG.colors.trim)
	addBaseboardBand(corridor, "WallLeft", leftWallOrigin, forward, length, CONFIG.materials.trim, CONFIG.colors.trim)
	addBaseboardBand(corridor, "WallRight", rightWallOrigin, forward, length, CONFIG.materials.trim, CONFIG.colors.trim)
	layCeilingBeams(corridor, "Beam", corridorStart, forward, width, height, 0, length, CONFIG.materials.wall, CONFIG.colors.wall)
	layWallTorches(corridor, "TorchLeft", leftWallOrigin, forward, right, 0, length)
	layWallTorches(corridor, "TorchRight", rightWallOrigin, forward, -right, 0, length)

	-- Connector hazards inside the corridor
	generateRoomAConnectorHazards(corridor, corridorStart, forward, length)

	-- Room A itself
	local roomEntrance = corridorStart + forward * length
	buildRoomA(root, roomEntrance, forward)

	print("[TrialChamberV2_RoomA] Room A standalone draft created.")
end

main()
animateSwingingBlades()
