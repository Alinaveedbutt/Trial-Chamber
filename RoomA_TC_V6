		Material = CONFIG.materials.wall,
		Color = CONFIG.colors.ancientStone,
		Parent = block,
	})
	addCollapsedMasonry(block, "SpallDebris", floorPosition + right * (wallSideRight * 2.6), 5, 2.0)
	return block
end

