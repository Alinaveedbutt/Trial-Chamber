local function addDamagedArch(parent, name, wallFloorPosition, forward, archWidth, wallHeight, material, color)
	local arch = newFolder(parent, name)
	local right = getRight(forward)

	local halfWidth = archWidth / 2
	local rise = archWidth * 0.32
	local archRadius = (halfWidth ^ 2 + rise ^ 2) / (2 * rise)
	local halfSweep = math.asin(math.min(halfWidth / archRadius, 1))
	local springHeight = wallHeight * 0.42
	local archCenter = wallFloorPosition + Vector3.new(0, springHeight, 0)

	for _, side in ipairs({ -1, 1 }) do
		addOrientedPart(arch, "Springer_" .. (side > 0 and "Right" or "Left"), Vector3.new(1.6, springHeight, 1.3),
			wallFloorPosition + right * (side * (halfWidth + 0.5)) + forward * 0.5 + Vector3.new(0, springHeight / 2, 0),
			forward, material, CONFIG.colors.ancientStone)
	end

	local voussoirCount = 7
	local angleStep = (halfSweep * 2) / voussoirCount
	local blockWidth = 2 * archRadius * math.sin(angleStep / 2) * 1.25
	local breakIndex = math.floor(voussoirCount * 0.6)

	for index = 0, breakIndex do
		local angle = (math.pi / 2 - halfSweep) + angleStep * (index + 0.5)
		local position = archCenter
			+ right * (archRadius * math.cos(angle))
			+ Vector3.new(0, archRadius * math.sin(angle), 0)
		local tangent = right * -math.sin(angle) + Vector3.new(0, math.cos(angle), 0)
		local radial = right * math.cos(angle) + Vector3.new(0, math.sin(angle), 0)

		newPart({
			Name = "Voussoir_" .. (index + 1),
			Size = Vector3.new(blockWidth, 1.3, 1.1),
			CFrame = CFrame.fromMatrix(position, tangent, radial),
			Material = material,
			Color = CONFIG.colors.ancientStone,
			Parent = arch,
		})
	end

	addCollapsedMasonry(arch, "ArchDebris", wallFloorPosition + right * (halfWidth * 0.6) + forward * 0.8, 4, 1.6)
	return arch
end

