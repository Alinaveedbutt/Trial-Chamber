-- TrialChamberRespawn.lua
-- Authoritative per-player room checkpoint + death respawn placement.
--
-- Studio setup (pick ONE):
--   A) Script under ServerScriptService named TrialChamberRespawn
--   B) ModuleScript under ServerScriptService — RevampV10 will require() it
--
-- API:
--   _G.TrialChamberRespawn.setCheckpoint(player, "A"|"B"|"C"|"D")
--   _G.TrialChamberRespawn.getCheckpoint(player)
--   _G.TrialChamberRespawn.bindChamber(rootModel)

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local ROOM_ORDER = { A = 1, B = 2, C = 3, D = 4 }

local ATTR_CHECKPOINT = "CurrentTrialRoom"
local ATTR_RESPAWNING = "TrialRespawnPending"

local chamberRoot = nil
local playerConnections = {}
local spawnByRoom = {} -- [ "A"|"B"|"C"|"D" ] = SpawnLocation
local lastPosByUser = {} -- [userId] = Vector3 (HRP may be gone by Died)
local cachedRoomDKillVolume = nil -- avoid a recursive FindFirstChild every poll
local bestRankByUser = {} -- [userId] = highest room rank reached; can never regress
local roomBands = nil -- chamber-local Z band per room, derived from real geometry
local RANK_TO_ROOM = { "A", "B", "C", "D" }

-- Death is a deliberate beat: Roblox waits RESPAWN_TIME, then the player is held
-- still at the checkpoint for RESPAWN_SETTLE_DELAY before regaining control.
local RESPAWN_TIME = 6
local RESPAWN_SETTLE_DELAY = 1.1

local inferRoomFromPosition -- forward declaration (isInRoomD depends on it)

pcall(function()
	Players.RespawnTime = RESPAWN_TIME
end)

local function findChamberRoot()
	if chamberRoot and chamberRoot.Parent then
		return chamberRoot
	end
	chamberRoot = Workspace:FindFirstChild("TrialChamberGeneratedV5_Sky")
		or Workspace:FindFirstChild("TrialChamberActive")
		or Workspace:FindFirstChild("TrialChamberV2")
	return chamberRoot
end

local function normalizeRoomKey(roomKey)
	if typeof(roomKey) ~= "string" then
		return nil
	end
	local key = string.upper(string.sub(roomKey, 1, 1))
	if ROOM_ORDER[key] then
		return key
	end
	return nil
end

local function findCheckpointPart(roomKey)
	local root = findChamberRoot()
	if not root then
		return nil
	end

	local preferredNames = {
		A = { "RoomACheckpoint", "TrialStartMarker", "Checkpoint_RoomA" },
		B = { "RoomBCheckpoint", "Checkpoint_RoomB" },
		C = { "RoomCCheckpoint", "Checkpoint_RoomC" },
		D = { "RoomDCheckpoint", "Checkpoint_RoomD" },
	}

	local names = preferredNames[roomKey]
	if names then
		for _, name in ipairs(names) do
			local part = root:FindFirstChild(name, true)
			if part and part:IsA("BasePart") then
				return part
			end
		end
	end

	local folder = root:FindFirstChild("Checkpoints")
	if folder then
		local part = folder:FindFirstChild("Room" .. roomKey .. "Checkpoint")
			or folder:FindFirstChild(roomKey)
		if part and part:IsA("BasePart") then
			return part
		end
	end

	return nil
end

local function topOfPart(part)
	return part.Position.Y + part.Size.Y * 0.5
end

local function getInstancePosition(inst)
	if not inst then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst.Position
	end
	if inst:IsA("Model") then
		local ok, cf = pcall(function()
			return inst:GetPivot()
		end)
		if ok and cf then
			return cf.Position
		end
	end
	local ok, cf = pcall(function()
		return select(1, inst:GetBoundingBox())
	end)
	if ok and typeof(cf) == "CFrame" then
		return cf.Position
	end
	local part = inst:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position or nil
end

-- Solid pad at the chasm mouth (Room D start), not the pit at y=-50.
-- Never falls back to TransitionCD: that clearing sits on Room C's side of the
-- Ancient Gate, which is what made Room D deaths respawn back in Room C.
local function findRoomDStandPart()
	local root = findChamberRoot()
	if not root then
		return nil
	end

	local chasm = root:FindFirstChild("RoomD_Chasm") or root:FindFirstChild("RoomD")
	if not chasm then
		return nil
	end

	for _, name in ipairs({ "RoomDSpawnPad", "RoomDCheckpoint" }) do
		local part = chasm:FindFirstChild(name, true)
		if part and part:IsA("BasePart") then
			return part
		end
	end

	-- Otherwise the southern-most standable parkour platform inside the chasm,
	-- i.e. the ledge the player first lands on when entering Room D.
	local pivot = root:GetPivot()
	local parkour = chasm:FindFirstChild("Parkour") or chasm
	local best, bestZ = nil, math.huge
	for _, inst in ipairs(parkour:GetDescendants()) do
		if inst:IsA("BasePart")
			and inst.CanCollide
			and inst.Transparency < 0.5
			and inst.Size.X >= 8
			and inst.Size.Z >= 8
			and inst.Size.Y <= 6
		then
			local z = pivot:PointToObjectSpace(inst.Position).Z
			if z < bestZ then
				bestZ = z
				best = inst
			end
		end
	end
	return best
end

local function roomDWorldCFrame()
	local root = findChamberRoot()
	if not root then
		return nil
	end

	local stand = findRoomDStandPart()
	local chasm = root:FindFirstChild("RoomD_Chasm") or root:FindFirstChild("RoomD")

	local pos
	if stand then
		pos = Vector3.new(stand.Position.X, topOfPart(stand) + 1, stand.Position.Z)
	end

	if not pos then
		return nil
	end

	local lookTarget = pos + Vector3.new(0, 0, 1)
	local chasmPos = getInstancePosition(chasm)
	if chasmPos then
		local flat = Vector3.new(chasmPos.X - pos.X, 0, chasmPos.Z - pos.Z)
		if flat.Magnitude > 1 then
			lookTarget = pos + flat.Unit
		end
	end
	return CFrame.lookAt(pos, lookTarget)
end

-- Keep the Trial_Chamber chasm-mouth checkpoint. Only create one if missing.
local function ensureRoomDCheckpointPart()
	local existing = findCheckpointPart("D")
	if existing then
		return existing
	end

	local root = findChamberRoot()
	if not root then
		return nil
	end
	local cf = roomDWorldCFrame()
	if not cf then
		return nil
	end

	local folder = root:FindFirstChild("RoomD_Chasm")
		or root:FindFirstChild("RoomD")
		or root:FindFirstChild("TransitionCD")
		or root

	local part = Instance.new("Part")
	part.Name = "RoomDCheckpoint"
	part.Size = Vector3.new(6, 1, 6)
	part.CFrame = cf
	part.Transparency = 1
	part.CanCollide = false
	part.CanQuery = false
	part.Anchored = true
	part.Parent = folder
	print("[TRIAL RESPAWN] RoomDCheckpoint placed at chasm start")
	return part
end

local function isInsidePart(part, worldPos)
	if not (part and part:IsA("BasePart") and worldPos) then
		return false
	end
	local lp = part.CFrame:PointToObjectSpace(worldPos)
	local h = part.Size * 0.5
	return math.abs(lp.X) <= h.X + 4
		and math.abs(lp.Y) <= h.Y + 20
		and math.abs(lp.Z) <= h.Z + 4
end

local function isInRoomD(worldPos)
	if not worldPos then
		return false
	end
	local root = findChamberRoot()
	if not root then
		return false
	end
	if not (cachedRoomDKillVolume and cachedRoomDKillVolume.Parent) then
		cachedRoomDKillVolume = root:FindFirstChild("RoomD_InstantDeath", true)
			or Workspace:FindFirstChild("RoomD_InstantDeath", true)
	end
	if cachedRoomDKillVolume and isInsidePart(cachedRoomDKillVolume, worldPos) then
		return true
	end
	return inferRoomFromPosition(worldPos) == "D"
end

-- Roblox-native spawn points so default respawn lands in the right room.
local function ensureRoomSpawnLocation(roomKey, checkpointPart)
	if not checkpointPart then
		return nil
	end

	local existing = spawnByRoom[roomKey]
	if existing and existing.Parent then
		existing.CFrame = checkpointPart.CFrame + Vector3.new(0, 1, 0)
		return existing
	end

	local name = "Room" .. roomKey .. "Spawn"
	local spawn = checkpointPart.Parent and checkpointPart.Parent:FindFirstChild(name)
	if not (spawn and spawn:IsA("SpawnLocation")) then
		spawn = Instance.new("SpawnLocation")
		spawn.Name = name
		spawn.Size = Vector3.new(6, 1, 6)
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.Anchored = true
		spawn.Duration = 0
		spawn.Neutral = true
		spawn.Enabled = true
		spawn.Parent = checkpointPart.Parent or findChamberRoot()
	end

	spawn.CFrame = checkpointPart.CFrame + Vector3.new(0, 1, 0)
	-- Keep enabled; Player.RespawnLocation selects which one is used.
	spawn.Enabled = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawnByRoom[roomKey] = spawn
	return spawn
end

local function rebuildSpawnLocations()
	table.clear(spawnByRoom)
	for _, key in ipairs({ "A", "B", "C", "D" }) do
		local cp = findCheckpointPart(key)
		if cp then
			ensureRoomSpawnLocation(key, cp)
		end
	end
end

local function applyPlayerRespawnLocation(player, roomKey)
	local key = normalizeRoomKey(roomKey) or "A"
	local spawn = spawnByRoom[key] or ensureRoomSpawnLocation(key, findCheckpointPart(key))
	if spawn then
		player.RespawnLocation = spawn
	end
end

-- Folders have no GetBoundingBox, so measure their parts directly.
local function localZRange(container)
	local root = findChamberRoot()
	if not (root and container) then
		return nil
	end
	local pivot = root:GetPivot()
	local minZ, maxZ = math.huge, -math.huge
	for _, inst in ipairs(container:GetDescendants()) do
		if inst:IsA("BasePart") then
			local z = pivot:PointToObjectSpace(inst.Position).Z
			minZ = math.min(minZ, z)
			maxZ = math.max(maxZ, z)
		end
	end
	if minZ == math.huge then
		return nil
	end
	return minZ, maxZ
end

-- Room boundaries are measured from the chamber that actually exists. Hardcoded
-- Z thresholds silently rot whenever the generator moves the layout, which is
-- how Room D deaths were being filed as Room A/B/C.
local function buildRoomBands()
	local root = findChamberRoot()
	if not root then
		return nil
	end

	local sources = {
		A = { "EntryForecourt", "RoomA" },
		B = { "RoomB" },
		C = { "RoomC" },
		D = { "RoomD_Chasm", "RoomD" },
	}

	local bands = {}
	for _, key in ipairs({ "A", "B", "C", "D" }) do
		local minZ, maxZ
		for _, name in ipairs(sources[key]) do
			local folder = root:FindFirstChild(name)
			if folder then
				local a, b = localZRange(folder)
				if a then
					minZ = minZ and math.min(minZ, a) or a
					maxZ = maxZ and math.max(maxZ, b) or b
				end
			end
		end
		if minZ then
			table.insert(bands, { key = key, minZ = minZ, maxZ = maxZ })
		end
	end

	if #bands == 0 then
		return nil
	end

	table.sort(bands, function(a, b)
		return a.minZ < b.minZ
	 end)

	-- Room folders overlap (Room D's chasm is enormous), so cut each boundary at
	-- the midpoint between neighbours and let the outer bands run to infinity.
	for i = 1, #bands - 1 do
		local mid = (bands[i].maxZ + bands[i + 1].minZ) * 0.5
		bands[i].maxZ = mid
		bands[i + 1].minZ = mid
	end
	bands[1].minZ = -math.huge
	bands[#bands].maxZ = math.huge

	roomBands = bands
	local parts = {}
	for _, band in ipairs(bands) do
		table.insert(parts, string.format("%s[%.0f..%.0f]", band.key, band.minZ, band.maxZ))
	end
	print("[TRIAL RESPAWN] Room bands: " .. table.concat(parts, " "))
	return bands
end

function inferRoomFromPosition(worldPos)
	local root = findChamberRoot()
	if not root or not worldPos then
		return nil
	end

	local bands = roomBands or buildRoomBands()
	if not bands then
		return nil
	end

	local z = root:GetPivot():PointToObjectSpace(worldPos).Z
	for _, band in ipairs(bands) do
		if z >= band.minZ and z < band.maxZ then
			return band.key
		end
	end
	return nil
end

local function setCheckpoint(player, roomKey, force)
	local key = normalizeRoomKey(roomKey)
	if not key or not player then
		return false
	end

	local locked = bestRankByUser[player.UserId] or 0
	local current = player:GetAttribute(ATTR_CHECKPOINT)
	local currentRank = math.max(ROOM_ORDER[current] or 0, locked)
	local nextRank = ROOM_ORDER[key] or 0

	-- Hard lock: nothing, not even a forced call, sends a player back a room.
	if nextRank < locked then
		return false
	end
	if not force and nextRank < currentRank then
		return false
	end

	bestRankByUser[player.UserId] = nextRank

	if current ~= key then
		player:SetAttribute(ATTR_CHECKPOINT, key)
		print("[TRIAL RESPAWN] " .. player.Name .. " checkpoint set to Room " .. key)
	else
		player:SetAttribute(ATTR_CHECKPOINT, key)
	end

	applyPlayerRespawnLocation(player, key)
	return true
end

local function getCheckpoint(player)
	if not player then
		return "A"
	end
	local key = normalizeRoomKey(player:GetAttribute(ATTR_CHECKPOINT))
	local rank = math.max(ROOM_ORDER[key] or 0, bestRankByUser[player.UserId] or 0)
	if rank <= 0 then
		return "A"
	end
	local resolved = RANK_TO_ROOM[rank] or "A"
	if resolved ~= key then
		-- Re-assert if anything cleared or downgraded the attribute.
		player:SetAttribute(ATTR_CHECKPOINT, resolved)
	end
	return resolved
end

local function placeCharacterAtCheckpoint(player, character)
	local roomKey = getCheckpoint(player)
	if roomKey == "D" then
		pcall(ensureRoomDCheckpointPart)
		rebuildSpawnLocations()
		applyPlayerRespawnLocation(player, "D")
	end
	local checkpoint = findCheckpointPart(roomKey)
	local spawnPos
	local flatLook = Vector3.new(0, 0, 1)

	if checkpoint then
		applyPlayerRespawnLocation(player, roomKey)
		local look = checkpoint.CFrame.LookVector
		flatLook = Vector3.new(look.X, 0, look.Z)
		if flatLook.Magnitude < 0.05 then
			flatLook = Vector3.new(0, 0, 1)
		else
			flatLook = flatLook.Unit
		end
		spawnPos = checkpoint.Position + Vector3.new(0, 4, 0)
	elseif roomKey == "D" then
		local cf = roomDWorldCFrame()
		if cf then
			spawnPos = cf.Position + Vector3.new(0, 4, 0)
			local look = cf.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude < 0.05 then
				flatLook = Vector3.new(0, 0, 1)
			else
				flatLook = flat.Unit
			end
			print("[TRIAL RESPAWN] Room D checkpoint missing — using chasm entrance fallback")
		end
	end

	if not spawnPos then
		warn("[TRIAL RESPAWN] No checkpoint part for Room " .. roomKey .. " — falling back to SpawnLocation only")
		applyPlayerRespawnLocation(player, roomKey)
		return false
	end

	local hrp = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
	if not hrp then
		warn("[TRIAL RESPAWN] No HumanoidRootPart for " .. player.Name)
		return false
	end
	local targetCF = CFrame.lookAt(spawnPos, spawnPos + flatLook)

	-- One primary seat + one short correction. Do NOT spam CFrame (looks like multi-respawn).
	if not character.Parent or not hrp.Parent then
		return false
	end

	-- Hold the player still while the world settles, so a respawn on a narrow
	-- Room D ledge cannot slide or fall before they have control.
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local savedWalkSpeed = humanoid and humanoid.WalkSpeed or nil
	if humanoid then
		humanoid.WalkSpeed = 0
	end
	hrp.Anchored = true
	hrp.CFrame = targetCF
	hrp.AssemblyLinearVelocity = Vector3.zero
	hrp.AssemblyAngularVelocity = Vector3.zero

	task.wait(RESPAWN_SETTLE_DELAY)

	if character.Parent and hrp.Parent then
		-- Only correct if something else moved the character away from the checkpoint.
		if (hrp.Position - spawnPos).Magnitude > 6 then
			hrp.CFrame = targetCF
		end
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.Anchored = false
	end
	if humanoid and humanoid.Parent then
		humanoid.WalkSpeed = savedWalkSpeed or 16
	end

	print("[TRIAL RESPAWN] " .. player.Name .. " respawned at Room " .. roomKey .. " checkpoint")
	return true
end

local function onPlayerDied(player, character)
	-- Guard: one death event per character instance.
	if character and character:GetAttribute("TrialDeathHandled") == true then
		return
	end
	if character then
		character:SetAttribute("TrialDeathHandled", true)
	end

	-- getCheckpoint() reflects the room the player was continuously tracked in
	-- while alive (see the Heartbeat tracker near the bottom of this file), so
	-- it's reliable even if HumanoidRootPart is already gone or mid-ragdoll by
	-- the time Died fires. This used to be the ONLY place A/B/C checkpoints got
	-- set, computed from a single position sample (live HRP, or a fallback that
	-- could be up to ~200ms stale) — if that sample landed just barely on the
	-- wrong side of a room boundary, the death got attributed to the PREVIOUS
	-- room instead of the one the player actually died in.
	if not player:GetAttribute(ATTR_CHECKPOINT) then
		setCheckpoint(player, "A", true)
	end
	local roomKey = getCheckpoint(player)

	-- Still take a fresh position sample when one is available, but only to
	-- ADVANCE the checkpoint (e.g. the player died the instant they crossed
	-- into a new room, before the tracker's next tick could run). setCheckpoint
	-- without `force` is rank-guarded, so this can never move it backwards.
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local deathPos = (hrp and hrp.Position) or lastPosByUser[player.UserId]
	if deathPos then
		if isInRoomD(deathPos) then
			pcall(ensureRoomDCheckpointPart)
			setCheckpoint(player, "D")
		else
			local inferred = inferRoomFromPosition(deathPos)
			if inferred then
				if inferred == "D" then
					pcall(ensureRoomDCheckpointPart)
				end
				setCheckpoint(player, inferred)
			end
		end
		roomKey = getCheckpoint(player)
	end

	print("[TRIAL RESPAWN] " .. player.Name .. " died in Room " .. roomKey)
	player:SetAttribute(ATTR_RESPAWNING, true)
	applyPlayerRespawnLocation(player, roomKey)

	-- Room A death: restart portcullis + restore pre-Room-B Gate_AB/passage state.
	if roomKey == "A" then
		player:SetAttribute("PendingRoomABarRestart", true)
		if _G.RoomAExitGateController and type(_G.RoomAExitGateController.reset) == "function" then
			_G.RoomAExitGateController.reset("trial_respawn_death")
		elseif type(_G.RoomAPortcullisReset) == "function" then
			_G.RoomAPortcullisReset("trial_respawn_death")
		end
		if _G.RoomABTransitionController and type(_G.RoomABTransitionController.resetForRoomA) == "function" then
			_G.RoomABTransitionController.resetForRoomA("room_a_death")
		elseif _G.PassageSecurityGateController and type(_G.PassageSecurityGateController.reset) == "function" then
			_G.PassageSecurityGateController.reset("room_a_death")
		end
	end
end

local function hookCharacter(player, character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end

	-- Relocate after a death-driven respawn, and also whenever the player has
	-- already banked a checkpoint. Roblox picks an arbitrary enabled SpawnLocation
	-- whenever RespawnLocation is momentarily unset, which is how a Room D death
	-- could drop the player back in Room C.
	local shouldPlace = player:GetAttribute(ATTR_RESPAWNING) == true
		or (bestRankByUser[player.UserId] or 0) > 0

	if player:GetAttribute(ATTR_RESPAWNING) == true then
		player:SetAttribute(ATTR_RESPAWNING, false)
	end

	if shouldPlace then
		task.defer(function()
			task.wait(0.05)
			if character.Parent then
				placeCharacterAtCheckpoint(player, character)
			end
			task.wait(0.15)
			-- Restore persistent unlocks after respawn (not room-gated).
			if _G.Progression and type(_G.Progression.ensureSwordAfterRespawn) == "function" then
				_G.Progression.ensureSwordAfterRespawn(player)
			end
			if _G.TrialSpell and type(_G.TrialSpell.restoreSpellAfterRespawn) == "function" then
				_G.TrialSpell.restoreSpellAfterRespawn(player)
			end
			if _G.TrialSpell and type(_G.TrialSpell.orderHotbar) == "function" then
				task.wait(0.1)
				_G.TrialSpell.orderHotbar(player)
			end
			-- Room A bars + A/B gates: one activate + one transition reset (no duplicate controllers).
			local roomKey = getCheckpoint(player)
			if roomKey == "A" and character.Parent then
				print("[ROOM RESET] Player respawned in Room A — restarting ExitPortcullis timer")
				if _G.RoomABTransitionController and type(_G.RoomABTransitionController.resetForRoomA) == "function" then
					_G.RoomABTransitionController.resetForRoomA("room_a_respawn")
				elseif _G.PassageSecurityGateController and type(_G.PassageSecurityGateController.reset) == "function" then
					_G.PassageSecurityGateController.reset("room_a_respawn")
				end
				if _G.RoomAExitGateController and type(_G.RoomAExitGateController.activate) == "function" then
					_G.RoomAExitGateController.activate(character)
					player:SetAttribute("PendingRoomABarRestart", nil)
				end
			end
		end)
	elseif not player:GetAttribute(ATTR_CHECKPOINT) then
		applyPlayerRespawnLocation(player, "A")
	else
		-- Keep RespawnLocation aligned with checkpoint; do not force-move living joins.
		applyPlayerRespawnLocation(player, getCheckpoint(player))
	end

	-- One Died connection for this character only (new CharacterAdded => new character).
	humanoid.Died:Connect(function()
		onPlayerDied(player, character)
	end)
end
local function bindPlayer(player)
	if playerConnections[player] then
		return
	end

	local conns = {}
	table.insert(conns, player.CharacterAdded:Connect(function(character)
		hookCharacter(player, character)
	end))

	if player.Character then
		hookCharacter(player, player.Character)
	end

	playerConnections[player] = conns

	-- Always bind a safe default RespawnLocation so Roblox does not pick a random room spawn.
	if player:GetAttribute(ATTR_CHECKPOINT) then
		applyPlayerRespawnLocation(player, getCheckpoint(player))
	else
		applyPlayerRespawnLocation(player, "A")
	end
end

local function unbindPlayer(player)
	local conns = playerConnections[player]
	if conns then
		for _, c in ipairs(conns) do
			c:Disconnect()
		end
		playerConnections[player] = nil
	end
	if player then
		lastPosByUser[player.UserId] = nil
		bestRankByUser[player.UserId] = nil
	end
end

local API = {}

function API.bindChamber(rootModel)
	chamberRoot = rootModel
	roomBands = nil
	cachedRoomDKillVolume = nil
	buildRoomBands()
	pcall(ensureRoomDCheckpointPart)
	rebuildSpawnLocations()
	print("[TRIAL RESPAWN] Chamber bound: " .. (rootModel and rootModel:GetFullName() or "nil"))

	-- Refresh RespawnLocation for everyone already in the trial.
	for _, player in ipairs(Players:GetPlayers()) do
		if player:GetAttribute(ATTR_CHECKPOINT) then
			applyPlayerRespawnLocation(player, getCheckpoint(player))
		end
	end
end

function API.setCheckpoint(player, roomKey, force)
	return setCheckpoint(player, roomKey, force)
end

function API.getCheckpoint(player)
	return getCheckpoint(player)
end

function API.findCheckpointPart(roomKey)
	return findCheckpointPart(roomKey)
end

function API.inferRoomFromPosition(worldPos)
	return inferRoomFromPosition(worldPos)
end

_G.TrialChamberRespawn = API

-- Continuously track which room every LIVING player is standing in, for all
-- four rooms (previously this only ever tracked Room D). setCheckpoint() is
-- called without force, so it's rank-guarded and can only ever advance the
-- checkpoint (A -> B -> C -> D), never move it backwards. This is what makes
-- onPlayerDied's getCheckpoint() reliable: the correct room gets latched in
-- well before a death happens, instead of being guessed from a single
-- position sample taken at (or just after) the moment of death.
local TRACK_INTERVAL = 0.05 -- 20Hz; closes the old ~200ms staleness window
local trackAcc = 0
RunService.Heartbeat:Connect(function(dt)
	trackAcc += dt
	if trackAcc < TRACK_INTERVAL then
		return
	end
	trackAcc = 0
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		-- Skip anyone already dead/ragdolling — a corpse sliding around post-death
		-- shouldn't feed a bogus room reading before the next respawn happens.
		if humanoid and humanoid.Health > 0 then
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if hrp then
				lastPosByUser[player.UserId] = hrp.Position
				local room = inferRoomFromPosition(hrp.Position)
				if room then
					if room == "D" then
						pcall(ensureRoomDCheckpointPart)
					end
					setCheckpoint(player, room)
				end
			end
		end
	end
end)

Players.PlayerAdded:Connect(bindPlayer)
Players.PlayerRemoving:Connect(unbindPlayer)
for _, player in ipairs(Players:GetPlayers()) do
	bindPlayer(player)
end

task.defer(function()
	local root = findChamberRoot()
	if root then
		API.bindChamber(root)
	end
end)

print("[TRIAL RESPAWN] TrialChamberRespawn ready")

return API
