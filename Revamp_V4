local function unitXZ(vector)
    local v = Vector3.new(vector.X, 0, vector.Z)
    if v.Magnitude > 0.001 then
        return v.Unit
    else
        return Vector3.new(0, 0, -1)
    end
end

local function getRight(forward)
    local fwd = unitXZ(forward)
    return Vector3.new(fwd.Z, 0, -fwd.X)
end

local function orientedCFrame(position, forward)
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    return CFrame.fromMatrix(position, right, Vector3.new(0, 1, 0), -fwd)
end

local function newFolder(parent, name)
    local folder = Instance.new("Folder")
    folder.Name = name
    folder.Parent = parent
    return folder
end

local function newPart(properties)
    local part = Instance.new("Part")
    part.Anchored = true
    for k, v in pairs(properties) do
        part[k] = v
    end
    return part
end

local function addGlow(part, color, range, brightness)
    local light = Instance.new("PointLight")
    light.Color = color
    light.Range = range
    light.Brightness = brightness
    light.Parent = part
    return light
end

local function addOrientedPart(parent, name, size, position, forward, material, color, options)
    local props = {
        Name = name,
        Size = size,
        CFrame = orientedCFrame(position, forward),
        Material = material,
        Color = color,
        Parent = parent
    }
    if options then
        for k, v in pairs(options) do
            props[k] = v
        end
    end
    return newPart(props)
end

local function horizontalAxisCFrame(position, axisDirection)
    local fwd = unitXZ(axisDirection)
    return CFrame.fromMatrix(position, fwd, Vector3.new(0, 1, 0))
end

local function addPilaster(parent, name, floorPosition, forward, height, material, color)
    -- A pilaster is the single most-repeated architectural element in
    -- the whole chamber (every bay boundary, every octagon corner, every
    -- gate). Making this one builder read as genuine load-bearing
    -- masonry -- stepped base, necking band, overhanging capital --
    -- raises the perceived quality of every room that uses it.
    local model = newFolder(parent, name)
    local right = getRight(forward)
    local fwd = unitXZ(forward)
    
    local w = CONFIG.detail.pillarSize
    local d = CONFIG.detail.pillarSize * 0.5
    local pos = floorPosition + Vector3.new(0, height/2, 0)
    addOrientedPart(model, "Shaft", Vector3.new(w, height, d), pos, fwd, material, color)

    -- Stepped base -- reads as load-bearing rather than applied trim
    addOrientedPart(model, "Base", Vector3.new(w + 0.7, 1.0, d + 0.5), floorPosition + Vector3.new(0, 0.5, 0) + fwd*0.12, fwd, material, CONFIG.colors.ancientStone)

    -- Necking band just under the capital -- the carved detail that
    -- separates "architecture" from "a plain post"
    addOrientedPart(model, "Necking", Vector3.new(w + 0.25, 0.3, d + 0.15), floorPosition + Vector3.new(0, height - 1.1, 0) + fwd*0.08, fwd, material, CONFIG.colors.ancientStone)

    -- Capital -- wider overhang than before, reads as a real load-bearing cap
    addOrientedPart(model, "Capital", Vector3.new(w + 1.0, 0.9, d + 0.7), floorPosition + Vector3.new(0, height - 0.3, 0) + fwd*0.14, fwd, material, CONFIG.colors.ancientStone)
    
    return model
end

