local function buildTransitionCorridor(root, name, startPosition, forward, length, style)
	local folder = newFolder(root, name)
	local geomFolder = newFolder(folder, "Geometry")
	local decFolder = newFolder(folder, "Decoration")

	local width = CONFIG.transitions.corridorWidth
	local height = CONFIG.transitions.corridorHeight
	local halfWidth = width / 2
	local wallThick = CONFIG.transitions.wallThickness
	local fwd = unitXZ(forward)
	local right = getRight(fwd)

	local center = startPosition + fwd * (length / 2)
	local floorY = startPosition.Y

	-- Floor
	addOrientedPart(geomFolder, "Floor",
		Vector3.new(width, 1, length),
		center + Vector3.new(0, -0.5, 0),
		fwd, CONFIG.materials.floor, CONFIG.colors.floor)

	-- Ceiling
	addOrientedPart(geomFolder, "Ceiling",
		Vector3.new(width, 1, length),
		center + Vector3.new(0, height + 0.5, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wallDark)

	-- Left Wall
	addOrientedPart(geomFolder, "LeftWall",
		Vector3.new(wallThick, height, length),
		center - right * (halfWidth + wallThick / 2) + Vector3.new(0, height / 2, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wall)

	-- Right Wall
	addOrientedPart(geomFolder, "RightWall",
		Vector3.new(wallThick, height, length),
		center + right * (halfWidth + wallThick / 2) + Vector3.new(0, height / 2, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wall)

	-- Cornice + Baseboard on both walls
	local leftFacePos = startPosition - right * halfWidth
	local rightFacePos = startPosition + right * halfWidth

	addCorniceBand(decFolder, "CorniceL", leftFacePos, fwd, length, height, CONFIG.materials.trim, CONFIG.colors.trim)
	addCorniceBand(decFolder, "CorniceR", rightFacePos, fwd, length, height, CONFIG.materials.trim, CONFIG.colors.trim)
	addBaseboardBand(decFolder, "BaseboardL", leftFacePos, fwd, length, CONFIG.materials.trim, CONFIG.colors.trim)
	addBaseboardBand(decFolder, "BaseboardR", rightFacePos, fwd, length, CONFIG.materials.trim, CONFIG.colors.trim)

	-- Ceiling beams
	layCeilingBeams(decFolder, "Beam", startPosition, fwd, width, height, 4, length - 4, CONFIG.materials.wood, CONFIG.colors.wood)

	-- Torches
	if style == "collapse" then
		local rng = Random.new(math.floor(math.abs(startPosition.X + startPosition.Z)) + 7777)
		for t = CONFIG.detail.torchSpacing, length - 10, CONFIG.detail.torchSpacing * 2 do
			if rng:NextNumber() > 0.3 then
				addWallTorch(decFolder, "TorchL_" .. t, startPosition - right * halfWidth + fwd * t, right, CONFIG.detail.torchHeight)
			end
			if rng:NextNumber() > 0.3 then
				addWallTorch(decFolder, "TorchR_" .. t, startPosition + right * halfWidth + fwd * t, -right, CONFIG.detail.torchHeight)
			end
		end
		-- Debris
		for i = 1, 3 do
			local zOff = rng:NextNumber() * (length - 20) + 10
			addCollapsedMasonry(decFolder, "Rubble_" .. i,
				startPosition + fwd * zOff + right * (rng:NextNumber() - 0.5) * (width - 6),
				5, 3)
		end
	else
		layWallTorches(decFolder, "TorchL", startPosition - right * halfWidth, fwd, right, 5, length - 5)
		layWallTorches(decFolder, "TorchR", startPosition + right * halfWidth, fwd, -right, 5, length - 5)
	end

	-- Door frames
	buildDoorFrame(geomFolder, "EntryFrame", startPosition + Vector3.new(0, 0, 0), fwd, width, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)

	local exitPosition = startPosition + fwd * length
	buildDoorFrame(geomFolder, "ExitFrame", exitPosition, fwd, width, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)

	return folder, exitPosition
end

----------------------------------------------------------------------
-- ROOM A: TRAP CORRIDOR
----------------------------------------------------------------------
-- Structure and hazard generation ported from the Room A reference
-- draft: continuous single-piece walls/floor/ceiling -- no segment
-- joins, which is what eliminates visible construction seams -- plus
-- the full weighted hazard system (entrance gauntlet phase, an
-- escalating main-course phase with combo encounters, occasional
-- zig-zag divider sequences, and probabilistic environmental
-- storytelling). Hazards now fire from the floor, the ceiling, AND
-- both side walls (the earlier version only had floor + ceiling).
--
-- Integration notes vs. the standalone draft (both documented here and
-- in the delivery summary, since "port faithfully" still means the
-- surrounding chamber has to stay consistent):
--   * No "ExitWall" is built -- the standalone draft caps the far end
--     because it's tested in isolation; here Room A already flows into
--     Transition_A_B's own gate/portcullis built by the main generator,
--     so a second solid wall would just create a redundant double-door.
--   * Wall thickness stays at 2 studs (this chamber's established
--     convention) rather than the draft's 1 stud -- cosmetic only.
--   * Ceiling beams and corner pilasters use stone (CONFIG.materials/
--     colors.wall), matching the draft, not the wood used elsewhere.

local ROOMA_TRAP_FOOTPRINT_DEPTH = CONFIG.spikeTrap.depth + CONFIG.spikeTrap.housingMargin * 2
local ROOMA_TRAP_CLEARANCE = ROOMA_TRAP_FOOTPRINT_DEPTH + 5

local function generateRoomAObstacleCourse(room, entrancePosition, forward, length, width, height)
	local fwd = unitXZ(forward)
	local right = getRight(fwd)
	local leftWallOrigin = entrancePosition - right * (width / 2)
	local rightWallOrigin = entrancePosition + right * (width / 2)
	local roomCfg = CONFIG.roomA
	local hazardRandom = Random.new(roomCfg.hazardSeed)

	local trapIndex = 1
	local bladeIndex = 1
	local decorIndex = 1
	local zigzagIndex = 1
	local bladePivotY = height - CONFIG.swingingBlade.mountDrop
	local dividerWidth = width * 0.62
	local hazardEnd = length - roomCfg.hazardEndOffset
	local finalStretchStart = hazardEnd - 35

	local function nextSpacing()
		return hazardRandom:NextInteger(roomCfg.spacingMin, roomCfg.spacingMax)
	end

	local function placeBlade(dist, lateralOffset)
		lateralOffset = lateralOffset or 0
		local blade = buildSwingingBlade(room, "SwingingBlade_" .. bladeIndex,
			entrancePosition + fwd * dist + right * lateralOffset + Vector3.new(0, bladePivotY, 0), fwd)
		blade:SetAttribute("PhaseOffset", hazardRandom:NextNumber())
		bladeIndex = bladeIndex + 1
		return blade
	end

	local function placeFloor(dist, lateralOffset)
		lateralOffset = lateralOffset or 0
		buildSpikeTrap(room, "SpikeTrap_" .. trapIndex, entrancePosition + fwd * dist + right * lateralOffset, fwd)
		trapIndex = trapIndex + 1
	end

	local function placeCeiling(dist)
		buildCeilingSpike(room, "CeilingSpike_" .. trapIndex, entrancePosition + fwd * dist + Vector3.new(0, height, 0), fwd)
		trapIndex = trapIndex + 1
	end

	local function placeWallLeft(dist)
		buildWallSpike(room, "WallSpike_" .. trapIndex, leftWallOrigin + fwd * dist + Vector3.new(0, height / 2 - 3, 0), fwd, false)
		trapIndex = trapIndex + 1
	end

	local function placeWallRight(dist)
		buildWallSpike(room, "WallSpike_" .. trapIndex, rightWallOrigin + fwd * dist + Vector3.new(0, height / 2 - 3, 0), fwd, true)
		trapIndex = trapIndex + 1
	end

	local encounterHasTrap = {
		floor = true, ceiling = true, wallLeft = true, wallRight = true, blade = false,
		floorBlade = true, ceilingBlade = true, opposingWalls = true, crushRight = true, crushLeft = true, doubleCeiling = true,
	}

	local encounterWeights = {
		{ id = "floor", weight = 18 }, { id = "ceiling", weight = 18 },
		{ id = "wallLeft", weight = 14 }, { id = "wallRight", weight = 14 },
		{ id = "blade", weight = 12 }, { id = "floorBlade", weight = 10 },
		{ id = "ceilingBlade", weight = 8 }, { id = "opposingWalls", weight = 10 },
		{ id = "crushRight", weight = 5 }, { id = "crushLeft", weight = 5 },
		{ id = "doubleCeiling", weight = 6 },
	}

	local finalEncounterWeights = {
		{ id = "floorBlade", weight = 14 }, { id = "ceilingBlade", weight = 12 },
		{ id = "opposingWalls", weight = 14 }, { id = "crushRight", weight = 10 },
		{ id = "crushLeft", weight = 10 }, { id = "floor", weight = 8 },
		{ id = "ceiling", weight = 8 }, { id = "blade", weight = 10 },
		{ id = "wallLeft", weight = 7 }, { id = "wallRight", weight = 7 },
	}

	local function pickEncounterId(inFinalStretch)
		local pool = inFinalStretch and finalEncounterWeights or encounterWeights
		local totalWeight = 0
		for _, entry in ipairs(pool) do totalWeight = totalWeight + entry.weight end
		local roll = hazardRandom:NextNumber() * totalWeight
		local cumulative = 0
		for _, entry in ipairs(pool) do
			cumulative = cumulative + entry.weight
			if roll <= cumulative then return entry.id end
		end
		return pool[1].id
	end

	local encounters = {
		floor = function(dist) placeFloor(dist) end,
		ceiling = function(dist) placeCeiling(dist) end,
		wallLeft = function(dist) placeWallLeft(dist) end,
		wallRight = function(dist) placeWallRight(dist) end,
		blade = function(dist) placeBlade(dist) end,
		floorBlade = function(dist) placeFloor(dist); placeBlade(dist) end,
		ceilingBlade = function(dist) placeCeiling(dist); placeBlade(dist, hazardRandom:NextInteger(-1, 1) * 2) end,
		opposingWalls = function(dist) placeWallLeft(dist); placeWallRight(dist) end,
		crushRight = function(dist) placeWallRight(dist); placeFloor(dist, -3) end,
		crushLeft = function(dist) placeWallLeft(dist); placeFloor(dist, 3) end,
		doubleCeiling = function(dist)
			placeCeiling(dist)
			if dist + ROOMA_TRAP_CLEARANCE < hazardEnd then placeCeiling(dist + ROOMA_TRAP_CLEARANCE) end
		end,
	}

	local function tryPlaceDecor(dist)
		if hazardRandom:NextNumber() > 0.22 then return end
		local side = hazardRandom:NextInteger(0, 1) == 0 and -1 or 1
		local decorType = hazardRandom:NextInteger(1, 6)
		local name = "Decor_" .. decorIndex
		decorIndex = decorIndex + 1

		if decorType == 1 then
			addRubblePile(room, name, entrancePosition + fwd * dist + right * side * (width / 2 - 2.5), 4 + hazardRandom:NextInteger(0, 2), 2)
		elseif decorType == 2 then
			addCollapsedMasonry(room, name, entrancePosition + fwd * dist + right * side * (width / 2 - 2.5), 4, 2)
		elseif decorType == 3 then
			addFallenCeilingBlock(room, name, leftWallOrigin + fwd * dist, fwd, side)
		elseif decorType == 4 then
			addWallAlcove(room, name, (side < 0 and leftWallOrigin or rightWallOrigin) + fwd * dist,
				side < 0 and right or -right, 2.4, 3.2, CONFIG.materials.wall, CONFIG.colors.wall)
		elseif decorType == 5 then
			addDamagedArch(room, name, (side < 0 and leftWallOrigin or rightWallOrigin) + fwd * dist,
				side < 0 and right or -right, 4 + hazardRandom:NextNumber() * 0.8, height, CONFIG.materials.wall, CONFIG.colors.wall)
		else
			addBrokenSupport(room, name, (side < 0 and leftWallOrigin or rightWallOrigin) + fwd * dist,
				fwd, height, height * (0.35 + hazardRandom:NextNumber() * 0.15))
		end
	end

	local function placeZigzagSequence(startDist)
		if startDist + 36 > hazardEnd then return startDist end
		local leftDist = startDist
		local rightDist = startDist + 14

		addOrientedPart(room, "ZigzagDividerLeft_" .. zigzagIndex, Vector3.new(dividerWidth, height, 1.5),
			entrancePosition + fwd * leftDist - right * (width / 2 - dividerWidth / 2) + Vector3.new(0, height / 2, 0),
			fwd, CONFIG.materials.wall, CONFIG.colors.wall)
		addPilaster(room, "DividerBraceLeft_" .. zigzagIndex, leftWallOrigin + fwd * leftDist, fwd, height, CONFIG.materials.wall, CONFIG.colors.wall)
		placeBlade(leftDist, dividerWidth / 2)

		addOrientedPart(room, "ZigzagDividerRight_" .. zigzagIndex, Vector3.new(dividerWidth, height, 1.5),
			entrancePosition + fwd * rightDist + right * (width / 2 - dividerWidth / 2) + Vector3.new(0, height / 2, 0),
			fwd, CONFIG.materials.wall, CONFIG.colors.wall)
		addPilaster(room, "DividerBraceRight_" .. zigzagIndex, rightWallOrigin + fwd * rightDist, fwd, height, CONFIG.materials.wall, CONFIG.colors.wall)
		placeBlade(rightDist, -dividerWidth / 2)

		zigzagIndex = zigzagIndex + 1
		return rightDist + nextSpacing()
	end

	local function entranceSpacing()
		return hazardRandom:NextInteger(roomCfg.connectorSpacingMin, roomCfg.connectorSpacingMax)
	end

	local function placeEntranceGauntlet()
		local gauntletEnd = math.min(roomCfg.entranceGauntletEnd, hazardEnd - 10)
		local currentDist = roomCfg.hazardStart

		local gauntletEncounters = {
			{ hasTrap = true, place = function(dist) placeCeiling(dist) end },
			{ hasTrap = true, place = function(dist) placeFloor(dist) end },
			{ hasTrap = true, place = function(dist) placeWallRight(dist) end },
			{ hasTrap = true, place = function(dist) placeWallLeft(dist) end },
			{ hasTrap = false, place = function(dist) placeBlade(dist) end },
			{ hasTrap = true, place = function(dist) placeFloor(dist); placeBlade(dist, hazardRandom:NextInteger(-1, 1) * 2) end },
			{ hasTrap = true, place = function(dist) placeCeiling(dist); placeBlade(dist) end },
			{ hasTrap = true, place = function(dist) placeWallRight(dist); placeFloor(dist, -3) end },
			{ hasTrap = true, place = function(dist) placeWallLeft(dist); placeFloor(dist, 3) end },
			{ hasTrap = true, place = function(dist) placeWallLeft(dist); placeWallRight(dist) end },
		}

		while currentDist < gauntletEnd do
			local encounter = gauntletEncounters[hazardRandom:NextInteger(1, #gauntletEncounters)]
			encounter.place(currentDist)
			local spacing = entranceSpacing()
			if encounter.hasTrap then
				spacing = math.max(spacing, ROOMA_TRAP_CLEARANCE)
			end
			currentDist = currentDist + spacing
		end
		return currentDist
	end

	-- Fixed entrance storytelling
	addRubblePile(room, "RubbleNearEntrance", entrancePosition + fwd * 6 - right * (width / 2 - 2.5), 6, 2.5)
	addCollapsedMasonry(room, "CaveInNearEntrance", entrancePosition + fwd * 7 + right * (width / 2 - 3), 5, 2.2)
	addWarningCarving(room, "WarningCarving", leftWallOrigin + fwd * 11, right, height * 0.55)
	addSkeletalRemains(room, "FallenTrialTaker", entrancePosition + fwd * 8 + right * (width / 2 - 2), fwd)

	local currentDist = placeEntranceGauntlet()

	while currentDist < hazardEnd do
		local inFinalStretch = currentDist >= finalStretchStart
		if hazardRandom:NextNumber() < 0.07 and currentDist + 36 < hazardEnd then
			currentDist = placeZigzagSequence(currentDist)
		else
			local encounterId = pickEncounterId(inFinalStretch)
			encounters[encounterId](currentDist)
			local spacing = nextSpacing()
			if encounterHasTrap[encounterId] then
				spacing = math.max(spacing, ROOMA_TRAP_CLEARANCE)
			end
			tryPlaceDecor(currentDist + spacing * 0.5)
			currentDist = currentDist + spacing
		end
	end

	-- Exit dressing before the portcullis
	local exitDressDist = length - 22
	addCrackedFloorPatch(room, "CrackedFloorNearDoor", entrancePosition + fwd * exitDressDist, fwd, width - 4, 6)
	addRubblePile(room, "RubbleNearExit", entrancePosition + fwd * (exitDressDist + 6) + right * (width / 2 - 2.5), 6, 2.5)
	buildPortcullisDoor(room, "ExitPortcullis", entrancePosition + fwd * (length - 12), fwd, width - 1, height)
	addBrokenTorchMount(room, "BrokenTorch_2", leftWallOrigin + fwd * (length - 8), right, CONFIG.detail.torchHeight)
	addWallAlcove(room, "AlcoveNiche_Last", rightWallOrigin + fwd * (length - 3), -right, 2.4, 3.2, CONFIG.materials.wall, CONFIG.colors.wall)
	addDamagedArch(room, "DamagedArch_Last", leftWallOrigin + fwd * (length - 2), right, 4.2, height, CONFIG.materials.wall, CONFIG.colors.wall)
end

local function buildRoomA(root, entrancePosition, forward)
	local folder = newFolder(root, "RoomA_TrapCorridor")
	local markersFolder = newFolder(folder, "Markers")

	local width = CONFIG.roomA.width
	local height = CONFIG.roomA.height
	local length = CONFIG.roomA.length
	local wallThick = 2
	local fwd = unitXZ(forward)
	local right = getRight(fwd)

	-- Continuous, single-piece structural shell -- entrance to exit, no
	-- segment joins.
	addOrientedPart(folder, "Floor", Vector3.new(width, 1, length),
		entrancePosition + fwd * (length / 2) + Vector3.new(0, -0.5, 0), fwd, CONFIG.materials.floor, CONFIG.colors.floor)
	addOrientedPart(folder, "Ceiling", Vector3.new(width, 1, length),
		entrancePosition + fwd * (length / 2) + Vector3.new(0, height + 0.5, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wall)
	addOrientedPart(folder, "WallLeft", Vector3.new(wallThick, height, length),
		entrancePosition + fwd * (length / 2) - right * (width / 2) + Vector3.new(0, height / 2, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wall)
	addOrientedPart(folder, "WallRight", Vector3.new(wallThick, height, length),
		entrancePosition + fwd * (length / 2) + right * (width / 2) + Vector3.new(0, height / 2, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wall)

	buildDoorFrame(folder, "EntranceDoor", entrancePosition, fwd, width, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)

	local leftWallOrigin = entrancePosition - right * (width / 2)
	local rightWallOrigin = entrancePosition + right * (width / 2)

	addCorniceBand(folder, "WallLeft", leftWallOrigin, fwd, length, height, CONFIG.materials.trim, CONFIG.colors.trim)
	addCorniceBand(folder, "WallRight", rightWallOrigin, fwd, length, height, CONFIG.materials.trim, CONFIG.colors.trim)
	addBaseboardBand(folder, "WallLeft", leftWallOrigin, fwd, length, CONFIG.materials.trim, CONFIG.colors.trim)
	addBaseboardBand(folder, "WallRight", rightWallOrigin, fwd, length, CONFIG.materials.trim, CONFIG.colors.trim)
	layCeilingBeams(folder, "Beam", entrancePosition, fwd, width, height, 0, length, CONFIG.materials.wall, CONFIG.colors.wall)
	layWallTorches(folder, "TorchLeft", leftWallOrigin, fwd, right, 0, length)
	layWallTorches(folder, "TorchRight", rightWallOrigin, fwd, -right, 0, length)

	addPilaster(folder, "CornerEntranceLeft", leftWallOrigin, fwd, height, CONFIG.materials.wall, CONFIG.colors.wall)
	addPilaster(folder, "CornerEntranceRight", rightWallOrigin, fwd, height, CONFIG.materials.wall, CONFIG.colors.wall)
	addPilaster(folder, "CornerExitLeft", leftWallOrigin + fwd * length, fwd, height, CONFIG.materials.wall, CONFIG.colors.wall)
	addPilaster(folder, "CornerExitRight", rightWallOrigin + fwd * length, fwd, height, CONFIG.materials.wall, CONFIG.colors.wall)

	generateRoomAObstacleCourse(folder, entrancePosition, fwd, length, width, height)

	local exitPosition = entrancePosition + fwd * length

	addCheckpoint(markersFolder, "RoomA_Start", entrancePosition)
	addCheckpoint(markersFolder, "RoomA_End", exitPosition + fwd * 5)

	return folder, exitPosition
end

----------------------------------------------------------------------
-- ROOM B: COMBAT COURTYARD (chamfered corners, open-air)
----------------------------------------------------------------------

local function buildRoomB(root, entrancePosition, forward)
	local folder = newFolder(root, "RoomB_CombatCourtyard")
	local geomFolder = newFolder(folder, "Geometry")
	local arenaFolder = newFolder(folder, "Arena")
	local decFolder = newFolder(folder, "Decoration")
	local markersFolder = newFolder(folder, "Markers")

	local radius = CONFIG.roomB.radius
	local height = CONFIG.roomB.wallHeight
	local wallThick = 2
	local fwd = unitXZ(forward)
	local right = getRight(fwd)
	
	local center = entrancePosition + fwd * radius
	local bRng = Random.new(20260850)

	-- Floor
	local floorPart = newPart({
		Name = "Floor",
		Size = Vector3.new(1, radius * 2, radius * 2),
		CFrame = CFrame.new(center + Vector3.new(0, -0.5, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Shape = Enum.PartType.Cylinder,
		Material = CONFIG.materials.floor,
		Color = CONFIG.colors.floor,
		Parent = geomFolder
	})

	----------------------------------------------------------------------
	-- Octagonal walls (8 segments)
	----------------------------------------------------------------------
	local numSides = 8
	local angleStep = (math.pi * 2) / numSides
	local sideLength = 2 * radius * math.tan(math.pi / numSides)
	
	for i = 0, numSides - 1 do
		-- Start from South (Entrance, i=0)
		local angle = i * angleStep
		local wallNormal = (-fwd * math.cos(angle) + right * math.sin(angle)).Unit
		local wallCenter = center + wallNormal * radius
		local wallRight = getRight(wallNormal)
		local segName = "Wall_"..i
		
		-- Entrance and Exit gates
		if i == 0 then -- Entrance side
			local archW = 16
			local sidePieceL = (sideLength - archW) / 2
			addOrientedPart(geomFolder, segName.."L", Vector3.new(sidePieceL, height, wallThick), wallCenter - wallRight * (archW/2 + sidePieceL/2) + Vector3.new(0, height/2, 0), -wallNormal, CONFIG.materials.wall, CONFIG.colors.wall)
			addOrientedPart(geomFolder, segName.."R", Vector3.new(sidePieceL, height, wallThick), wallCenter + wallRight * (archW/2 + sidePieceL/2) + Vector3.new(0, height/2, 0), -wallNormal, CONFIG.materials.wall, CONFIG.colors.wall)
			buildAncientArch(geomFolder, "EntranceArch", wallCenter, -wallNormal, archW, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
		elseif i == 4 then -- Exit side (North)
			local archW = 16
			local sidePieceL = (sideLength - archW) / 2
			addOrientedPart(geomFolder, segName.."L", Vector3.new(sidePieceL, height, wallThick), wallCenter - wallRight * (archW/2 + sidePieceL/2) + Vector3.new(0, height/2, 0), -wallNormal, CONFIG.materials.wall, CONFIG.colors.wall)
			addOrientedPart(geomFolder, segName.."R", Vector3.new(sidePieceL, height, wallThick), wallCenter + wallRight * (archW/2 + sidePieceL/2) + Vector3.new(0, height/2, 0), -wallNormal, CONFIG.materials.wall, CONFIG.colors.wall)
			buildAncientArch(geomFolder, "ExitArch", wallCenter, -wallNormal, archW, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
		else
			-- Standard solid wall segment
			addOrientedPart(geomFolder, segName, Vector3.new(sideLength, height, wallThick), wallCenter + Vector3.new(0, height/2, 0), -wallNormal, CONFIG.materials.wall, CONFIG.colors.wall)
		end
		
		-- Trim
		addCorniceBand(decFolder, segName .. "_Cornice", wallCenter, -wallNormal, sideLength, height, CONFIG.materials.trim, CONFIG.colors.trim)
		addBaseboardBand(decFolder, segName .. "_Baseboard", wallCenter, -wallNormal, sideLength, CONFIG.materials.trim, CONFIG.colors.trim)

		-- Corner pillars
		local cornerAngle = angle + angleStep/2
		local cornerNormal = (-fwd * math.cos(cornerAngle) + right * math.sin(cornerAngle)).Unit
		local cornerDist = radius / math.cos(math.pi/numSides)
		local cornerPos = center + cornerNormal * cornerDist
		addPilaster(decFolder, "Pilaster_"..i, cornerPos, -cornerNormal, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
		
		-- Statues and water at the 4 diagonal corners (i = 1,3,5,7)
		if i % 2 == 1 then
			buildStatue(decFolder, "Statue_" .. i, cornerPos - cornerNormal * 2, -cornerNormal, 10, "standing")
			buildAncientArch(decFolder, "StatueFrame_" .. i, cornerPos - cornerNormal * 2.2, -cornerNormal, 6, 11, CONFIG.materials.wall, CONFIG.colors.ancientStone)
			
			-- Water channels along diagonal walls
			local chanW = CONFIG.roomB.waterChannelWidth
			local chanDepth = CONFIG.roomB.waterDepth
			local bThick = 1
			local chanPos = center + wallNormal * (radius - wallThick - chanW/2 - bThick)
			local cStart = chanPos - wallRight * (sideLength/2 - 4)
			buildWaterChannel(decFolder, "Water_"..i, cStart, wallRight, sideLength - 8, chanW, chanDepth)
			
			addOrientedPart(decFolder, "WaterBorderL_"..i, Vector3.new(bThick, 1.2, sideLength - 8), chanPos - wallNormal * (chanW/2 + bThick/2) + Vector3.new(0,-0.4,0), wallRight, CONFIG.materials.wall, CONFIG.colors.ancientStone)
			addOrientedPart(decFolder, "WaterBorderR_"..i, Vector3.new(bThick, 1.2, sideLength - 8), chanPos + wallNormal * (chanW/2 + bThick/2) + Vector3.new(0,-0.4,0), wallRight, CONFIG.materials.wall, CONFIG.colors.ancientStone)

			-- Algae along the channel -- Room B should read as overgrown near its water
			buildAlgaeCluster(decFolder, "WaterAlgae_"..i.."_A", cStart + wallRight * (sideLength * 0.2), wallRight, bRng, CONFIG.vegetation.density.roomB)
			buildAlgaeCluster(decFolder, "WaterAlgae_"..i.."_B", cStart + wallRight * (sideLength * 0.6), wallRight, bRng, CONFIG.vegetation.density.roomB)
		else
			if i ~= 0 and i ~= 4 then
				-- Torches on main walls
				addWallTorch(decFolder, segName .. "_Torch", wallCenter - wallNormal * (wallThick / 2), -wallNormal, CONFIG.detail.torchHeight)
			end
		end
	end

	----------------------------------------------------------------------
	-- Extra decoration (benches, rubble, moss)
	----------------------------------------------------------------------
	-- Benches around arena
	for i = 1, 4 do
		local angle = (i / 4) * math.pi * 2 + math.pi/4
		local bPos = center + Vector3.new(math.sin(angle), 0, math.cos(angle)) * 20
		local bDir = (center - bPos).Unit
		local bRight = getRight(bDir)
		-- Bench seat
		addOrientedPart(decFolder, "Bench_"..i, Vector3.new(6, 1.2, 2), bPos + Vector3.new(0, 0.6, 0), bDir, CONFIG.materials.wall, CONFIG.colors.ancientStone)
		-- Bench supports
		addOrientedPart(decFolder, "BenchSupport1_"..i, Vector3.new(1.5, 0.6, 2), bPos - bRight*2 + Vector3.new(0, 0.3, 0), bDir, CONFIG.materials.wall, CONFIG.colors.ancientStone)
		addOrientedPart(decFolder, "BenchSupport2_"..i, Vector3.new(1.5, 0.6, 2), bPos + bRight*2 + Vector3.new(0, 0.3, 0), bDir, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	end

	-- Moss on floor edges
	for i = 1, 6 do
		local angle = (i / 6) * math.pi * 2
		local mPos = center + Vector3.new(math.sin(angle), 0, math.cos(angle)) * (radius - 6)
		buildMossPatch(decFolder, "Moss_" .. i, mPos, fwd, 4, 4)
	end

	-- Rocks/broken stones distributed around the edges (never the clear
	-- central combat area) -- size, rotation and clustering all vary.
	for i = 1, 10 do
		local angle = bRng:NextNumber(0, math.pi * 2)
		local ringR = radius - bRng:NextNumber(3, 9)
		local rPos = center + Vector3.new(math.sin(angle), 0, math.cos(angle)) * ringR
		addRubblePile(decFolder, "EdgeRock_" .. i, rPos, bRng:NextInteger(3, 7), bRng:NextNumber(1.5, 4))
	end
	addRubblePile(decFolder, "Rubble_1", center - fwd * 15 - right * 15, 5, 3)
	addRubblePile(decFolder, "Rubble_2", center + fwd * 15 + right * 15, 4, 2.5)
	addRubblePile(decFolder, "Rubble_3", center - fwd * 18 + right * 15, 6, 4)

	----------------------------------------------------------------------
	-- Markers
	----------------------------------------------------------------------
	local exitPosition = entrancePosition + fwd * (radius * 2)
	addCheckpoint(markersFolder, "RoomB_Start", entrancePosition)
	addCheckpoint(markersFolder, "RoomB_End", exitPosition + fwd * 5)

	-- Golem: this is a pre-built 3D model, NOT generator geometry. The
	-- generator only builds the pedestal it stands on and a spawn marker;
	-- if a model matching CONFIG.roomB.golemModelName already exists in
	-- ServerStorage, it's cloned into place automatically. If not, the
	-- marker is still there for the encounter script to spawn into.
	local golemPedestal = newPart({
		Name = "GolemPedestal",
		Size = Vector3.new(CONFIG.roomB.golemPedestalRadius * 2, 1, CONFIG.roomB.golemPedestalRadius * 2),
		CFrame = CFrame.new(center - Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.pi/2),
		Shape = Enum.PartType.Cylinder,
		Material = CONFIG.materials.wall, Color = CONFIG.colors.ancientStone,
		Parent = arenaFolder
	})

	local spawnMarker = newPart({
		Name = "RoomB_GolemSpawn",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(center + Vector3.new(0, 2, 0)),
		Transparency = 1, CanCollide = false,
		Parent = markersFolder
	})

	spawnExternalModel(arenaFolder, CONFIG.roomB.golemStorageService, CONFIG.roomB.golemModelName, CFrame.new(center + Vector3.new(0, 1, 0)))

	local centerMarker = newPart({
		Name = "RoomB_ArenaCenter",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(center + Vector3.new(0, 0.5, 0)),
		Transparency = 1, CanCollide = false,
		Parent = markersFolder
	})

	return folder, exitPosition
end

