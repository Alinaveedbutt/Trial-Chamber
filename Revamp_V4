    newPart({Name="Cloth", Size=Vector3.new(width, height, 0.15), CFrame = cf * CFrame.new(0, -height/2, 0), Material = Enum.Material.Fabric, Color = CONFIG.colors.banner, CanCollide = false, Parent = model})
    newPart({Name="Emblem", Size=Vector3.new(width * 0.4, width * 0.4, 0.05), CFrame = cf * CFrame.new(0, -height * 0.32, 0.11), Material = Enum.Material.Neon, Color = CONFIG.colors.bannerTrim, CanCollide = false, Transparency = 0.15, Parent = model})
    return model
end

local function buildDoorFrame(parent, name, floorPosition, forward, width, height, material, color)
    local model = newFolder(parent, name)
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    
    local thick = 2
    local pPos1 = floorPosition - right * (width/2 + thick/2) + Vector3.new(0, height/2, 0)
    local pPos2 = floorPosition + right * (width/2 + thick/2) + Vector3.new(0, height/2, 0)
    
    addOrientedPart(model, "Jamb1", Vector3.new(thick, height, thick), pPos1, fwd, material, color)
    addOrientedPart(model, "Jamb2", Vector3.new(thick, height, thick), pPos2, fwd, material, color)
    
    local lintelPos = floorPosition + Vector3.new(0, height + thick/2, 0)
    addOrientedPart(model, "Lintel", Vector3.new(width + thick*2, thick, thick), lintelPos, fwd, material, color)
    
    return model
end

local function buildBarredGate(parent, name, floorPosition, forward, width, height)
    local model = buildDoorFrame(parent, name, floorPosition, forward, width, height, CONFIG.materials.metal, CONFIG.colors.metal)
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    
    local bars = 5
    for i=1, bars do
        local frac = i/(bars+1)
        local bx = -width/2 + width*frac
        local bPos = floorPosition + right * bx + Vector3.new(0, height/2, 0)
        addOrientedPart(model, "Bar_"..i, Vector3.new(0.4, height, 0.4), bPos, fwd, CONFIG.materials.metal, CONFIG.colors.metal)
    end
    
    local crossPos = floorPosition + Vector3.new(0, height*0.6, 0)
    addOrientedPart(model, "Crossbar", Vector3.new(width, 0.6, 0.6), crossPos, fwd, CONFIG.materials.metal, CONFIG.colors.metal)
    
    return model
end

local function buildSpikeTrap(parent, name, floorPosition, forward)
    -- Ported from the Room A reference draft: full mechanical detail --
    -- stone housing rings, carved corner stones, a geared medallion,
    -- guide rails, coiled springs, and genuinely tapering segmented
    -- spikes (stacked shrinking cylinders = a real point), instead of
    -- the earlier flat wedge-pair spikes. A transparent RootPart is the
    -- Model's PrimaryPart so buildCeilingSpike/buildWallSpike can
    -- rotate the whole assembly in place via PivotTo.
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    local t = CONFIG.spikeTrap
    local trap = Instance.new("Model")
    trap.Name = name
    trap.Parent = parent

    local rootPart = newPart({
        Name = "RootPart", Size = Vector3.new(1, 1, 1),
        CFrame = orientedCFrame(floorPosition, fwd),
        Transparency = 1, CanCollide = false, CanQuery = false,
        Parent = trap,
    })
    trap.PrimaryPart = rootPart

    ------------------------------------------------------------
    -- Stone housing
    ------------------------------------------------------------
    local lowOuterWidth = t.width + t.housingMargin * 2
    local lowOuterDepth = t.depth + t.housingMargin * 2
    local capOuterWidth = t.width + t.housingMargin
    local capOuterDepth = t.depth + t.housingMargin

    local function buildHousingRing(ringName, outerWidth, outerDepth, ringThickness, yCenter, ringHeight, material, color)
        addOrientedPart(trap, ringName.."_Front", Vector3.new(outerWidth, ringHeight, ringThickness),
            floorPosition + fwd * (outerDepth/2 - ringThickness/2) + Vector3.new(0, yCenter, 0), fwd, material, color)
        addOrientedPart(trap, ringName.."_Back", Vector3.new(outerWidth, ringHeight, ringThickness),
            floorPosition - fwd * (outerDepth/2 - ringThickness/2) + Vector3.new(0, yCenter, 0), fwd, material, color)
        addOrientedPart(trap, ringName.."_Left", Vector3.new(ringThickness, ringHeight, outerDepth - ringThickness*2),
            floorPosition - right * (outerWidth/2 - ringThickness/2) + Vector3.new(0, yCenter, 0), fwd, material, color)
        addOrientedPart(trap, ringName.."_Right", Vector3.new(ringThickness, ringHeight, outerDepth - ringThickness*2),
            floorPosition + right * (outerWidth/2 - ringThickness/2) + Vector3.new(0, yCenter, 0), fwd, material, color)
    end

    buildHousingRing("HousingLow", lowOuterWidth, lowOuterDepth, t.housingMargin*0.85,
        t.housingLowHeight/2, t.housingLowHeight, CONFIG.materials.wall, CONFIG.colors.ancientStone)
    buildHousingRing("HousingCap", capOuterWidth, capOuterDepth, t.housingMargin*0.6,
        t.housingLowHeight + t.housingCapHeight/2, t.housingCapHeight, CONFIG.materials.wall, CONFIG.colors.wall)

    local housingCorners = {
        floorPosition - right*(lowOuterWidth/2 - 0.9) - fwd*(lowOuterDepth/2 - 0.9),
        floorPosition + right*(lowOuterWidth/2 - 0.9) - fwd*(lowOuterDepth/2 - 0.9),
        floorPosition - right*(lowOuterWidth/2 - 0.9) + fwd*(lowOuterDepth/2 - 0.9),
        floorPosition + right*(lowOuterWidth/2 - 0.9) + fwd*(lowOuterDepth/2 - 0.9),
    }
    for index, cornerPos in ipairs(housingCorners) do
        newPart({
            Name = "HousingCornerStone_"..index,
            Size = Vector3.new(1.8, t.housingLowHeight + t.housingCapHeight + 0.3, 1.8),
            CFrame = CFrame.new(cornerPos + Vector3.new(0, (t.housingLowHeight + t.housingCapHeight)/2, 0)),
            Material = CONFIG.materials.wall, Color = CONFIG.colors.ancientStone, Parent = trap,
        })
    end

    local gearCenter = floorPosition + fwd*(lowOuterDepth/2 - t.housingMargin*0.425) + Vector3.new(0, t.housingLowHeight*0.55, 0)
    local gearAxis = horizontalAxisCFrame(gearCenter, fwd)
    newPart({Name="GearMedallion_Hub", Shape=Enum.PartType.Cylinder, Size=Vector3.new(0.3, 1.4, 1.4),
        CFrame=gearAxis, Material=CONFIG.materials.metal, Color=CONFIG.colors.metal, Parent=trap})
    for toothIndex = 0, 9 do
        local toothAngle = math.rad(toothIndex * 36)
        newPart({Name="GearMedallion_Tooth"..toothIndex, Size=Vector3.new(0.32, 0.4, 0.4),
            CFrame=gearAxis * CFrame.Angles(toothAngle, 0, 0) * CFrame.new(0, 0.85, 0),
            Material=CONFIG.materials.metal, Color=CONFIG.colors.metal, Parent=trap})
    end

    ------------------------------------------------------------
    -- Mechanism
    ------------------------------------------------------------
    newPart({Name="PitFloor", Size=Vector3.new(t.width, 0.4, t.depth),
        CFrame=orientedCFrame(floorPosition + Vector3.new(0, -t.pitDepth - 0.2, 0), fwd),
        Material=CONFIG.materials.spikeSteel, Color=CONFIG.colors.spikeSteel, Parent=trap})

    addOrientedPart(trap, "FrameFront", Vector3.new(t.width + t.frameThickness*2, 0.3, t.frameThickness),
        floorPosition + fwd*(t.depth/2 + t.frameThickness/2) + Vector3.new(0, 0.15, 0), fwd, CONFIG.materials.metal, CONFIG.colors.metal)
    addOrientedPart(trap, "FrameBack", Vector3.new(t.width + t.frameThickness*2, 0.3, t.frameThickness),
        floorPosition - fwd*(t.depth/2 + t.frameThickness/2) + Vector3.new(0, 0.15, 0), fwd, CONFIG.materials.metal, CONFIG.colors.metal)
    addOrientedPart(trap, "FrameLeft", Vector3.new(t.frameThickness, 0.3, t.depth),
        floorPosition - right*(t.width/2 + t.frameThickness/2) + Vector3.new(0, 0.15, 0), fwd, CONFIG.materials.metal, CONFIG.colors.metal)
    addOrientedPart(trap, "FrameRight", Vector3.new(t.frameThickness, 0.3, t.depth),
        floorPosition + right*(t.width/2 + t.frameThickness/2) + Vector3.new(0, 0.15, 0), fwd, CONFIG.materials.metal, CONFIG.colors.metal)

    local frameCorners = {
        floorPosition - right*(t.width/2 + t.frameThickness/2) - fwd*(t.depth/2 + t.frameThickness/2),
        floorPosition + right*(t.width/2 + t.frameThickness/2) - fwd*(t.depth/2 + t.frameThickness/2),
        floorPosition - right*(t.width/2 + t.frameThickness/2) + fwd*(t.depth/2 + t.frameThickness/2),
        floorPosition + right*(t.width/2 + t.frameThickness/2) + fwd*(t.depth/2 + t.frameThickness/2),
    }
    for index, cornerPos in ipairs(frameCorners) do
        newPart({Name="FrameBracket_"..index, Size=Vector3.new(0.75, 0.55, 0.75),
            CFrame=CFrame.new(cornerPos + Vector3.new(0, 0.3, 0)),
            Material=CONFIG.materials.metal, Color=CONFIG.colors.metal, Parent=trap})
        for boltIndex = 1, 2 do
            local boltRight = boltIndex == 1 and 0.22 or -0.22
            local boltForward = boltIndex == 1 and -0.22 or 0.22
            newPart({Name="FrameBolt_"..index.."_"..boltIndex, Shape=Enum.PartType.Cylinder, Size=Vector3.new(0.22, 0.24, 0.24),
                CFrame=CFrame.new(cornerPos + right*boltRight + fwd*boltForward + Vector3.new(0, 0.62, 0)) * CFrame.Angles(0, 0, math.rad(90)),
                Material=CONFIG.materials.metal, Color=CONFIG.colors.metal, Parent=trap})
        end
    end

    local railHeight = t.pitDepth + t.extendOffsetY + 0.6
    local railInset = 0.55
    local railCorners = {
        floorPosition - right*(t.width/2 - railInset) - fwd*(t.depth/2 - railInset),
        floorPosition + right*(t.width/2 - railInset) - fwd*(t.depth/2 - railInset),
        floorPosition - right*(t.width/2 - railInset) + fwd*(t.depth/2 - railInset),
        floorPosition + right*(t.width/2 - railInset) + fwd*(t.depth/2 - railInset),
    }
    for index, cornerPos in ipairs(railCorners) do
        newPart({Name="GuideRail_"..index, Shape=Enum.PartType.Cylinder, Size=Vector3.new(railHeight, 0.22, 0.22),
            CFrame=CFrame.new(cornerPos + Vector3.new(0, railHeight/2 - t.pitDepth, 0)) * CFrame.Angles(0, 0, math.rad(90)),
            Material=CONFIG.materials.metal, Color=CONFIG.colors.metal, Parent=trap})
    end

    local springInset = railInset + 0.85
    local springCorners = {
        floorPosition - right*(t.width/2 - springInset) - fwd*(t.depth/2 - springInset),
        floorPosition + right*(t.width/2 - springInset) - fwd*(t.depth/2 - springInset),
        floorPosition - right*(t.width/2 - springInset) + fwd*(t.depth/2 - springInset),
        floorPosition + right*(t.width/2 - springInset) + fwd*(t.depth/2 - springInset),
    }
    for cornerIndex, cornerPos in ipairs(springCorners) do
        for coil = 1, t.springCoils do
            local coilY = -t.pitDepth + 0.3 + (coil-1)*0.34
            newPart({Name="Spring_"..cornerIndex.."_Coil"..coil, Shape=Enum.PartType.Cylinder, Size=Vector3.new(0.16, 0.85, 0.85),
                CFrame=CFrame.new(cornerPos + Vector3.new(0, coilY, 0)) * CFrame.Angles(0, 0, math.rad(90)),
                Material=CONFIG.materials.metal, Color=CONFIG.colors.spring, Parent=trap})
        end
    end

    local supportY = -t.pitDepth - 0.05
    local diagLength = math.sqrt(t.width^2 + t.depth^2) * 0.88
    addOrientedPart(trap, "SupportBrace1", Vector3.new(diagLength, 0.3, 0.5), floorPosition + Vector3.new(0, supportY, 0), unitXZ(right + fwd), CONFIG.materials.metal, CONFIG.colors.metal)
    addOrientedPart(trap, "SupportBrace2", Vector3.new(diagLength, 0.3, 0.5), floorPosition + Vector3.new(0, supportY, 0), unitXZ(right - fwd), CONFIG.materials.metal, CONFIG.colors.metal)

    local plankSpan = (t.depth - t.plankGap*(t.plankCount-1)) / t.plankCount
    local plankOffsets = {}
    for plankIndex = 0, t.plankCount - 1 do
        local plankOffset = -t.depth/2 + plankSpan/2 + plankIndex*(plankSpan + t.plankGap)
        plankOffsets[plankIndex+1] = plankOffset
        addOrientedPart(trap, "Plank_"..(plankIndex+1), Vector3.new(t.width, 0.5, plankSpan), floorPosition + fwd*plankOffset, fwd, CONFIG.materials.wood, CONFIG.colors.wood)
    end

    ------------------------------------------------------------
    -- Moving spike bed -- tapering segmented spikes (stacked shrinking
    -- cylinders) instead of flat wedges: a genuinely pointed silhouette.
    ------------------------------------------------------------
    local spikeBed = Instance.new("Model")
    spikeBed.Name = "SpikeBed"
    spikeBed.Parent = trap

    local bedPlate = newPart({
        Name = "BedPlate", Size = Vector3.new(t.width - 1, 0.3, t.depth - 1),
        CFrame = orientedCFrame(floorPosition + Vector3.new(0, t.restOffsetY, 0), fwd),
        Material = CONFIG.materials.spikeSteel, Color = CONFIG.colors.spikeSteel, Parent = spikeBed,
    })
    spikeBed.PrimaryPart = bedPlate

    local colSpacing = t.width / (t.spikeCols + 1)
    for col = 1, t.spikeCols do
        local localRight = -t.width/2 + colSpacing*col
        for row = 1, #plankOffsets - 1 do
            local localForward = (plankOffsets[row] + plankOffsets[row+1]) / 2
            local spikeBase = floorPosition + right*localRight + fwd*localForward + Vector3.new(0, t.restOffsetY + 0.15, 0)
            local segHeight = t.spikeHeight / t.spikeSegments
            for seg = 1, t.spikeSegments do
                local segRadius = t.spikeBaseRadius * (1 - (seg-1)/t.spikeSegments)
                local nextRadius = t.spikeBaseRadius * (1 - seg/t.spikeSegments)
                local segRadiusAvg = math.max((segRadius + nextRadius)/2, 0.03)
                newPart({
                    Name = string.format("Spike_%d_%d_Seg%d", col, row, seg),
                    Shape = Enum.PartType.Cylinder,
                    Size = Vector3.new(segHeight + 0.06, segRadiusAvg*2, segRadiusAvg*2),
                    CFrame = CFrame.new(spikeBase + Vector3.new(0, segHeight*(seg-0.5), 0)) * CFrame.Angles(0, 0, math.rad(90)),
                    Material = CONFIG.materials.spikeSteel, Color = CONFIG.colors.spikeSteel, Parent = spikeBed,
                })
            end
        end
    end

    trap:SetAttribute("Kind", "SpikeTrap")
    trap:SetAttribute("CycleSeconds", t.cycleSeconds)
    trap:SetAttribute("Damage", t.damage)
    trap:SetAttribute("RestOffsetY", t.restOffsetY)
    trap:SetAttribute("ExtendOffsetY", t.extendOffsetY)
    CollectionService:AddTag(trap, "SpikeTrap")

    return trap
end

----------------------------------------------------------------------
-- CEILING / WALL SPIKE VARIANTS
----------------------------------------------------------------------
-- Same trap, rotated in place around its own RootPart pivot -- 180 deg
-- for a ceiling-mounted trap (spikes hang down), +/-90 deg for a wall-
-- mounted trap (spikes point sideways into the corridor).
local function buildCeilingSpike(parent, name, centerPosition, forward)
    local trap = buildSpikeTrap(parent, name, centerPosition, forward)
    trap:PivotTo(trap:GetPivot() * CFrame.Angles(0, 0, math.pi))
    return trap
end

local function buildWallSpike(parent, name, centerPosition, forward, isRightWall)
    local trap = buildSpikeTrap(parent, name, centerPosition, forward)
    local angle = isRightWall and (math.pi/2) or (-math.pi/2)
    trap:PivotTo(trap:GetPivot() * CFrame.Angles(0, 0, angle))
    return trap
end

local function buildSwingingBlade(parent, name, pivotPosition, forward)
    -- Ported from the Room A reference draft: separate ceiling support
    -- posts + mount plates, a visible chain link run down to the pivot,
    -- a ball pivot hub, and a counterweight arm opposite the blade --
    -- reads as a real mechanical assembly, not a disc on a stick.
    local b = CONFIG.swingingBlade
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    local blade = Instance.new("Model")
    blade.Name = name
    blade.Parent = parent

    local postForwardOffset = b.axleLength / 2
    for _, side in ipairs({-1, 1}) do
        local postTop = pivotPosition + fwd * (postForwardOffset * side) + Vector3.new(0, b.mountDrop, 0)
        local postBottom = pivotPosition + fwd * (postForwardOffset * side)
        newPart({
            Name = "SupportPost_" .. (side > 0 and "Front" or "Back"),
            Size = Vector3.new(0.55, b.mountDrop, 0.55),
            CFrame = CFrame.new((postTop + postBottom) / 2),
            Material = CONFIG.materials.metal, Color = CONFIG.colors.metal, Parent = blade,
        })
        newPart({
            Name = "MountPlate_" .. (side > 0 and "Front" or "Back"),
            Size = Vector3.new(1.1, 0.3, 1.1),
            CFrame = CFrame.new(postTop + Vector3.new(0, -0.1, 0)),
            Material = CONFIG.materials.metal, Color = CONFIG.colors.metal, Parent = blade,
        })
    end

    newPart({
        Name = "Axle", Shape = Enum.PartType.Cylinder, Size = Vector3.new(b.axleLength + 0.6, 0.3, 0.3),
        CFrame = horizontalAxisCFrame(pivotPosition, fwd),
        Material = CONFIG.materials.metal, Color = CONFIG.colors.metal, Parent = blade,
    })

    for linkIndex = 1, b.chainLinks do
        local linkY = pivotPosition.Y + 0.5 + (linkIndex - 1) * 0.55
        newPart({
            Name = "ChainLink_" .. linkIndex,
            Size = linkIndex % 2 == 0 and Vector3.new(0.55, 0.5, 0.22) or Vector3.new(0.22, 0.5, 0.55),
            CFrame = CFrame.new(pivotPosition.X, linkY, pivotPosition.Z),
            Material = CONFIG.materials.metal, Color = CONFIG.colors.metal, Parent = blade,
        })
    end

    local pivot = Instance.new("Model")
    pivot.Name = "Pivot"
    pivot.Parent = blade

    local pivotHub = newPart({
        Name = "PivotHub", Shape = Enum.PartType.Ball, Size = Vector3.new(1.1, 1.1, 1.1),
        CFrame = CFrame.new(pivotPosition), Material = CONFIG.materials.metal, Color = CONFIG.colors.metal, Parent = pivot,
    })
    pivot.PrimaryPart = pivotHub

    local bladeCenter = pivotPosition - Vector3.new(0, b.armLength, 0)
    newPart({
        Name = "Arm", Size = Vector3.new(0.4, b.armLength, 0.4),
        CFrame = CFrame.new((pivotPosition + bladeCenter) / 2),
        Material = CONFIG.materials.metal, Color = CONFIG.colors.metal, Parent = pivot,
    })

    local bladeAxis = horizontalAxisCFrame(bladeCenter, fwd)
    newPart({
        Name = "BladeHub", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.65, 1.7, 1.7),
        CFrame = bladeAxis, Material = CONFIG.materials.metal, Color = CONFIG.colors.metal, Parent = pivot,
    })
    newPart({
        Name = "BladeDisc", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.35, b.bladeRadius*2, b.bladeRadius*2),
        CFrame = bladeAxis, Material = CONFIG.materials.spikeSteel, Color = CONFIG.colors.spikeSteel, Parent = pivot,
    })
    for toothIndex = 0, 15 do
        local toothAngle = math.rad(toothIndex * 22.5)
        newPart({
            Name = "BladeTooth_" .. toothIndex, Size = Vector3.new(0.3, 0.5, 0.42),
            CFrame = bladeAxis * CFrame.Angles(toothAngle, 0, 0) * CFrame.new(0, b.bladeRadius - 0.1, 0),
            Material = CONFIG.materials.spikeSteel, Color = CONFIG.colors.spikeSteel, Parent = pivot,
        })
    end

    local counterCenter = pivotPosition + Vector3.new(0, b.counterArmLength, 0)
    newPart({
        Name = "CounterArm", Size = Vector3.new(0.32, b.counterArmLength, 0.32),
        CFrame = CFrame.new((pivotPosition + counterCenter) / 2),
        Material = CONFIG.materials.metal, Color = CONFIG.colors.metal, Parent = pivot,
    })
    newPart({
        Name = "Counterweight", Shape = Enum.PartType.Ball,
        Size = Vector3.new(b.counterweightRadius*2, b.counterweightRadius*2, b.counterweightRadius*2),
        CFrame = CFrame.new(counterCenter), Material = CONFIG.materials.spikeSteel, Color = CONFIG.colors.counterweight, Parent = pivot,
    })

    blade:SetAttribute("Kind", "SwingingBlade")
    blade:SetAttribute("SwingAxis", fwd)
    blade:SetAttribute("SwingDegrees", b.swingDegrees)
    blade:SetAttribute("PeriodSeconds", b.periodSeconds)
    blade:SetAttribute("Damage", b.damage)
    CollectionService:AddTag(blade, "SwingingBlade")

    return blade
end

local function buildPortcullisDoor(parent, name, floorPosition, forward, doorWidth, roomHeight)
    -- Ported from the Room A reference draft: real jambs + metal tracks,
    -- a heavy lintel, counterweight housings with visible weights, and a
    -- leaf built from tapering spiked vertical bars + horizontal
    -- crossbars, hanging open near the ceiling by default.
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    local d = CONFIG.portcullis
    local assembly = newFolder(parent, name)
    local trackInset = doorWidth / 2 + 0.5
    local trackHeight = roomHeight - 0.5

    for _, side in ipairs({-1, 1}) do
        local sideName = side < 0 and "Left" or "Right"
        addOrientedPart(assembly, "Jamb"..sideName, Vector3.new(1.6, trackHeight, 2.2),
            floorPosition + right * (trackInset * side) + Vector3.new(0, trackHeight/2, 0), fwd, CONFIG.materials.wall, CONFIG.colors.ancientStone)
        addOrientedPart(assembly, "Track"..sideName, Vector3.new(0.4, trackHeight, 0.6),
            floorPosition + right * ((trackInset - 0.9) * side) + Vector3.new(0, trackHeight/2, 0), fwd, CONFIG.materials.metal, CONFIG.colors.metal)
    end

    addOrientedPart(assembly, "Lintel", Vector3.new(doorWidth + 3.6, 2.2, 2.6),
        floorPosition + Vector3.new(0, roomHeight - 1.1, 0), fwd, CONFIG.materials.wall, CONFIG.colors.ancientStone)

    for _, side in ipairs({-1, 1}) do
        local sideName = side < 0 and "Left" or "Right"
        local housingCenter = floorPosition + right * (trackInset * side) + Vector3.new(0, roomHeight - 2.0, 0)
        addOrientedPart(assembly, "CounterHousing"..sideName, Vector3.new(1.9, 2.6, 2.4), housingCenter, fwd, CONFIG.materials.wall, CONFIG.colors.wall)
        newPart({
            Name = "CounterWeight"..sideName, Size = Vector3.new(1.0, 1.0, 1.0),
            CFrame = CFrame.new(housingCenter + Vector3.new(0, -0.4, 0)),
            Material = CONFIG.materials.spikeSteel, Color = CONFIG.colors.counterweight, Parent = assembly,
        })
    end

    local leaf = Instance.new("Model")
    leaf.Name = "Leaf"
    leaf.Parent = assembly

    local leafHeight = roomHeight * d.leafHeightRatio
    local leafWidth = doorWidth - 0.6
    local openCenterY = roomHeight - leafHeight/2 - 0.4
    local closedCenterY = leafHeight/2 + 0.1
    local leafCenter = floorPosition + Vector3.new(0, openCenterY, 0)

    local barSpacing = leafWidth / (d.verticalBars + 1)
    local primaryBar = nil
    for barIndex = 1, d.verticalBars do
        local barRight = -leafWidth/2 + barSpacing * barIndex
        local bar = addOrientedPart(leaf, "VerticalBar_"..barIndex, Vector3.new(0.4, leafHeight - 0.8, 0.4),
            leafCenter + right * barRight + Vector3.new(0, -0.4, 0), fwd, CONFIG.materials.metal, CONFIG.colors.metal)
        primaryBar = primaryBar or bar

        local segHeight = 0.9 / 3
        for seg = 1, 3 do
            local segRadiusAvg = math.max(0.24 * (1 - (seg-1)/3), 0.03)
            newPart({
                Name = string.format("BarSpike_%d_%d", barIndex, seg),
                Shape = Enum.PartType.Cylinder, Size = Vector3.new(segHeight + 0.05, segRadiusAvg*2, segRadiusAvg*2),
                CFrame = CFrame.new(leafCenter + right * barRight + Vector3.new(0, -leafHeight/2 + segHeight*(seg-0.5), 0)) * CFrame.Angles(0, 0, math.rad(90)),
                Material = CONFIG.materials.spikeSteel, Color = CONFIG.colors.spikeSteel, Parent = leaf,
            })
        end
    end

    for crossIndex = 1, d.horizontalBars do
        local crossY = -leafHeight/2 + (leafHeight / (d.horizontalBars + 1)) * crossIndex
        addOrientedPart(leaf, "CrossBar_"..crossIndex, Vector3.new(leafWidth, 0.35, 0.35),
            leafCenter + Vector3.new(0, crossY, 0), fwd, CONFIG.materials.metal, CONFIG.colors.metal)
    end

    leaf.PrimaryPart = primaryBar

    assembly:SetAttribute("Kind", "SealingDoor")
    assembly:SetAttribute("OpenOffsetY", openCenterY)
    assembly:SetAttribute("ClosedOffsetY", closedCenterY)
    assembly:SetAttribute("TriggerType", "CrossDistance")
    CollectionService:AddTag(assembly, "SealingDoor")

    return assembly
end

local function addCollapsedMasonry(parent, name, centerPosition, chunkCount, spreadRadius)
    local model = newFolder(parent, name)
    for i=1, chunkCount do
        local size = Vector3.new(random:NextNumber(2, 4), random:NextNumber(1, 2.5), random:NextNumber(2, 4))
        local rx = random:NextNumber(-spreadRadius, spreadRadius)
        local rz = random:NextNumber(-spreadRadius, spreadRadius)
        local pos = centerPosition + Vector3.new(rx, size.Y/2, rz)
        newPart({
            Name = "Block_"..i,
            Size = size,
            CFrame = CFrame.new(pos) * CFrame.Angles(random:NextNumber(-0.2,0.2), random:NextNumber(0, math.pi*2), random:NextNumber(-0.2,0.2)),
            Material = CONFIG.materials.wall,
            Color = CONFIG.colors.ancientStone,
            Parent = model
        })
    end
    return model
end

local function addBrokenSupport(parent, name, basePosition, forward, fullHeight, breakHeight)
    local model = newFolder(parent, name)
    local w = 2.5
    local pos1 = basePosition + Vector3.new(0, breakHeight/2, 0)
    addOrientedPart(model, "Stub", Vector3.new(w, breakHeight, w), pos1, forward, CONFIG.materials.wall, CONFIG.colors.ancientStone)
    
    local rem = fullHeight - breakHeight
    local fwd = unitXZ(forward)
    local pos2 = basePosition + fwd * (rem/2 + 2) + Vector3.new(0, w/2, 0)
    local fallen = addOrientedPart(model, "Fallen", Vector3.new(w, rem, w), pos2, forward, CONFIG.materials.wall, CONFIG.colors.ancientStone)
    fallen.CFrame = fallen.CFrame * CFrame.Angles(math.pi/2, random:NextNumber(-0.3,0.3), 0)
    
    return model
end

local function addCrackedFloorPatch(parent, name, centerPosition, forward, patchWidth, patchDepth)
    local model = newFolder(parent, name)
    local fwd = unitXZ(forward)
    local cf = orientedCFrame(centerPosition, fwd)
    
    local base = newPart({
        Name = "PatchBase",
        Size = Vector3.new(patchWidth, 0.2, patchDepth),
        CFrame = cf * CFrame.new(0, 0.1, 0),
        Material = CONFIG.materials.floor,
        Color = CONFIG.colors.floor,
        Parent = model
    })
    
    for i=1, 6 do
        local cw = random:NextNumber(patchWidth*0.1, patchWidth*0.3)
        local cd = random:NextNumber(patchDepth*0.1, patchDepth*0.3)
        local cx = random:NextNumber(-patchWidth/2 + cw/2, patchWidth/2 - cw/2)
        local cz = random:NextNumber(-patchDepth/2 + cd/2, patchDepth/2 - cd/2)
        newPart({
            Name = "Chip_"..i,
            Size = Vector3.new(cw, 0.25, cd),
            CFrame = cf * CFrame.new(cx, 0.15, cz) * CFrame.Angles(0, random:NextNumber(0, math.pi*2), 0),
            Material = CONFIG.materials.rubble,
            Color = CONFIG.colors.crack,
            Parent = model
        })
    end
    
    return model
end

local function addWarningCarving(parent, name, wallFloorPosition, forward, mountHeight)
    local model = newFolder(parent, name)
    local fwd = unitXZ(forward)
    local pos = wallFloorPosition + Vector3.new(0, mountHeight, 0)
    
    local panel = addOrientedPart(model, "Panel", Vector3.new(4, 4, 0.5), pos, fwd, CONFIG.materials.wall, CONFIG.colors.danger)
    
    for i=1, 3 do
        local sx = random:NextNumber(-1, 1)
        local sy = random:NextNumber(-1, 1)
        addOrientedPart(model, "Glyph_"..i, Vector3.new(0.5, 0.1, 0.6), pos + fwd*0.1 + Vector3.new(sx, sy, 0), fwd, CONFIG.materials.neon, CONFIG.colors.danger)
    end
    
    return model
end

