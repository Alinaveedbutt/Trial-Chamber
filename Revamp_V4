----------------------------------------------------------------------
-- FLOOR MASONRY (large slab + border strip)
----------------------------------------------------------------------
-- A coherent stone floor reads as one large slab bordered by a trim
-- strip along its edges -- NOT a noisy checkerboard, and not a single
-- featureless plane either. Kept to 3 parts so it stays cheap even
-- called once per architectural bay.
local function buildFloorMasonry(parent, name, centerPosition, forward, width, length, material, color, borderColor)
    local model = newFolder(parent, name)
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    addOrientedPart(model, "Slab", Vector3.new(width, 1, length), centerPosition + Vector3.new(0, -0.5, 0), fwd, material, color)
    local borderW = 0.5
    addOrientedPart(model, "BorderL", Vector3.new(borderW, 0.06, length), centerPosition - right * (width/2 - borderW/2) + Vector3.new(0, 0.03, 0), fwd, material, borderColor, {CanCollide = false})
    addOrientedPart(model, "BorderR", Vector3.new(borderW, 0.06, length), centerPosition + right * (width/2 - borderW/2) + Vector3.new(0, 0.03, 0), fwd, material, borderColor, {CanCollide = false})
    return model
end

local function buildAncientArch(parent, name, floorPosition, forward, width, height, material, color)
    local model = newFolder(parent, name)
    local right = getRight(forward)
    local colW = 2
    local colPos1 = floorPosition + right * (width/2)
    local colPos2 = floorPosition - right * (width/2)
    
    addOrientedPart(model, "Pillar1", Vector3.new(colW, height, colW), colPos1 + Vector3.new(0, height/2, 0), forward, material, color)
    addOrientedPart(model, "Pillar2", Vector3.new(colW, height, colW), colPos2 + Vector3.new(0, height/2, 0), forward, material, color)
    
    local archHeight = 3
    local lintelPos = floorPosition + Vector3.new(0, height + archHeight/2, 0)
    addOrientedPart(model, "Lintel", Vector3.new(width + colW, archHeight, colW), lintelPos, forward, material, color)
    return model
end

local function buildStonePillar(parent, name, basePosition, height, radius, material, color, broken)
    local model = newFolder(parent, name)
    local finalHeight = height
    if broken then
        finalHeight = random:NextNumber(height*0.2, height*0.7)
    end
    
    local pos = basePosition + Vector3.new(0, finalHeight/2, 0)
    local part = newPart({
        Name = "PillarBase",
        Size = Vector3.new(radius*2, finalHeight, radius*2),
        CFrame = CFrame.new(pos),
        Shape = Enum.PartType.Cylinder,
        Material = material,
        Color = color,
        Parent = model
    })
    
    if broken then
        addRubblePile(model, "PillarRubble", basePosition, math.floor(radius*4), radius*1.5)
    end
    
    return model
end

