----------------------------------------------------------------------
-- CEILING SUPPORT BEAM (beam + corbels bridging down to the walls)
----------------------------------------------------------------------
-- A plain beam floating under a flat ceiling reads as decoration. Two
-- small corbel brackets at the beam's ends, sitting where the beam
-- meets the wall tops, is what makes "the ceiling relates to the
-- walls" instead of the walls and ceiling looking independently built.
local function buildCeilingSupportBeam(parent, name, centerPosition, spanAxis, span, ceilingHeight, beamMaterial, beamColor, corbelMaterial, corbelColor)
    local model = newFolder(parent, name)
    addCeilingBeam(model, "Beam", centerPosition, spanAxis, span, ceilingHeight, beamMaterial, beamColor)
    local axis = unitXZ(spanAxis)
    local corbelY = ceilingHeight - CONFIG.detail.beamDrop - CONFIG.detail.beamThickness/2 - 0.6
    for _, sign in ipairs({1, -1}) do
        local cPos = centerPosition + axis * (sign * (span/2 - 0.6)) + Vector3.new(0, corbelY, 0)
        addOrientedPart(model, sign > 0 and "CorbelA" or "CorbelB", Vector3.new(1.4, 1.2, 1.4), cPos, axis, corbelMaterial, corbelColor)
    end
    return model
end

local function layCeilingBeams(parent, namePrefix, originPosition, forward, span, ceilingHeight, startDistance, endDistance, material, color)
    local dist = startDistance
    local i = 1
    local right = getRight(forward)
    while dist <= endDistance do
        local pos = originPosition + forward * dist
        addCeilingBeam(parent, namePrefix .. "_" .. i, pos, right, span, ceilingHeight, material, color)
        dist = dist + CONFIG.detail.beamSpacing
        i = i + 1
    end
end

local function addWallTorch(parent, name, floorPosition, forward, mountHeight)
    local model = newFolder(parent, name)
    local fwd = unitXZ(forward)
    local pos = floorPosition + Vector3.new(0, mountHeight, 0)
    
    addOrientedPart(model, "Bracket", Vector3.new(0.5, 0.5, 1.2), pos + fwd*0.6, fwd, CONFIG.materials.metal, CONFIG.colors.metal)
    addOrientedPart(model, "Stick", Vector3.new(0.3, 2, 0.3), pos + fwd*1.0 + Vector3.new(0,0.5,0), fwd, CONFIG.materials.torchWood, CONFIG.colors.torchWood)
    
    local flame = addOrientedPart(model, "Flame", Vector3.new(0.4, 0.6, 0.4), pos + fwd*1.0 + Vector3.new(0,1.7,0), fwd, CONFIG.materials.neon, CONFIG.colors.torch, {CanCollide=false, CanQuery=false})
    addGlow(flame, CONFIG.colors.torch, CONFIG.lighting.torchRange, CONFIG.lighting.torchBrightness)
    
    return model
end

local function layWallTorches(parent, namePrefix, wallOriginPosition, travelForward, faceDirection, startDistance, endDistance)
    local dist = startDistance
    local i = 1
    while dist <= endDistance do
        local pos = wallOriginPosition + travelForward * dist
        addWallTorch(parent, namePrefix .. "_" .. i, pos, faceDirection, CONFIG.detail.torchHeight)
        dist = dist + CONFIG.detail.torchSpacing
        i = i + 1
    end
end

local function addRubblePile(parent, name, centerPosition, chunkCount, spreadRadius)
    local model = newFolder(parent, name)
    for i=1, chunkCount do
        local size = Vector3.new(random:NextNumber(0.5,2), random:NextNumber(0.5,2), random:NextNumber(0.5,2))
        local offX = random:NextNumber(-spreadRadius, spreadRadius)
        local offZ = random:NextNumber(-spreadRadius, spreadRadius)
        local offY = size.Y/2
        local pos = centerPosition + Vector3.new(offX, offY, offZ)
        local part = newPart({
            Name = "Chunk_"..i,
            Size = size,
            CFrame = CFrame.new(pos) * CFrame.Angles(random:NextNumber(0,math.pi*2), random:NextNumber(0,math.pi*2), random:NextNumber(0,math.pi*2)),
            Material = CONFIG.materials.rubble,
            Color = CONFIG.colors.rubble,
            Parent = model
        })
    end
    return model
end

