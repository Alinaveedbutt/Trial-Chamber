}

local function buildStatue(parent, name, basePosition, forward, height, pose)
    local model = newFolder(parent, name)
    local mat = CONFIG.materials.wall
    local col = CONFIG.colors.statue
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    local pd = STATUE_POSES[pose] or STATUE_POSES.standing
    
    local pedH = height * 0.15
    addOrientedPart(model, "Pedestal", Vector3.new(height*0.4, pedH, height*0.4), basePosition + Vector3.new(0, pedH/2, 0), fwd, mat, col)
    
    local legH = height * 0.35 * pd.legScale
    local torsoH = height * 0.35
    local headS = height * 0.15
    local legW = height * 0.15
    
    local legPosY = basePosition.Y + pedH + legH/2
    local lLegPos = Vector3.new(basePosition.X, legPosY, basePosition.Z) - right*(legW/2)
    local rLegPos = Vector3.new(basePosition.X, legPosY, basePosition.Z) + right*(legW/2)
    
    addOrientedPart(model, "LeftLeg", Vector3.new(legW*0.8, legH, legW*0.8), lLegPos, fwd, mat, col)
    addOrientedPart(model, "RightLeg", Vector3.new(legW*0.8, legH, legW*0.8), rLegPos, fwd, mat, col)
    
    local torsoPos = basePosition + Vector3.new(0, pedH + legH + torsoH/2, 0)
    addOrientedPart(model, "Torso", Vector3.new(height*0.35, torsoH, height*0.2), torsoPos, fwd, mat, col)
    
    local headPos = basePosition + Vector3.new(0, pedH + legH + torsoH + headS/2, 0)
    addOrientedPart(model, "Head", Vector3.new(headS, headS, headS), headPos, fwd, mat, col)
    
    local armW = height * 0.1
    local armL = height * 0.35
    local lArmPos = torsoPos - right*(height*0.25)
    local rArmPos = torsoPos + right*(height*0.25)
    
    local armPitch = pd.armPitch
    
    local lArmCF = orientedCFrame(lArmPos, fwd) * CFrame.Angles(armPitch, 0, 0) * CFrame.new(0, -armL/2, 0)
    local lArm = newPart({Name="LeftArm", Size=Vector3.new(armW, armL, armW), CFrame=lArmCF, Material=mat, Color=col, Parent=model})
    
    local rArmCF = orientedCFrame(rArmPos, fwd) * CFrame.Angles(armPitch, 0, 0) * CFrame.new(0, -armL/2, 0)
    local rArm = newPart({Name="RightArm", Size=Vector3.new(armW, armL, armW), CFrame=rArmCF, Material=mat, Color=col, Parent=model})
    
    return model
end

local function buildChainSegment(parent, name, topPosition, bottomPosition, linkCount)
    local model = newFolder(parent, name)
    local diff = bottomPosition - topPosition
    local len = diff.Magnitude
    local fwd = unitXZ(diff)
    if fwd.Magnitude < 0.001 then fwd = Vector3.new(1,0,0) end
    
    local step = len / linkCount
    local size = CONFIG.roomD.chainLinkSize
    
    for i=1, linkCount do
        local fraction = (i - 0.5) / linkCount
        local pos = topPosition + diff * fraction
        local orient = CFrame.new(pos, pos + diff)
        if i % 2 == 0 then
            orient = orient * CFrame.Angles(0, 0, math.pi/2)
        end
        newPart({
            Name = "Link_"..i,
            Size = size,
            CFrame = orient,
            Material = CONFIG.materials.metal,
            Color = CONFIG.colors.chainMetal,
            Parent = model
        })
    end
    
    return model
end

local function buildParkourPlatform(parent, name, position, forward, width, depth, material, color)
    local minW = CONFIG.roomD.parkour.minLandingSize
    local finalW = math.max(width, minW)
    local finalD = math.max(depth, minW)
    return addOrientedPart(parent, name, Vector3.new(finalW, 1, finalD), position - Vector3.new(0, 0.5, 0), forward, material, color)
end

local function buildBrokenBridge(parent, name, startPosition, endPosition, forward, bridgeWidth, intact)
    local model = newFolder(parent, name)
    local diff = endPosition - startPosition
    local dist = diff.Magnitude
    local fwd = unitXZ(diff)
    local thick = 1.5
    
    if intact then
        local pos = startPosition + diff/2 - Vector3.new(0, thick/2, 0)
        addOrientedPart(model, "Span", Vector3.new(bridgeWidth, thick, dist), pos, fwd, CONFIG.materials.wall, CONFIG.colors.ancientStone)
    else
        local span1 = dist * 0.3
        local span2 = dist * 0.25
        
        local pos1 = startPosition + fwd*(span1/2) - Vector3.new(0, thick/2, 0)
        addOrientedPart(model, "Span1", Vector3.new(bridgeWidth, thick, span1), pos1, fwd, CONFIG.materials.wall, CONFIG.colors.ancientStone)
        
        local pos2 = endPosition - fwd*(span2/2) - Vector3.new(0, thick/2, 0)
        addOrientedPart(model, "Span2", Vector3.new(bridgeWidth, thick, span2), pos2, fwd, CONFIG.materials.wall, CONFIG.colors.ancientStone)
        
        addRubblePile(model, "BridgeRubble", startPosition + fwd*span1 - Vector3.new(0, thick, 0), 6, bridgeWidth/2)
        addRubblePile(model, "BridgeRubble2", endPosition - fwd*span2 - Vector3.new(0, thick, 0), 4, bridgeWidth/2)
    end
    
    return model
end

local function buildSunlightShaft(parent, name, topPosition, beamWidth, beamHeight)
    -- NOTE: this used to be a single fat, near-white, low-transparency
    -- Neon cylinder -- which is exactly the "white cylindrical object"
    -- bug reported in Room A. A visible light shaft needs two different
    -- things, not one geometric primitive: (1) a small bright patch AT
    -- the actual roof/wall opening that explains where the light enters,
    -- and (2) a thin, heavily transparent, warm-toned haze beneath it.
    -- The actual illumination comes from the SpotLight, not the geometry.
    local model = newFolder(parent, name)
    local pos = topPosition - Vector3.new(0, beamHeight/2, 0)
    local dustColor = CONFIG.colors.skyLight:Lerp(CONFIG.colors.torch, 0.35)

    local beam = newPart({
        Name = "DustHaze",
        Size = Vector3.new(beamWidth * 0.4, beamHeight, beamWidth * 0.4),
        CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi/2),
        Shape = Enum.PartType.Cylinder,
        Material = Enum.Material.Neon,
        Color = dustColor,
        Transparency = 0.94,
        CanCollide = false,
        CanQuery = false,
        Parent = model
    })

    local opening = newPart({
        Name = "SkyOpening",
        Size = Vector3.new(0.15, beamWidth * 0.55, beamWidth * 0.55),
        CFrame = CFrame.new(topPosition) * CFrame.Angles(0, 0, math.pi/2),
        Shape = Enum.PartType.Cylinder,
        Material = Enum.Material.Neon,
        Color = dustColor,
        Transparency = 0.25,
        CanCollide = false,
        CanQuery = false,
        Parent = model
    })

    local light = Instance.new("SpotLight")
    light.Color = CONFIG.colors.skyLight
    light.Range = beamHeight * 1.5
    light.Brightness = CONFIG.lighting.sunlightBrightness
    light.Angle = 45
    light.Face = Enum.NormalId.Bottom
    light.Parent = opening
    
    return model
end

local function buildDragonMural(parent, name, wallPosition, forward, width, height)
