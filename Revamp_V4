----------------------------------------------------------------------
-- VEGETATION: reusable algae/moss/vine clustering
----------------------------------------------------------------------
-- Scatters a small cluster of moss patches (varied size/rotation) plus
-- an optional hanging vine around a point, so vegetation reads as
-- naturally distributed growth instead of identical green rectangles
-- dropped on a grid. Every room calls this rather than hand-rolling
-- its own moss loop.
local function buildAlgaeCluster(parent, name, position, forward, rng, densityScale)
    rng = rng or random
    densityScale = densityScale or 1.0
    local model = newFolder(parent, name)
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    local vconf = CONFIG.vegetation

    local count = math.max(1, math.floor(rng:NextInteger(vconf.clusterMossCount[1], vconf.clusterMossCount[2]) * densityScale + 0.5))
    for i = 1, count do
        local jitter = right * rng:NextNumber(-2.5, 2.5) + fwd * rng:NextNumber(-2.5, 2.5)
        local w = rng:NextNumber(vconf.mossSizeMin, vconf.mossSizeMax)
        local d = rng:NextNumber(vconf.mossSizeMin, vconf.mossSizeMax)
        local patchFwd = (fwd * math.cos(rng:NextNumber(0, math.pi*2)) + right * math.sin(rng:NextNumber(0, math.pi*2)))
        buildMossPatch(model, "Moss_"..i, position + jitter + Vector3.new(0, 0.05, 0), patchFwd, w, d)
    end

    if rng:NextNumber() < vconf.clusterVineChance * densityScale then
        buildVineStrip(model, "Vine", position + Vector3.new(0, rng:NextNumber(2, 6), 0), rng:NextNumber(3, 9))
    end

    return model
end

----------------------------------------------------------------------
-- WALL NICHE / ALCOVE (architecture-first dressing for A / B / D)
----------------------------------------------------------------------
-- A genuine recessed alcove built INTO an already-flush wall face: side
-- returns bridge the flush face back to a shadowed recessed panel, with
-- a header lintel and sill at the wall plane. This replaces the old
-- trick of literally widening the whole corridor to fake a "recess" --
-- that read as the hallway randomly getting wider, not as a carved
-- niche. `outwardForward` must point FROM the wall face INTO the room.
local function buildWallNiche(parent, name, wallFacePosition, outwardForward, width, height, material, color, hasStatue, rng)
    rng = rng or random
    local model = newFolder(parent, name)
    local outFwd = unitXZ(outwardForward)
    local intoWall = -outFwd
    local right = getRight(outFwd)
    local depth = 1.3

    -- Recessed back panel, set back into the wall -- darker so it reads as shadowed
    local backPos = wallFacePosition + intoWall * depth + Vector3.new(0, height/2, 0)
    addOrientedPart(model, "RecessBack", Vector3.new(width, height, 0.4), backPos, outFwd, material, CONFIG.colors.wallDark)

    -- Side returns connecting the flush face to the recessed back
    local retPos1 = wallFacePosition + intoWall * (depth/2) + right * (width/2) + Vector3.new(0, height/2, 0)
    local retPos2 = wallFacePosition + intoWall * (depth/2) - right * (width/2) + Vector3.new(0, height/2, 0)
    addOrientedPart(model, "ReturnA", Vector3.new(0.4, height, depth), retPos1, right, material, color)
    addOrientedPart(model, "ReturnB", Vector3.new(0.4, height, depth), retPos2, right, material, color)

    -- Header lintel at the wall face plane, plus a sill at the base
    local headerPos = wallFacePosition + Vector3.new(0, height + 0.4, 0)
    addOrientedPart(model, "Header", Vector3.new(width + 1.4, 0.8, 1.2), headerPos, outFwd, material, color)
    addOrientedPart(model, "Sill", Vector3.new(width + 0.6, 0.5, 1.0), wallFacePosition + Vector3.new(0, 0.25, 0), outFwd, material, color)

    if hasStatue then
        local plinthPos = wallFacePosition + intoWall * (depth * 0.6) + Vector3.new(0, 0.9, 0)
        addOrientedPart(model, "Plinth", Vector3.new(width * 0.6, 1.8, width * 0.6), plinthPos, outFwd, material, CONFIG.colors.ancientStone)
        buildStatue(model, "NicheStatue", plinthPos + Vector3.new(0, 0.9, 0), outFwd, height * 0.72, "guarding")
    else
        -- An empty niche still needs a reason to exist: a votive torch
        local torchPos = wallFacePosition + intoWall * (depth * 0.5)
        addWallTorch(model, "NicheTorch", torchPos, outFwd, height * 0.55)
    end

    -- Vines originate from the header/ledge, per the brief -- never
    -- floating in open space
    if rng:NextNumber() > 0.4 then
        buildVineStrip(model, "NicheVine", headerPos + Vector3.new(0, 0.4, 0) + outFwd * 0.3, rng:NextNumber(3, 6))
    end
    if rng:NextNumber() > 0.5 then
        buildMossPatch(model, "NicheMoss", wallFacePosition + Vector3.new(0, 0.3, 0) + outFwd * 0.2, outFwd, width * 0.7, 1.5)
    end

    return model
end

----------------------------------------------------------------------
-- FALLEN WARRIOR SET PIECES (Room D environmental storytelling)
----------------------------------------------------------------------
-- Every call produces a genuinely different situation: a broken statue
-- in a distinct pose, plus a dropped weapon and/or shield lying nearby,
-- occasionally bone fragments. This directly answers the brief's
-- complaint that Room D previously had "one random block called
-- FallenWarrior" -- these are proper set-pieces with variation.
local FALLEN_WARRIOR_VARIANTS = {"reaching", "collapsed", "kneeling", "climbing", "guarding"}

local function buildFallenSword(parent, name, position, forward, tilt)
    local model = newFolder(parent, name)
    local fwd = unitXZ(forward)
    local cf = CFrame.new(position) * CFrame.Angles(0, tilt or 0, math.rad(90))
    newPart({Name="Blade", Size=Vector3.new(0.35, 3.6, 0.05), CFrame=cf * CFrame.new(0, 1.8, 0), Material=CONFIG.materials.spikeSteel, Color=CONFIG.colors.spikeSteel, Parent=model})
    newPart({Name="Hilt", Size=Vector3.new(0.5, 0.9, 0.5), CFrame=cf * CFrame.new(0, -0.1, 0), Material=CONFIG.materials.metal, Color=CONFIG.colors.metal, Parent=model})
    newPart({Name="Crossguard", Size=Vector3.new(1.2, 0.25, 0.25), CFrame=cf * CFrame.new(0, 0.5, 0), Material=CONFIG.materials.metal, Color=CONFIG.colors.metal, Parent=model})
    return model
end

local function buildFallenShield(parent, name, position, forward, leaning)
    local model = newFolder(parent, name)
    local fwd = unitXZ(forward)
    local pitch = leaning and math.rad(20) or math.rad(90)
    local cf = orientedCFrame(position, fwd) * CFrame.Angles(pitch, 0, 0)
    newPart({Name="ShieldFace", Size=Vector3.new(1.8, 2.2, 0.25), CFrame=cf * CFrame.new(0, 1.1, 0), Shape=Enum.PartType.Cylinder, Material=CONFIG.materials.metal, Color=CONFIG.colors.chainMetal, Parent=model})
    newPart({Name="ShieldBoss", Size=Vector3.new(0.6, 0.6, 0.4), CFrame=cf * CFrame.new(0, 1.1, 0.15), Shape=Enum.PartType.Ball, Material=CONFIG.materials.metal, Color=CONFIG.colors.metal, Parent=model})
    return model
end

local function buildFallenWarrior(parent, name, position, forward, variant, rng)
    rng = rng or random
    variant = variant or FALLEN_WARRIOR_VARIANTS[rng:NextInteger(1, #FALLEN_WARRIOR_VARIANTS)]
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    local model = newFolder(parent, name)

    local warriorHeight = rng:NextNumber(6.5, 8.5)
    buildStatue(model, "Warrior", position, fwd, warriorHeight, variant)

    -- Weathering: every fallen warrior gets some moss, tying it into the ruin
    buildAlgaeCluster(model, "Growth", position, fwd, rng, 0.6)

    -- Dropped equipment, varied per situation
    if variant == "collapsed" or variant == "kneeling" then
        buildFallenSword(model, "DroppedSword", position + right * rng:NextNumber(1.5, 2.5) + fwd * rng:NextNumber(-1, 1), fwd, rng:NextNumber(0, math.pi*2))
        if rng:NextNumber() > 0.5 then
            buildFallenShield(model, "DroppedShield", position - right * 2, fwd, false)
        end
    elseif variant == "reaching" or variant == "climbing" then
        -- weapon still slung/dropped just below the reach
        buildFallenSword(model, "DroppedSword", position - right * 1.8, fwd, math.pi/2)
    else -- guarding
        buildFallenShield(model, "PropShield", position + right * 1.6, fwd, true)
        buildFallenSword(model, "PlantedSword", position - right * 1.6, fwd, 0)
    end

    return model
end

----------------------------------------------------------------------
-- SHATTERED STAIRCASE (Room D, Section 1)
----------------------------------------------------------------------
-- Climbs from basePosition to topPosition along `forward`, with a
-- deliberately incomplete step run (missing steps are gaps the player
-- must small-jump, never gaps wide enough to strand them) and mossy,
-- chain-braced side supports.
local function buildShatteredStaircase(parent, name, basePosition, topPosition, forward, width, rng)
    rng = rng or random
    local model = newFolder(parent, name)
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    local diff = topPosition - basePosition
    local totalHeight = diff.Y
    local totalRun = Vector3.new(diff.X, 0, diff.Z).Magnitude
    local runDir = totalRun > 0.01 and unitXZ(diff) or fwd

    local stepCount = math.max(8, math.floor(totalHeight / 1.3))
    local stepHeight = totalHeight / stepCount
    local stepDepth = totalRun / stepCount

    for i = 1, stepCount do
        -- Never remove more than one step in a row, and never the first
        -- or last two steps, so entry/landing is always solid.
        local missing = (i > 3 and i < stepCount - 2) and (rng:NextNumber() > 0.82)
        local stepPos = basePosition + runDir * (stepDepth * (i - 0.5)) + Vector3.new(0, stepHeight * i - stepHeight/2, 0)
        if not missing then
            addOrientedPart(model, "Step_"..i, Vector3.new(width, stepHeight + 0.4, stepDepth + 0.5), stepPos, runDir, CONFIG.materials.floor, CONFIG.colors.ancientStone)
            if rng:NextNumber() > 0.7 then
                buildMossPatch(model, "StepMoss_"..i, stepPos + Vector3.new(0, stepHeight/2 + 0.1, 0), runDir, width * 0.5, stepDepth * 0.6)
            end
        else
            -- A broken stub instead of a full step -- reads as damage, not a random void
            addOrientedPart(model, "StepStub_"..i, Vector3.new(width * 0.4, stepHeight + 0.4, stepDepth * 0.5), stepPos - right * width * 0.25, runDir, CONFIG.materials.floor, CONFIG.colors.wallDark)
        end
    end

    -- Broken side railing with chain bracing every few steps
    for i = 4, stepCount - 2, 4 do
        local stepPos = basePosition + runDir * (stepDepth * (i - 0.5)) + Vector3.new(0, stepHeight * i, 0)
        if rng:NextNumber() > 0.4 then
            buildChainSegment(model, "RailChain_"..i, stepPos + right * (width/2) + Vector3.new(0, 4, 0), stepPos + right * (width/2), 3)
        end
    end

    addRubblePile(model, "BaseRubble", basePosition + right * (width/2 + 2), 5, 2.5)

    return model, topPosition
end

----------------------------------------------------------------------
-- WALL-MOUNTED RUINED LEDGE (Room D, Section 2 / general ascent use)
----------------------------------------------------------------------
-- A platform that visibly belongs to the architecture: it sits on a
-- broken support corbel/stub pillar rather than floating, which is
-- the difference between "ruined balcony" and "random floating block".
local function buildWallLedgePlatform(parent, name, position, forward, width, depth, tilted, rng)
    rng = rng or random
    local model = newFolder(parent, name)
    local fwd = unitXZ(forward)

    local plat = addOrientedPart(model, "Ledge", Vector3.new(width, 1.4, depth), position, fwd, CONFIG.materials.wall, CONFIG.colors.ancientStone)
    if tilted then
        plat.CFrame = plat.CFrame * CFrame.Angles(math.rad(rng:NextNumber(-6, 6)), 0, math.rad(rng:NextNumber(-8, 8)))
    end

    -- Support corbel/stub running down to (approximately) the structure below
    buildStonePillar(model, "SupportCorbel", position - Vector3.new(0, 10, 0), 10, 1.6, CONFIG.materials.wall, CONFIG.colors.ancientStone, true)

    if rng:NextNumber() > 0.5 then
        buildAlgaeCluster(model, "Growth", position + Vector3.new(0, 0.7, 0), fwd, rng, 1.0)
    end
    if rng:NextNumber() > 0.6 then
        addRubblePile(model, "Debris", position + Vector3.new(0, 0.9, 0), 4, depth * 0.3)
    end

    return model
end

----------------------------------------------------------------------
-- EXTERNAL MODEL HOOK (e.g. the pre-built Room B golem)
----------------------------------------------------------------------
-- Some encounter pieces (the golem chief among them) are already
-- authored as real 3D models rather than generator geometry. This
-- helper places the spawn marker the encounter script needs and, if a
-- matching model already exists in the configured storage service,
-- clones it into place -- but never fails generation if it's absent,
-- since the generator must remain safely rerunnable on its own.
local function spawnExternalModel(parentFolder, storageServiceName, modelName, cframe)
    local ok, storage = pcall(function() return game:GetService(storageServiceName) end)
    if not ok or not storage then return nil end

    local ok2, template = pcall(function() return storage:FindFirstChild(modelName) end)
    if not ok2 or not template then
        print(string.format("  (note) '%s' not found in %s -- leaving spawn marker only, no placeholder geometry built.", modelName, storageServiceName))
        return nil
    end

    local ok3, clone = pcall(function() return template:Clone() end)
    if not ok3 or not clone then return nil end

    clone.Parent = parentFolder
    if clone:IsA("Model") and clone.PrimaryPart then
        clone:SetPrimaryPartCFrame(cframe)
    elseif clone:IsA("BasePart") then
        clone.CFrame = cframe
    end
    return clone
end

