local function buildCentralHub(root, basePosition, branches)
	local hub = newFolder(root, "CentralHub")

	local radius = CONFIG.hub.radius
	local height = CONFIG.hub.height
	local thickness = CONFIG.hub.wallThickness
	local sideLength = 2 * radius * math.tan(math.pi / 8)

	newPart({
		Name = "HubFloor",
		Size = Vector3.new(
			CONFIG.hub.floorSize,
			1,
			CONFIG.hub.floorSize
		),
		CFrame = CFrame.new(basePosition + Vector3.new(0, -0.5, 0)),
		Material = CONFIG.materials.floor,
		Color = CONFIG.colors.floor,
		Parent = hub,
	})

	newPart({
		Name = "HubCeiling",
		Size = Vector3.new(
			CONFIG.hub.floorSize,
			1,
			CONFIG.hub.floorSize
		),
		CFrame = CFrame.new(basePosition + Vector3.new(0, height + 0.5, 0)),
		Material = CONFIG.materials.wall,
		Color = CONFIG.colors.wall,
		Parent = hub,
	})

	for index = 0, 7 do
		local angle = math.rad(index * 45)
		local normal = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local isOpening = false

		for _, branch in ipairs(branches) do
			if normal:Dot(branch.forward) > 0.97 then
				isOpening = true
				break
			end
		end

		if not isOpening then
			addOrientedPart(
				hub,
				"HubWall_" .. (index + 1),
				Vector3.new(sideLength + 1, height, thickness),
				basePosition
					+ normal * radius
					+ Vector3.new(0, height / 2, 0),
				normal,
				CONFIG.materials.wall,
				CONFIG.colors.wall
			)
		end
	end

	local startMarker = newPart({
		Name = "DraftStartPoint",
		Size = Vector3.new(5, 0.25, 5),
		CFrame = CFrame.new(basePosition + Vector3.new(0, 0.15, 0)),
		Material = CONFIG.materials.neon,
		Color = CONFIG.colors.portal,
		Transparency = 0.45,
		CanCollide = false,
		CanQuery = false,
		Parent = hub,
	})

	addGlow(startMarker, CONFIG.colors.portal, 10, 1)

	return hub
end

