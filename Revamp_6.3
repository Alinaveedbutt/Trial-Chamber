local EntryForecourt = {}

function EntryForecourt.build(parent)
    local folder = GeometryCore.newFolder(parent, "EntryForecourt")
    local pos = MapManager.rooms.Forecourt.position
    
    Masonry.buildGrounding(folder, pos, 30 + 40, 30 + 20, 60)
    
    -- Floor slab
    GeometryCore.addOrientedPart(folder, "StructuralFloor", Vector3.new(30, 2, 30), Vector3.new(0, -1, -15), Vector3.new(0,0,-1), STONE, C_DARK_STONE, "structural")
    
    -- Low side walls
    for side = -1, 1, 2 do
        np("RuinedWall", Vector3.new(3, 2, 30), CFrame.new(side * 13.5, 1, -15), STONE, C_DARK_STONE, folder)
        -- Torch anchors
        np("TorchAnchor", Vector3.new(4, 3, 4), CFrame.new(side * 13, 1.5, -15), STONE, C_LITE_STONE, folder)
        
        local tf = Instance.new("Folder")
        tf.Name = "Torch_" .. (side > 0 and "R" or "L")
        tf.Parent = folder
        
        nc("Shaft", 0.35, 2.5, CFrame.new(side * 13, 4, -15), WOOD, C_WOOD, tf, false)
        local flame = np("Flame", Vector3.new(0.5, 0.9, 0.5), CFrame.new(side * 13, 5.5, -15), NEON, C_FLAME, tf, false)
        flame.Transparency = 0.25
        local pl = Instance.new("PointLight")
        pl.Color = C_WARM; pl.Brightness = 1.2; pl.Range = 18; pl.Parent = flame
    end
    
    -- Spawn Marker
    local sm = np("TrialStartMarker", Vector3.new(6, 0.2, 6), CFrame.new(0, 0.1, -20), METAL, C_DARK_IRON, folder, false)
    local sl = Instance.new("SpawnLocation")
    sl.Size = Vector3.new(6, 0.2, 6)
    sl.CFrame = CFrame.new(0, 0.1, -20)
    sl.Transparency = 1
    sl.CanCollide = false
    sl.Parent = folder
    
    return folder
end

