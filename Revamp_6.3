local function generateTrialChamberV4()

    print("TrialChamberV4 Generator (Extended Stage 1A) starting...")

    

    local targetName = "TrialChamberGeneratedV5"

    if workspace:FindFirstChild(targetName) then

        workspace[targetName]:Destroy()

    end

    

    MapManager.init()

    local root = Instance.new("Model")

    root.Name = targetName

    root.Parent = workspace

    

    print("Building Forecourt & Phase 1A Structural Shells...")

    EntryForecourt.build(root)

    RoomA.build(root)

    print("Building Clearance Chamber...")
    ClearanceChamber.build(root)

    Collapse.buildAll(root)

    RoomB.build(root)

    

    print("Building Room A Visuals & 5-Zone Hazards...")

    RoomA_VisualPass.build(root)

    

    print("--- Navigation Validation ---")

    Validation.run()

    print("--- Validation Complete ---")

    print("Starting blade animations...")
    animateSwingingBlades()

    

    print(targetName .. " Generation complete!")

    print("Total BaseParts:", GeometryCore.partCount.total)

    print("Structural Parts:", GeometryCore.partCount.structural)

    print("Grounding Parts:", GeometryCore.partCount.grounding)

    print("Visual Parts:", GeometryCore.partCount.visual)
end

local function setupLighting()
    local lighting = game:GetService("Lighting")
    lighting.Ambient = Color3.fromRGB(20, 25, 35)
    lighting.OutdoorAmbient = Color3.fromRGB(15, 20, 30)
    lighting.Brightness = 1.0
    lighting.GlobalShadows = true
    -- Future technology cannot always be set safely from a script during runtime, 
    -- but we can adjust exposure and color correction.
    lighting.ExposureCompensation = -0.2
    
    local cc = lighting:FindFirstChild("TrialColorCorrection")
    if not cc then
        cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "TrialColorCorrection"
        cc.Parent = lighting
    end
    cc.Contrast = 0.15
    cc.Brightness = -0.05
    cc.Saturation = -0.1
    cc.TintColor = Color3.fromRGB(240, 245, 255) -- Slight cool tint to contrast warm torches
end

setupLighting()
generateTrialChamberV4()
