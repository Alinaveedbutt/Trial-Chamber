    addOrientedPart(model, "Pillar1", Vector3.new(colW, height, colW), colPos1 + Vector3.new(0, height/2, 0), forward, material, color)
    addOrientedPart(model, "Pillar2", Vector3.new(colW, height, colW), colPos2 + Vector3.new(0, height/2, 0), forward, material, color)
    
