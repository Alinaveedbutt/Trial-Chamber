----------------------------------------------------------------------
-- ROOM C: OASIS SANCTUARY
----------------------------------------------------------------------

local function buildRoomC(root, entrancePosition, forward)
	local folder = newFolder(root, "RoomC_OasisSanctuary")
	local archFolder = newFolder(folder, "Architecture")
	local heartFolder = newFolder(folder, "Heart")
	local waterFolder = newFolder(folder, "Water")
	local decorFolder = newFolder(folder, "Decoration")
	local markersFolder = newFolder(folder, "Markers")

	local radius = CONFIG.roomC.radius
	local height = CONFIG.roomC.wallHeight
	local fwd = unitXZ(forward)
	local right = getRight(fwd)
	local center = entrancePosition + fwd * radius
	local dRng = Random.new(20260901)

	-- Floor
	addOrientedPart(archFolder, "Floor",
		Vector3.new(radius * 2, 1, radius * 2),
		center + Vector3.new(0, -0.5, 0),
		fwd, CONFIG.materials.floor, CONFIG.colors.ancientStone)

	-- Circular wall ring (16 segments)
	local segmentCount = 16
	local angleStep = math.pi * 2 / segmentCount
	local wallWidth = (radius * 2 * math.pi) / segmentCount * 1.05

	for i = 0, segmentCount - 1 do
		local angle = i * angleStep
		local offset = Vector3.new(math.sin(angle), 0, math.cos(angle)) * radius
		local wallPos = center + offset + Vector3.new(0, height / 2, 0)
		
		-- Check distance to entrance/exit to leave gaps
		local distToEnt = (wallPos * Vector3.new(1,0,1) - entrancePosition * Vector3.new(1,0,1)).Magnitude
		local exitPosExact = center + fwd * radius
		local distToExit = (wallPos * Vector3.new(1,0,1) - exitPosExact * Vector3.new(1,0,1)).Magnitude

		if distToEnt > 10 and distToExit > 10 then
			local inward = (center - wallPos).Unit
			inward = unitXZ(inward)
			addOrientedPart(archFolder, "WallSegment_" .. i,
				Vector3.new(wallWidth, height, 2),
				wallPos, inward, CONFIG.materials.wall, CONFIG.colors.wall)
				
			-- Occasional carved stone relief on the walls
			if dRng:NextNumber() > 0.6 then
				local reliefPos = wallPos + inward * 1.2 - Vector3.new(0, height/4, 0)
				addOrientedPart(decorFolder, "WallRelief_"..i, Vector3.new(8, 6, 0.6), reliefPos, inward, CONFIG.materials.wall, CONFIG.colors.ancientStone)
			end
			
			-- Vines hanging down the walls
			if dRng:NextNumber() > 0.4 then
				buildVineStrip(decorFolder, "WallVine_"..i, wallPos + Vector3.new(0, height/2, 0) + inward * 1.2, height * 0.4 + dRng:NextNumber() * height * 0.4)
			end
		end
	end

	-- Internal arches (8)
	local archCount = CONFIG.roomC.archCount
	local archAngleStep = math.pi * 2 / archCount
	for i = 1, archCount do
		local angle = i * archAngleStep
		local offset = Vector3.new(math.sin(angle), 0, math.cos(angle)) * (radius - 6)
		local archPos = center + offset
		local inward = (center - archPos).Unit
		
		buildAncientArch(archFolder, "Arch_" .. i, archPos, inward, CONFIG.roomC.archWidth, CONFIG.roomC.archHeight, CONFIG.materials.wall, CONFIG.colors.ancientStone)
		
		-- Wall Torches between arches
		local torchAngle = angle + (archAngleStep / 2)
		local tOffset = Vector3.new(math.sin(torchAngle), 0, math.cos(torchAngle)) * (radius - 1)
		local tPos = center + tOffset
		local tInward = (center - tPos).Unit
		local torch = addWallTorch(decorFolder, "Torch_" .. i, tPos, tInward, 10)
		-- Golden light modifier for torches in this room
		local flame = torch:FindFirstChild("Flame")
		if flame then
			local light = flame:FindFirstChildOfClass("PointLight")
			if light then light.Color = CONFIG.colors.sacred end
		end
		
		-- Pillars between arches
		buildStonePillar(decorFolder, "PerimeterPillar_"..i, tPos + tInward*3, height * 0.8, 1.2, CONFIG.materials.wall, CONFIG.colors.ancientStone, dRng:NextNumber() > 0.7)

		-- Algae at every arch base and pillar base -- Room C is the most overgrown room in the chamber
		buildMossPatch(decorFolder, "ArchMoss_"..i, archPos + inward * 1.5, inward, 3.5 + dRng:NextNumber()*2, 2.5 + dRng:NextNumber()*1.5)
		buildMossPatch(decorFolder, "PillarMoss_"..i, tPos + tInward*3, tInward, 2 + dRng:NextNumber(), 2 + dRng:NextNumber())
		if dRng:NextNumber() > 0.3 then
			buildVineStrip(decorFolder, "ArchVine_"..i, archPos + Vector3.new(0, CONFIG.roomC.archHeight, 0), CONFIG.roomC.archHeight * 0.3 + dRng:NextNumber() * CONFIG.roomC.archHeight * 0.3)
		end
	end

	-- Segmented Dome Roof (hole in middle for sunlight)
	local ceilThick = 2
	local roofSegments = 16
	local roofAngle = math.pi * 2 / roofSegments
	local outerRadius = radius + 2
	local innerRadius = 10
	
	for r = 0, roofSegments - 1 do
		local a = r * roofAngle
		local midA = a + roofAngle/2
		local dir = (fwd * math.cos(midA) + right * math.sin(midA)).Unit
		
		local slabLen = outerRadius - innerRadius + 4
		local slabW = (outerRadius * math.tan(roofAngle/2)) * 2 + 2
		
		-- Slope upwards towards the center hole
		local slabCenter = center + dir * (innerRadius + slabLen/2 - 2) + Vector3.new(0, height + (slabLen * math.sin(math.rad(20)))/2, 0)
		
		-- Controlled roof damage: a small number of slabs are missing
		-- entirely (never adjacent to each other), reading as centuries of
		-- deterioration rather than a random hole -- each becomes a
		-- secondary sunlight shaft instead of leaving a structural gap.
		local isBroken = (r % 5 == 2) and dRng:NextNumber() > 0.4
		if isBroken then
			buildSunlightShaft(decorFolder, "RoofBreakSun_"..r, slabCenter + Vector3.new(0, 3, 0), 6, 10)
			addCollapsedMasonry(archFolder, "RoofBreakRubble_"..r, slabCenter - Vector3.new(0, height * 0.5, 0), 3, 2.5)
		else
			local slab = addOrientedPart(archFolder, "RoofSlab_"..r, Vector3.new(slabW, ceilThick, slabLen), slabCenter, -dir, CONFIG.materials.wall, CONFIG.colors.wallDark)
			slab.CFrame = slab.CFrame * CFrame.Angles(math.rad(20), 0, 0)
			-- Weathering: moss and hairline cracks on roughly half the intact slabs
			if dRng:NextNumber() > 0.5 then
				buildMossPatch(archFolder, "RoofMoss_"..r, slabCenter + Vector3.new(0, ceilThick/2 + 0.05, 0), dir, slabW * 0.4, slabLen * 0.35)
			end
			if dRng:NextNumber() > 0.75 then
				buildVineStrip(archFolder, "RoofVine_"..r, slabCenter - dir * (slabLen/2 - 1), dRng:NextNumber(3, 7))
			end
		end
	end

	-- Heart Dais (stepped)
	local function makeCylStep(name, r, h, y, mat, col)
		local p = newPart({
			Name = name,
			Size = Vector3.new(h, r * 2, r * 2),
			CFrame = CFrame.new(center + Vector3.new(0, y + h/2, 0)) * CFrame.Angles(0, 0, math.pi/2),
			Shape = Enum.PartType.Cylinder,
			Material = mat, Color = col, Parent = heartFolder
		})
		return p
	end

	makeCylStep("Step1", 10, 0.8, 0, CONFIG.materials.floor, CONFIG.colors.ancientStone)
	makeCylStep("Step2", 8, 0.8, 0.8, CONFIG.materials.floor, CONFIG.colors.ancientStone)
	makeCylStep("Step3", 6, 0.9, 1.6, CONFIG.materials.floor, CONFIG.colors.ancientStone)
	makeCylStep("Pedestal", 1.5, 0.6, 2.5, CONFIG.materials.wall, CONFIG.colors.ancientStone)

	-- Heart Crystal (Intricate Floating Assembly)
	local corePos = center + Vector3.new(0, 9, 0)
	local mainCrystal = newPart({
		Name = "HeartCrystal",
		Size = Vector3.new(2.5, 7, 2.5),
		CFrame = CFrame.new(corePos) * CFrame.Angles(math.pi/8, math.pi/4, math.pi/8),
		Material = CONFIG.materials.neon,
		Color = CONFIG.colors.crystal,
		Parent = heartFolder
	})
	
	addGlow(mainCrystal, CONFIG.colors.crystalGlow, CONFIG.lighting.crystalRange, CONFIG.lighting.crystalBrightness)
	addGlow(mainCrystal, CONFIG.colors.sacred, CONFIG.lighting.sacredRange, 1)

	-- Orbiting shards
	for f = 1, 6 do
		local a = f * math.pi/3
		local shardOffset = Vector3.new(math.sin(a)*3, math.sin(a*2)*1.5, math.cos(a)*3)
		local shard = newPart({
			Name = "Shard_" .. f,
			Size = Vector3.new(0.8, 2.5, 0.8),
			CFrame = CFrame.new(corePos + shardOffset) * CFrame.Angles(math.random(), math.random(), math.random()),
			Material = CONFIG.materials.neon, Color = CONFIG.colors.crystal,
			Parent = heartFolder
		})
	end
	
	-- Containment rings (ancient tech/magic)
	local function buildRing(name, rCenter, ringRadius, thickness, tilt)
		local ringModel = Instance.new("Model", heartFolder)
		ringModel.Name = name
		local segs = 16
		local step = math.pi*2/segs
		local len = 2 * ringRadius * math.tan(math.pi/segs)
		for i=1, segs do
			local a = i * step
			local cf = tilt * CFrame.new(math.sin(a)*ringRadius, 0, math.cos(a)*ringRadius) * CFrame.Angles(0, a, 0)
			newPart({
				Name = "Seg_"..i, Size = Vector3.new(len + 0.2, thickness, thickness),
				CFrame = cf, Material = CONFIG.materials.metal, Color = CONFIG.colors.metal,
				Parent = ringModel
			})
		end
	end
	
	buildRing("InnerRing", corePos, 4.5, 0.4, CFrame.new(corePos) * CFrame.Angles(math.rad(20), 0, 0))
	buildRing("OuterRing", corePos, 6.0, 0.6, CFrame.new(corePos) * CFrame.Angles(math.rad(-15), math.rad(45), 0))

	-- Water Pool (surrounding dais)
	local poolY = -CONFIG.roomC.poolDepth + 0.1
	local poolRadius = CONFIG.roomC.poolRadius
	
	local waterVol = newPart({
		Name = "MainWater",
		Size = Vector3.new(0.4, poolRadius*2, poolRadius*2),
		CFrame = CFrame.new(center + Vector3.new(0, poolY, 0)) * CFrame.Angles(0, 0, math.pi/2),
		Shape = Enum.PartType.Cylinder,
		Material = CONFIG.materials.water,
		Color = CONFIG.colors.waterShallow,
		Transparency = 0.4,
		CanCollide = false,
		Parent = waterFolder
	})
	
	-- Segmented stone border (outer ring)
	local borderSegments = 24
	local borderAngleStep = math.pi * 2 / borderSegments
	local borderWidth = (poolRadius * 2 * math.pi) / borderSegments * 1.05
	for b = 0, borderSegments - 1 do
		local bAngle = b * borderAngleStep
		local bOffset = Vector3.new(math.sin(bAngle), 0, math.cos(bAngle)) * poolRadius
		local bPos = center + bOffset + Vector3.new(0, -0.2, 0)
		
		-- Don't place borders directly on the main entrance/exit path
		local dToAxis = math.abs((bPos - center):Dot(right))
		if dToAxis > 4 or (bPos - center).Magnitude < poolRadius - 1 then
			local inward = (center - bPos).Unit
			addOrientedPart(waterFolder, "PoolBorder_"..b, Vector3.new(borderWidth, 1.2, 1.5), bPos, inward, CONFIG.materials.wall, CONFIG.colors.ancientStone)
			
			-- Add moss/ferns on the border
			if dRng:NextNumber() > 0.4 then
				buildMossPatch(decorFolder, "PoolMoss_"..b, bPos + Vector3.new(0, 0.6, 0), fwd, 2.5, 1.8)
			end
		end
	end

	-- Additional Decoration (magic motes, vines, moss)
	for d = 1, 6 do
		local angle = d * math.pi / 3
		local mPos = center + Vector3.new(math.sin(angle)*4, 9 + 2 + math.sin(d)*1.5, math.cos(angle)*4)
		newPart({
			Name = "Mote_" .. d,
			Size = Vector3.new(0.5, 0.5, 0.5),
			CFrame = CFrame.new(mPos),
			Shape = Enum.PartType.Ball,
			Material = CONFIG.materials.neon, Color = CONFIG.colors.sacred,
			Transparency = 0.3, CanCollide = false, Parent = decorFolder
		})
	end

	buildSunlightShaft(decorFolder, "CentralSunlight", center + Vector3.new(0, height, 0), 16, height)
	buildMossPatch(decorFolder, "DaisMoss1", center + Vector3.new(3, 1.6, 5), fwd, 4, 3)
	buildMossPatch(decorFolder, "DaisMoss2", center + Vector3.new(-4, 0.8, -6), fwd, 5, 3)
	
	-- Markers
	local exitPosition = center + fwd * radius
	addCheckpoint(markersFolder, "RoomC_Start", entrancePosition)
	addCheckpoint(markersFolder, "RoomC_Heart", corePos)
	addCheckpoint(markersFolder, "RoomC_End", exitPosition)

	-- Invisible narrative hooks
	local function addHook(name, pos)
		newPart({Name = name, Size = Vector3.new(1,1,1), CFrame = CFrame.new(pos), Transparency = 1, CanCollide = false, Parent = markersFolder})
	end
	addHook("RoomC_HeartModel", corePos)
	addHook("RoomC_HeartPedestal", center + Vector3.new(0, 2.5, 0))
	addHook("RoomC_HeartRevealPoint", center - fwd * 20)
	addHook("RoomC_HeartInteractPoint", center - fwd * 8)
	addHook("RoomC_ProctorPoint", center + right * 10)
	addHook("RoomC_ProctorSpawn", center + right * 12)
	addHook("RoomC_ExitGate", exitPosition)
	addHook("RoomC_WizardExit", exitPosition + right * 6)
	addHook("RoomC_ToRoomD", exitPosition + fwd * 4)

	local colZone = newPart({
		Name = "RoomC_CollapseZone", Size = Vector3.new(100, 50, 100),
		CFrame = CFrame.new(center + Vector3.new(0, 10, 0)),
		Transparency = 1, CanCollide = false, Parent = markersFolder
	})
	CollectionService:AddTag(colZone, "CollapseTrigger")

	return folder, exitPosition
end

----------------------------------------------------------------------
-- COLLAPSE TRANSITION C -> D
----------------------------------------------------------------------

local function buildCollapseTransition(root, startPosition, forward)
	local folder = newFolder(root, "Transition_C_D_Collapse")
	local geoFolder = newFolder(folder, "Geometry")
	local debrisFolder = newFolder(folder, "Debris")
	local decorFolder = newFolder(folder, "Decoration")
	local markersFolder = newFolder(folder, "Markers")

	local length = CONFIG.transitions.collapseLength
	local fwd = unitXZ(forward)
	local right = getRight(fwd)
	
	-- Broken, heavily slanted geometry
	addOrientedPart(geoFolder, "Floor1",
		Vector3.new(16, 1, length/2 + 2),
		startPosition + fwd * (length/4) + Vector3.new(0, -0.5, 0),
		fwd, CONFIG.materials.floor, CONFIG.colors.floor)
	
	-- Drastic tilt for second half
	local f2 = addOrientedPart(geoFolder, "Floor2",
		Vector3.new(14, 2, length/2 + 2),
		startPosition + fwd * (length*0.75) + Vector3.new(0, -4, 0),
		fwd, CONFIG.materials.floor, CONFIG.colors.floor)
	f2.CFrame = f2.CFrame * CFrame.Angles(math.rad(-12), 0, math.rad(5))

	-- Jagged walls
	local wL = addOrientedPart(geoFolder, "WallL",
		Vector3.new(2, 20, length),
		startPosition + fwd * (length/2) - right * 8 + Vector3.new(0, 8, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wall)
	wL.CFrame = wL.CFrame * CFrame.Angles(0, math.rad(5), math.rad(15))

	local wR = addOrientedPart(geoFolder, "WallR",
		Vector3.new(2, 20, length),
		startPosition + fwd * (length/2) + right * 8 + Vector3.new(0, 8, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wall)
	wR.CFrame = wR.CFrame * CFrame.Angles(0, math.rad(-5), math.rad(-12))

	local ceil = addOrientedPart(geoFolder, "CeilPartial",
		Vector3.new(16, 2, length*0.6),
		startPosition + fwd * (length*0.3) + Vector3.new(0, 18, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wallDark)
	ceil.CFrame = ceil.CFrame * CFrame.Angles(math.rad(15), 0, math.rad(8))

	-- Exposed Rock (ominous framing)
	addOrientedPart(geoFolder, "ExposedRock_1", Vector3.new(10, 15, 10), startPosition + fwd * (length*0.6) - right * 12 + Vector3.new(0, 2, 0), fwd, Enum.Material.Slate, Color3.fromRGB(30, 30, 30))
	addOrientedPart(geoFolder, "ExposedRock_2", Vector3.new(12, 25, 12), startPosition + fwd * (length*0.8) + right * 10 + Vector3.new(0, 5, 0), fwd, Enum.Material.Slate, Color3.fromRGB(25, 25, 25))

	-- Ominous red/orange ambient lighting
	local ominousLight = newPart({
		Name = "OminousAmbient", Size = Vector3.new(1,1,1),
		CFrame = CFrame.new(startPosition + fwd * (length*0.7) + Vector3.new(0, 5, 0)),
		Transparency = 1, CanCollide = false, Parent = decorFolder
	})
	addGlow(ominousLight, Color3.fromRGB(200, 50, 20), 30, 1.5)

	-- Debris
	addBrokenSupport(debrisFolder, "FallenPillar", startPosition + fwd * (length*0.55) + right * 3, fwd, 16, 3)
	addCollapsedMasonry(debrisFolder, "Rubble_1", startPosition + fwd * (length*0.4) - right * 4, 6, 3)
	addCollapsedMasonry(debrisFolder, "Rubble_2", startPosition + fwd * (length*0.8) + right * 2, 8, 4)

	-- Glowing stress cracks
	for c = 1, 8 do
		local crackPos = startPosition + fwd * (length * c/9) + right * ((c%2 == 0) and 4 or -4)
		local p = newPart({
			Name = "GlowingCrack_"..c, Size = Vector3.new(6, 0.3, 0.5),
			CFrame = CFrame.new(crackPos) * CFrame.Angles(0, math.rad(math.random(-60, 60)), 0),
			Material = CONFIG.materials.neon, Color = CONFIG.colors.crack,
			CanCollide = false, Parent = debrisFolder
		})
		addGlow(p, CONFIG.colors.crack, 10, 2)
	end

	local exitPos = startPosition + fwd * length + Vector3.new(0, -6, 0) -- Drop down slightly at exit

	-- Markers
	local function addHook(name, pos)
		newPart({Name = name, Size = Vector3.new(1,1,1), CFrame = CFrame.new(pos), Transparency = 1, CanCollide = false, Parent = markersFolder})
	end
	
	addHook("RoomC_CollapseDebris", startPosition + fwd * 8)
	addHook("Transition_C_D_WizardPoint", startPosition + fwd * 5)
	addHook("Transition_C_D_WizardRoute_1", startPosition + fwd * 15)
	addHook("Transition_C_D_WizardRoute_2", startPosition + fwd * 25)
	addHook("Transition_C_D_ExitTrigger", exitPos)
	addHook("Transition_C_D_MysteriousWarriorPoint", exitPos + fwd * 5)
	addHook("Transition_C_D_WarriorReveal", exitPos + fwd * 10)

	return folder, exitPos
end

----------------------------------------------------------------------
-- ROOM D: ASCENT OF ECHOES
----------------------------------------------------------------------

local function buildRoomD(root, entrancePosition, forward)
	local folder = newFolder(root, "RoomD_AscentOfEchoes")
	local approachFolder = newFolder(folder, "Approach")
	local shaftFolder = newFolder(folder, "Shaft")
	local ascentFolder = newFolder(folder, "Ascent")
	local warriorsFolder = newFolder(folder, "Warriors")
	local muralsFolder = newFolder(folder, "Murals")
	local hazardsFolder = newFolder(folder, "Hazards")
	local echoesFolder = newFolder(folder, "Echoes")
	local decorFolder = newFolder(folder, "Decoration")
	local markersFolder = newFolder(folder, "Markers")

	local fwd = unitXZ(forward)
	local right = getRight(fwd)
	local conf = CONFIG.roomD
	local roomDRng = Random.new(conf.seed)

	----------------------------------------------------------------
	-- SECTION 0: RUINED APPROACH -- horizontal depth before the shaft.
	-- This is what keeps Room D from being "Room C -> tiny room -> climb".
	----------------------------------------------------------------
	local aLen = conf.approachLength
	local aWidth = conf.approachWidth
	local aHeight = conf.approachHeight
	local aCenter = entrancePosition + fwd * (aLen / 2)

	addOrientedPart(approachFolder, "ApproachFloor", Vector3.new(aWidth, 1, aLen), aCenter + Vector3.new(0, -0.5, 0), fwd, CONFIG.materials.floor, CONFIG.colors.floor)
	addOrientedPart(approachFolder, "ApproachWallL", Vector3.new(conf.wallThickness, aHeight, aLen), aCenter - right * (aWidth/2 + conf.wallThickness/2) + Vector3.new(0, aHeight/2, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wall)
	addOrientedPart(approachFolder, "ApproachWallR", Vector3.new(conf.wallThickness, aHeight, aLen), aCenter + right * (aWidth/2 + conf.wallThickness/2) + Vector3.new(0, aHeight/2, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wall)

	local approachSegs = 5
	local segLen = aLen / approachSegs
	for i = 0, approachSegs - 1 do
		local segCenter = entrancePosition + fwd * (i * segLen + segLen / 2)
		if roomDRng:NextNumber() > 0.45 then
			addOrientedPart(approachFolder, "ApproachCeil_" .. i, Vector3.new(aWidth, 1, segLen), segCenter + Vector3.new(0, aHeight + 0.5, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wallDark)
		else
			buildSunlightShaft(decorFolder, "ApproachSun_" .. i, segCenter + Vector3.new(0, aHeight, 0), 8, aHeight)
		end
		if roomDRng:NextNumber() > 0.5 then
			buildAlgaeCluster(decorFolder, "ApproachAlgae_" .. i, segCenter - right * (aWidth/2 - 1), fwd, roomDRng, CONFIG.vegetation.density.roomD * 0.6)
		end
	end
	addCrackedFloorPatch(approachFolder, "ApproachCrack_1", entrancePosition + fwd * (aLen * 0.4), fwd, 6, 5)
	addCollapsedMasonry(approachFolder, "ApproachRubble_1", entrancePosition + fwd * (aLen * 0.7) + right * (aWidth/2 - 2), 5, 2.5)

	-- One quiet, early fallen warrior: the first sign something went wrong here (Doubt phase begins)
	buildFallenWarrior(warriorsFolder, "Warrior_00", entrancePosition + fwd * (aLen * 0.6) - right * (aWidth/2 - 3), fwd, "collapsed", roomDRng)

	addCheckpoint(markersFolder, "RoomD_Start", entrancePosition)

	----------------------------------------------------------------
	-- THE SHAFT: bounded vertical chasm the ascent climbs through
	----------------------------------------------------------------
	local shaftBase = entrancePosition + fwd * aLen
	local shaftWidth = conf.shaftWidth
	local shaftHalf = shaftWidth / 2

	-- Precompute every leg's height/forward gain up front so the boundary
	-- walls and fog can be sized to the real total extent.
	local legHeights, legForwards = {}, {}
	local totalForward, totalHeight = 0, 0
	for L = 1, conf.legCount do
		local hGain = roomDRng:NextNumber(conf.legHeightMin, conf.legHeightMax)
		local fGain = conf.legForwardAdvance * (0.7 + 0.6 * roomDRng:NextNumber())
		legHeights[L] = hGain
		legForwards[L] = fGain
		totalHeight = totalHeight + hGain
		totalForward = totalForward + fGain
	end
	totalForward = totalForward + conf.finalStairLength
	totalHeight = totalHeight + conf.finalStairHeight

	local shaftDepthSpan = totalForward + 10
	local shaftCenterFwd = shaftBase + fwd * (shaftDepthSpan / 2)

	addOrientedPart(shaftFolder, "ShaftWallL", Vector3.new(conf.wallThickness, totalHeight + 30, shaftDepthSpan), shaftCenterFwd - right * (shaftHalf + conf.wallThickness/2) + Vector3.new(0, (totalHeight + 30)/2, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wall)
	addOrientedPart(shaftFolder, "ShaftWallR", Vector3.new(conf.wallThickness, totalHeight + 30, shaftDepthSpan), shaftCenterFwd + right * (shaftHalf + conf.wallThickness/2) + Vector3.new(0, (totalHeight + 30)/2, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wall)

	-- Deep chasm below the entry point -- fog swallows the true bottom
	newPart({
		Name = "ChasmFog", Size = Vector3.new(shaftWidth, 30, shaftDepthSpan),
		CFrame = CFrame.new(shaftCenterFwd + Vector3.new(0, -40, 0)),
		Material = Enum.Material.Neon, Color = CONFIG.colors.fog,
		Transparency = 0.75, CanCollide = false, CanQuery = false, Parent = decorFolder
	})

	-- Vertical wall growth running the height of the shaft
	local wallDecoCount = math.floor(totalHeight / 14)
	for i = 1, wallDecoCount do
		local yFrac = i / (wallDecoCount + 1)
		local wY = yFrac * totalHeight
		local wF = yFrac * totalForward
		local side = (i % 2 == 0) and 1 or -1
		local wPos = shaftBase + fwd * wF + right * (side * shaftHalf) + Vector3.new(0, wY, 0)
		buildAlgaeCluster(decorFolder, "ShaftAlgae_" .. i, wPos - right * (side * 1.5), fwd, roomDRng, CONFIG.vegetation.density.roomD)
		if roomDRng:NextNumber() > 0.6 then
			buildVineStrip(decorFolder, "ShaftVine_" .. i, wPos + Vector3.new(0, 4, 0), roomDRng:NextNumber(6, 14))
		end
	end

	----------------------------------------------------------------
	-- ASCENT LEGS (Sections 1-6): a real switchback climb, not a
	-- straight elevator shaft and not a floating-pillar arena.
	----------------------------------------------------------------
	local LEG_NAMES = {"ShatteredStairs", "BrokenPlatforms", "ShiftingPlatforms", "CrumblingBridge", "ChainAscent", "VerticalPillars"}
	local waypoints = {}
	waypoints[0] = shaftBase + Vector3.new(0, 2, 0)
	addOrientedPart(shaftFolder, "ShaftEntryLanding", Vector3.new(conf.landingSize + 4, 1.2, conf.landingSize + 4), waypoints[0] - Vector3.new(0, 0.6, 0), fwd, CONFIG.materials.floor, CONFIG.colors.ancientStone)

	local chainIndex, shiftIndex, warriorIndex, muralIndex = 0, 0, 0, 0
	local cumFwd, cumY = 0, 0

	for L = 1, conf.legCount do
		local legName = LEG_NAMES[L] or ("Leg" .. L)
		local legFolder = newFolder(ascentFolder, "Section_" .. L .. "_" .. legName)

		local hGain = legHeights[L]
		local fGain = legForwards[L]
		cumFwd = cumFwd + fGain
		cumY = cumY + hGain

		local sign = (L % 2 == 0) and 1 or -1
		local swing = conf.lateralSwing * (0.55 + 0.45 * roomDRng:NextNumber())
		local maxLateral = shaftHalf - conf.landingSize/2 - 3
		local lateralX = sign * math.min(swing, maxLateral)

		local startWp = waypoints[L - 1]
		local endWp = shaftBase + fwd * cumFwd + right * lateralX + Vector3.new(0, cumY + 2, 0)
		waypoints[L] = endWp

		local phase = (L <= 2) and "Doubt" or ((L <= 4) and "Desperation" or "Anger")
		local densityScale = (phase == "Doubt") and 0.6 or ((phase == "Desperation") and 1.0 or 1.5)

		if L == 1 then
			-- SECTION 1: Shattered Staircases
			buildShatteredStaircase(legFolder, "Stair", startWp, endWp, fwd, conf.landingSize * 0.8, roomDRng)

		elseif L == 2 then
			-- SECTION 2: Broken Platforms -- wall ledges linked by short broken bridges
			local mid1 = startWp:Lerp(endWp, 0.35) + right * (-sign * 6)
			local mid2 = startWp:Lerp(endWp, 0.7) + right * (sign * 4)
			buildWallLedgePlatform(legFolder, "Ledge_A", mid1, fwd, conf.landingSize * 0.75, conf.landingSize * 0.75, true, roomDRng)
			buildWallLedgePlatform(legFolder, "Ledge_B", mid2, fwd, conf.landingSize * 0.75, conf.landingSize * 0.75, true, roomDRng)
			buildBrokenBridge(legFolder, "Bridge_Approach", startWp, mid1, fwd, 6, false)
			buildBrokenBridge(legFolder, "Bridge_Exit", mid2, endWp, fwd, 6, false)
			buildChainSegment(legFolder, "SupportChain_A", mid1 + Vector3.new(0, 8, 0), mid1 + Vector3.new(0, 2, 0), 5)

		elseif L == 3 then
			-- SECTION 3: Shifting Platforms -- real static geometry now, named + tagged for future movement scripting
			local steps = 3
			for i = 1, steps do
				shiftIndex = shiftIndex + 1
				local wp = startWp:Lerp(endWp, i / (steps + 1))
				local jitter = right * (sign * ((i % 2 == 0) and -5 or 5))
				local plat = buildParkourPlatform(legFolder, string.format("RoomD_ShiftingPlatform_%02d", shiftIndex), wp + jitter, fwd, conf.landingSize * 0.7, conf.landingSize * 0.7, CONFIG.materials.wall, CONFIG.colors.ancientStone)
				plat:SetAttribute("Kind", "ShiftingPlatform")
				plat:SetAttribute("PatrolAxis", "Right")
				plat:SetAttribute("PatrolDistance", 10)
				CollectionService:AddTag(plat, "ShiftingPlatform")
			end

		elseif L == 4 then
			-- SECTION 4: Crumbling Bridge -- one long broken span across the chasm, then a short climb
			local bridgeEnd = startWp + fwd * (fGain * 0.6) + right * (lateralX * 0.6)
			buildBrokenBridge(legFolder, "MainCrumblingBridge", startWp, bridgeEnd, fwd, 8, false)
			addCollapsedMasonry(legFolder, "BridgeDebris", bridgeEnd, 6, 3)
			buildShatteredStaircase(legFolder, "PostBridgeStair", bridgeEnd, endWp, fwd, conf.landingSize * 0.7, roomDRng)

		elseif L == 5 then
			-- SECTION 5: Chain Ascent -- a genuine vertical climb between two aligned ledges
			local chainBase = startWp + right * (lateralX * 0.3)
			local chainTop = Vector3.new(chainBase.X, endWp.Y, chainBase.Z)
			buildWallLedgePlatform(legFolder, "ChainBaseLedge", chainBase, fwd, conf.landingSize * 0.7, conf.landingSize * 0.7, false, roomDRng)
			local chainCount = 3
			for c = 1, chainCount do
				chainIndex = chainIndex + 1
				local cOff = right * ((c - (chainCount + 1) / 2) * 3)
				local chain = buildChainSegment(hazardsFolder, string.format("RoomD_Chain_%02d", chainIndex), chainTop + cOff + Vector3.new(0, -2, 0), chainBase + cOff + Vector3.new(0, 3, 0), 14)
				CollectionService:AddTag(chain, "ChainClimb")
			end
			buildWallLedgePlatform(legFolder, "RestLedge", chainBase:Lerp(chainTop, 0.5) + right * 5, fwd, conf.landingSize * 0.5, conf.landingSize * 0.5, true, roomDRng)
			buildBrokenBridge(legFolder, "ChainTopLink", chainTop, endWp, fwd, 6, true)

		elseif L == 6 then
			-- SECTION 6: Vertical Pillars / Ruined Architecture -- climb via broken pillar-top ledges
			local pillarSteps = 4
			local prev = startWp
			for i = 1, pillarSteps do
				local wp = startWp:Lerp(endWp, i / pillarSteps)
				local pOff = right * (sign * (2 + i))
				buildStonePillar(legFolder, "RuinPillar_" .. i, wp - Vector3.new(0, 12, 0) + pOff, 12, 2.4, CONFIG.materials.wall, CONFIG.colors.ancientStone, false)
				buildWallLedgePlatform(legFolder, "PillarLedge_" .. i, wp + pOff, fwd, conf.landingSize * 0.65, conf.landingSize * 0.65, (i % 2 == 0), roomDRng)
				buildBrokenBridge(legFolder, "PillarLink_" .. i, prev, wp + pOff, fwd, 5, i == 1)
				prev = wp + pOff
			end
			buildBrokenBridge(legFolder, "FinalPillarLink", prev, endWp, fwd, 6, false)
		end

		-- Landing platform at the end of every leg: always solid, always a safe checkpoint
		buildWallLedgePlatform(legFolder, "Landing_" .. L, endWp, fwd, conf.landingSize, conf.landingSize, false, roomDRng)
		addCheckpoint(markersFolder, string.format("RoomD_Checkpoint_%02d", L), endWp)

		-- Environmental storytelling scaled to the psychological phase (Doubt -> Desperation -> Anger)
		local warriorsThisLeg = (phase == "Doubt") and 1 or ((phase == "Desperation") and 2 or 3)
		for w = 1, warriorsThisLeg do
			warriorIndex = warriorIndex + 1
			local wp = startWp:Lerp(endWp, w / (warriorsThisLeg + 1)) + right * (-sign * roomDRng:NextNumber(4, 8))
			buildFallenWarrior(warriorsFolder, "Warrior_" .. warriorIndex, wp, fwd, nil, roomDRng)
		end

		if L >= 3 and muralIndex < conf.muralCount then
			muralIndex = muralIndex + 1
			local mSide = (L % 2 == 0) and -right or right
			local muralSize = 14 + muralIndex * 2
			buildDragonMural(muralsFolder, "Mural_" .. muralIndex, endWp + mSide * (shaftHalf - 1) - fwd * 4, -mSide, muralSize, muralSize * 0.55)
		end

		if L % 2 == 1 then
			buildSunlightShaft(decorFolder, "ShaftSun_" .. L, endWp + Vector3.new(0, 14, 0), 10 + L * 1.5, 16 + L * 2)
		end

		if roomDRng:NextNumber() < densityScale * 0.5 then
			addCollapsedMasonry(legFolder, "PhaseRubble_" .. L, endWp + right * (sign * 5), 5, 3)
		end
	end

	----------------------------------------------------------------
	-- SECTION 8: FINAL SUMMIT APPROACH -- the most intact stretch;
	-- structurally, the trial is almost over.
	----------------------------------------------------------------
	local lastWp = waypoints[conf.legCount]
	local finalTop = lastWp + fwd * conf.finalStairLength + Vector3.new(0, conf.finalStairHeight, 0)
	local finalStairFolder = newFolder(ascentFolder, "Section_8_FinalApproach")
	buildShatteredStaircase(finalStairFolder, "FinalStair", lastWp, finalTop, fwd, conf.landingSize, roomDRng)
	buildAncientArch(finalStairFolder, "SummitThreshold", finalTop - fwd * 2, fwd, conf.landingSize, 18, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	buildSunlightShaft(decorFolder, "FinalSun", finalTop + Vector3.new(0, 20, 0), 20, 30)
	buildStatue(finalStairFolder, "GuardianRemnant_L", finalTop - right * (conf.landingSize/2 + 2), fwd, 9, "guarding")
	buildStatue(finalStairFolder, "GuardianRemnant_R", finalTop + right * (conf.landingSize/2 + 2), fwd, 9, "guarding")

	----------------------------------------------------------------
	-- WARRIOR ECHO TRIGGERS -- positioned on the real ascent path
	----------------------------------------------------------------
	local echoStages = {"Doubt", "Desperation", "Anger", "Silence"}
	local echoWaypointIdx = {2, 4, 6, conf.legCount}
	for i = 1, #echoStages do
		local idx = math.min(echoWaypointIdx[i], conf.legCount)
		local ePos = waypoints[idx]
		local echo = Instance.new("Model")
		echo.Name = "RoomD_Echo_" .. i
		echo.Parent = echoesFolder

		newPart({
			Name = "EchoTrigger", Size = Vector3.new(shaftWidth, 20, 20),
			CFrame = CFrame.new(ePos), Transparency = 1, CanCollide = false, CanQuery = true, Parent = echo
		})
		echo:SetAttribute("EchoStage", echoStages[i])
		echo:SetAttribute("EchoIndex", i)
		CollectionService:AddTag(echo, "WarriorEcho")
	end

	----------------------------------------------------------------
	-- MARKERS
	----------------------------------------------------------------
	addCheckpoint(markersFolder, "RoomD_Mid", waypoints[3])
	addCheckpoint(markersFolder, "RoomD_End", finalTop)

	return folder, finalTop
end

----------------------------------------------------------------------
-- SUMMIT + MAIN GENERATOR
----------------------------------------------------------------------

local function buildSummit(root, basePosition, forward)
	local folder = newFolder(root, "Summit")
	local geoFolder = newFolder(folder, "Geometry")
	local ruinsFolder = newFolder(folder, "Ruins")
	local cineFolder = newFolder(folder, "CinematicMarkers")

	local fwd = unitXZ(forward)
	local right = getRight(fwd)
	local center = basePosition + fwd * (CONFIG.summit.depth / 2)
	local dRng = Random.new(20260902)

	-- Stepped monumental platform
	addOrientedPart(geoFolder, "SummitFloor_Step1",
		Vector3.new(CONFIG.summit.width, 1, CONFIG.summit.depth),
		center + Vector3.new(0, -0.5, 0),
		fwd, CONFIG.materials.floor, CONFIG.colors.ancientStone)
		
	addOrientedPart(geoFolder, "SummitFloor_Step2",
		Vector3.new(CONFIG.summit.width - 6, 1, CONFIG.summit.depth - 6),
		center + Vector3.new(0, 0.5, 0),
		fwd, CONFIG.materials.floor, CONFIG.colors.ancientStone)
		
	addOrientedPart(geoFolder, "SummitFloor_Step3",
		Vector3.new(CONFIG.summit.width - 12, 1, CONFIG.summit.depth - 12),
		center + Vector3.new(0, 1.5, 0),
		fwd, CONFIG.materials.floor, CONFIG.colors.wall)

	-- Colossal statues framing the exit
	local exitPos = center + fwd * (CONFIG.summit.depth/2 - 4)
	buildStatue(geoFolder, "GuardianStatue_L", exitPos - right * 14 + Vector3.new(0, 1.5, 0), fwd, 15, "standing")
	buildStatue(geoFolder, "GuardianStatue_R", exitPos + right * 14 + Vector3.new(0, 1.5, 0), fwd, 15, "standing")

	-- Exit Arch (Monumental)
	buildAncientArch(geoFolder, "ExitArch_Main", exitPos + Vector3.new(0, 1.5, 0), fwd, 20, 25, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	buildAncientArch(geoFolder, "ExitArch_Inner", exitPos + fwd * 2 + Vector3.new(0, 1.5, 0), fwd, 16, 20, CONFIG.materials.wall, CONFIG.colors.wallDark)

	-- Low broken walls around edges
	local h = CONFIG.summit.wallHeight
	addOrientedPart(geoFolder, "WallL",
		Vector3.new(2, h, CONFIG.summit.depth * 0.8),
		center - right * (CONFIG.summit.width/2 - 1) + Vector3.new(0, h/2, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	addOrientedPart(geoFolder, "WallR",
		Vector3.new(2, h, CONFIG.summit.depth * 0.8),
		center + right * (CONFIG.summit.width/2 - 1) + Vector3.new(0, h/2, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.ancientStone)

	-- Ruins and debris
	for r = 1, 6 do
		local rPos = center + right * ((r%2==0) and 18 or -18) + fwd * ((dRng:NextNumber()-0.5)*30)
		buildStonePillar(ruinsFolder, "BrokenPillar_"..r, rPos, 12 + dRng:NextNumber()*10, 3, CONFIG.materials.wall, CONFIG.colors.ancientStone, true)
	end
	addCollapsedMasonry(ruinsFolder, "Rubble_1", center - right*20, 10, 6)
	addCollapsedMasonry(ruinsFolder, "Rubble_2", center + right*20 + fwd*10, 8, 5)

	-- Cinematic lighting
	buildSunlightShaft(geoFolder, "SummitSun", center + Vector3.new(0, 40, 0), 20, 40)

	-- Cinematic Markers
	local function addCine(name, pos)
		newPart({Name = name, Size = Vector3.new(1,1,1), CFrame = CFrame.new(pos), Transparency = 1, CanCollide = false, Parent = cineFolder})
	end

	addCine("RoomD_Summit", center)
	addCine("RoomD_FinalView", center - fwd * (CONFIG.summit.depth/2 - 2))
	addCine("RoomD_AcademyView", center + fwd * (CONFIG.summit.depth/2 - 2))
	addCine("RoomD_DragonRevealPoint", center + fwd * 30 + Vector3.new(0, 40, 0))
	addCine("RoomD_VisionPoint", center)
	addCine("RoomD_ProctorFinalDialoguePoint", center + right * 8)
	addCine("TrialChamber_Exit", exitPos)

	addCheckpoint(cineFolder, "TrialChamber_Exit_Check", exitPos)

	return folder
end

local function generateTrialChamber()
	local existing = workspace:FindFirstChild("TrialChamberV2")
	if existing then
		existing:Destroy()
	end
	
	local root = Instance.new("Model")
	root.Name = "TrialChamberV2"
	
	local origin = CONFIG.layout.origin
	local forward = unitXZ(CONFIG.layout.progressionAxis)
	local right = getRight(forward)
	local cursor = origin
	
	print("=== Trial Chamber V2: Linear Progression ===")
	print("Origin:", origin)
	
	-- START
	local startFolder = newFolder(root, "Start")
	buildAncientArch(startFolder, "EntranceArch", cursor, forward, CONFIG.transitions.corridorWidth, CONFIG.transitions.corridorHeight, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	addCheckpoint(startFolder, "TrialChamber_Start", cursor)
	
	local _, startExitPos = buildStandardTransition(root, "Entrance_Corridor", cursor, forward)
	cursor = startExitPos + forward * CONFIG.layout.roomGap
	
	-- ROOM A
	print("Building Room A: Trap Corridor...")
	local roomAFolder, roomAExit = buildRoomA(root, cursor, forward)
	cursor = roomAExit
	
	-- TRANSITION A -> B
	cursor = cursor + Vector3.new(0, CONFIG.layout.verticalStep, 0)
	local transFolderAB = newFolder(root, "Transition_A_B")
	-- Massive ancient gate leading to the courtyard -- this announces
	-- "the first trial is complete", so it gets real mechanical weight:
	-- a working-looking portcullis between two monumental arches.
	buildAncientArch(transFolderAB, "Gate_A_B_Outer", cursor + forward * 2, forward, 22, 24, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	buildAncientArch(transFolderAB, "Gate_A_B_Inner", cursor + forward * 4, forward, 18, 20, CONFIG.materials.wall, CONFIG.colors.wallDark)
	buildPortcullisDoor(transFolderAB, "Gate_A_B_Portcullis", cursor + forward * 6, forward, 16, 18)
	buildDoorFrame(transFolderAB, "Gate_A_B_Frame", cursor + forward * 8, forward, 16, 18, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	buildBanner(transFolderAB, "Gate_A_B_BannerL", cursor + forward * 2 - right * 13 + Vector3.new(0, 22, 0), forward, 9, 3)
	buildBanner(transFolderAB, "Gate_A_B_BannerR", cursor + forward * 2 + right * 13 + Vector3.new(0, 22, 0), forward, 9, 3)
	buildAlgaeCluster(transFolderAB, "Gate_A_B_Algae_L", cursor + forward * 2 - right * 11, forward, random, 1.0)
	buildAlgaeCluster(transFolderAB, "Gate_A_B_Algae_R", cursor + forward * 2 + right * 11, forward, random, 1.0)
	
	local _, transABExit = buildStandardTransition(transFolderAB, "Corridor", cursor, forward)
	cursor = transABExit + forward * CONFIG.layout.roomGap
	
	-- ROOM B
	print("Building Room B: Combat Courtyard...")
	local roomBFolder, roomBExit = buildRoomB(root, cursor, forward)
	cursor = roomBExit
	
	-- TRANSITION B -> C
	cursor = cursor + Vector3.new(0, CONFIG.layout.verticalStep, 0)
	local transFolderBC = newFolder(root, "Transition_B_C")
	-- Sacred Sanctuary Gate -- deliberately NOT barred like the A->B gate;
	-- this one should feel inviting and mysterious, not mechanical.
	buildAncientArch(transFolderBC, "Gate_B_C_Sacred", cursor + forward * 2, forward, 14, 18, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	addPilaster(transFolderBC, "SacredPillarL", cursor + forward * 2 - right * 9, forward, 20, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	addPilaster(transFolderBC, "SacredPillarR", cursor + forward * 2 + right * 9, forward, 20, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	buildBanner(transFolderBC, "Gate_B_C_BannerL", cursor + forward * 2 - right * 9 + Vector3.new(0, 19, 0), forward, 7, 2.5)
	buildBanner(transFolderBC, "Gate_B_C_BannerR", cursor + forward * 2 + right * 9 + Vector3.new(0, 19, 0), forward, 7, 2.5)
	buildAlgaeCluster(transFolderBC, "Gate_B_C_Algae_L", cursor + forward * 2 - right * 8, forward, random, 1.4)
	buildAlgaeCluster(transFolderBC, "Gate_B_C_Algae_R", cursor + forward * 2 + right * 8, forward, random, 1.4)
	do
		local motePos = cursor + forward * 2 + Vector3.new(0, 12, 0)
		local mote = newPart({Name = "Gate_B_C_SacredGlow", Size = Vector3.new(1,1,1), CFrame = CFrame.new(motePos), Transparency = 1, CanCollide = false, Parent = transFolderBC})
		addGlow(mote, CONFIG.colors.sacred, 16, 1.2)
	end
	
	local _, transBCExit = buildStandardTransition(transFolderBC, "Corridor", cursor, forward)
	cursor = transBCExit + forward * CONFIG.layout.roomGap
	
	-- ROOM C
	print("Building Room C: Oasis Sanctuary...")
	local roomCFolder, roomCExit = buildRoomC(root, cursor, forward)
	cursor = roomCExit
	
	-- COLLAPSE TRANSITION C -> D
	cursor = cursor + Vector3.new(0, CONFIG.layout.verticalStep, 0)
	local _, collapseExit = buildCollapseTransition(root, cursor, forward)
	cursor = collapseExit + forward * CONFIG.layout.roomGap
	
	-- ROOM D
	print("Building Room D: Ascent of Echoes...")
	local roomDFolder, roomDEnd = buildRoomD(root, cursor, forward)
	
	-- SUMMIT
	print("Building Summit...")
	buildSummit(root, roomDEnd, forward)
	
	-- Count parts
	local partCount = 0
	for _, desc in ipairs(root:GetDescendants()) do
		if desc:IsA("BasePart") then
			partCount = partCount + 1
		end
	end
	
	root.Parent = workspace
	
	print("=== Trial Chamber V2 Complete ===")
	print("Total parts:", partCount)
	print("Structure: START -> A -> B -> C -> D -> SUMMIT -> EXIT")
end

generateTrialChamber()
