    local finalW = math.max(width, minW)
    local finalD = math.max(depth, minW)
    return addOrientedPart(parent, name, Vector3.new(finalW, 1, finalD), position - Vector3.new(0, 0.5, 0), forward, material, color)
end

local function buildBrokenBridge(parent, name, startPosition, endPosition, forward, bridgeWidth, intact)
    local model = newFolder(parent, name)
    local diff = endPosition - startPosition
    local dist = diff.Magnitude
    local fwd = unitXZ(diff)
    local thick = 1.5
    
    if intact then
        local pos = startPosition + diff/2 - Vector3.new(0, thick/2, 0)
        addOrientedPart(model, "Span", Vector3.new(bridgeWidth, thick, dist), pos, fwd, CONFIG.materials.wall, CONFIG.colors.ancientStone)
    else
        local span1 = dist * 0.3
        local span2 = dist * 0.25
        
        local pos1 = startPosition + fwd*(span1/2) - Vector3.new(0, thick/2, 0)
        addOrientedPart(model, "Span1", Vector3.new(bridgeWidth, thick, span1), pos1, fwd, CONFIG.materials.wall, CONFIG.colors.ancientStone)
        
        local pos2 = endPosition - fwd*(span2/2) - Vector3.new(0, thick/2, 0)
        addOrientedPart(model, "Span2", Vector3.new(bridgeWidth, thick, span2), pos2, fwd, CONFIG.materials.wall, CONFIG.colors.ancientStone)
        
        addRubblePile(model, "BridgeRubble", startPosition + fwd*span1 - Vector3.new(0, thick, 0), 6, bridgeWidth/2)
        addRubblePile(model, "BridgeRubble2", endPosition - fwd*span2 - Vector3.new(0, thick, 0), 4, bridgeWidth/2)
    end
    
    return model
end

local function buildSunlightShaft(parent, name, topPosition, beamWidth, beamHeight)
    local model = newFolder(parent, name)
    local pos = topPosition - Vector3.new(0, beamHeight/2, 0)
    
    local beam = newPart({
        Name = "Shaft",
        Size = Vector3.new(beamWidth, beamHeight, beamWidth),
        CFrame = CFrame.new(pos),
        Shape = Enum.PartType.Cylinder,
        Material = Enum.Material.Neon,
        Color = CONFIG.colors.skyLight,
        Transparency = 0.85,
        CanCollide = false,
        CanQuery = false,
        Parent = model
    })
    
    -- cylinder is oriented along X naturally, need to flip it
    beam.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.pi/2)
    
    local light = Instance.new("SpotLight")
    light.Color = CONFIG.colors.skyLight
    light.Range = beamHeight * 1.5
    light.Brightness = CONFIG.lighting.sunlightBrightness
    light.Angle = 45
    light.Face = Enum.NormalId.Bottom
    light.Parent = beam
    
    return model
end

