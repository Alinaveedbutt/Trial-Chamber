local function buildSpikeTrap(parent, name, floorPosition, forward)
    local model = Instance.new("Model")
    model.Name = name
    model.Parent = parent
    
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    local cf = orientedCFrame(floorPosition, fwd)
    
    local conf = CONFIG.spikeTrap
    local hw = conf.width
    local hd = conf.depth
    
    local housingLow = addOrientedPart(model, "HousingLow", Vector3.new(hw + conf.housingMargin, conf.housingLowHeight, hd + conf.housingMargin), floorPosition + Vector3.new(0, conf.housingLowHeight/2, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wall)
    local housingCap = addOrientedPart(model, "HousingCap", Vector3.new(hw + conf.housingMargin - 0.4, conf.housingCapHeight, hd + conf.housingMargin - 0.4), floorPosition + Vector3.new(0, conf.housingLowHeight + conf.housingCapHeight/2, 0), fwd, CONFIG.materials.trim, CONFIG.colors.trim)
    
    local gear = addOrientedPart(model, "GearMedallion", Vector3.new(1.5, 1.5, 0.4), floorPosition + Vector3.new(0, conf.housingLowHeight, 0) + fwd * ((hd + conf.housingMargin)/2 + 0.2), fwd, CONFIG.materials.metal, CONFIG.colors.metal)
    
    local pitPos = floorPosition - Vector3.new(0, conf.pitDepth/2, 0)
    local pitFloor = addOrientedPart(model, "PitFloor", Vector3.new(hw, 0.5, hd), pitPos, fwd, CONFIG.materials.floor, CONFIG.colors.metal)
    
    local pW = hw
    local plankW = (hd - (conf.plankCount + 1)*conf.plankGap) / conf.plankCount
    for i=1, conf.plankCount do
        local offsetZ = -hd/2 + conf.plankGap*i + plankW*(i - 0.5)
        local pPos = floorPosition + fwd * offsetZ + Vector3.new(0, -0.2, 0)
        addOrientedPart(model, "Plank_"..i, Vector3.new(pW, 0.4, plankW), pPos, fwd, CONFIG.materials.wood, CONFIG.colors.wood)
    end
    
    local bedModel = Instance.new("Model")
    bedModel.Name = "SpikeBed"
    bedModel.Parent = model
    
    local bedPlate = addOrientedPart(bedModel, "BedPlate", Vector3.new(hw - 1, 0.4, hd - 1), floorPosition + Vector3.new(0, conf.restOffsetY, 0), fwd, CONFIG.materials.metal, CONFIG.colors.spikeSteel)
    bedModel.PrimaryPart = bedPlate
    
    for i=1, conf.plankCount - 1 do
        local offsetZ = -hd/2 + conf.plankGap*(i+0.5) + plankW*i
        for j=1, conf.spikeCols do
            local frac = j/(conf.spikeCols+1)
            local offsetX = -hw/2 + hw*frac
            local spikeBase = cf * CFrame.new(offsetX, conf.restOffsetY + 0.2 + conf.spikeHeight/2, offsetZ)
            
            -- Create a sharp pointed wedge shape from two wedges
            local s1 = newPart({
                Name = "SpikeHalf1",
                Size = Vector3.new(conf.spikeBaseRadius*2, conf.spikeHeight, conf.spikeBaseRadius),
                CFrame = spikeBase * CFrame.new(0, 0, conf.spikeBaseRadius/2),
                Shape = Enum.PartType.Wedge,
                Material = CONFIG.materials.spikeSteel, Color = CONFIG.colors.spikeSteel, Parent = bedModel
            })
            local s2 = newPart({
                Name = "SpikeHalf2",
                Size = Vector3.new(conf.spikeBaseRadius*2, conf.spikeHeight, conf.spikeBaseRadius),
                CFrame = spikeBase * CFrame.new(0, 0, -conf.spikeBaseRadius/2) * CFrame.Angles(0, math.pi, 0),
                Shape = Enum.PartType.Wedge,
                Material = CONFIG.materials.spikeSteel, Color = CONFIG.colors.spikeSteel, Parent = bedModel
            })
        end
    end
    
    model:SetAttribute("Kind", "SpikeTrap")
    model:SetAttribute("CycleSeconds", conf.cycleSeconds)
    model:SetAttribute("Damage", conf.damage)
    model:SetAttribute("RestOffsetY", conf.restOffsetY)
    model:SetAttribute("ExtendOffsetY", conf.extendOffsetY)
    
    CollectionService:AddTag(model, "SpikeTrap")
    
    return model
end

local function buildSwingingBlade(parent, name, pivotPosition, forward)
    local model = Instance.new("Model")
    model.Name = name
    model.Parent = parent
    
    local conf = CONFIG.swingingBlade
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    
    local mount = addOrientedPart(model, "Mount", Vector3.new(4, 1, 4), pivotPosition + Vector3.new(0, conf.mountDrop, 0), fwd, CONFIG.materials.metal, CONFIG.colors.metal)
    
    local axle = addOrientedPart(model, "Axle", Vector3.new(conf.axleLength, 0.6, 0.6), pivotPosition, right, CONFIG.materials.metal, CONFIG.colors.metal)
    
    local arm = addOrientedPart(model, "Arm", Vector3.new(0.6, conf.armLength, 1.2), pivotPosition - Vector3.new(0, conf.armLength/2, 0), fwd, CONFIG.materials.metal, CONFIG.colors.metal)
    
    local bladeHubPos = pivotPosition - Vector3.new(0, conf.armLength, 0)
    local bladeHubCFrame = CFrame.new(bladeHubPos) * CFrame.Angles(0, math.pi/2, 0)
    
    local blade = newPart({
        Name = "BladeDisc",
        Size = Vector3.new(0.4, conf.bladeRadius*2, conf.bladeRadius*2),
        CFrame = bladeHubCFrame,
        Shape = Enum.PartType.Cylinder,
        Material = CONFIG.materials.metal,
        Color = CONFIG.colors.metal,
        Parent = model
    })

    -- Central hub: thicker, darker disc bolted to the axle -- the part of
    -- a real cutting blade that reads immediately as "this spins".
    newPart({
        Name = "Hub",
        Size = Vector3.new(0.7, conf.bladeRadius*0.7, conf.bladeRadius*0.7),
        CFrame = bladeHubCFrame,
        Shape = Enum.PartType.Cylinder,
        Material = CONFIG.materials.metal,
        Color = CONFIG.colors.spikeSteel,
        Parent = model
    })
    for b = 1, 6 do
        local ba = (b/6) * math.pi * 2
        newPart({
            Name = "HubBolt_"..b,
            Size = Vector3.new(0.75, 0.35, 0.35),
            CFrame = bladeHubCFrame * CFrame.Angles(ba, 0, 0) * CFrame.new(0, conf.bladeRadius*0.28, 0),
            Shape = Enum.PartType.Cylinder,
            Material = CONFIG.materials.metal,
            Color = CONFIG.colors.metal,
            Parent = model
        })
    end

    -- Worn/rust ring near the outer edge -- breaks up the flat plate look
    newPart({
        Name = "WearRing",
        Size = Vector3.new(0.44, conf.bladeRadius*1.82, conf.bladeRadius*1.82),
        CFrame = bladeHubCFrame,
        Shape = Enum.PartType.Cylinder,
        Material = CONFIG.materials.spikeSteel,
        Color = CONFIG.colors.rubble,
        Transparency = 0.55,
        Parent = model
    })
    
    -- Serrated teeth around the disc, alternating long/short for a less
    -- uniform, more aggressively "cutting" silhouette
    local numTeeth = 16
    for t = 1, numTeeth do
        local angle = (t / numTeeth) * math.pi * 2
        local toothCF = bladeHubCFrame * CFrame.Angles(angle, 0, 0) * CFrame.new(0, conf.bladeRadius, 0) * CFrame.Angles(math.pi/4, 0, 0)
        local toothLen = (t % 2 == 0) and 1.4 or 1.0
        local tooth = newPart({
            Name = "Tooth_"..t,
            Size = Vector3.new(0.3, toothLen, toothLen),
            CFrame = toothCF,
            Material = CONFIG.materials.metal,
            Color = CONFIG.colors.spikeSteel,
            Parent = model
        })
    end
    
    model.PrimaryPart = axle
    
    model:SetAttribute("Kind", "SwingingBlade")
    model:SetAttribute("SwingAxis", right)
    model:SetAttribute("SwingDegrees", conf.swingDegrees)
    model:SetAttribute("PeriodSeconds", conf.periodSeconds)
    model:SetAttribute("Damage", conf.damage)
    
    CollectionService:AddTag(model, "SwingingBlade")
    
    return model
end

local function buildPortcullisDoor(parent, name, floorPosition, forward, doorWidth, roomHeight)
    local model = Instance.new("Model")
    model.Name = name
    model.Parent = parent
    
    local fwd = unitXZ(forward)
    local right = getRight(fwd)
    local conf = CONFIG.portcullis
    local h = roomHeight * conf.leafHeightRatio
    
    local jambW = 2
    local pPos1 = floorPosition - right * (doorWidth/2 + jambW/2) + Vector3.new(0, roomHeight/2, 0)
    local pPos2 = floorPosition + right * (doorWidth/2 + jambW/2) + Vector3.new(0, roomHeight/2, 0)
    
    addOrientedPart(model, "JambLeft", Vector3.new(jambW, roomHeight, jambW), pPos1, fwd, CONFIG.materials.wall, CONFIG.colors.wall)
    addOrientedPart(model, "JambRight", Vector3.new(jambW, roomHeight, jambW), pPos2, fwd, CONFIG.materials.wall, CONFIG.colors.wall)
    
    local lintelPos = floorPosition + Vector3.new(0, roomHeight - jambW/2, 0)
    addOrientedPart(model, "Lintel", Vector3.new(doorWidth + jambW*2, jambW, jambW), lintelPos, fwd, CONFIG.materials.wall, CONFIG.colors.wall)
    
    local leaf = Instance.new("Model")
    leaf.Name = "Leaf"
    leaf.Parent = model
    
    local closedY = h/2
    local openY = roomHeight - h/2
    
    local leafBase = addOrientedPart(leaf, "LeafBase", Vector3.new(doorWidth, 0.4, 0.4), floorPosition + Vector3.new(0, closedY, 0), fwd, CONFIG.materials.metal, CONFIG.colors.metal)
    leaf.PrimaryPart = leafBase
    
    for i=1, conf.verticalBars do
        local frac = i/(conf.verticalBars+1)
        local bx = -doorWidth/2 + doorWidth*frac
        local bPos = floorPosition + Vector3.new(0, closedY, 0) + right * bx
        addOrientedPart(leaf, "VBar_"..i, Vector3.new(0.6, h, 0.6), bPos, fwd, CONFIG.materials.metal, CONFIG.colors.metal)
    end
    
    for i=1, conf.horizontalBars do
        local frac = i/(conf.horizontalBars+1)
        local by = h * frac
        local bPos = floorPosition + Vector3.new(0, by, 0)
        addOrientedPart(leaf, "HBar_"..i, Vector3.new(doorWidth, 0.6, 0.6), bPos, fwd, CONFIG.materials.metal, CONFIG.colors.metal)
    end
    
    model:SetAttribute("Kind", "SealingDoor")
    model:SetAttribute("ClosedOffsetY", closedY)
    model:SetAttribute("OpenOffsetY", openY)
    model:SetAttribute("TriggerType", "None")
    
    CollectionService:AddTag(model, "SealingDoor")
    
    return model
end

local function addCollapsedMasonry(parent, name, centerPosition, chunkCount, spreadRadius)
    local model = newFolder(parent, name)
    for i=1, chunkCount do
        local size = Vector3.new(random:NextNumber(2, 4), random:NextNumber(1, 2.5), random:NextNumber(2, 4))
        local rx = random:NextNumber(-spreadRadius, spreadRadius)
        local rz = random:NextNumber(-spreadRadius, spreadRadius)
        local pos = centerPosition + Vector3.new(rx, size.Y/2, rz)
        newPart({
            Name = "Block_"..i,
            Size = size,
            CFrame = CFrame.new(pos) * CFrame.Angles(random:NextNumber(-0.2,0.2), random:NextNumber(0, math.pi*2), random:NextNumber(-0.2,0.2)),
            Material = CONFIG.materials.wall,
            Color = CONFIG.colors.ancientStone,
            Parent = model
        })
    end
    return model
end

local function addBrokenSupport(parent, name, basePosition, forward, fullHeight, breakHeight)
    local model = newFolder(parent, name)
    local w = 2.5
    local pos1 = basePosition + Vector3.new(0, breakHeight/2, 0)
    addOrientedPart(model, "Stub", Vector3.new(w, breakHeight, w), pos1, forward, CONFIG.materials.wall, CONFIG.colors.ancientStone)
    
    local rem = fullHeight - breakHeight
    local fwd = unitXZ(forward)
    local pos2 = basePosition + fwd * (rem/2 + 2) + Vector3.new(0, w/2, 0)
    local fallen = addOrientedPart(model, "Fallen", Vector3.new(w, rem, w), pos2, forward, CONFIG.materials.wall, CONFIG.colors.ancientStone)
    fallen.CFrame = fallen.CFrame * CFrame.Angles(math.pi/2, random:NextNumber(-0.3,0.3), 0)
    
    return model
end

local function addCrackedFloorPatch(parent, name, centerPosition, forward, patchWidth, patchDepth)
    local model = newFolder(parent, name)
    local fwd = unitXZ(forward)
    local cf = orientedCFrame(centerPosition, fwd)
    
    local base = newPart({
        Name = "PatchBase",
        Size = Vector3.new(patchWidth, 0.2, patchDepth),
        CFrame = cf * CFrame.new(0, 0.1, 0),
        Material = CONFIG.materials.floor,
        Color = CONFIG.colors.floor,
        Parent = model
    })
    
    for i=1, 6 do
        local cw = random:NextNumber(patchWidth*0.1, patchWidth*0.3)
        local cd = random:NextNumber(patchDepth*0.1, patchDepth*0.3)
        local cx = random:NextNumber(-patchWidth/2 + cw/2, patchWidth/2 - cw/2)
        local cz = random:NextNumber(-patchDepth/2 + cd/2, patchDepth/2 - cd/2)
        newPart({
            Name = "Chip_"..i,
            Size = Vector3.new(cw, 0.25, cd),
            CFrame = cf * CFrame.new(cx, 0.15, cz) * CFrame.Angles(0, random:NextNumber(0, math.pi*2), 0),
            Material = CONFIG.materials.rubble,
            Color = CONFIG.colors.crack,
            Parent = model
        })
    end
    
    return model
end

local function addWarningCarving(parent, name, wallFloorPosition, forward, mountHeight)
    local model = newFolder(parent, name)
    local fwd = unitXZ(forward)
    local pos = wallFloorPosition + Vector3.new(0, mountHeight, 0)
    
    local panel = addOrientedPart(model, "Panel", Vector3.new(4, 4, 0.5), pos, fwd, CONFIG.materials.wall, CONFIG.colors.danger)
    
    for i=1, 3 do
        local sx = random:NextNumber(-1, 1)
        local sy = random:NextNumber(-1, 1)
        addOrientedPart(model, "Glyph_"..i, Vector3.new(0.5, 0.1, 0.6), pos + fwd*0.1 + Vector3.new(sx, sy, 0), fwd, CONFIG.materials.neon, CONFIG.colors.danger)
    end
    
    return model
end

local function addCheckpoint(parent, name, position)
    local part = newPart({
        Name = name,
        Size = Vector3.new(5, 0.25, 5),
        CFrame = CFrame.new(position + Vector3.new(0, 0.125, 0)),
        Material = Enum.Material.Neon,
        Color = CONFIG.colors.portal,
        Transparency = 0.7,
        CanCollide = false,
        CanQuery = true,
        Parent = parent
    })
    addGlow(part, CONFIG.colors.portal, 10, 1)
    return part
end


----------------------------------------------------------------------
-- TRANSITION CORRIDOR
----------------------------------------------------------------------

local function buildTransitionCorridor(root, name, startPosition, forward, length, style)
	local folder = newFolder(root, name)
	local geomFolder = newFolder(folder, "Geometry")
	local decFolder = newFolder(folder, "Decoration")

	local width = CONFIG.transitions.corridorWidth
	local height = CONFIG.transitions.corridorHeight
	local halfWidth = width / 2
	local wallThick = CONFIG.transitions.wallThickness
	local fwd = unitXZ(forward)
	local right = getRight(fwd)

	local center = startPosition + fwd * (length / 2)
	local floorY = startPosition.Y

	-- Floor
	addOrientedPart(geomFolder, "Floor",
		Vector3.new(width, 1, length),
		center + Vector3.new(0, -0.5, 0),
		fwd, CONFIG.materials.floor, CONFIG.colors.floor)

	-- Ceiling
	addOrientedPart(geomFolder, "Ceiling",
		Vector3.new(width, 1, length),
		center + Vector3.new(0, height + 0.5, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wallDark)

	-- Left Wall
	addOrientedPart(geomFolder, "LeftWall",
		Vector3.new(wallThick, height, length),
		center - right * (halfWidth + wallThick / 2) + Vector3.new(0, height / 2, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wall)

	-- Right Wall
	addOrientedPart(geomFolder, "RightWall",
		Vector3.new(wallThick, height, length),
		center + right * (halfWidth + wallThick / 2) + Vector3.new(0, height / 2, 0),
		fwd, CONFIG.materials.wall, CONFIG.colors.wall)

	-- Cornice + Baseboard on both walls
	local leftFacePos = startPosition - right * halfWidth
	local rightFacePos = startPosition + right * halfWidth

	addCorniceBand(decFolder, "CorniceL", leftFacePos, fwd, length, height, CONFIG.materials.trim, CONFIG.colors.trim)
	addCorniceBand(decFolder, "CorniceR", rightFacePos, fwd, length, height, CONFIG.materials.trim, CONFIG.colors.trim)
	addBaseboardBand(decFolder, "BaseboardL", leftFacePos, fwd, length, CONFIG.materials.trim, CONFIG.colors.trim)
	addBaseboardBand(decFolder, "BaseboardR", rightFacePos, fwd, length, CONFIG.materials.trim, CONFIG.colors.trim)

	-- Ceiling beams
	layCeilingBeams(decFolder, "Beam", startPosition, fwd, width, height, 4, length - 4, CONFIG.materials.wood, CONFIG.colors.wood)

	-- Torches
	if style == "collapse" then
		local rng = Random.new(math.floor(math.abs(startPosition.X + startPosition.Z)) + 7777)
		for t = CONFIG.detail.torchSpacing, length - 10, CONFIG.detail.torchSpacing * 2 do
			if rng:NextNumber() > 0.3 then
				addWallTorch(decFolder, "TorchL_" .. t, startPosition - right * halfWidth + fwd * t, right, CONFIG.detail.torchHeight)
			end
			if rng:NextNumber() > 0.3 then
				addWallTorch(decFolder, "TorchR_" .. t, startPosition + right * halfWidth + fwd * t, -right, CONFIG.detail.torchHeight)
			end
		end
		-- Debris
		for i = 1, 3 do
			local zOff = rng:NextNumber() * (length - 20) + 10
			addCollapsedMasonry(decFolder, "Rubble_" .. i,
				startPosition + fwd * zOff + right * (rng:NextNumber() - 0.5) * (width - 6),
				5, 3)
		end
	else
		layWallTorches(decFolder, "TorchL", startPosition - right * halfWidth, fwd, right, 5, length - 5)
		layWallTorches(decFolder, "TorchR", startPosition + right * halfWidth, fwd, -right, 5, length - 5)
	end

	-- Door frames
	buildDoorFrame(geomFolder, "EntryFrame", startPosition + Vector3.new(0, 0, 0), fwd, width, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)

	local exitPosition = startPosition + fwd * length
	buildDoorFrame(geomFolder, "ExitFrame", exitPosition, fwd, width, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)

	return folder, exitPosition
end

----------------------------------------------------------------------
-- ROOM A: TRAP CORRIDOR
----------------------------------------------------------------------

local function buildRoomA(root, entrancePosition, forward)
	local folder = newFolder(root, "RoomA_TrapCorridor")
	local geomFolder = newFolder(folder, "Geometry")
	local hazFolder = newFolder(folder, "Hazards")
	local decFolder = newFolder(folder, "Decoration")
	local markersFolder = newFolder(folder, "Markers")

	local width = CONFIG.roomA.width
	local height = CONFIG.roomA.height
	local length = CONFIG.roomA.length
	local halfWidth = width / 2
	local wallThick = 2
	local fwd = unitXZ(forward)
	local right = getRight(fwd)

	local center = entrancePosition + fwd * (length / 2)

	-- The main continuous floor and ceiling are removed, 
	-- as they are now handled entirely by the segment generator to allow cracks/gaps.

	-- Entrance door frame
	buildDoorFrame(geomFolder, "EntranceDoor", entrancePosition, fwd, width, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)

	-- Exit portcullis -- this is Room A's "closing door escape" climax.
	-- It's tagged as a proximity-closing door (not a static gate) with a
	-- trigger marker upstream so gameplay scripting can start the close
	-- countdown as the player approaches, and dash through under pressure.
	local exitPosition = entrancePosition + fwd * length
	local exitPortcullis = buildPortcullisDoor(geomFolder, "ExitPortcullis", exitPosition, fwd, width, height)
	exitPortcullis:SetAttribute("TriggerType", "ProximityClose")
	exitPortcullis:SetAttribute("TriggerDistance", CONFIG.roomA.closingDoorTriggerOffset)

	----------------------------------------------------------------------
	-- Segmented Architectural Walls, Floor, Ceiling
	----------------------------------------------------------------------
	local segmentLength = 20
	local numSegments = math.floor(length / segmentLength)
	local decRng = Random.new(CONFIG.roomA.hazardSeed + 2)
	
	for i = 0, numSegments - 1 do
		local segZ = i * segmentLength
		local segCenter = entrancePosition + fwd * (segZ + segmentLength/2)
		local isRecessed = (i % 2 == 1) and (i > 0 and i < numSegments - 1)
		
		local currentW = width
		local wallColor = CONFIG.colors.wall
		local mat = CONFIG.materials.wall

		-- Floor for this segment
		addOrientedPart(geomFolder, "Floor_"..i,
			Vector3.new(width, 1, segmentLength),
			segCenter + Vector3.new(0, -0.5, 0),
			fwd, CONFIG.materials.floor, CONFIG.colors.floor)

		-- Ceiling for this segment (with chance of structural crack/gap)
		local hasGap = decRng:NextNumber() > 0.75 and (i > 1 and i < numSegments - 1)
		if hasGap then
			-- Two pieces with a gap in the middle
			local gapSize = 2 + decRng:NextNumber() * 3
			local leftW = (width - gapSize) / 2
			local rightW = leftW
			addOrientedPart(geomFolder, "CeilL_"..i, Vector3.new(leftW, 1, segmentLength), segCenter - right * (width/2 - leftW/2) + Vector3.new(0, height + 0.5, 0), fwd, mat, CONFIG.colors.wallDark)
			addOrientedPart(geomFolder, "CeilR_"..i, Vector3.new(rightW, 1, segmentLength), segCenter + right * (width/2 - rightW/2) + Vector3.new(0, height + 0.5, 0), fwd, mat, CONFIG.colors.wallDark)
			
			-- Add broken slabs around gap
			addOrientedPart(decFolder, "CeilSlab_"..i, Vector3.new(leftW*0.8, 0.8, segmentLength*0.6), segCenter - right * (width/2 - leftW*0.6) + Vector3.new(0, height, 0), fwd, mat, CONFIG.colors.wallDark).CFrame = CFrame.new(segCenter - right * (width/2 - leftW*0.6) + Vector3.new(0, height, 0)) * CFrame.Angles(0, math.rad(15), math.rad(5))
			
			-- Sunlight shaft through this specific gap
			buildSunlightShaft(decFolder, "Sunlight_"..i, segCenter + Vector3.new(0, height, 0), gapSize*1.5, height)
		else
			addOrientedPart(geomFolder, "Ceiling_"..i,
				Vector3.new(width, 1, segmentLength),
				segCenter + Vector3.new(0, height + 0.5, 0),
				fwd, mat, CONFIG.colors.wallDark)
		end

		if isRecessed then
			currentW = width + 6 -- Reduce recess depth to avoid gaps
			wallColor = CONFIG.colors.wallDark
			
			-- Arches framing the recess
			buildAncientArch(geomFolder, "RecessArchL_"..i, segCenter - right * (halfWidth), right, segmentLength, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
			buildAncientArch(geomFolder, "RecessArchR_"..i, segCenter + right * (halfWidth), -right, segmentLength, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
			
			-- Extra floor and ceiling for recess (extend slightly back to ensure overlap)
			addOrientedPart(geomFolder, "FloorRecessL_"..i, Vector3.new(4, 1, segmentLength), segCenter - right * (halfWidth + 1.5) + Vector3.new(0, -0.5, 0), fwd, CONFIG.materials.floor, CONFIG.colors.floor)
			addOrientedPart(geomFolder, "FloorRecessR_"..i, Vector3.new(4, 1, segmentLength), segCenter + right * (halfWidth + 1.5) + Vector3.new(0, -0.5, 0), fwd, CONFIG.materials.floor, CONFIG.colors.floor)
			addOrientedPart(geomFolder, "CeilRecessL_"..i, Vector3.new(4, 1, segmentLength), segCenter - right * (halfWidth + 1.5) + Vector3.new(0, height + 0.5, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wallDark)
			addOrientedPart(geomFolder, "CeilRecessR_"..i, Vector3.new(4, 1, segmentLength), segCenter + right * (halfWidth + 1.5) + Vector3.new(0, height + 0.5, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wallDark)
		else
			-- Regular segment trim (cornice & baseboard)
			local leftFacePos = entrancePosition + fwd * segZ - right * halfWidth
			local rightFacePos = entrancePosition + fwd * segZ + right * halfWidth
			addCorniceBand(decFolder, "CorniceL_"..i, leftFacePos, fwd, segmentLength, height, CONFIG.materials.trim, CONFIG.colors.trim)
			addCorniceBand(decFolder, "CorniceR_"..i, rightFacePos, fwd, segmentLength, height, CONFIG.materials.trim, CONFIG.colors.trim)
			addBaseboardBand(decFolder, "BaseboardL_"..i, leftFacePos, fwd, segmentLength, CONFIG.materials.trim, CONFIG.colors.trim)
			addBaseboardBand(decFolder, "BaseboardR_"..i, rightFacePos, fwd, segmentLength, CONFIG.materials.trim, CONFIG.colors.trim)
		end
		
		local curHalfW = currentW / 2
		
		-- Left Wall segment (with slight variation)
		local lColor = decRng:NextNumber() > 0.8 and CONFIG.colors.ancientStone or wallColor
		addOrientedPart(geomFolder, "LeftWall_"..i,
			Vector3.new(wallThick, height, segmentLength),
			segCenter - right * (curHalfW + wallThick / 2) + Vector3.new(0, height / 2, 0),
			fwd, mat, lColor)

		-- Right Wall segment
		local rColor = decRng:NextNumber() > 0.8 and CONFIG.colors.ancientStone or wallColor
		addOrientedPart(geomFolder, "RightWall_"..i,
			Vector3.new(wallThick, height, segmentLength),
			segCenter + right * (curHalfW + wallThick / 2) + Vector3.new(0, height / 2, 0),
			fwd, mat, rColor)
			
		-- Pilasters between segments (ensure they sit perfectly flush)
		if i > 0 then
			addPilaster(decFolder, "PilasterL_"..i, entrancePosition + fwd * segZ - right * halfWidth, fwd, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
			addPilaster(decFolder, "PilasterR_"..i, entrancePosition + fwd * segZ + right * halfWidth, fwd, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
		end
	end
	
	-- Fill remaining gap
	local remainder = length - (numSegments * segmentLength)
	if remainder > 0 then
		local remCenter = entrancePosition + fwd * (numSegments * segmentLength + remainder/2)
		addOrientedPart(geomFolder, "Floor_Rem", Vector3.new(width, 1, remainder), remCenter + Vector3.new(0, -0.5, 0), fwd, CONFIG.materials.floor, CONFIG.colors.floor)
		addOrientedPart(geomFolder, "Ceiling_Rem", Vector3.new(width, 1, remainder), remCenter + Vector3.new(0, height + 0.5, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wallDark)
		addOrientedPart(geomFolder, "LeftWall_Rem", Vector3.new(wallThick, height, remainder), remCenter - right * (halfWidth + wallThick / 2) + Vector3.new(0, height / 2, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wall)
		addOrientedPart(geomFolder, "RightWall_Rem", Vector3.new(wallThick, height, remainder), remCenter + right * (halfWidth + wallThick / 2) + Vector3.new(0, height / 2, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wall)
	end
	
	-- Corner pilasters at very start and end
	addPilaster(decFolder, "PilasterFL", entrancePosition - right * halfWidth, fwd, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	addPilaster(decFolder, "PilasterFR", entrancePosition + right * halfWidth, fwd, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	addPilaster(decFolder, "PilasterBL", exitPosition - right * halfWidth, fwd, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	addPilaster(decFolder, "PilasterBR", exitPosition + right * halfWidth, fwd, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)


	----------------------------------------------------------------------
	-- Hazard placement (deterministic, clearance-validated)
	----------------------------------------------------------------------
	local hazardRng = Random.new(CONFIG.roomA.hazardSeed)
	local trapFootprint = CONFIG.spikeTrap.depth + CONFIG.spikeTrap.housingMargin * 2
	local clearance = 3
	local safetyFloor = trapFootprint + clearance
	local cursor = CONFIG.roomA.hazardStart
	local hazardIndex = 0
	local zones = CONFIG.roomA.spacingZones

	while cursor < length - CONFIG.roomA.hazardEndOffset do
		hazardIndex = hazardIndex + 1
		local progress = cursor / length
		local spacing
		if progress < zones.earlyFraction then
			spacing = hazardRng:NextInteger(zones.earlyMin, zones.earlyMax)
		elseif progress < zones.midFraction then
			spacing = hazardRng:NextInteger(zones.midMin, zones.midMax)
		else
			spacing = hazardRng:NextInteger(zones.lateMin, zones.lateMax)
		end

		if hazardIndex % 3 == 0 then
			-- Swinging blade at ceiling -- kept centered; its swing arc already
			-- eats into the corridor width, so it isn't laterally offset.
			local pivotY = height - CONFIG.swingingBlade.mountDrop
			local pivotPos = entrancePosition + fwd * cursor + Vector3.new(0, pivotY, 0)
			buildSwingingBlade(hazFolder, "Blade_" .. hazardIndex, pivotPos, right)
			-- Add a support beam for the blade
			addCeilingBeam(decFolder, "BladeBeam_"..hazardIndex, entrancePosition + fwd * cursor, right, width, height, CONFIG.materials.wood, CONFIG.colors.wood)
		else
			-- Spike trap on floor -- gentle side-to-side weave that grows with
			-- distance travelled, capped well inside the wall clearance budget.
			local weaveAmt = CONFIG.roomA.lateralWeaveMax * math.min(1, progress / zones.midFraction)
			local weave = ((hazardIndex % 2 == 0) and 1 or -1) * weaveAmt
			local trapPos = entrancePosition + fwd * cursor + right * weave
			buildSpikeTrap(hazFolder, "SpikeTrap_" .. hazardIndex, trapPos, fwd)
		end

		cursor = cursor + math.max(spacing, safetyFloor)
	end

	----------------------------------------------------------------------
	-- Decoration
	----------------------------------------------------------------------
	-- Torches
	layWallTorches(decFolder, "TorchL", entrancePosition - right * halfWidth, fwd, right, 5, length - 5)
	layWallTorches(decFolder, "TorchR", entrancePosition + right * halfWidth, fwd, -right, 5, length - 5)

	-- Ceiling beams (placed occasionally)
	for b = 10, length - 10, 20 do
		addCeilingBeam(decFolder, "Beam_"..b, entrancePosition + fwd * b, right, width, height, CONFIG.materials.wood, CONFIG.colors.wood)
	end

	-- Environmental details (deterministic)
	local decRng = Random.new(CONFIG.roomA.hazardSeed + 1)

	-- Moss patches on floor
	for i = 1, 8 do
		local zOff = decRng:NextNumber() * (length - 20) + 10
		local xOff = (decRng:NextNumber() - 0.5) * (width - 4)
		buildMossPatch(decFolder, "Moss_" .. i,
			entrancePosition + fwd * zOff + right * xOff,
			fwd, 2 + decRng:NextNumber() * 3, 2 + decRng:NextNumber() * 3)
	end

	-- Vine strips from ceiling
	for i = 1, 6 do
		local zOff = decRng:NextNumber() * (length - 20) + 10
		local side = decRng:NextNumber() > 0.5 and 1 or -1
		buildVineStrip(decFolder, "Vine_" .. i,
			entrancePosition + fwd * zOff + right * (side * halfWidth) + Vector3.new(0, height, 0),
			height * 0.4 + decRng:NextNumber() * height * 0.4)
	end

	-- Collapsed masonry (away from hazards)
	addCollapsedMasonry(decFolder, "Masonry_1",
		entrancePosition + fwd * (length - 20) + right * (halfWidth - 3), 6, 2.5)
	addCollapsedMasonry(decFolder, "Masonry_2",
		entrancePosition + fwd * (length - 12) - right * (halfWidth - 4), 5, 2)

	-- Broken support pillars
	addBrokenSupport(decFolder, "BrokenSupport_1", entrancePosition + fwd * 35 - right * (halfWidth - 1), fwd, height, height * 0.4)
	addBrokenSupport(decFolder, "BrokenSupport_2", entrancePosition + fwd * 95 + right * (halfWidth - 1), fwd, height, height * 0.6)

	-- Cracked floor patches
	for c = 1, 4 do
		local zOff = decRng:NextNumber() * (length - 30) + 15
		addCrackedFloorPatch(decFolder, "CrackedFloor_"..c,
			entrancePosition + fwd * zOff, fwd, 6, 5)
	end

	-- Warning carvings
	addWarningCarving(decFolder, "Warning_1", entrancePosition + fwd * 5 - right * halfWidth, right, height * 0.5)
	addWarningCarving(decFolder, "Warning_2", entrancePosition + fwd * 5 + right * halfWidth, -right, height * 0.5)
	addWarningCarving(decFolder, "Warning_3", entrancePosition + fwd * (length/2) - right * halfWidth, right, height * 0.5)

	----------------------------------------------------------------------
	-- Markers
	----------------------------------------------------------------------
	addCheckpoint(markersFolder, "RoomA_Start", entrancePosition)
	addCheckpoint(markersFolder, "RoomA_End", exitPosition + fwd * 5)

	local closingTrigger = newPart({
		Name = "RoomA_ClosingDoorTrigger",
		Size = Vector3.new(width, height, 2),
		CFrame = CFrame.new(exitPosition - fwd * CONFIG.roomA.closingDoorTriggerOffset),
		Transparency = 1, CanCollide = false, CanQuery = true, Parent = markersFolder
	})
	CollectionService:AddTag(closingTrigger, "ClosingDoorTrigger")

	return folder, exitPosition
end

----------------------------------------------------------------------
-- ROOM B: COMBAT COURTYARD (chamfered corners, open-air)
----------------------------------------------------------------------

local function buildRoomB(root, entrancePosition, forward)
	local folder = newFolder(root, "RoomB_CombatCourtyard")
	local geomFolder = newFolder(folder, "Geometry")
	local arenaFolder = newFolder(folder, "Arena")
	local decFolder = newFolder(folder, "Decoration")
	local markersFolder = newFolder(folder, "Markers")

	local radius = CONFIG.roomB.radius
	local height = CONFIG.roomB.wallHeight
	local wallThick = 2
	local fwd = unitXZ(forward)
	local right = getRight(fwd)
	
	local center = entrancePosition + fwd * radius
	local bRng = Random.new(20260850)

	-- Floor
	local floorPart = newPart({
		Name = "Floor",
		Size = Vector3.new(1, radius * 2, radius * 2),
		CFrame = CFrame.new(center + Vector3.new(0, -0.5, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Shape = Enum.PartType.Cylinder,
		Material = CONFIG.materials.floor,
		Color = CONFIG.colors.floor,
		Parent = geomFolder
	})

	----------------------------------------------------------------------
	-- Octagonal walls (8 segments)
	----------------------------------------------------------------------
	local numSides = 8
	local angleStep = (math.pi * 2) / numSides
	local sideLength = 2 * radius * math.tan(math.pi / numSides)
	
	for i = 0, numSides - 1 do
		-- Start from South (Entrance, i=0)
		local angle = i * angleStep
		local wallNormal = (-fwd * math.cos(angle) + right * math.sin(angle)).Unit
		local wallCenter = center + wallNormal * radius
		local wallRight = getRight(wallNormal)
		local segName = "Wall_"..i
		
		-- Entrance and Exit gates
		if i == 0 then -- Entrance side
			local archW = 16
			local sidePieceL = (sideLength - archW) / 2
			addOrientedPart(geomFolder, segName.."L", Vector3.new(sidePieceL, height, wallThick), wallCenter - wallRight * (archW/2 + sidePieceL/2) + Vector3.new(0, height/2, 0), -wallNormal, CONFIG.materials.wall, CONFIG.colors.wall)
			addOrientedPart(geomFolder, segName.."R", Vector3.new(sidePieceL, height, wallThick), wallCenter + wallRight * (archW/2 + sidePieceL/2) + Vector3.new(0, height/2, 0), -wallNormal, CONFIG.materials.wall, CONFIG.colors.wall)
			buildAncientArch(geomFolder, "EntranceArch", wallCenter, -wallNormal, archW, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
		elseif i == 4 then -- Exit side (North)
			local archW = 16
			local sidePieceL = (sideLength - archW) / 2
			addOrientedPart(geomFolder, segName.."L", Vector3.new(sidePieceL, height, wallThick), wallCenter - wallRight * (archW/2 + sidePieceL/2) + Vector3.new(0, height/2, 0), -wallNormal, CONFIG.materials.wall, CONFIG.colors.wall)
			addOrientedPart(geomFolder, segName.."R", Vector3.new(sidePieceL, height, wallThick), wallCenter + wallRight * (archW/2 + sidePieceL/2) + Vector3.new(0, height/2, 0), -wallNormal, CONFIG.materials.wall, CONFIG.colors.wall)
			buildAncientArch(geomFolder, "ExitArch", wallCenter, -wallNormal, archW, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
		else
			-- Standard solid wall segment
			addOrientedPart(geomFolder, segName, Vector3.new(sideLength, height, wallThick), wallCenter + Vector3.new(0, height/2, 0), -wallNormal, CONFIG.materials.wall, CONFIG.colors.wall)
		end
		
		-- Trim
		addCorniceBand(decFolder, segName .. "_Cornice", wallCenter, -wallNormal, sideLength, height, CONFIG.materials.trim, CONFIG.colors.trim)
		addBaseboardBand(decFolder, segName .. "_Baseboard", wallCenter, -wallNormal, sideLength, CONFIG.materials.trim, CONFIG.colors.trim)

		-- Corner pillars
		local cornerAngle = angle + angleStep/2
		local cornerNormal = (-fwd * math.cos(cornerAngle) + right * math.sin(cornerAngle)).Unit
		local cornerDist = radius / math.cos(math.pi/numSides)
		local cornerPos = center + cornerNormal * cornerDist
		addPilaster(decFolder, "Pilaster_"..i, cornerPos, -cornerNormal, height, CONFIG.materials.wall, CONFIG.colors.ancientStone)
		
		-- Statues and water at the 4 diagonal corners (i = 1,3,5,7)
		if i % 2 == 1 then
			buildStatue(decFolder, "Statue_" .. i, cornerPos - cornerNormal * 2, -cornerNormal, 10, "standing")
			
			-- Water channels along diagonal walls
			local chanW = CONFIG.roomB.waterChannelWidth
			local chanDepth = CONFIG.roomB.waterDepth
			local bThick = 1
			local chanPos = center + wallNormal * (radius - wallThick - chanW/2 - bThick)
			local cStart = chanPos - wallRight * (sideLength/2 - 4)
			buildWaterChannel(decFolder, "Water_"..i, cStart, wallRight, sideLength - 8, chanW, chanDepth)
			
			addOrientedPart(decFolder, "WaterBorderL_"..i, Vector3.new(bThick, 1.2, sideLength - 8), chanPos - wallNormal * (chanW/2 + bThick/2) + Vector3.new(0,-0.4,0), wallRight, CONFIG.materials.wall, CONFIG.colors.ancientStone)
			addOrientedPart(decFolder, "WaterBorderR_"..i, Vector3.new(bThick, 1.2, sideLength - 8), chanPos + wallNormal * (chanW/2 + bThick/2) + Vector3.new(0,-0.4,0), wallRight, CONFIG.materials.wall, CONFIG.colors.ancientStone)

			-- Algae along the channel -- Room B should read as overgrown near its water
			buildAlgaeCluster(decFolder, "WaterAlgae_"..i.."_A", cStart + wallRight * (sideLength * 0.2), wallRight, bRng, CONFIG.vegetation.density.roomB)
			buildAlgaeCluster(decFolder, "WaterAlgae_"..i.."_B", cStart + wallRight * (sideLength * 0.6), wallRight, bRng, CONFIG.vegetation.density.roomB)
		else
			if i ~= 0 and i ~= 4 then
				-- Torches on main walls
				addWallTorch(decFolder, segName .. "_Torch", wallCenter - wallNormal * (wallThick / 2), -wallNormal, CONFIG.detail.torchHeight)
			end
		end
	end

	----------------------------------------------------------------------
	-- Extra decoration (benches, rubble, moss)
	----------------------------------------------------------------------
	-- Benches around arena
	for i = 1, 4 do
		local angle = (i / 4) * math.pi * 2 + math.pi/4
		local bPos = center + Vector3.new(math.sin(angle), 0, math.cos(angle)) * 20
		local bDir = (center - bPos).Unit
		local bRight = getRight(bDir)
		-- Bench seat
		addOrientedPart(decFolder, "Bench_"..i, Vector3.new(6, 1.2, 2), bPos + Vector3.new(0, 0.6, 0), bDir, CONFIG.materials.wall, CONFIG.colors.ancientStone)
		-- Bench supports
		addOrientedPart(decFolder, "BenchSupport1_"..i, Vector3.new(1.5, 0.6, 2), bPos - bRight*2 + Vector3.new(0, 0.3, 0), bDir, CONFIG.materials.wall, CONFIG.colors.ancientStone)
		addOrientedPart(decFolder, "BenchSupport2_"..i, Vector3.new(1.5, 0.6, 2), bPos + bRight*2 + Vector3.new(0, 0.3, 0), bDir, CONFIG.materials.wall, CONFIG.colors.ancientStone)
	end

	-- Moss on floor edges
	for i = 1, 6 do
		local angle = (i / 6) * math.pi * 2
		local mPos = center + Vector3.new(math.sin(angle), 0, math.cos(angle)) * (radius - 6)
		buildMossPatch(decFolder, "Moss_" .. i, mPos, fwd, 4, 4)
	end

	-- Rocks/broken stones distributed around the edges (never the clear
	-- central combat area) -- size, rotation and clustering all vary.
	for i = 1, 10 do
		local angle = bRng:NextNumber(0, math.pi * 2)
		local ringR = radius - bRng:NextNumber(3, 9)
		local rPos = center + Vector3.new(math.sin(angle), 0, math.cos(angle)) * ringR
		addRubblePile(decFolder, "EdgeRock_" .. i, rPos, bRng:NextInteger(3, 7), bRng:NextNumber(1.5, 4))
	end
	addRubblePile(decFolder, "Rubble_1", center - fwd * 15 - right * 15, 5, 3)
	addRubblePile(decFolder, "Rubble_2", center + fwd * 15 + right * 15, 4, 2.5)
	addRubblePile(decFolder, "Rubble_3", center - fwd * 18 + right * 15, 6, 4)

	----------------------------------------------------------------------
	-- Markers
	----------------------------------------------------------------------
	local exitPosition = entrancePosition + fwd * (radius * 2)
	addCheckpoint(markersFolder, "RoomB_Start", entrancePosition)
	addCheckpoint(markersFolder, "RoomB_End", exitPosition + fwd * 5)

	-- Golem: this is a pre-built 3D model, NOT generator geometry. The
	-- generator only builds the pedestal it stands on and a spawn marker;
	-- if a model matching CONFIG.roomB.golemModelName already exists in
	-- ServerStorage, it's cloned into place automatically. If not, the
	-- marker is still there for the encounter script to spawn into.
	local golemPedestal = newPart({
		Name = "GolemPedestal",
		Size = Vector3.new(CONFIG.roomB.golemPedestalRadius * 2, 1, CONFIG.roomB.golemPedestalRadius * 2),
		CFrame = CFrame.new(center - Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.pi/2),
		Shape = Enum.PartType.Cylinder,
		Material = CONFIG.materials.wall, Color = CONFIG.colors.ancientStone,
		Parent = arenaFolder
	})

	local spawnMarker = newPart({
		Name = "RoomB_GolemSpawn",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(center + Vector3.new(0, 2, 0)),
		Transparency = 1, CanCollide = false,
		Parent = markersFolder
	})

	spawnExternalModel(arenaFolder, CONFIG.roomB.golemStorageService, CONFIG.roomB.golemModelName, CFrame.new(center + Vector3.new(0, 1, 0)))

	local centerMarker = newPart({
		Name = "RoomB_ArenaCenter",
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(center + Vector3.new(0, 0.5, 0)),
		Transparency = 1, CanCollide = false,
		Parent = markersFolder
	})

	return folder, exitPosition
end

