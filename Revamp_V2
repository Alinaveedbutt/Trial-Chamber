    if broken then
        finalHeight = random:NextNumber(height*0.2, height*0.7)
    end
    
    local pos = basePosition + Vector3.new(0, finalHeight/2, 0)
    local part = newPart({
        Name = "PillarBase",
        Size = Vector3.new(radius*2, finalHeight, radius*2),
        CFrame = CFrame.new(pos),
        Shape = Enum.PartType.Cylinder,
        Material = material,
        Color = color,
        Parent = model
    })
    
    if broken then
        addRubblePile(model, "PillarRubble", basePosition, math.floor(radius*4), radius*1.5)
    end
    
    return model
end

