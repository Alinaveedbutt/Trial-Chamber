local function buildRoomD(root, entrancePosition, forward)
	local folder = newFolder(root, "RoomD_PassageOfEchoes")
	local geoFolder = newFolder(folder, "Geometry")
	local parkourFolder = newFolder(folder, "Parkour")
	local echoesFolder = newFolder(folder, "Echoes")
	local hazardsFolder = newFolder(folder, "Hazards")
	local decorFolder = newFolder(folder, "Decoration")
	local markersFolder = newFolder(folder, "Markers")

	local fwd = unitXZ(forward)
	local right = getRight(fwd)
	local length = CONFIG.roomD.length
	local wWidth = CONFIG.roomD.width
	local wHeight = CONFIG.roomD.height
	local t = CONFIG.roomD.wallThickness
	local roomDRng = Random.new(CONFIG.roomD.seed)
	
	local center = entrancePosition + fwd * (length / 2)

	-- Deep chasm fog
	local fog = newPart({
		Name = "ChasmFog",
		Size = Vector3.new(wWidth, 20, length),
		CFrame = CFrame.new(center + Vector3.new(0, -15, 0)),
		Material = Enum.Material.Neon, Color = CONFIG.colors.fog,
		Transparency = 0.8, CanCollide = false, Parent = decorFolder
	})

	-- Horizontal passage generated in sections
	local sectionLength = length / CONFIG.roomD.sectionCount
	
	for s = 1, CONFIG.roomD.sectionCount do
		local secStart = entrancePosition + fwd * (s - 1) * sectionLength
		local secCenter = secStart + fwd * (sectionLength/2)
		
		-- Walls for this section
		addOrientedPart(geoFolder, "WallLeft_"..s, Vector3.new(t, wHeight, sectionLength), secCenter - right * (wWidth/2 + t/2) + Vector3.new(0, wHeight/2, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wall)
		addOrientedPart(geoFolder, "WallRight_"..s, Vector3.new(t, wHeight, sectionLength), secCenter + right * (wWidth/2 + t/2) + Vector3.new(0, wHeight/2, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wall)
		
		-- Pillars along the walls
		buildStonePillar(decorFolder, "PillarL_"..s, secCenter - right * (wWidth/2 - 2), wHeight, 3, CONFIG.materials.wall, CONFIG.colors.ancientStone, roomDRng:NextNumber() > 0.6)
		buildStonePillar(decorFolder, "PillarR_"..s, secCenter + right * (wWidth/2 - 2), wHeight, 3, CONFIG.materials.wall, CONFIG.colors.ancientStone, roomDRng:NextNumber() > 0.6)
		
		-- Floor generation (creates a gap in the middle sections)
		if s == 1 or s == CONFIG.roomD.sectionCount then
			-- Solid floor at entrance and exit
			addOrientedPart(geoFolder, "Floor_"..s, Vector3.new(wWidth, 1, sectionLength), secCenter + Vector3.new(0, -0.5, 0), fwd, CONFIG.materials.floor, CONFIG.colors.floor)
		else
			-- Broken floor (gap)
			local leftW = (wWidth/2) - (roomDRng:NextNumber() * 6 + 4)
			local rightW = (wWidth/2) - (roomDRng:NextNumber() * 6 + 4)
			if leftW > 0 then
				addOrientedPart(geoFolder, "FloorL_"..s, Vector3.new(leftW, 1, sectionLength), secCenter - right * (wWidth/2 - leftW/2) + Vector3.new(0, -0.5, 0), fwd, CONFIG.materials.floor, CONFIG.colors.floor)
			end
			if rightW > 0 then
				addOrientedPart(geoFolder, "FloorR_"..s, Vector3.new(rightW, 1, sectionLength), secCenter + right * (wWidth/2 - rightW/2) + Vector3.new(0, -0.5, 0), fwd, CONFIG.materials.floor, CONFIG.colors.floor)
			end
			
			-- Add some floating debris/parkour platforms across the gap
			local platSize = CONFIG.roomD.parkour.minLandingSize
			local pPos = secCenter + right * (roomDRng:NextNumber()*10 - 5) + Vector3.new(0, roomDRng:NextNumber()*2 - 1, 0)
			buildParkourPlatform(parkourFolder, "Platform_"..s, pPos, fwd, platSize + roomDRng:NextNumber()*4, platSize + roomDRng:NextNumber()*4, CONFIG.materials.wall, CONFIG.colors.ancientStone)
		end
		
		-- Ceiling (also broken)
		if roomDRng:NextNumber() > 0.3 then
			addOrientedPart(geoFolder, "Ceiling_"..s, Vector3.new(wWidth, 1, sectionLength), secCenter + Vector3.new(0, wHeight + 0.5, 0), fwd, CONFIG.materials.wall, CONFIG.colors.wallDark)
		else
			-- Gap in ceiling creates sunlight
			buildSunlightShaft(decorFolder, "Sun_"..s, secCenter + Vector3.new(0, wHeight, 0), 12, wHeight)
			addCollapsedMasonry(decorFolder, "Rubble_"..s, secCenter + right * (roomDRng:NextNumber()*10 - 5) + Vector3.new(0, -0.5, 0), 8, 4)
		end
		
		-- Directional lighting progression (Dark red at start -> bright gold at exit)
		local progress = s / CONFIG.roomD.sectionCount
		local lColor = (progress < 0.3) and Color3.fromRGB(150, 40, 20) or ((progress < 0.7) and Color3.fromRGB(200, 150, 50) or Color3.fromRGB(255, 230, 150))
		local lightPart = newPart({
			Name = "ProgressionLight_"..s, Size = Vector3.new(1,1,1),
			CFrame = CFrame.new(secCenter + Vector3.new(0, wHeight * 0.8, 0)),
			Transparency = 1, CanCollide = false, Parent = decorFolder
		})
		addGlow(lightPart, lColor, wWidth, 0.8)
		
		-- Dragon murals
		if (s == 2 or s == 4) and s <= CONFIG.roomD.muralCount + 1 then
			local mSide = (s%2 == 0) and -right or right
			buildDragonMural(decorFolder, "Mural_"..s, secCenter + mSide * (wWidth/2 - 0.5) + Vector3.new(0, wHeight/2, 0), -mSide, 20, 10)
		end
	end
	
	-- Dead warrior scene near the exit
	local warriorPos = entrancePosition + fwd * (length - 15) + right * 8
	local warrior = newPart({
		Name = "FallenWarrior", Size = Vector3.new(4, 1, 6),
		CFrame = CFrame.new(warriorPos) * CFrame.Angles(0, math.rad(45), 0),
		Material = Enum.Material.Slate, Color = Color3.fromRGB(50, 50, 50),
		Parent = decorFolder
	})
	
	local function addHook(name, pos)
		newPart({Name = name, Size = Vector3.new(1,1,1), CFrame = CFrame.new(pos), Transparency = 1, CanCollide = false, Parent = markersFolder})
	end
	addHook("Transition_C_D_WarriorReveal", warriorPos)

	-- Echo Triggers along the passage
	local echoStages = {"Doubt", "Desperation", "Anger", "Silence"}
	for i = 1, #echoStages do
		local ePos = entrancePosition + fwd * (length * (i / (#echoStages + 1)))
		local echo = Instance.new("Model")
		echo.Name = "RoomD_Echo_" .. i
		echo.Parent = echoesFolder
		
		local trig = newPart({
			Name = "EchoTrigger",
			Size = Vector3.new(wWidth, wHeight, sectionLength),
			CFrame = CFrame.new(ePos + Vector3.new(0, wHeight/2, 0)),
			Transparency = 1, CanCollide = false, CanQuery = true, Parent = echo
		})
		echo:SetAttribute("EchoStage", echoStages[i])
		echo:SetAttribute("EchoIndex", i)
		CollectionService:AddTag(echo, "WarriorEcho")
		
		-- Statue for echo
		local pose = "standing"
		if echoStages[i] == "Doubt" then pose = "sitting" end
		if echoStages[i] == "Desperation" then pose = "collapsed" end
		if echoStages[i] == "Anger" then pose = "reaching" end
		
		local sPos = ePos - right * (wWidth/2 - 3)
		buildStatue(decorFolder, "Statue_"..echoStages[i], sPos, right, 6, pose)
	end
	
	-- Chain hazards over gaps
	for c = 2, CONFIG.roomD.sectionCount - 1 do
		if roomDRng:NextNumber() > 0.5 then
			local cPos = entrancePosition + fwd * (c - 0.5) * sectionLength
			local chainTop = cPos + Vector3.new(0, wHeight, 0)
			local chainBot = cPos + Vector3.new(0, 2, 0)
			local chain = buildChainSegment(hazardsFolder, "Chain_"..c, chainTop, chainBot, 10)
			CollectionService:AddTag(chain, "ChainClimb")
		end
	end

	-- Markers
	local exitPos = entrancePosition + fwd * length
	addCheckpoint(markersFolder, "RoomD_Start", entrancePosition)
	addCheckpoint(markersFolder, "RoomD_Mid", center)
	addCheckpoint(markersFolder, "RoomD_End", exitPos)

	return folder, exitPos
end

