    local i = 1
    while dist <= endDistance do
        local pos = wallOriginPosition + travelForward * dist
        addWallTorch(parent, namePrefix .. "_" .. i, pos, faceDirection, CONFIG.detail.torchHeight)
        dist = dist + CONFIG.detail.torchSpacing
        i = i + 1
    end
end

local function addRubblePile(parent, name, centerPosition, chunkCount, spreadRadius)
