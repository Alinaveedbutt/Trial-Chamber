			Transparency = 0.1, CanCollide = false, Parent = decorFolder
		}, "decorative")

		-- Pillar capitals (Heavy metal)
		GeometryCore.newPart({
			Name = "CapL_" .. i, Size = Vector3.new(3.2, 1.5, 3.2),
			CFrame = CFrame.new(aPos - right * 4.5 + Vector3.new(0, pillarH + 0.75, 0)),
			Material = Enum.Material.Metal, Color = Color3.fromRGB(25, 25, 30), Parent = decorFolder
		}, "structural")
		GeometryCore.newPart({
			Name = "CapR_" .. i, Size = Vector3.new(3.2, 1.5, 3.2),
			CFrame = CFrame.new(aPos + right * 4.5 + Vector3.new(0, pillarH + 0.75, 0)),
			Material = Enum.Material.Metal, Color = Color3.fromRGB(25, 25, 30), Parent = decorFolder
		}, "structural")

		-- Arch lintel
		GeometryCore.newPart({
			Name = "ContainArch_" .. i, Size = Vector3.new(11, 3, 2.5),
			CFrame = CFrame.fromMatrix(aPos + Vector3.new(0, pillarH + 2, 0), right, Vector3.yAxis),
			Material = pMat, Color = pCol, Parent = decorFolder
		}, "structural")

		-- Central Arch Eye / Jewel
		GeometryCore.newPart({
			Name = "ArchEye_" .. i, Size = Vector3.new(1.8, 1.8, 1.8),
			CFrame = CFrame.new(aPos + Vector3.new(0, pillarH + 2, 0) + fwd * 1.25) * CFrame.Angles(math.pi/4, 0, math.pi/4),
			Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 40, 40), Parent = decorFolder
		}, "decorative")
	end

	-- Chain building helper for realistic 3D interlocking links with sag
	local function buildRealisticChain(parentName, p1, p2, sag, isRed)
		local linkFolder = GeometryCore.newFolder(decorFolder, parentName)
		local dist = (p2 - p1).Magnitude
		local linkLength = 1.6
		local linkWidth = 0.8
		local thick = 0.25
		local numLinks = math.max(2, math.floor(dist / (linkLength * 0.75)))

		local mat = isRed and Enum.Material.Neon or Enum.Material.Metal
		local col = isRed and Color3.fromRGB(220, 20, 20) or Color3.fromRGB(20, 20, 25)

		for L = 0, numLinks - 1 do
			local t0 = L / numLinks
			local t1 = (L + 1) / numLinks
			local tMid = (L + 0.5) / numLinks

			local function getPos(t)
				local lerpP = p1:Lerp(p2, t)
				local sagOff = sag * 4 * t * (1 - t)
				return lerpP - Vector3.new(0, sagOff, 0)
			end

			local pos0 = getPos(t0)
			local pos1 = getPos(t1)
			local posMid = getPos(tMid)

			local cframe = CFrame.new(posMid, pos1) * CFrame.Angles(0, 0, (L % 2 == 0) and math.pi/2 or 0)

			local sideDist = (linkWidth - thick)/2
			local endDist = (linkLength - thick)/2
			local actualLen = (pos1 - pos0).Magnitude + thick

			-- 4 Parts per link
			GeometryCore.newPart({Name="SideA", Size=Vector3.new(thick, thick, actualLen - thick), CFrame=cframe * CFrame.new(sideDist, 0, 0), Material=mat, Color=col, Parent=linkFolder}, "decorative")
			GeometryCore.newPart({Name="SideB", Size=Vector3.new(thick, thick, actualLen - thick), CFrame=cframe * CFrame.new(-sideDist, 0, 0), Material=mat, Color=col, Parent=linkFolder}, "decorative")
			GeometryCore.newPart({Name="EndA", Size=Vector3.new(linkWidth, thick, thick), CFrame=cframe * CFrame.new(0, 0, endDist), Material=mat, Color=col, Parent=linkFolder}, "decorative")
			GeometryCore.newPart({Name="EndB", Size=Vector3.new(linkWidth, thick, thick), CFrame=cframe * CFrame.new(0, 0, -endDist), Material=mat, Color=col, Parent=linkFolder}, "decorative")
		end
	end

	-- Chains & Tethers connecting the array and restraining the Heart
	for i = 1, numArches do
		local curr = archPositions[i]
		local nxt = archPositions[(i % numArches) + 1]

		-- Chain connecting adjacent arches
		local p1 = curr.pos + curr.right * 4.5 + Vector3.new(0, 16, 0)
		local p2 = nxt.pos - nxt.right * 4.5 + Vector3.new(0, 16, 0)
		buildRealisticChain("HeavyChain_" .. i, p1, p2, 2.5, false)

		-- Heavy iron chain aiming at the Heart Crystal (with deeper sag)
		local tetherStart = curr.pos + Vector3.new(0, 19, 0)
		buildRealisticChain("RestrainingChain_" .. i, tetherStart, heartCenter, 5.0, false)
	end

	------------------------------------------------------------------------
	-- 16-SIDED OUTER WALLS (With Gap Fillers)
	------------------------------------------------------------------------
	for i = 0, numSides - 1 do
		local angle = i * angleStep
		local dirX = math.sin(angle)
		local dirZ = math.cos(angle)

		local wallCenter = pos + Vector3.new(dirX * ap, 0, dirZ * ap)
		local fwd = Vector3.new(-dirX, 0, -dirZ)
		local right = GeometryCore.getRight(fwd)

		local p1 = wallCenter - right * (sl / 2)
		local p2 = wallCenter + right * (sl / 2)

		if i == 0 then
			Masonry.buildIntegratedArch(wallFolder, "WallSegment_North_Exit", p1, p2, height, t, 14, 19, MAT.wall, COLOR.wall)
		elseif i == 8 then
			Masonry.buildIntegratedArch(wallFolder, "WallSegment_South_Entry", p1, p2, height, t, 14, 19, MAT.wall, COLOR.wall)
		else
			Masonry.buildWallCourse(wallFolder, "WallSegment_" .. i, p1, p2, height, t, MAT.wall, COLOR.wall)
		end
		Masonry.buildPilaster(wallFolder, "Pilaster_" .. i, p1, fwd, 4, height, 2)

		-- Gap Filler: A column exactly at the vertex connecting to the next wall segment
		GeometryCore.newPart({
			Name = "WallSeamFiller_" .. i,
			Size = Vector3.new(t * 1.05, height, t * 1.05), Shape = Enum.PartType.Cylinder,
			CFrame = CFrame.new(p2 + Vector3.new(0, height/2, 0)) * CFrame.Angles(0, 0, math.pi/2),
			Material = MAT.wall, Color = COLOR.wall, Parent = wallFolder
		}, "structural")
	end

	------------------------------------------------------------------------
	-- WALL DECORATIONS (vines, moss, torches, banners, scary writings)
	------------------------------------------------------------------------
	local rng = Random.new(99887)
	for i = 0, numSides - 1 do
		local angle = i * angleStep
		local dirX = math.sin(angle)
		local dirZ = math.cos(angle)
		local wallCenter = pos + Vector3.new(dirX * ap, 0, dirZ * ap)
		local fwd = Vector3.new(-dirX, 0, -dirZ)
		local right = GeometryCore.getRight(fwd)

		-- Torches on alternating walls
		if i % 2 ~= 0 then
			local torchPos = pos + Vector3.new(dirX * (ap - t / 2 - 0.5), 14, dirZ * (ap - t / 2 - 0.5))
			local tf = GeometryCore.newFolder(decorFolder, "Torch_" .. i)
			GeometryCore.newPart({ Name = "Sconce", Size = Vector3.new(1, 2, 1), CFrame = CFrame.new(torchPos), Material = Enum.Material.Wood, Color = Color3.fromRGB(60, 40, 20), Parent = tf })
			GeometryCore.newPart({ Name = "SconceBase", Size = Vector3.new(1.5, 0.5, 1.5), CFrame = CFrame.new(torchPos - Vector3.new(0, 1, 0)), Material = Enum.Material.Metal, Color = Color3.fromRGB(30, 30, 30), Parent = tf })
			local flame = GeometryCore.newPart({ Name = "Flame", Size = Vector3.new(0.5, 0.5, 0.5), CFrame = CFrame.new(torchPos + Vector3.new(0, 1.5, 0)), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 150, 50), Parent = tf })
			local tl = Instance.new("PointLight")
			tl.Color = Color3.fromRGB(255, 160, 80); tl.Range = 25; tl.Brightness = 2; tl.Shadows = false; tl.Parent = flame
		end

		-- Skip gate walls for moss/vines
		if i ~= 0 and i ~= 8 then
			-- Moss at wall base
			GeometryCore.newPart({
				Name = "WallMoss_" .. i, Size = Vector3.new(sl - 2, 1.5, 3),
				CFrame = CFrame.fromMatrix(wallCenter + Vector3.new(0, -0.2, 0) + fwd * 2, right, Vector3.yAxis),
				Material = Enum.Material.Grass, Color = Color3.fromRGB(40, 80, 35),
				CanCollide = false, Parent = decorFolder
			}, "decorative")

			-- Hanging vines
			local numVines = 3 + rng:NextInteger(0, 2)
			for v = 1, numVines do
				local vineX = (rng:NextNumber() - 0.5) * (sl - 4)
				local vineLen = 6 + rng:NextNumber() * 10
				local vineY = height - 2 - vineLen / 2 + rng:NextNumber() * 3
				GeometryCore.newPart({
					Name = "Vine_" .. i .. "_" .. v,
					Size = Vector3.new(0.7, vineLen, 0.7),
					CFrame = CFrame.fromMatrix(
						wallCenter + Vector3.new(0, vineY, 0) + fwd * (t / 2 + 0.3) + right * vineX,
						right, Vector3.yAxis
					),
					Material = Enum.Material.LeafyGrass, Color = Color3.fromRGB(35, 80, 30),
					CanCollide = false, Parent = decorFolder
				}, "decorative")
			end
		end
	end

	------------------------------------------------------------------------
	-- ROOF: Black stone dome with circular oculus above the Heart
	------------------------------------------------------------------------
	local roofFolder = GeometryCore.newFolder(folder, "Roof")
	local roofY = pos.Y + height
	local roofColor = Color3.fromRGB(18, 18, 22) -- Very dark, almost black
	local roofMat = Enum.Material.Basalt

	-- Build the roof as radial slabs with a hole in the center
	local oculusRadius = 10 -- The circular opening
	local roofSegments = 24
	local roofInnerR = oculusRadius
	local roofOuterR = ap + 6 -- Extend past walls to prevent light leaks

	for i = 0, roofSegments - 1 do
		local a1 = i * (math.pi * 2) / roofSegments
		local a2 = (i + 1) * (math.pi * 2) / roofSegments
		local aMid = (a1 + a2) / 2

		local midDirX = math.sin(aMid)
		local midDirZ = math.cos(aMid)
		local segFwd = Vector3.new(-midDirX, 0, -midDirZ)
		local segRight = GeometryCore.getRight(segFwd)

		-- Each slab spans from oculusRadius to roofOuterR
		local slabDepth = roofOuterR - roofInnerR
		local slabCenter = pos + Vector3.new(
			midDirX * (roofInnerR + slabDepth / 2),
			height + 1,
			midDirZ * (roofInnerR + slabDepth / 2)
		)
		-- Width of the slab at the outer edge (arc length)
		local slabWidth = 2 * roofOuterR * math.sin(math.pi / roofSegments) + 1.5

		GeometryCore.newPart({
			Name = "RoofSlab_" .. i,
			Size = Vector3.new(slabWidth, 3, slabDepth),
			CFrame = CFrame.fromMatrix(slabCenter, segRight, Vector3.yAxis),
			Material = roofMat, Color = roofColor, Parent = roofFolder
		}, "structural")
	end

	-- Oculus rim (decorative stone ring around the opening)
	local rimParts = 24
	for i = 0, rimParts - 1 do
		local a = i * (math.pi * 2) / rimParts
		local dx = math.sin(a) * oculusRadius
		local dz = math.cos(a) * oculusRadius
		local segFwd = Vector3.new(-math.sin(a), 0, -math.cos(a))
		local segRight = GeometryCore.getRight(segFwd)
		local arcLen = 2 * oculusRadius * math.pi / rimParts + 0.5

		GeometryCore.newPart({
			Name = "OculusRim_" .. i,
			Size = Vector3.new(arcLen, 4, 2.5),
			CFrame = CFrame.fromMatrix(
				pos + Vector3.new(dx, height + 1, dz),
				segRight, Vector3.yAxis
			),
			Material = Enum.Material.Slate, Color = Color3.fromRGB(30, 30, 35), Parent = roofFolder
		}, "structural")
	end

	-- Golden light beam pouring down through the oculus onto the crystal
	local beam = GeometryCore.newPart({
		Name = "OculusLightBeam",
		Size = Vector3.new(oculusRadius * 1.6, height + 2, oculusRadius * 1.6),
		Shape = Enum.PartType.Cylinder,
		CFrame = CFrame.new(pos + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 220, 120),
		Transparency = 0.92,
		CanCollide = false,
		Parent = roofFolder
	}, "decorative")

	-- SpotLight shining down through the oculus
	local oculusLight = Instance.new("SpotLight")
	oculusLight.Color = Color3.fromRGB(255, 230, 160)
	oculusLight.Range = 80
	oculusLight.Brightness = 8
	oculusLight.Angle = 55
	oculusLight.Face = Enum.NormalId.Bottom
	oculusLight.Shadows = true

	local oculusLightAnchor = GeometryCore.newPart({
		Name = "OculusLightAnchor",
		Size = Vector3.new(2, 1, 2),
		CFrame = CFrame.new(pos + Vector3.new(0, height + 3, 0)),
		Transparency = 1, CanCollide = false,
		Parent = roofFolder
	}, "decorative")
	oculusLight.Parent = oculusLightAnchor

	-- Sky visible through the oculus (bright neon disc above the opening)
	GeometryCore.newPart({
		Name = "SkyDisc",
		Size = Vector3.new(oculusRadius * 2 - 2, 0.5, oculusRadius * 2 - 2),
		Shape = Enum.PartType.Cylinder,
		CFrame = CFrame.new(pos + Vector3.new(0, height + 4, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Material = Enum.Material.Neon, Color = Color3.fromRGB(200, 220, 255),
		Transparency = 0.3, CanCollide = false, Parent = roofFolder
	}, "decorative")

	-- Starfield on the underside of the roof
	local numStars = 180
	local starRng = Random.new(4242)
	for i = 1, numStars do
		local angle = starRng:NextNumber(0, math.pi * 2)
		local dist = starRng:NextNumber(oculusRadius + 1, roofOuterR - 2)
		local sx = math.sin(angle) * dist
		local sz = math.cos(angle) * dist
		local sSize = starRng:NextNumber(0.2, 0.8)

		local isBright = starRng:NextNumber() > 0.85
		local starColor = isBright and Color3.fromRGB(200, 230, 255) or Color3.fromRGB(255, 255, 255)

		GeometryCore.newPart({
			Name = "RoofStar_" .. i,
			Size = Vector3.new(sSize, 0.2, sSize),
			CFrame = CFrame.new(pos + Vector3.new(sx, height - 0.45, sz)) * CFrame.Angles(0, starRng:NextNumber(0, math.pi), 0),
			Material = Enum.Material.Neon, 
			Color = starColor,
			Transparency = isBright and 0.1 or 0.4,
			CanCollide = false, Parent = roofFolder
		}, "decorative")
	end

	------------------------------------------------------------------------
	-- DYNAMIC ROOM LIGHTING CONTROLLER
	------------------------------------------------------------------------
	local function runLightingController(roomCenter, radius)
		local runService = game:GetService("RunService")
		local lighting = game:GetService("Lighting")
		local tweenService = game:GetService("TweenService")
		
		local inRoom = false
		local defaultAmbient = lighting.Ambient
		local defaultOutdoor = lighting.OutdoorAmbient
		local dimAmbient = Color3.fromRGB(10, 10, 15)
		local dimOutdoor = Color3.fromRGB(15, 15, 20)
		
		runService.Heartbeat:Connect(function()
			local isSomeoneInRoom = false
			for _, player in ipairs(game.Players:GetPlayers()) do
				if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					local dist = (player.Character.HumanoidRootPart.Position - roomCenter).Magnitude
					if dist < radius then
						isSomeoneInRoom = true
						break
					end
				end
			end
			
			if isSomeoneInRoom and not inRoom then
				inRoom = true
				tweenService:Create(lighting, TweenInfo.new(1.5), {
					Ambient = dimAmbient,
					OutdoorAmbient = dimOutdoor
				}):Play()
			elseif not isSomeoneInRoom and inRoom then
				inRoom = false
				tweenService:Create(lighting, TweenInfo.new(1.5), {
					Ambient = defaultAmbient,
					OutdoorAmbient = defaultOutdoor
				}):Play()
			end
		end)
	end

	local lightingScript = Instance.new("Script")
	lightingScript.Name = "RoomCLightingController"
	local lightingSource = [[
		local roomCenter = script.Parent.StructuralFloor.Floor_SquareBase.Position
		local radius = ]] .. tostring(R + 25) .. [[
		
		local runService = game:GetService("RunService")
		local lighting = game:GetService("Lighting")
		local tweenService = game:GetService("TweenService")
		
		local inRoom = false
		local defaultAmbient = lighting.Ambient
		local defaultOutdoor = lighting.OutdoorAmbient
		local dimAmbient = Color3.fromRGB(10, 10, 15)
		local dimOutdoor = Color3.fromRGB(15, 15, 20)
		
		runService.Heartbeat:Connect(function()
			local isSomeoneInRoom = false
			for _, player in ipairs(game.Players:GetPlayers()) do
				if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					local dist = (player.Character.HumanoidRootPart.Position - roomCenter).Magnitude
					if dist < radius then
						isSomeoneInRoom = true
						break
					end
				end
			end
			
			if isSomeoneInRoom and not inRoom then
				inRoom = true
				tweenService:Create(lighting, TweenInfo.new(1.5), {
					Ambient = dimAmbient,
					OutdoorAmbient = dimOutdoor
				}):Play()
			elseif not isSomeoneInRoom and inRoom then
				inRoom = false
				tweenService:Create(lighting, TweenInfo.new(1.5), {
					Ambient = defaultAmbient,
					OutdoorAmbient = defaultOutdoor
				}):Play()
			end
		end)
	]]
	
	local canSetLightingSource = pcall(function()
		lightingScript.Source = lightingSource
	end)
	
	if not canSetLightingSource then
		task.spawn(function()
			runLightingController(folder.StructuralFloor.Floor_SquareBase.Position, R + 25)
		end)
	end
	
	lightingScript.Parent = folder

	return folder
end

local Collapse = {}

function Collapse.buildCorridor(parent, name, zStart, yStart, zEnd, yEnd, widthStart, widthEnd)
	local folder = GeometryCore.newFolder(parent, name)
	local t = 4
	local length = zEnd - zStart
	local zCenter = (zStart + zEnd) / 2
	local yCenter = (yStart + yEnd) / 2
	local pos = Vector3.new(0, yCenter, zCenter)
	local floorWidth = (widthStart + widthEnd) / 2

	local numSteps = 5
	local stepHeight = (yEnd - yStart) / numSteps
	local stepLength = 2  -- 2 studs per step

	for i = 1, numSteps do
		local curY = yStart + i * stepHeight
		local curZStart = zStart + (i-1) * stepLength
		GeometryCore.newPart({
			Name = "StairStep_" .. i,
			Size = Vector3.new(floorWidth, curY - yStart, stepLength),
			CFrame = CFrame.new(0, yStart + (curY - yStart)/2, curZStart + stepLength/2),
			Material = MAT.floor, Color = COLOR.floor, Parent = folder
		}, "structural")
	end

	local landingZStart = zStart + numSteps * stepLength
	local landingLength = zEnd - landingZStart
	if landingLength > 0 then
		GeometryCore.newPart({
			Name = "StairLanding",
			Size = Vector3.new(floorWidth, yEnd - yStart, landingLength),
			CFrame = CFrame.new(0, yStart + (yEnd - yStart)/2, landingZStart + landingLength/2),
			Material = MAT.floor, Color = COLOR.floor, Parent = folder
		}, "structural")
	end

	local height = 24

	GeometryCore.newPart({
		Name = "WallL", Size = Vector3.new(t, height, length),
		CFrame = CFrame.new(pos + Vector3.new(-floorWidth/2 - t/2, height/2, 0)),
		Material = MAT.wall, Color = COLOR.wall, Parent = folder
	}, "structural")

	GeometryCore.newPart({
		Name = "WallR", Size = Vector3.new(t, height, length),
		CFrame = CFrame.new(pos + Vector3.new(floorWidth/2 + t/2, height/2, 0)),
		Material = MAT.wall, Color = COLOR.wall, Parent = folder
	}, "structural")

	return folder
end

function Collapse.buildAll(parent)
	local folder = GeometryCore.newFolder(parent, "Transitions")

	-- Transition from Room A to B
	local tAB = MapManager.rooms.TransAB
	Collapse.buildCorridor(folder, "TransAB", tAB.zStart, tAB.yStart, tAB.zEnd, tAB.yEnd, tAB.width, tAB.width)

	-- Transition from Room B to C
	local tBC = MapManager.rooms.TransBC
	Collapse.buildCorridor(folder, "TransBC", tBC.zStart, tBC.yStart, tBC.zEnd, tBC.yEnd, tBC.width, tBC.width)

	-- Transition from Room C to D (Chasm Entrance)
	local tCD = MapManager.rooms.TransCD
	Collapse.buildCorridor(folder, "TransCD", tCD.zStart, tCD.yStart, tCD.zEnd, tCD.yEnd, tCD.width, tCD.width)

	return folder
end

------------------------------------------------------------------------
-- 8.5 ROOM D (THE ANCIENT CHASM)
------------------------------------------------------------------------
local RoomD = {}

function RoomD.build(parent)
	local rDef = MapManager.rooms.RoomD
	local folder = GeometryCore.newFolder(parent, "RoomD_Chasm")
	local pos = rDef.position
	
	-- Materials and Colors
	local rockMat = Enum.Material.Rock
	local rockCol = Color3.fromRGB(105, 100, 90)
	local mossCol = Color3.fromRGB(45, 65, 40)
	local floorMat = Enum.Material.Cobblestone
	local floorCol = Color3.fromRGB(80, 95, 75) -- Same as Rooms A,B,C
	local trimMat = Enum.Material.Slate
	local trimCol = Color3.fromRGB(85, 80, 75)
	local abyssCol = Color3.fromRGB(5, 5, 5)

	-- Chain building helper for realistic 3D interlocking links with sag
	local function buildRealisticChain(parentName, p1, p2, sag)
		local linkFolder = GeometryCore.newFolder(folder, parentName)
		local dist = (p2 - p1).Magnitude
		local linkLength = 3.2
		local linkWidth = 1.6
		local thick = 0.5
		local numLinks = math.max(2, math.floor(dist / (linkLength * 0.75)))

		local mat = Enum.Material.Metal
		local col = Color3.fromRGB(20, 20, 25)

		for L = 0, numLinks - 1 do
			local t0 = L / numLinks
			local t1 = (L + 1) / numLinks
			local tMid = (L + 0.5) / numLinks

			local function getPos(t)
				local lerpP = p1:Lerp(p2, t)
				local sagOff = sag * 4 * t * (1 - t)
				return lerpP - Vector3.new(0, sagOff, 0)
			end

			local pos0 = getPos(t0)
			local pos1 = getPos(t1)
			local posMid = getPos(tMid)

			local cframe = CFrame.new(posMid, pos1) * CFrame.Angles(0, 0, (L % 2 == 0) and math.pi/2 or 0)

			local sideDist = (linkWidth - thick)/2
			local endDist = (linkLength - thick)/2
			local actualLen = (pos1 - pos0).Magnitude + thick

			GeometryCore.newPart({Name="SideA", Size=Vector3.new(thick, thick, actualLen - thick), CFrame=cframe * CFrame.new(sideDist, 0, 0), Material=mat, Color=col, Parent=linkFolder}, "decorative")
			GeometryCore.newPart({Name="SideB", Size=Vector3.new(thick, thick, actualLen - thick), CFrame=cframe * CFrame.new(-sideDist, 0, 0), Material=mat, Color=col, Parent=linkFolder}, "decorative")
			GeometryCore.newPart({Name="EndA", Size=Vector3.new(linkWidth, thick, thick), CFrame=cframe * CFrame.new(0, 0, endDist), Material=mat, Color=col, Parent=linkFolder}, "decorative")
			GeometryCore.newPart({Name="EndB", Size=Vector3.new(linkWidth, thick, thick), CFrame=cframe * CFrame.new(0, 0, -endDist), Material=mat, Color=col, Parent=linkFolder}, "decorative")
		end
	end

	------------------------------------------------------------------------
	-- 1. CHASM WALLS & ABYSS (Mountain Look)
	------------------------------------------------------------------------
	local structFolder = GeometryCore.newFolder(folder, "Structural")
	
	-- The deep abyss floor
	GeometryCore.newPart({
		Name = "AbyssFloor",
		Size = Vector3.new(rDef.chasmWidth + 20, 10, rDef.chasmLength + 20),
		CFrame = CFrame.new(pos.X, pos.Y - rDef.depthBelow, pos.Z),
		Material = Enum.Material.Slate, Color = abyssCol, Parent = structFolder
	}, "structural")

	-- Solid backing walls so the sky doesn't show through
	GeometryCore.newPart({
		Name = "BackWallL", Size = Vector3.new(10, rDef.wallHeight + rDef.depthBelow + 50, rDef.chasmLength + 50),
		CFrame = CFrame.new(pos.X - rDef.chasmWidth/2 - 15, pos.Y + (rDef.wallHeight - rDef.depthBelow)/2, pos.Z),
		Material = rockMat, Color = rockCol, Parent = structFolder
	}, "structural")
	GeometryCore.newPart({
		Name = "BackWallR", Size = Vector3.new(10, rDef.wallHeight + rDef.depthBelow + 50, rDef.chasmLength + 50),
		CFrame = CFrame.new(pos.X + rDef.chasmWidth/2 + 15, pos.Y + (rDef.wallHeight - rDef.depthBelow)/2, pos.Z),
		Material = rockMat, Color = rockCol, Parent = structFolder
	}, "structural")

	-- High-density detailed rock strata
	local stepZ = 14
	local stepY = 14
	
	for side = -1, 1, 2 do
		for zOffset = 0, rDef.chasmLength, stepZ do
			local curZ = pos.Z - rDef.chasmLength/2 + zOffset
			for yOffset = 0, rDef.wallHeight + rDef.depthBelow, stepY do
				local curY = pos.Y - rDef.depthBelow + yOffset
				local rng = Random.new(math.floor(curZ * 100 + curY))
				
				-- Use multiple overlapping rocks per grid cell to create high density detail
				local numRocks = rng:NextInteger(2, 4)
				for rock = 1, numRocks do
					local rSize = Vector3.new(rng:NextNumber(15, 30), rng:NextNumber(10, 22), rng:NextNumber(20, 35))
					local depthVar = rng:NextNumber(-2, 10)
					local wX = pos.X + side * (rDef.chasmWidth/2 + depthVar)
					
					local pType = (rng:NextNumber() > 0.4) and "WedgePart" or "Part"
					local p = Instance.new(pType)
					p.Name = "MountainRock"
					p.Size = rSize
					p.CFrame = CFrame.new(
						wX + rng:NextNumber(-3, 3), 
						curY + rng:NextNumber(-4, 4), 
						curZ + rng:NextNumber(-4, 4)
					) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, math.pi), rng:NextNumber(-0.5, 0.5))
					p.Material = rockMat
					p.Color = rockCol
					p.Anchored = true
					p.Parent = structFolder
					GeometryCore.incrementCount("structural")
				end

				-- Massive amount of vines hanging down the walls
				-- Spawning a huge amount everywhere for a very overgrown look
				local numVines = rng:NextInteger(4, 8)
				for v = 1, numVines do
					local vLen = rng:NextNumber(20, 100)
					local vThick = rng:NextNumber(0.8, 3.5)
					GeometryCore.newPart({
						Name = "WallVine", Size = Vector3.new(vThick, vLen, vThick),
						CFrame = CFrame.new(pos.X + side * (rDef.chasmWidth/2 - rng:NextNumber(1, 12)), curY - vLen/2 + rng:NextNumber(-5, 5), curZ + rng:NextNumber(-8, 8)),
						Material = Enum.Material.LeafyGrass, Color = mossCol, CanCollide = false, Parent = structFolder
					}, "decorative")
				end
			end
		end
	end
	
	------------------------------------------------------------------------
	-- 2. PARKOUR PLATFORMS (Double Jump Spacing)
	------------------------------------------------------------------------
	local parkourFolder = GeometryCore.newFolder(folder, "Parkour")
	local numPlatforms = 16
	local startY = pos.Y
	local endY = pos.Y + 160 -- They climb up 160 studs
	local climbZStart = rDef.zStart + 20
	local climbZEnd = rDef.zEnd - 40
	
	local prevPos = Vector3.new(0, startY, climbZStart)
	
	for i = 1, numPlatforms do
		local prng = Random.new(4000 + i)
		local pY = startY + (endY - startY) * (i / numPlatforms)
		local pZ = climbZStart + (climbZEnd - climbZStart) * (i / numPlatforms)
		
		-- Alternate walls: even = left, odd = right
		local onLeft = (i % 2 == 0)
		-- Pulled platforms further out into the chasm so they are highly visible
		local pX = onLeft and (pos.X - 14) or (pos.X + 14)
		
		-- Only the first 2 steps are small jumps, the rest are huge double-jump gaps (12-15+ studs)
		if i > 2 then
			pY = prevPos.Y + prng:NextNumber(10, 18)
			pZ = prevPos.Z + prng:NextNumber(12, 18)
		else
			pY = prevPos.Y + 5
			pZ = prevPos.Z + 8
		end
		
		-- Massive thick platforms to stand out against the rocks
		local pSize = Vector3.new(prng:NextNumber(16, 24), 4, prng:NextNumber(16, 24))
		local platCFrame = CFrame.new(pX, pY, pZ)
		
		local plat = GeometryCore.newPart({
			Name = "Platform_"..i,
			Size = pSize,
			CFrame = platCFrame,
			Material = floorMat, Color = floorCol, Parent = parkourFolder
		}, "structural")
		
		-- Add the entrance guide rope at platform 1
		if i == 1 then
			local ropeStart = Vector3.new(pos.X, pos.Y + 20, rDef.zStart) -- Above entrance
			local ropeEnd = platCFrame.Position + Vector3.new(0, 5, 0)
			local ropeVec = ropeEnd - ropeStart
			local ropeDist = ropeVec.Magnitude
			
			GeometryCore.newPart({
				Name = "GuideRope",
				Size = Vector3.new(0.6, ropeDist, 0.6),
				CFrame = CFrame.new(ropeStart + ropeVec/2, ropeEnd) * CFrame.Angles(math.pi/2, 0, 0),
				Shape = Enum.PartType.Cylinder,
				Material = Enum.Material.Fabric,
				Color = Color3.fromRGB(150, 120, 80),
				Parent = parkourFolder
			}, "decorative")
		end
		
		-- Platform Edge Ruins
		GeometryCore.newPart({
			Name = "PlatEdge", Size = Vector3.new(pSize.X+1, 1, pSize.Z+1),
			CFrame = platCFrame * CFrame.new(0, 1.5, 0),
			Material = trimMat, Color = rockCol, Parent = parkourFolder
		}, "structural")

		-- Hanging vines under platform
		local numVines = prng:NextInteger(3, 6)
		for v = 1, numVines do
			local vLen = prng:NextNumber(15, 30)
			GeometryCore.newPart({
				Name = "Vine", Size = Vector3.new(1, vLen, 1),
				CFrame = platCFrame * CFrame.new(prng:NextNumber(-pSize.X/2, pSize.X/2), -1.5 - vLen/2, prng:NextNumber(-pSize.Z/2, pSize.Z/2)),
				Material = Enum.Material.LeafyGrass, Color = mossCol, CanCollide = false, Parent = parkourFolder
			}, "decorative")
		end
		
		prevPos = platCFrame.Position
	end
	
	------------------------------------------------------------------------
	-- 3. FINAL VIEWING PLATFORM
	------------------------------------------------------------------------
	local endPlatY = prevPos.Y + 12
	local endPlatZ = rDef.zEnd - 10
	local viewingPlat = GeometryCore.newPart({
		Name = "ViewingPlatform",
		Size = Vector3.new(rDef.chasmWidth - 10, 4, 30),
		CFrame = CFrame.new(pos.X, endPlatY, endPlatZ),
		Material = floorMat, Color = floorCol, Parent = parkourFolder
	}, "structural")
	
	for i = -1, 1 do
		if i ~= 0 then
			GeometryCore.newPart({
				Name = "Pillar",
				Size = Vector3.new(4, 12, 4),
				CFrame = CFrame.new(pos.X + i * 20, endPlatY + 6, endPlatZ + 12),
				Material = trimMat, Color = rockCol, Parent = parkourFolder
			}, "structural")
		end
	end
	
	------------------------------------------------------------------------
	-- 4. HANGING CHAINS
	------------------------------------------------------------------------
	local decorFolder = GeometryCore.newFolder(folder, "Decorations")
	local numChains = 6
	for i = 1, numChains do
		local cZ = rDef.zStart + 40 + i * 35
		local cY = pos.Y + 80 + (i%3)*30
		local p1 = Vector3.new(pos.X - rDef.chasmWidth/2, cY, cZ)
		local p2 = Vector3.new(pos.X + rDef.chasmWidth/2, cY, cZ)
		buildRealisticChain("Chain_"..i, p1, p2, 15) -- 15 stud sag
	end

	return folder
end

------------------------------------------------------------------------
-- 9. ROOM A VISUAL & GAMEPLAY PASS (5 ZONES)
------------------------------------------------------------------------


local function getRight(forward)
	return Vector3.new(forward.Z, 0, -forward.X)
end

local function orientedCFrame(position, forward)
	local right = getRight(forward)
	return CFrame.fromMatrix(position, right, Vector3.new(0, 1, 0), -forward)
end

local function horizontalAxisCFrame(position, axisDirection)
	local flat = Vector3.new(axisDirection.X, 0, axisDirection.Z)
	if flat.Magnitude == 0 then flat = Vector3.new(0, 0, -1) end
	flat = flat.Unit
	return CFrame.fromMatrix(position, flat, Vector3.new(0, 1, 0))
end

local function unitXZ(vector)
	local flat = Vector3.new(vector.X, 0, vector.Z)
	if flat.Magnitude == 0 then return Vector3.new(0, 0, -1) end
	return flat.Unit
end

buildSpikeTrap = function(parent, name, floorPosition, forward, skipTravelGuides, customWidth, customDepth)
	local fwd = unitXZ(forward)
	local right = GeometryCore.getRight(fwd)
	local t = table.clone(CONFIG.spikeTrap)
	if customWidth then 
		t.width = customWidth 
		-- Calculate cols based on original spacing (11 studs -> 3 cols = ~3.6 stud spacing)
		t.spikeCols = math.max(3, math.floor(customWidth / 3.6))
	end
	if customDepth then 
		t.depth = customDepth 
		-- Calculate planks and rows based on original spacing
		t.plankCount = math.max(6, math.floor(customDepth / 1.5))
		t.spikeRows = 6 
	end
	local trap = Instance.new("Model")
	trap.Name = name
	trap.Parent = parent

	local rootPart = GeometryCore.newPart({
		Name = "RootPart",
		Size = Vector3.new(1, 1, 1),
		CFrame = GeometryCore.orientedCFrame(floorPosition, fwd),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = trap,
	})
	trap.PrimaryPart = rootPart

	-- Z-FIGHTING FIX: We no longer create a ContinuousFloorPatch here, 
	-- as it overlaps exactly with the structural floor created in RoomA.build!

	local spikeBed = Instance.new("Model")
	spikeBed.Name = "SpikeBed"
	spikeBed.Parent = trap

	-- BedPlate drives the animation but must be completely invisible (no separate base holding spikes)
	local bedPlate = GeometryCore.newPart({
		Name = "BedPlate",
		Size = Vector3.new(t.width - 1, 0.3, t.depth - 1),
		CFrame = GeometryCore.orientedCFrame(floorPosition + Vector3.new(0, t.restOffsetY, 0), fwd),
		Transparency = 1,
		CanCollide = false,
		Parent = spikeBed,
	})
	spikeBed.PrimaryPart = bedPlate

	-- Dense and intentional grid: exactly 6 rows, and 6 columns
	local numRows = 6
	local numCols = 6
	local colSpacing = t.width / (numCols + 1)
	local rowSpacing = t.depth / (numRows + 1)

	-- Target: approximately 4-5x taller than base diameter.
	-- Height = 6.0, Radius = 0.6 -> Diameter = 1.2 -> Ratio = 5.0
	local spikeHeight = 6.0 
	local spikeBaseRadius = 0.6

	-- The base of the spike sits 1.0 studs below the BedPlate.
	-- At rest, BedPlate is at -1.0. Spike base is at -2.0. Spike tip is at -2.0 + 6.0 = 4.0 (Visibly tall!)
	-- At max extension, BedPlate is at 2.4. Spike base is at 1.4. Wait, floor is at Y=0!
	-- If base is at 1.4, it floats!
	-- So we MUST put the base at least 2.5 studs below BedPlate so it never exceeds Y=0.
	local localSpikeYOffset = -2.5

	for col = 1, numCols do
		local localRight = -t.width / 2 + colSpacing * col
		for row = 1, numRows do
			local localForward = -t.depth / 2 + rowSpacing * row

			local spikeBase = floorPosition
				+ right * localRight
				+ fwd * localForward
				+ Vector3.new(0, t.restOffsetY + localSpikeYOffset, 0)

			local rng = Random.new(col * 100 + row)
			local tiltX = math.rad(rng:NextNumber(-2, 2))
			local tiltZ = math.rad(rng:NextNumber(-2, 2))
			local offsetX = rng:NextNumber(-0.03, 0.03)
			local offsetZ = rng:NextNumber(-0.03, 0.03)

			local spikePart = Instance.new("Part")
			spikePart.Name = string.format("Spike_%d_%d", col, row)
			spikePart.Size = Vector3.new(spikeBaseRadius * 2, spikeHeight, spikeBaseRadius * 2)
			spikePart.CFrame = CFrame.new(spikeBase + Vector3.new(offsetX, spikeHeight / 2, offsetZ))
				* CFrame.Angles(tiltX, 0, tiltZ)
			spikePart.Anchored = true
			spikePart.CanCollide = true
			spikePart.Material = Enum.Material.CorrodedMetal
			-- Dark brown/aged metal or stone material
			spikePart.Color = Color3.fromRGB(80, 65, 55)
			spikePart.Parent = spikeBed
			GeometryCore.incrementCount("structural")

			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.FileMesh
			mesh.MeshId = "rbxassetid://1033714"
			-- CRITICAL FIX: SpecialMesh with FileMesh DOES NOT scale to Part.Size automatically!
			-- We MUST manually set the Scale property to the desired world dimensions!
			mesh.Scale = Vector3.new(spikeBaseRadius * 2, spikeHeight, spikeBaseRadius * 2)
			mesh.Parent = spikePart
		end
	end

	trap:SetAttribute("Kind", "SpikeTrap")
	trap:SetAttribute("CycleSeconds", t.cycleSeconds)
	trap:SetAttribute("Damage", t.damage)
	trap:SetAttribute("RestOffsetY", t.restOffsetY)
	trap:SetAttribute("ExtendOffsetY", t.extendOffsetY)
	CollectionService:AddTag(trap, "SpikeTrap")

	return trap
end

local function buildSwingingBlade(parent, name, pivotPosition, forward, floorY)
	local b = CONFIG.swingingBlade
	local fwd = unitXZ(forward)
	local right = GeometryCore.getRight(fwd)
	local blade = Instance.new("Model")
	blade.Name = name
	blade.Parent = parent

	-- STATIC CEILING MOUNT (Very short, just to anchor to the ceiling)
	local mountDrop = 1.0
	local postForwardOffset = b.axleLength / 2
	for _, side in ipairs({ -1, 1 }) do
		local postTop = pivotPosition + fwd * (postForwardOffset * side) + Vector3.new(0, mountDrop, 0)
		local postBottom = pivotPosition + fwd * (postForwardOffset * side)

		GeometryCore.newPart({
			Name = "SupportPost_" .. (side > 0 and "Front" or "Back"),
			Size = Vector3.new(0.55, mountDrop, 0.55),
			CFrame = CFrame.new((postTop + postBottom) / 2),
			Material = METAL,
			Color = C_IRON,
			Parent = blade,
		})
		GeometryCore.newPart({
			Name = "MountPlate_" .. (side > 0 and "Front" or "Back"),
			Size = Vector3.new(1.1, 0.3, 1.1),
			CFrame = CFrame.new(postTop + Vector3.new(0, -0.1, 0)),
			Material = METAL,
			Color = C_IRON,
			Parent = blade,
		})
	end

	GeometryCore.newPart({
		Name = "Axle",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(b.axleLength + 0.6, 0.3, 0.3),
		CFrame = horizontalAxisCFrame(pivotPosition, fwd),
		Material = METAL,
		Color = C_IRON,
		Parent = blade,
	})

	-- SWINGING ASSEMBLY (Everything below this swings)
	local pivot = Instance.new("Model")
	pivot.Name = "Pivot"
	pivot.Parent = blade

	local pivotHub = GeometryCore.newPart({
		Name = "PivotHub",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.4, 1.4, 1.4), -- Slightly larger to look robust
		CFrame = CFrame.new(pivotPosition),
		Material = METAL,
		Color = C_IRON,
		Parent = pivot,
	})
	pivot.PrimaryPart = pivotHub

	-- Calculate exact player-level blade position based on REAL floor
	local bladeCenterY = floorY + 5.0
	local bladeCenter = Vector3.new(pivotPosition.X, bladeCenterY, pivotPosition.Z)
	local dynamicArmLength = pivotPosition.Y - bladeCenterY

	GeometryCore.newPart({
		Name = "Arm",
		Size = Vector3.new(0.45, dynamicArmLength, 0.45),
		CFrame = CFrame.new((pivotPosition + bladeCenter) / 2),
		Material = METAL,
		Color = C_IRON,
		Parent = pivot,
	})

	-- Decorative chains that SWING with the arm
	for linkIndex = 1, 8 do
		local linkY = pivotPosition.Y - 0.7 - (linkIndex - 1) * 0.55
		if linkY < bladeCenterY + 2 then break end
		GeometryCore.newPart({
			Name = "ChainLink_" .. linkIndex,
			Size = linkIndex % 2 == 0 and Vector3.new(0.6, 0.5, 0.25) or Vector3.new(0.25, 0.5, 0.6),
			CFrame = CFrame.new(pivotPosition.X, linkY, pivotPosition.Z),
			Material = METAL,
			Color = C_IRON,
			Parent = pivot,
		})
	end

	local bladeAxis = horizontalAxisCFrame(bladeCenter, fwd)
	GeometryCore.newPart({
		Name = "BladeHub",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.7, 1.8, 1.8),
		CFrame = bladeAxis,
		Material = METAL,
		Color = C_IRON,
		Parent = pivot,
	})

	GeometryCore.newPart({
		Name = "BladeDisc",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.35, b.bladeRadius * 2, b.bladeRadius * 2),
		CFrame = bladeAxis,
		Material = SPIKE_STEEL,
		Color = C_SPIKE_STEEL,
		Parent = pivot,
	})

	for toothIndex = 0, 15 do
		local toothAngle = math.rad(toothIndex * 22.5)
		GeometryCore.newPart({
			Name = "BladeTooth_" .. toothIndex,
			Size = Vector3.new(0.3, 0.5, 0.42),
			CFrame = bladeAxis * CFrame.Angles(toothAngle, 0, 0) * CFrame.new(0, b.bladeRadius - 0.1, 0),
			Material = SPIKE_STEEL,
			Color = C_SPIKE_STEEL,
			Parent = pivot,
		})
	end

	-- We remove the counterweight because it would stick into the ceiling and clip.
	-- The heavy PivotHub serves as the mechanical anchor.

	blade:SetAttribute("Kind", "SwingingBlade")
	blade:SetAttribute("SwingAxis", fwd)
	blade:SetAttribute("SwingDegrees", b.swingDegrees)
	blade:SetAttribute("PeriodSeconds", b.periodSeconds)
	blade:SetAttribute("Damage", b.damage)
	-- We save the dynamicArmLength so we can use it to calculate the safe swing angle!
	blade:SetAttribute("DynamicArmLength", dynamicArmLength)
	CollectionService:AddTag(blade, "SwingingBlade")

	return blade
end

local function buildPortcullisDoor(parent, name, floorPosition, forward, doorWidth, roomHeight)
	local right = GeometryCore.getRight(forward)
	local d = CONFIG.portcullis
	local assembly = Instance.new("Folder")
	assembly.Name = name
	assembly.Parent = parent

	local trackInset = doorWidth / 2 + 0.5
	local trackHeight = roomHeight - 0.5

	for _, side in ipairs({ -1, 1 }) do
		local sideName = side < 0 and "Left" or "Right"
		GeometryCore.addOrientedPart(assembly, "Jamb" .. sideName, Vector3.new(1.6, trackHeight, 2.2),
			floorPosition + right * (trackInset * side) + Vector3.new(0, trackHeight / 2, 0),
			forward, STONE, C_DARK_STONE)
		GeometryCore.addOrientedPart(assembly, "Track" .. sideName, Vector3.new(0.4, trackHeight, 0.6),
			floorPosition + right * ((trackInset - 0.9) * side) + Vector3.new(0, trackHeight / 2, 0),
			forward, METAL, C_IRON)
	end

	GeometryCore.addOrientedPart(assembly, "Lintel", Vector3.new(doorWidth + 3.6, 2.2, 2.6),
		floorPosition + Vector3.new(0, roomHeight - 1.1, 0),
		forward, STONE, C_DARK_STONE)

	for _, side in ipairs({ -1, 1 }) do
		local sideName = side < 0 and "Left" or "Right"
		local housingCenter = floorPosition + right * (trackInset * side) + Vector3.new(0, roomHeight - 2.0, 0)
		GeometryCore.addOrientedPart(assembly, "CounterHousing" .. sideName, Vector3.new(1.9, 2.6, 2.4),
			housingCenter, forward, STONE, C_STONE)
		GeometryCore.newPart({
			Name = "CounterWeight" .. sideName,
			Size = Vector3.new(1.0, 1.0, 1.0),
			CFrame = CFrame.new(housingCenter + Vector3.new(0, -0.4, 0)),
			Material = METAL,
			Color = C_IRON,
			Parent = assembly,
		})
	end

	local leaf = Instance.new("Model")
	leaf.Name = "Leaf"
	leaf.Parent = assembly

	local leafHeight = roomHeight * d.leafHeightRatio
	local leafWidth = doorWidth - 0.6
	local openCenterY = roomHeight - leafHeight / 2 - 0.4
	local closedCenterY = leafHeight / 2 + 0.1
	local leafCenter = floorPosition + Vector3.new(0, openCenterY, 0)

	local barSpacing = leafWidth / (d.verticalBars + 1)
	local primaryBar = nil

	for barIndex = 1, d.verticalBars do
		local barRight = -leafWidth / 2 + barSpacing * barIndex
		local bar = GeometryCore.addOrientedPart(leaf, "VerticalBar_" .. barIndex, Vector3.new(0.4, leafHeight - 0.8, 0.4),
			leafCenter + right * barRight + Vector3.new(0, -0.4, 0), forward,
			METAL, C_IRON)
		primaryBar = primaryBar or bar

		local segHeight = 0.9 / 3
		for seg = 1, 3 do
			local segRadiusAvg = math.max(0.24 * (1 - (seg - 1) / 3), 0.03)
			GeometryCore.newPart({
				Name = string.format("BarSpike_%d_%d", barIndex, seg),
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(segHeight + 0.05, segRadiusAvg * 2, segRadiusAvg * 2),
				CFrame = CFrame.new(leafCenter + right * barRight
					+ Vector3.new(0, -leafHeight / 2 + segHeight * (seg - 0.5), 0))
					* CFrame.Angles(0, 0, math.rad(90)),
				Material = METAL,
				Color = C_SPIKE,
				Parent = leaf,
			})
		end
	end

	for crossIndex = 1, d.horizontalBars do
		local crossY = -leafHeight / 2 + (leafHeight / (d.horizontalBars + 1)) * crossIndex
		GeometryCore.addOrientedPart(leaf, "CrossBar_" .. crossIndex, Vector3.new(leafWidth, 0.35, 0.35),
			leafCenter + Vector3.new(0, crossY, 0), forward,
			METAL, C_IRON)
	end

	leaf.PrimaryPart = primaryBar
	assembly:SetAttribute("Kind", "SealingDoor")
	assembly:SetAttribute("OpenOffsetY", openCenterY)
	assembly:SetAttribute("ClosedOffsetY", closedCenterY)
	assembly:SetAttribute("TriggerType", "CrossDistance")
	CollectionService:AddTag(assembly, "SealingDoor")

	return assembly
end

local function buildCeilingSpike(parent, name, centerPosition, forward)
	local trap = buildSpikeTrap(parent, name, centerPosition, forward, true)
	trap:PivotTo(trap:GetPivot() * CFrame.Angles(0, 0, math.pi))
	return trap
end

local function buildWallSpike(parent, name, centerPosition, forward, isRightWall)
	local trap = buildSpikeTrap(parent, name, centerPosition, forward, true)
	local angle = isRightWall and (math.pi / 2) or (-math.pi / 2)
	trap:PivotTo(trap:GetPivot() * CFrame.Angles(0, 0, angle))
	return trap
end

local function generateRoomAObstacleCourse(room, entrancePosition, forward, length, width, height)
	local right = GeometryCore.getRight(forward)
	local leftWallOrigin = entrancePosition - right * (width / 2)
	local rightWallOrigin = entrancePosition + right * (width / 2)

	local hazardRandom = Random.new(20260931)

	local trapIndex = 1
	local bladeIndex = 1
	local bladePivotY = height - CONFIG.swingingBlade.mountDrop
	local hazardEnd = length - 30

	local trapFootprintDepth = CONFIG.spikeTrap.depth + CONFIG.spikeTrap.housingMargin * 2
	local trapClearance = trapFootprintDepth + 2

	local function nextSpacing()
		return hazardRandom:NextInteger(8, 11)
	end

	local function placeBlade(dist, lateralOffset)
		lateralOffset = lateralOffset or 0
		local bladePivotY = height - 1.0 -- Mount exactly under the ceiling
		local pivotPos = entrancePosition + forward * dist + right * lateralOffset + Vector3.new(0, bladePivotY, 0)
		local floorY = entrancePosition.Y

		local blade = buildSwingingBlade(
			room,
			"SwingingBlade_" .. bladeIndex,
			pivotPos,
			forward,
			floorY
		)
		blade:SetAttribute("PhaseOffset", hazardRandom:NextNumber())

		-- Calculate maximum safe swing angle to prevent wall clipping.
		-- Margins tightened from the original (2.5 / 0.5 / -2deg) so blades actually
		-- use close to the full configured swingDegrees instead of being clamped
		-- down to a few degrees near the corridor walls.
		local b = CONFIG.swingingBlade
		local corridorHalfWidth = (width / 2) - 1.25 -- wall/pilaster safety margin
		local spaceLeft = corridorHalfWidth + lateralOffset
		local spaceRight = corridorHalfWidth - lateralOffset
		local maxLateralSpace = math.min(spaceLeft, spaceRight)

		local effectiveR = b.bladeRadius + 0.3 -- small extra for teeth
		local dynamicArmLength = blade:GetAttribute("DynamicArmLength")
		local safeTheta = math.asin( math.clamp((maxLateralSpace - effectiveR) / dynamicArmLength, 0, 1) )
		local safeDegrees = math.min(b.swingDegrees, math.deg(safeTheta) - 1) -- 1 degree safety margin, capped at config target
		blade:SetAttribute("SwingDegrees", safeDegrees)

		bladeIndex = bladeIndex + 1
		return blade
	end

	local function placeFloor(dist, lateralOffset)
		lateralOffset = lateralOffset or 0
		-- Floor Spike Redesign: calculate actual usable corridor width at this Z position.
		-- Room A width is 30. Pilasters stick out 2 studs on each side (usable = 26).
		-- With a small architectural clearance, a width of 25 is safe for normal corridors.
		local zPos = (entrancePosition + forward * dist).Z
		local isTrench = zPos >= 125 and zPos <= 170
		local isCrush = (lateralOffset == 6 or lateralOffset == -6)
		local depth = 18 -- Expand to 6 rows

		if isTrench then
			-- In Zone 4 (Z=125 to 170), the Central Trench has two 8-stud side lanes.
			-- Calculate usable geometry for side lanes (w = 8, x = -11 and 11)
			-- Small clearance to ensure no wall clipping.
			local usableWidth = 7
			buildSpikeTrap(
				room,
				"SpikeTrap_" .. trapIndex .. "_Left",
				entrancePosition + forward * dist + right * -11,
				forward,
				false,
				usableWidth,
				depth
			)
			buildSpikeTrap(
				room,
				"SpikeTrap_" .. trapIndex .. "_Right",
				entrancePosition + forward * dist + right * 11,
				forward,
				false,
				usableWidth,
				depth
			)
			trapIndex = trapIndex + 1
		else
			-- For Crush encouters (where spike trap is pushed to one side), 
			-- or normal corridor encounters. 
			-- If Crush, we only want it on half the corridor so we don't clip the opposite wall spikes.
			local usableWidth = isCrush and 13 or 25
			local actualOffset = isCrush and lateralOffset or 0
			
			buildSpikeTrap(
				room,
				"SpikeTrap_" .. trapIndex,
				entrancePosition + forward * dist + right * actualOffset,
				forward,
				false,
				usableWidth,
				depth
			)
			trapIndex = trapIndex + 1
		end
	end

	local function placeCeiling(dist)
		buildCeilingSpike(
			room,
			"CeilingSpike_" .. trapIndex,
			entrancePosition + forward * dist + Vector3.new(0, height, 0),
			forward
		)
		trapIndex = trapIndex + 1
	end

	local function placeWallLeft(dist)
		buildWallSpike(
			room,
			"WallSpike_" .. trapIndex,
			leftWallOrigin + forward * dist + Vector3.new(0, height / 2 - 3, 0),
			forward,
			false
		)
		trapIndex = trapIndex + 1
	end

	local function placeWallRight(dist)
		buildWallSpike(
			room,
			"WallSpike_" .. trapIndex,
			rightWallOrigin + forward * dist + Vector3.new(0, height / 2 - 3, 0),
			forward,
			true
		)
		trapIndex = trapIndex + 1
	end

	local encounterHasTrap = {
		floor = true, ceiling = true, wallLeft = true, wallRight = true,
		blade = false, floorBlade = true, ceilingBlade = true, opposingWalls = true,
		crushRight = true, crushLeft = true, doubleCeiling = true,
	}

	local encounterWeights = {
		{ id = "floor", weight = 18 }, { id = "ceiling", weight = 18 },
		{ id = "wallLeft", weight = 14 }, { id = "wallRight", weight = 14 },
		{ id = "blade", weight = 12 }, { id = "floorBlade", weight = 10 },
		{ id = "ceilingBlade", weight = 8 }, { id = "opposingWalls", weight = 10 },
		{ id = "crushRight", weight = 5 }, { id = "crushLeft", weight = 5 },
		{ id = "doubleCeiling", weight = 6 },
	}

	local function pickEncounterId()
		local totalWeight = 0
		for _, entry in ipairs(encounterWeights) do totalWeight = totalWeight + entry.weight end
		local roll = hazardRandom:NextNumber() * totalWeight
		local cumulative = 0
		for _, entry in ipairs(encounterWeights) do
			cumulative = cumulative + entry.weight
			if roll <= cumulative then return entry.id end
		end
		return encounterWeights[1].id
	end

	local function randRightOffset()
		return hazardRandom:NextInteger(-6, 6)
	end

	local encounters = {
		floor = function(dist) placeFloor(dist, randRightOffset()) end,
		ceiling = function(dist) placeCeiling(dist) end,
		wallLeft = function(dist) placeWallLeft(dist) end,
		wallRight = function(dist) placeWallRight(dist) end,
		blade = function(dist) placeBlade(dist, 0) end,
		floorBlade = function(dist) placeFloor(dist, randRightOffset()); placeBlade(dist, 0) end,
		ceilingBlade = function(dist) placeCeiling(dist); placeBlade(dist, 0) end,
		opposingWalls = function(dist) placeWallLeft(dist); placeWallRight(dist) end,
		crushRight = function(dist) placeWallRight(dist); placeFloor(dist, -6) end,
		crushLeft = function(dist) placeWallLeft(dist); placeFloor(dist, 6) end,
		doubleCeiling = function(dist)
			placeCeiling(dist)
			if dist + trapClearance < hazardEnd then placeCeiling(dist + trapClearance) end
		end,
	}

	local currentDist = 30
	while currentDist < hazardEnd do
		local encounterId = pickEncounterId()
		encounters[encounterId](currentDist)
		local spacing = nextSpacing()
		if encounterHasTrap[encounterId] then
			spacing = math.max(spacing, trapClearance)
		end
		currentDist = currentDist + spacing
	end

	buildPortcullisDoor(room, "ExitPortcullis", entrancePosition + forward * (length - 12), forward, width - 2, height)
end

local function animateSwingingBlades()
	local startTime = os.clock()
	RunService.Heartbeat:Connect(function()
		local elapsed = os.clock() - startTime
		for _, blade in ipairs(CollectionService:GetTagged("SwingingBlade")) do
			local pivotModel = blade:FindFirstChild("Pivot")
			if pivotModel and pivotModel.PrimaryPart then
				local axis = blade:GetAttribute("SwingAxis")
				local degrees = blade:GetAttribute("SwingDegrees")
				local period = blade:GetAttribute("PeriodSeconds")
				if axis and degrees and period and period > 0 then
					local amplitude = math.rad(degrees)
					local phaseOffset = blade:GetAttribute("PhaseOffset") or 0
					local angle = amplitude * math.sin((elapsed / period + phaseOffset) * (math.pi * 2))
					local pivotPosition = pivotModel.PrimaryPart.Position
					pivotModel:PivotTo(CFrame.new(pivotPosition) * CFrame.fromAxisAngle(axis, angle))
				end
			end
		end
	end)
end

local RoomA_VisualPass = {}

local function addSlabFloor(parent, x, z, w, l)
	local p = Instance.new("Part")
	p.Name = "RaisedFloor"
	p.Size = Vector3.new(w, 2, l)
	p.CFrame = CFrame.new(x, -1, z)
	p.Anchored = true
	p.Material = Enum.Material.Cobblestone
	p.Color = Color3.fromRGB(80, 85, 75) -- C_MOSSY
	p.Parent = parent
	GeometryCore.incrementCount("visual")

	if l >= 15 then
		local numStrips = math.floor(l / 15)
		for i = 1, numStrips do
			local sz = z - l/2 + (i * 15)
			if sz < z + l/2 - 1 then
				local g = Instance.new("Part")
				g.Name = "GroutStrip"
				g.Size = Vector3.new(w, 0.1, 0.5)
				g.CFrame = CFrame.new(x, 0.05, sz)
				g.Anchored = true
				g.CanCollide = false
				g.Material = Enum.Material.Cobblestone
				g.Color = Color3.fromRGB(50, 48, 53) -- C_DARK_STONE
				g.Parent = parent
				GeometryCore.incrementCount("visual")
			end
		end
	end
end

function RoomA_VisualPass.build(parent)
	local root = GeometryCore.newFolder(parent, "RoomA_VisualPass")
	local length = CONFIG.roomA.length
	local width = CONFIG.roomA.width
	local height = 24
	local CY = height

	-- Continuous mossy floor is now handled directly by StructuralFloor_Seg in RoomA.build
	-- to prevent Z-fighting and correctly preserve the floor pits.
	local actualLength = 250

	-- Ancient stone-brick ruined roof
	local Roof = Instance.new("Folder"); Roof.Name = "Roof"; Roof.Parent = root
	local rng = Random.new(12345)
	local slabLength = 10
	local numSlabs = math.floor(actualLength / slabLength)

	local function p(n, s, c, m, col, parent, canCol)
		local pt = Instance.new("Part"); pt.Name = n; pt.Size = s; pt.CFrame = c; pt.Anchored = true; pt.CanCollide = (canCol ~= false)
		pt.Material = m; pt.Color = col; pt.Parent = parent; GeometryCore.incrementCount("visual"); return pt
	end

	local function addVines(parent, cframe, drop)
		local vine = p("HangingVine", Vector3.new(0.5, drop, 0.5), cframe * CFrame.new(0, -drop/2, 0), Enum.Material.Grass, Color3.fromRGB(50, 100, 30), parent, false)
	end

	for i = 0, numSlabs - 1 do
		local sz = (i + 0.5) * slabLength
		local sf = Instance.new("Folder"); sf.Name = "RoofSlab_" .. i; sf.Parent = Roof

		-- Base stone color (ancient stone-brick)
		local stoneCol = Color3.fromRGB(115, 118, 125)

		-- Roughly 30% chance of a broken roof section
		if rng:NextNumber() > 0.70 and sz > 30 and sz < actualLength - 40 then
			-- Broken roof section (small irregular gaps)
			p("BrokenSlab1", Vector3.new(width, 2, 4), CFrame.new(0, CY, sz - 3) * CFrame.Angles(0,0,0), Enum.Material.Cobblestone, stoneCol, sf, true)
			p("BrokenSlab2", Vector3.new(width, 2, 4), CFrame.new(0, CY, sz + 3) * CFrame.Angles(0,0,0), Enum.Material.Cobblestone, stoneCol, sf, true)

			-- Jagged edge pieces
			for j=1, 6 do
				local rx = rng:NextNumber(-width/2 + 2, width/2 - 2)
				local rz = sz + rng:NextNumber(-2, 2)
				local rs = rng:NextNumber(2, 5)
				local rRot = rng:NextNumber(-0.3, 0.3)
				p("JaggedEdge_"..j, Vector3.new(rs, 2, rs), CFrame.new(rx, CY, rz) * CFrame.Angles(0, rRot, 0), Enum.Material.Cobblestone, stoneCol, sf, true)
			end

			-- Hanging vines through the opening
			if rng:NextNumber() > 0.35 then
				for v=1, 4 do
					local vx = rng:NextNumber(-width/4, width/4)
					local vz = sz + rng:NextNumber(-2, 2)
					local vDrop = rng:NextNumber(4, 14)
					addVines(sf, CFrame.new(vx, CY, vz), vDrop)
				end
			end

			-- Sunlight shafts (Primary Environmental Lighting)
			local sun = p("SkyOpening", Vector3.new(12, 0.5, 12), CFrame.new(0, CY+2, sz), Enum.Material.Neon, Color3.fromRGB(230, 240, 255), sf, false)
			local sl = Instance.new("SpotLight")
			sl.Color = Color3.fromRGB(255, 250, 240); sl.Range = 80; sl.Brightness = 6; sl.Angle = 140; sl.Face = Enum.NormalId.Bottom
			sl.Shadows = true; sl.Parent = sun

			-- Rubble on the floor directly beneath illuminated by the sun
			local rubbleFolder = Instance.new("Folder"); rubbleFolder.Name = "FallenRubble_"..i; rubbleFolder.Parent = Roof
			for k=1, 6 do
				local rx = rng:NextNumber(-8, 8)
				local rz = sz + rng:NextNumber(-6, 6)
				local rs = rng:NextNumber(2, 4)
				local rRotX = rng:NextNumber(0, math.pi)
				local rRotZ = rng:NextNumber(0, math.pi)
				p("FallenChunk_"..k, Vector3.new(rs, rs*0.8, rs), CFrame.new(rx, 1, rz) * CFrame.Angles(rRotX, 0, rRotZ), Enum.Material.Cobblestone, stoneCol, rubbleFolder, false)
			end
		else
			-- Intact roof slab
			p("SolidSlab", Vector3.new(width + 4, 2, slabLength), CFrame.new(0, CY, sz), Enum.Material.Cobblestone, stoneCol, sf, true)
		end
	end

	-- Extra hanging vines from the ceiling along the whole corridor, independent of roof breaks
	local RoofVines = Instance.new("Folder"); RoofVines.Name = "RoofVines"; RoofVines.Parent = root
	local vineRng = Random.new(78901)
	local vineZ = 15
	while vineZ < actualLength - 15 do
		local numVines = vineRng:NextInteger(2, 4)
		for v = 1, numVines do
			local vx = vineRng:NextNumber(-width/2 + 2, width/2 - 2)
			local vz = vineZ + vineRng:NextNumber(-2, 2)
			local vDrop = vineRng:NextNumber(5, 14)
			addVines(RoofVines, CFrame.new(vx, CY, vz), vDrop)
		end
		vineZ = vineZ + vineRng:NextInteger(14, 22)
	end

	-- Vines hanging down the side walls, scattered along the whole corridor
	local WallVines = Instance.new("Folder"); WallVines.Name = "WallVines"; WallVines.Parent = root
	local wallVineRng = Random.new(45612)
	local wvZ = 10
	while wvZ < actualLength - 10 do
		for _, side in ipairs({-1, 1}) do
			if wallVineRng:NextNumber() > 0.12 then
				local strands = wallVineRng:NextInteger(1, 2)
				for s = 1, strands do
					local wx = side * (width/2 - 0.4)
					local wz = wvZ + wallVineRng:NextNumber(-3, 3)
					local vDrop = wallVineRng:NextNumber(6, 18)
					local topY = wallVineRng:NextNumber(height - 12, height - 1)
					local vThick = wallVineRng:NextNumber(0.35, 0.6)
					p("SideWallVine", Vector3.new(vThick, vDrop, vThick), CFrame.new(wx, topY - vDrop/2, wz), Enum.Material.LeafyGrass, Color3.fromRGB(35, 85, 30), WallVines, false)
				end
			end
		end
		wvZ = wvZ + wallVineRng:NextInteger(6, 10)
	end

	-- Secondary Warm Illumination (Torches/Sconces)
	local Torches = Instance.new("Folder"); Torches.Name = "Torches"; Torches.Parent = root
	local torchSpacing = 30
	local numTorches = math.floor(actualLength / torchSpacing)
	for i = 1, numTorches - 1 do
		local tz = i * torchSpacing
		for _, side in ipairs({-1, 1}) do
			local tf = Instance.new("Folder"); tf.Name = "Torch_" .. (side > 0 and "R" or "L"); tf.Parent = Torches
			local tx = side * (width/2 - 1)
			-- Sconce
			p("Sconce", Vector3.new(1, 2, 1), CFrame.new(tx, 12, tz), Enum.Material.Wood, Color3.fromRGB(60, 40, 20), tf, false)
			p("SconceBase", Vector3.new(1.5, 0.5, 1.5), CFrame.new(tx, 11, tz), Enum.Material.Metal, Color3.fromRGB(30, 30, 30), tf, false)
			-- Flame part
			local flame = p("Flame", Vector3.new(0.5, 0.5, 0.5), CFrame.new(tx, 13.5, tz), Enum.Material.Neon, Color3.fromRGB(255, 150, 50), tf, false)
			-- PointLight
			local pl = Instance.new("PointLight")
			pl.Color = Color3.fromRGB(255, 160, 80); pl.Range = 18; pl.Brightness = 2.5; pl.Shadows = false; pl.Parent = flame
		end
	end

	-- Re-add GateAB Visuals
	local gateVisual = Instance.new("Folder"); gateVisual.Name = "GateAB_Visual"; gateVisual.Parent = root
	local gateZ = MapManager.rooms.GateAB.z
	local function pG(n, s, c, m, col)
		local pt = Instance.new("Part"); pt.Name = n; pt.Size = s; pt.CFrame = c; pt.Anchored = true
		pt.Material = m; pt.Color = col; pt.Parent = gateVisual; GeometryCore.incrementCount("visual"); return pt
	end

	-- Heavy Stone Portal Frame (Recessed)
	pG("ColumnL", Vector3.new(3, 15, 3), CFrame.new(-7.5, 6.5, gateZ - 2), Enum.Material.Cobblestone, Color3.fromRGB(45, 42, 48))
	pG("ColumnR", Vector3.new(3, 15, 3), CFrame.new(7.5, 6.5, gateZ - 2), Enum.Material.Cobblestone, Color3.fromRGB(45, 42, 48))
	pG("ArchLintel", Vector3.new(18, 4, 3.5), CFrame.new(0, 15.5, gateZ - 2), Enum.Material.Cobblestone, Color3.fromRGB(40, 38, 42))
	pG("Keystone", Vector3.new(4, 5, 4), CFrame.new(0, 15.5, gateZ - 1.8), Enum.Material.Cobblestone, Color3.fromRGB(35, 32, 38))

	pG("Threshold", Vector3.new(16, 1.5, 5), CFrame.new(0, -1.25, gateZ), Enum.Material.Cobblestone, Color3.fromRGB(40, 38, 43))

	-- Removed GateAB Wooden Door here, it will be added in RoomB

	-- Add Obstacles
	local startPos = Vector3.new(0, 0, 0)
	local forward = Vector3.new(0, 0, 1)

	-- Wrap generation in a protected call to avoid crashing if it fails
	local success, err = pcall(function()
		generateRoomAObstacleCourse(root, startPos, forward, actualLength, width, height)
	end)
	if not success then
		warn("Failed to generate obstacle course: " .. tostring(err))
	end
end

