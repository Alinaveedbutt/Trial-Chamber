	print("TrialChamberV5 Generator (Stage 1A, 1B, 1C) starting...")

	local targetName = "TrialChamberGeneratedV5"

	if workspace:FindFirstChild(targetName) then
		workspace[targetName]:Destroy()
	end

	MapManager.init()

	local root = Instance.new("Model")
	root.Name = targetName
	root.Parent = workspace

	print("Building Forecourt & Phase 1A Structural Shells...")
	EntryForecourt.build(root)
	RoomA.build(root)

	print("Building Clearance Chamber & Transitions...")
	ClearanceChamber.build(root)
	Collapse.buildAll(root)

	print("Building Room B...")
	RoomB.build(root)

	print("Building Room C (The Heart Chamber)...")
	RoomC.build(root)

	print("Building Room D (The Ancient Chasm)...")
