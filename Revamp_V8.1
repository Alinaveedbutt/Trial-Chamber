-- 4. GEOMETRY CORE
------------------------------------------------------------------------
local GeometryCore = {
	partCount = { total = 0, structural = 0, grounding = 0, visual = 0 }
}

function GeometryCore.incrementCount(category)
	GeometryCore.partCount.total += 1
	if category then
		GeometryCore.partCount[category] = (GeometryCore.partCount[category] or 0) + 1
	end
end

function GeometryCore.getRight(forward)
	-- Right-hand rule: Right = Forward x Up
	-- (X, 0, Z) x (0, 1, 0) = (-Z, 0, X)
	return Vector3.new(-forward.Z, 0, forward.X).Unit
end

function GeometryCore.orientedCFrame(position, forward)
	local right = GeometryCore.getRight(forward)
	local up = Vector3.new(0, 1, 0)
	return CFrame.fromMatrix(position, right, up, -forward)
end

function GeometryCore.newFolder(parent, name)
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

function GeometryCore.newPart(properties, category)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = true
	part.CastShadow = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(properties) do part[k] = v end
	GeometryCore.incrementCount(category or "structural")
	return part
end

function GeometryCore.addOrientedPart(parent, name, size, position, forward, material, color, category)
	return GeometryCore.newPart({
		Name = name, Size = size, CFrame = GeometryCore.orientedCFrame(position, forward),
		Material = material, Color = color, Parent = parent
	}, category)
end

local function np(name, size, cframe, material, color, parent, canCollide)
	local p = Instance.new("Part")
	p.Name = name; p.Size = size; p.CFrame = cframe
	p.Anchored = true; p.CanCollide = (canCollide ~= false)
	p.Material = material; p.Color = color
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent; GeometryCore.incrementCount("visual")
	return p
end

local function nw(name, size, cframe, material, color, parent)
	local p = Instance.new("WedgePart")
	p.Name = name; p.Size = size; p.CFrame = cframe
	p.Anchored = true; p.CanCollide = false
	p.Material = material; p.Color = color
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent; GeometryCore.incrementCount("visual")
	return p
end

local function nc(name, diameter, length, cframe, material, color, parent, canCollide)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Name = name; p.Size = Vector3.new(length, diameter, diameter); p.CFrame = cframe
	p.Anchored = true; p.CanCollide = (canCollide ~= false)
	p.Material = material; p.Color = color
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent; GeometryCore.incrementCount("visual")
	return p
end

