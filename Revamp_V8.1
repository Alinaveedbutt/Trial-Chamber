	prompt.HoldDuration = 1.5
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = 12
	prompt.Parent = promptAnchor

	------------------------------------------------------------------------
	-- FLOATING ARCANE ORBS (6 motes orbiting the crystal)
	------------------------------------------------------------------------
	local orbFolder = GeometryCore.newFolder(daisFolder, "ArcaneOrbs")
	local numOrbs = 6
	for i = 0, numOrbs - 1 do
		local orbAngle = i * (math.pi * 2) / numOrbs
		local orbDist = 12
		local orbX = math.sin(orbAngle) * orbDist
		local orbZ = math.cos(orbAngle) * orbDist
		local orbY = heartCenter.Y + math.sin(orbAngle * 2) * 1.5

		local orb = GeometryCore.newPart({
			Name = "ArcaneOrb_" .. i,
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2.5, 2.5, 2.5),
			CFrame = CFrame.new(heartCenter.X + orbX, orbY, heartCenter.Z + orbZ),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(50, 150, 255), -- Blue
			Transparency = 0.15,
			CanCollide = false,
			Parent = orbFolder
		}, "decorative")

		local orbLight = Instance.new("PointLight")
		orbLight.Color = Color3.fromRGB(80, 180, 255) -- Blue light
		orbLight.Range = 16
		orbLight.Brightness = 2
		orbLight.Shadows = false
		orbLight.Parent = orb
	end

	-- Collapse trigger script (placed on the folder, NOT on the crystal part)
	local function runCollapseSequence(dais)
		local crystal = dais:FindFirstChild("TheHeartCrystal")
		local anchor = dais:FindFirstChild("HeartPromptAnchor")
		local orbFolder = dais:FindFirstChild("ArcaneOrbs")
		if not crystal or not anchor then return end

		local prompt = anchor:FindFirstChildOfClass("ProximityPrompt")
		local runService = game:GetService("RunService")
		local startY = crystal.Position.Y

		-- Float + spin the crystal and orbs
		local floatConn
		floatConn = runService.Heartbeat:Connect(function(dt)
			local t = os.clock()
			-- Crystal: gentle spin and bob
			local newY = startY + math.sin(t * 1.8) * 0.6
			crystal.CFrame = CFrame.new(crystal.Position.X, newY, crystal.Position.Z)
				* CFrame.Angles(0, 0, math.rad(45))
				* CFrame.Angles(0, math.rad(t * 25), 0)

			-- Orbs: orbit around the crystal
			if orbFolder then
				local orbs = orbFolder:GetChildren()
				for idx, orb in ipairs(orbs) do
					if orb:IsA("BasePart") then
						local baseAngle = (idx - 1) * (math.pi * 2) / #orbs
						local orbAngle = baseAngle + t * 0.8
						local orbDist = 12
						local ox = math.sin(orbAngle) * orbDist
						local oz = math.cos(orbAngle) * orbDist
						local oy = newY + math.sin(orbAngle * 2 + t) * 1.5
						orb.Position = Vector3.new(crystal.Position.X + ox, oy, crystal.Position.Z + oz)
					end
				end
			end
		end)

		if prompt then
			prompt.Triggered:Connect(function(player)
				prompt:Destroy()
				crystal.Color = Color3.fromRGB(100, 100, 100)
				crystal.Material = Enum.Material.Glass
				for _, child in ipairs(crystal:GetChildren()) do
					if child:IsA("PointLight") or child:IsA("Highlight") then
						child:Destroy()
					end
				end
				-- Fade out orbs
				if orbFolder then
					for _, orb in ipairs(orbFolder:GetChildren()) do
						if orb:IsA("BasePart") then
							orb.Transparency = 0.8
							orb.Color = Color3.fromRGB(80, 80, 80)
							for _, c in ipairs(orb:GetChildren()) do
								if c:IsA("PointLight") then c:Destroy() end
							end
						end
					end
				end
				if floatConn then floatConn:Disconnect() end

				local sound = Instance.new("Sound")
				sound.SoundId = "rbxassetid://138081509"
				sound.Volume = 2
				sound.Looped = true
				sound.Parent = crystal
				sound:Play()

				local tweenService = game:GetService("TweenService")
				local ti = TweenInfo.new(3, Enum.EasingStyle.Linear)
				tweenService:Create(game.Lighting, ti, {Ambient = Color3.fromRGB(30, 15, 15)}):Play()

				print("COLLAPSE SEQUENCE INITIATED - Wizard: 'Quickly, child! The chamber is unstable!'")
			end)
		end
	end

	local collapseScript = Instance.new("Script")
	collapseScript.Name = "CollapseSequence"
	local collapseSource = [[
		local dais = script.Parent
		local crystal = dais:FindFirstChild("TheHeartCrystal")
		local anchor = dais:FindFirstChild("HeartPromptAnchor")
		local orbFolder = dais:FindFirstChild("ArcaneOrbs")
		if not crystal or not anchor then return end

		local prompt = anchor:FindFirstChildOfClass("ProximityPrompt")
		local runService = game:GetService("RunService")
		local startY = crystal.Position.Y

		-- Float + spin the crystal and orbs
		local floatConn
		floatConn = runService.Heartbeat:Connect(function(dt)
			local t = os.clock()
			-- Crystal: gentle spin and bob
			local newY = startY + math.sin(t * 1.8) * 0.6
			crystal.CFrame = CFrame.new(crystal.Position.X, newY, crystal.Position.Z)
				* CFrame.Angles(0, 0, math.rad(45))
				* CFrame.Angles(0, math.rad(t * 25), 0)

			-- Orbs: orbit around the crystal
			if orbFolder then
				local orbs = orbFolder:GetChildren()
				for idx, orb in ipairs(orbs) do
					if orb:IsA("BasePart") then
						local baseAngle = (idx - 1) * (math.pi * 2) / #orbs
						local orbAngle = baseAngle + t * 0.8
						local orbDist = 12
						local ox = math.sin(orbAngle) * orbDist
						local oz = math.cos(orbAngle) * orbDist
						local oy = newY + math.sin(orbAngle * 2 + t) * 1.5
						orb.Position = Vector3.new(crystal.Position.X + ox, oy, crystal.Position.Z + oz)
					end
				end
			end
		end)

		if prompt then
			prompt.Triggered:Connect(function(player)
				prompt:Destroy()
				crystal.Color = Color3.fromRGB(100, 100, 100)
				crystal.Material = Enum.Material.Glass
				for _, child in ipairs(crystal:GetChildren()) do
					if child:IsA("PointLight") or child:IsA("Highlight") then
						child:Destroy()
					end
				end
				-- Fade out orbs
				if orbFolder then
					for _, orb in ipairs(orbFolder:GetChildren()) do
						if orb:IsA("BasePart") then
							orb.Transparency = 0.8
							orb.Color = Color3.fromRGB(80, 80, 80)
							for _, c in ipairs(orb:GetChildren()) do
								if c:IsA("PointLight") then c:Destroy() end
							end
						end
					end
				end
				if floatConn then floatConn:Disconnect() end

				local sound = Instance.new("Sound")
				sound.SoundId = "rbxassetid://138081509"
				sound.Volume = 2
				sound.Looped = true
				sound.Parent = crystal
				sound:Play()

				local tweenService = game:GetService("TweenService")
				local ti = TweenInfo.new(3, Enum.EasingStyle.Linear)
				tweenService:Create(game.Lighting, ti, {Ambient = Color3.fromRGB(30, 15, 15)}):Play()

				print("COLLAPSE SEQUENCE INITIATED - Wizard: 'Quickly, child! The chamber is unstable!'")
			end)
		end
	]]
	
	local canSetSource = pcall(function()
		collapseScript.Source = collapseSource
	end)
	
	if not canSetSource then
		task.spawn(function()
			runCollapseSequence(daisFolder)
		end)
	end
	
	collapseScript.Parent = daisFolder

	------------------------------------------------------------------------
	-- ARCANE CONTAINMENT ARRAY (Upgraded Arches)
	------------------------------------------------------------------------
	local numArches = 8
	local archPositions = {}
	for i = 0, numArches - 1 do
		local aAngle = i * (math.pi * 2) / numArches
		local dirX = math.sin(aAngle)
		local dirZ = math.cos(aAngle)
		local aDist = poolRadius + 3
		local aPos = pos + Vector3.new(dirX * aDist, 0, dirZ * aDist)
		local fwd = Vector3.new(-dirX, 0, -dirZ)
		local right = GeometryCore.getRight(fwd)

		table.insert(archPositions, {pos = aPos, right = right, fwd = fwd})

		-- Pillars (Dark obsidian/basalt)
		local pillarH = 18
		local pMat = Enum.Material.Basalt
		local pCol = Color3.fromRGB(18, 18, 22)

		GeometryCore.newPart({
			Name = "ContainPillarL_" .. i, Size = Vector3.new(2.5, pillarH, 2.5),
			CFrame = CFrame.new(aPos - right * 4.5 + Vector3.new(0, pillarH / 2, 0)),
			Material = pMat, Color = pCol, Parent = decorFolder
		}, "structural")
		GeometryCore.newPart({
			Name = "ContainPillarR_" .. i, Size = Vector3.new(2.5, pillarH, 2.5),
			CFrame = CFrame.new(aPos + right * 4.5 + Vector3.new(0, pillarH / 2, 0)),
			Material = pMat, Color = pCol, Parent = decorFolder
		}, "structural")

		-- Ominous Glowing Runes carved into the pillars
		GeometryCore.newPart({
			Name = "PillarRuneL_" .. i, Size = Vector3.new(2.6, 8, 0.2),
			CFrame = CFrame.new(aPos - right * 4.5 + Vector3.new(0, pillarH / 2 + 1, 0)) * CFrame.fromMatrix(Vector3.zero, right, Vector3.yAxis),
			Material = Enum.Material.Neon, Color = Color3.fromRGB(220, 20, 20),
			Transparency = 0.1, CanCollide = false, Parent = decorFolder
		}, "decorative")
		GeometryCore.newPart({
			Name = "PillarRuneR_" .. i, Size = Vector3.new(2.6, 8, 0.2),
			CFrame = CFrame.new(aPos + right * 4.5 + Vector3.new(0, pillarH / 2 + 1, 0)) * CFrame.fromMatrix(Vector3.zero, right, Vector3.yAxis),
