local Masonry = {}

function Masonry.buildWallCourse(parent, name, p1, p2, height, thickness, material, color)
	local edge = (p2 - p1)
	local length = edge.Magnitude
	local dir = edge.Unit
	local inward = Vector3.new(dir.Z, 0, -dir.X)
	local midpoint = (p1 + p2) / 2
	local center = midpoint + Vector3.new(0, height / 2, 0)

	local folder = GeometryCore.newFolder(parent, name)
	local courses = 3
	local cHeight = height / courses
	for i = 1, courses do
		local cCenter = midpoint + Vector3.new(0, (i - 0.5) * cHeight, 0)
		local cFrame = CFrame.fromMatrix(cCenter, dir, Vector3.yAxis, -inward)
		GeometryCore.newPart({
			Name = "Course_" .. i, Size = Vector3.new(length, cHeight, thickness),
			CFrame = cFrame, Material = material or MAT.wall, Color = color or COLOR.wall, Parent = folder
		}, "structural")
	end
	return folder
end

function Masonry.buildPilaster(parent, name, pos, fwd, width, height, depth)
	local folder = GeometryCore.newFolder(parent, name)
	local w = width
	local d = depth
	local mat = Enum.Material.Cobblestone
	local trimMat = Enum.Material.Slate
	local col = COLOR.wall
	local trimCol = COLOR.trim

	-- 1. Base Plinth (Thick, wide bottom block)
	local plinthH = 1.5
	GeometryCore.addOrientedPart(folder, "Plinth", Vector3.new(w, plinthH, d + 1.2), pos + Vector3.new(0, plinthH/2, 0), fwd, trimMat, trimCol, "structural")

	-- 2. Base Torus (Trim ring above plinth)
	local torusH = 1.0
	GeometryCore.addOrientedPart(folder, "Torus", Vector3.new(w - 0.2, torusH, d + 0.8), pos + Vector3.new(0, plinthH + torusH/2, 0), fwd, trimMat, trimCol, "structural")

	-- 3. Lower Shaft (Heavy blocks)
	local lowerH = 6.0
	GeometryCore.addOrientedPart(folder, "LowerShaft", Vector3.new(w - 0.4, lowerH, d + 0.4), pos + Vector3.new(0, plinthH + torusH + lowerH/2, 0), fwd, mat, col, "structural")

	-- 4. Mid Band (Horizontal trim break)
	local bandH = 1.0
	GeometryCore.addOrientedPart(folder, "MidBand", Vector3.new(w, bandH, d + 0.6), pos + Vector3.new(0, plinthH + torusH + lowerH + bandH/2, 0), fwd, trimMat, trimCol, "structural")

	-- 5. Upper Shaft (Taller section)
	local upperY = plinthH + torusH + lowerH + bandH
	local capY = height - 3.0
	local upperH = capY - upperY
	GeometryCore.addOrientedPart(folder, "UpperShaft", Vector3.new(w - 0.4, upperH, d + 0.4), pos + Vector3.new(0, upperY + upperH/2, 0), fwd, mat, col, "structural")

	-- 6. Capital Neck (Trim below abacus)
	local neckH = 1.0
	GeometryCore.addOrientedPart(folder, "CapitalNeck", Vector3.new(w - 0.2, neckH, d + 0.8), pos + Vector3.new(0, capY + neckH/2, 0), fwd, trimMat, trimCol, "structural")

	-- 7. Capital Abacus (Wide top block supporting the arch)
	local abacusH = 2.0
	GeometryCore.addOrientedPart(folder, "CapitalAbacus", Vector3.new(w, abacusH, d + 1.2), pos + Vector3.new(0, capY + neckH + abacusH/2, 0), fwd, trimMat, trimCol, "structural")

	-- 8. Front Pilaster Flute (Decorative vertical strip running up the shaft to give it depth)
	local fluteW = w - 1.2
	local fluteD = 0.6
	local zOffset = (d + 0.4) / 2 + fluteD / 2
	GeometryCore.addOrientedPart(folder, "FluteLower", Vector3.new(fluteW, lowerH, fluteD), pos + Vector3.new(0, plinthH + torusH + lowerH/2, 0) + fwd * zOffset, fwd, mat, col, "structural")
	GeometryCore.addOrientedPart(folder, "FluteUpper", Vector3.new(fluteW, upperH, fluteD), pos + Vector3.new(0, upperY + upperH/2, 0) + fwd * zOffset, fwd, mat, col, "structural")

	return folder
end

function Masonry.buildIntegratedArch(parent, name, p1, p2, height, thickness, openingWidth, openingHeight, mat, col)
	local folder = GeometryCore.newFolder(parent, name)
	local edge = (p2 - p1)
	local length = edge.Magnitude
	local dir = edge.Unit
	local inward = Vector3.new(dir.Z, 0, -dir.X)
	local midpoint = (p1 + p2) / 2
	local sideWidth = (length - openingWidth) / 2
	local lintelHeight = height - openingHeight

	local leftCenter = p1 + dir * (sideWidth / 2) + Vector3.new(0, height / 2, 0)
	GeometryCore.newPart({
		Name = "WallL", Size = Vector3.new(sideWidth, height, thickness),
		CFrame = CFrame.fromMatrix(leftCenter, dir, Vector3.yAxis, -inward), Material = mat or MAT.wall, Color = col or COLOR.wall, Parent = folder
	}, "structural")

	local rightCenter = p2 - dir * (sideWidth / 2) + Vector3.new(0, height / 2, 0)
	GeometryCore.newPart({
		Name = "WallR", Size = Vector3.new(sideWidth, height, thickness),
		CFrame = CFrame.fromMatrix(rightCenter, dir, Vector3.yAxis, -inward), Material = mat or MAT.wall, Color = col or COLOR.wall, Parent = folder
	}, "structural")

	local lintelCenter = midpoint + Vector3.new(0, openingHeight + lintelHeight / 2, 0)
	GeometryCore.newPart({
		Name = "Lintel", Size = Vector3.new(openingWidth, lintelHeight, thickness),
		CFrame = CFrame.fromMatrix(lintelCenter, dir, Vector3.yAxis, -inward), Material = MAT.trim, Color = COLOR.trim, Parent = folder
	}, "structural")

	GeometryCore.newPart({
		Name = "OpeningAperture", Size = Vector3.new(openingWidth, openingHeight, thickness + 0.1),
		CFrame = CFrame.fromMatrix(midpoint + Vector3.new(0, openingHeight/2, 0), dir, Vector3.yAxis, -inward),
		Transparency = 1, CanCollide = false, Parent = folder
	}, "structural")
	return folder
end

function Masonry.buildGrounding(parent, pos, width, length, depth)
	local folder = GeometryCore.newFolder(parent, "RuggedGrounding")

	local coreW = width * 0.8
	local coreL = length * 0.8
	GeometryCore.newPart({
		Name = "FoundationCore", Size = Vector3.new(coreW, depth, coreL),
		CFrame = CFrame.new(pos - Vector3.new(0, depth / 2 + 1, 0)),
		Material = MAT.foundation, Color = COLOR.foundation, Parent = folder
	}, "grounding")

	math.randomseed(math.floor(pos.X + pos.Y + pos.Z + width + length))
	local edgeBlocks = math.floor(length / 2.5) -- Scaled for length
	for edge = 1, 4 do
		local isLongEdge = (edge == 1 or edge == 2)
		local iter = isLongEdge and edgeBlocks or math.floor(width / 2.5)
		for i = 1, iter do
			local t = (math.random() - 0.5)
			local bx, bz
			if edge == 1 then bx = t * width; bz = length/2
			elseif edge == 2 then bx = t * width; bz = -length/2
			elseif edge == 3 then bx = width/2; bz = t * length
			else bx = -width/2; bz = t * length end

			-- Prevent buttresses from spawning in the center of edges (blocking doorways)
			if math.abs(bx) < 20 and math.abs(bz) >= length/2 - 1 then
				continue
			end
			if math.abs(bz) < 20 and math.abs(bx) >= width/2 - 1 then
				continue
			end

			-- Mossy ruins treatment on top-facing edges (if not completely hidden)
			local isMossy = math.random() > 0.6
			local cMat = isMossy and MAT.wall or MAT.cliff
			local cCol = isMossy and C_LITE_STONE or COLOR.cliff

			bx = bx + (bx > 0 and 2 or (bx < 0 and -2 or 0))
			bz = bz + (bz > 0 and 2 or (bz < 0 and -2 or 0))

			local bw = 15 + math.random() * 15
			local bl = 15 + math.random() * 15
			local bh = depth + math.random() * 20

			local yOffset = isMossy and (-bh/2 - 0.5) or (-bh/2 - 2) -- Mossy ones slightly higher
			local bCFrame = CFrame.new(pos + Vector3.new(bx, yOffset, bz)) * CFrame.Angles(0, math.random() * math.pi, 0)

			GeometryCore.newPart({
				Name = "CliffButtress", Size = Vector3.new(bw, bh, bl),
				CFrame = bCFrame, Material = cMat, Color = cCol, Parent = folder
			}, "grounding")
		end
	end
end

function Masonry.buildBlindArchBay(parent, name, p1, p2, height, thickness, recessDepth, mat, col)
	local folder = GeometryCore.newFolder(parent, name)
	local edge = (p2 - p1)
	local length = edge.Magnitude
	local dir = edge.Unit
	local inward = Vector3.new(-dir.Z, 0, dir.X)

	local pilasterWidth = 2
	local bayWidth = length - (pilasterWidth * 2)
	local p1C = p1 + dir * (pilasterWidth/2)
	local p2C = p2 - dir * (pilasterWidth/2)
	local pCenter = p1 + dir * (length/2)

	-- Sub-foundation to ensure no black voids or floating sections if the floor dips
	local subDepth = 12
	GeometryCore.newPart({
		Name = "PilasterL_Foundation", Size = Vector3.new(pilasterWidth, subDepth, thickness + 1),
		CFrame = CFrame.fromMatrix(p1C + Vector3.new(0, -subDepth/2, 0), dir, Vector3.yAxis, -inward),
		Material = MAT.trim, Color = COLOR.trim, Parent = folder
	}, "structural")
	GeometryCore.newPart({
		Name = "PilasterR_Foundation", Size = Vector3.new(pilasterWidth, subDepth, thickness + 1),
		CFrame = CFrame.fromMatrix(p2C + Vector3.new(0, -subDepth/2, 0), dir, Vector3.yAxis, -inward),
		Material = MAT.trim, Color = COLOR.trim, Parent = folder
	}, "structural")

	-- Main Architectural Pilasters (Base, Shaft, Capital)
	Masonry.buildPilaster(folder, "PilasterL", p1C, -inward, pilasterWidth, height, thickness)
	Masonry.buildPilaster(folder, "PilasterR", p2C, -inward, pilasterWidth, height, thickness)

	local archHeight = 6
	local clearHeight = height - archHeight
	GeometryCore.newPart({
		Name = "BayArch", Size = Vector3.new(bayWidth + 0.1, archHeight, thickness),
		CFrame = CFrame.fromMatrix(pCenter + Vector3.new(0, clearHeight + archHeight/2, 0), dir, Vector3.yAxis, -inward),
		Material = mat or MAT.wall, Color = col or COLOR.wall, Parent = folder
	}, "structural")

	-- Removed ArchBracketL and ArchBracketR to eliminate excessive X-shaped cross-bracing

	local backThickness = thickness - recessDepth
	local backShift = recessDepth / 2
	-- The 'inward' vector actually points outward (away from the room center).
	-- Adding it pushes the wall deep into the boundary, properly recessing it.
	local backCenter = pCenter + inward * backShift

	GeometryCore.newPart({
		Name = "RecessedWall", Size = Vector3.new(bayWidth + 0.2, clearHeight + 0.1, backThickness),
		CFrame = CFrame.fromMatrix(backCenter + Vector3.new(0, clearHeight/2, 0), dir, Vector3.yAxis, -inward),
		Material = MAT.wall, Color = COLOR.wallDark, Parent = folder
	}, "structural")

	return folder
end

