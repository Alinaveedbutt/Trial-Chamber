	{z = 62.5, len = 125}, -- Zone 1, 2, 3: Continuous structural floor
	-- Zone 4 (Z=125-170): Central trench
	{z = 147.5, len = 45, y = -6},        -- Trench base
	{z = 147.5, len = 45, w = 8, x = -11, h = 8, y = -3},-- Left lane (Solid to bottom)
	{z = 147.5, len = 45, w = 8, x = 11, h = 8, y = -3}, -- Right lane (Solid to bottom)
	-- Zone 5 (Z=170-185): Gate approach
	{z = 177.5, len = 15},
	-- Zone 6 (Z=200-250): Post-ramp platform
	{z = 225, len = 50, h = 6, y = 2}, -- Platform (Solid to bottom: top=5, bottom=-1)
}

function RoomA.build(parent)
	local folder = GeometryCore.newFolder(parent, "RoomA")
	local pos = MapManager.rooms.RoomA.position

	local length = 250
	local width = 30
	local height = 24
	local t = 4

	Masonry.buildGrounding(folder, pos, width + 40, length + 40, 60)

	-- Structural floor segments to support physical pits/trenches
	for i, fd in ipairs(RoomA.floorData) do
		local yOffset = fd.y or 0
		local segW = fd.w or width
		local segX = fd.x or 0
		local segH = fd.h or 2
		GeometryCore.addOrientedPart(folder, "StructuralFloor_Seg"..i, Vector3.new(segW, segH, fd.len), 
			Vector3.new(segX, -1 + yOffset, fd.z), Vector3.new(0,0,-1), Enum.Material.Cobblestone, Color3.fromRGB(80, 95, 75), "structural")
	end

	local rampLen = 15
	local rampRise = 5
	local rampPitch = math.atan2(rampRise, rampLen)
	local rampHyp = math.sqrt(rampLen^2 + rampRise^2)
	local rampCFrame = CFrame.new(Vector3.new(0, rampRise/2 - 1, 185 + rampLen/2)) * CFrame.Angles(rampPitch, 0, 0)
	GeometryCore.newPart({
		Name = "StructuralRamp", Size = Vector3.new(width, 2, rampHyp),
		CFrame = rampCFrame, Material = Enum.Material.Cobblestone, Color = Color3.fromRGB(80, 95, 75), Parent = folder
	}, "structural")

	local numBays = 10
	local bayLength = length / numBays
	local recessDepth = 2.5

	for i = 1, numBays do
		local bayZStart = (i - 1) * bayLength
		local bayZEnd = bayZStart + bayLength

		local p1L = Vector3.new(-width/2, 0, bayZStart)
		local p2L = Vector3.new(-width/2, 0, bayZEnd)
		Masonry.buildBlindArchBay(folder, "BayL_"..i, p1L, p2L, height, t, recessDepth, MAT.wall, COLOR.wall)

		local p1R = Vector3.new(width/2, 0, bayZEnd)
		local p2R = Vector3.new(width/2, 0, bayZStart)
		Masonry.buildBlindArchBay(folder, "BayR_"..i, p1R, p2R, height, t, recessDepth, MAT.wall, COLOR.wall)
	end

	local gateParams = MapManager.rooms.GateAB
	local p1G = Vector3.new(-width/2, gateParams.y, gateParams.z)
	local p2G = Vector3.new(width/2, gateParams.y, gateParams.z)
	Masonry.buildIntegratedArch(folder, "GateAB", p1G, p2G, height, t, gateParams.width, gateParams.height, MAT.wall, COLOR.wall)

	return folder
end

